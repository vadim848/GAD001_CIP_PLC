<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="MAIN" Id="{97de8132-b6af-4a2c-b014-8f1e8c1f4c6b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	k: REAL;
	ton_Life: TON;
	memo_last_component_Index: INT;
	ton_BlendingTime: TON;
	tBlendingRemainTime: DINT;
	fBlendingPercenatge: DINT;
	ptTemp: DINT;
	realTemp: REAL;
	iProgressBarOfset: DINT;
	iActualComponentDisolving_Done_lifetime: INT;
	ftDissolvingActive: F_TRIG;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[k:=k+1;

//g_HMI_Panel.stVisuPLC_To_PLC.RPM_setPoint:=k;

ton_Life(PT:=T#1S, IN:=NOT ton_Life.Q);
IF ton_Life.ET>T#0.5S THEN;
	g_HMI_Panel.stVisuPLC_To_PLC.lifeBit:=TRUE;
ELSE;
	g_HMI_Panel.stVisuPLC_To_PLC.lifeBit:=FALSE;
END_IF


IF memo_last_component_Index <> stPLC_To_VisuPLC.iActual_Component THEN;
	IF stPLC_To_VisuPLC.iActual_Component>=1 AND stPLC_To_VisuPLC.iActual_Component<=10 THEN;
		stVisuPLC_To_PLC.RPM_setPoint:=stPLC_To_VisuPLC.arr_Component[stPLC_To_VisuPLC.iActual_Component].rFlowRate_Dissolving;
		ton_BlendingTime(PT:=g_HMI_Panel.stPLC_To_VisuPLC.arr_Component[stPLC_To_VisuPLC.iActual_Component].tBlendingDuration);
	ELSE;
		stVisuPLC_To_PLC.RPM_setPoint:=0;
	END_IF	
	memo_last_component_Index:= stPLC_To_VisuPLC.iActual_Component;
	g_HMI_Panel.stVisuPLC_To_PLC.bActualComponentDisolving_Done:=FALSE;
END_IF


ton_BlendingTime();
IF g_HMI_Panel.stPLC_To_VisuPLC.bBlending_Active THEN;
	ton_BlendingTime.IN:=TRUE;
	tBlendingRemainTime:=TIME_TO_DINT(ton_BlendingTime.PT - ton_BlendingTime.ET);
ELSE;
	ton_BlendingTime.IN:=FALSE;
END_IF

ptTemp:=TIME_TO_DINT(ton_BlendingTime.PT);
IF ton_BlendingTime.PT<>T#0S THEN;
	realTemp:=(DINT_TO_REAL(tBlendingRemainTime)/DINT_TO_REAL(ptTemp)*100.0);
	fBlendingPercenatge:=TRUNC(realTemp);
END_IF

iProgressBarOfset:=TRUNC(stPLC_To_VisuPLC.iActual_Component*37.2);

ftDissolvingActive(CLK:=g_HMI_Panel.stPLC_To_VisuPLC.bDissolving_Active);
IF ftDissolvingActive.Q THEN;
	g_HMI_Panel.stVisuPLC_To_PLC.bActualComponentDisolving_Done:=FALSE;
END_IF

(*
IF iActualComponentDisolving_Done_lifetime>0 THEN;
	iActualComponentDisolving_Done_lifetime:=0;
	g_HMI_Panel.stVisuPLC_To_PLC.bActualComponentDisolving_Done:=FALSE;
END_IF
IF g_HMI_Panel.stVisuPLC_To_PLC.bActualComponentDisolving_Done THEN;
	iActualComponentDisolving_Done_lifetime:=iActualComponentDisolving_Done_lifetime+1;	
END_IF
*)]]></ST>
    </Implementation>
