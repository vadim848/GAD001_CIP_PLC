    <Action Name="act_SetAnalogSens_Test" Id="{455abcb0-c90c-4f45-9ea9-f7b3ab53cef4}">
      <Implementation>
        <ST><![CDATA[//set analog sensors setting only for the test. 
//Later this action should be deleted 
IF NOT bTesting THEN
	//Level
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1004].rawVal_Max:=14350;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1004].rawVal_Min:=1270;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1004].outVal_Max:=785;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1004].outVal_Min:=0;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1004].outOffset:=73;
	
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1003].rawVal_Max:=14350;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1003].rawVal_Min:=1270;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1003].outVal_Max:=785;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1003].outVal_Min:=0;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1003].outOffset:=73;
	
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1002].rawVal_Max:=14350;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1002].rawVal_Min:=1270;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1002].outVal_Max:=785;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1002].outVal_Min:=0;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1002].outOffset:=73;
	
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1001].rawVal_Max:=14350;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1001].rawVal_Min:=1270;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1001].outVal_Max:=785;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1001].outVal_Min:=0;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.LT1001].outOffset:=73;
	
	//Flow
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.FT1001].rawVal_Max:=10000;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.FT1001].rawVal_Min:=0;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.FT1001].outVal_Max:=306;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.FT1001].outVal_Min:=0;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.FT1001].outOffset:=0;
	
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.FT1002].rawVal_Max:=10000;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.FT1002].rawVal_Min:=0;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.FT1002].outVal_Max:=306;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.FT1002].outVal_Min:=0;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.FT1002].outOffset:=0;
	
	////conductivity sensors
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.CT1101].rawVal_Max:=14150;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.CT1101].rawVal_Min:=305;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.CT1101].outVal_Max:=14560;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.CT1101].outVal_Min:=346;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.CT1101].outOffset:=0;
	(*
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.CT3101].rawVal_Max:=14150;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.CT3101].rawVal_Min:=305;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.CT3101].outVal_Max:=14560;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.CT3101].outVal_Min:=346;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.CT3101].outOffset:=0;
	*)
	//Temperature sensor
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1001].rawVal_Max:=7470;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1001].rawVal_Min:=6400;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1001].outVal_Max:=26;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1001].outVal_Min:=20.9;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1001].outOffset:=0;
	
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1002].rawVal_Max:=7470;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1002].rawVal_Min:=6400;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1002].outVal_Max:=26;
