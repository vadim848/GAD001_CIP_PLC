    <Action Name="act_ClientPump_Select" Id="{480df326-8779-4f2c-832e-de232bda0b87}">
      <Implementation>
        <ST><![CDATA[CASE arCIP_RequestBufer[0].eClient OF
	E_CIP_Usage.eTank_1,
	E_CIP_Usage.eTank_2:;
				eClientPump:=E_Pump_List.P3002;
	E_CIP_Usage.eTank_3,
	E_CIP_Usage.eTank_4:;
				eClientPump:=E_Pump_List.P4002;
	E_CIP_Usage.eLine_Marinada:;
				eClientPump:=E_Pump_List.P3001;
	E_CIP_Usage.eLine_Color:;
				eClientPump:=E_Pump_List.P4001;
	E_CIP_Usage.eTriBlender_Marinada,
	E_CIP_Usage.eTriBlender_Color:;
				eClientPump:=E_Pump_List.TB0001;
END_CASE]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_ClientStirrer_Select" Id="{05df8c1d-392d-480e-9db6-d6482e017999}">
      <Implementation>
        <ST><![CDATA[CASE arCIP_RequestBufer[0].eClient OF
	E_CIP_Usage.eTank_1:;
				eClientStirrer:=E_Pump_List.AG3001;
	E_CIP_Usage.eTank_2:;
				eClientStirrer:=E_Pump_List.AG3002;
	E_CIP_Usage.eTank_3:;
				eClientStirrer:=E_Pump_List.AG4001;
	E_CIP_Usage.eTank_4:;
				eClientStirrer:=E_Pump_List.AG4002;
	E_CIP_Usage.eLine_Marinada:;
	E_CIP_Usage.eLine_Color:;
	E_CIP_Usage.eTriBlender_Marinada,
	E_CIP_Usage.eTriBlender_Color:;
				
END_CASE]]></ST>
      </Implementation>
    </Action>
