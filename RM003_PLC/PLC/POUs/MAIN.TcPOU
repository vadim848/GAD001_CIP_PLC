	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1002].outOffset:=0;
	
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1003].rawVal_Max:=7470;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1003].rawVal_Min:=6400;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1003].outVal_Max:=26;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1003].outVal_Min:=20.9;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1003].outOffset:=0;
	
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1004].rawVal_Max:=7470;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1004].rawVal_Min:=6400;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1004].outVal_Max:=26;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1004].outVal_Min:=20.9;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1004].outOffset:=0;
	
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1101].rawVal_Max:=7470;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1101].rawVal_Min:=6400;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1101].outVal_Max:=26;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1101].outVal_Min:=20.9;
	g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1101].outOffset:=0;

	bTesting:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
