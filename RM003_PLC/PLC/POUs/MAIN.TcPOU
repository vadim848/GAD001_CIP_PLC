    <Action Name="act_ResetPumps" Id="{d6d5f25f-7520-4a69-86f1-bc96d10af8f9}">
      <Implementation>
        <ST><![CDATA[(*ftg_EStop_Fall(CLK:=prg_Safety.ftStateSafe.Q , Q=> );//EStop falling signal
rs_EStopFall(SET:=ftg_EStop_Fall.Q , RESET1:= , Q1=> );
IF rs_EStopFall.Q1 THEN
	FOR nI_1:=1 TO E_Pump_List.last BY 1 DO
		g_Pump.arr_st_Pump[nI_1].bRun_Auto:=FALSE;
	END_FOR
	rs_EStopFall.RESET1:=TRUE;
END_IF
rs_EStopFall.RESET1:=FALSE;*)
;]]></ST>
      </Implementation>
    </Action>
