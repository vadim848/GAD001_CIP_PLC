<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="MAIN" Id="{3441d04c-1b6a-45f8-92c9-effbc902d265}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR

	fTotalCIP_Volume: REAL;
	fbWritePersistent: FB_WritePersistentData;
	bTesting		:	BOOL:=FALSE	;
	nI_1			: 	INT		;
	ftg_EStop_Fall	: 	F_TRIG	;
	rs_EStopFall	: 	RS	;
	bTestEstop		:	BOOL:=TRUE	;
	FB_OpenClose_Vlave_4026: FB_OpenClose_Vlave;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[prg_RealClock();
prg_Piston();
prg_Safety();
act_ResetPumps();

//act_SetAnalogSens_Test();//To be deleted, for testing purposes
act_Call_Sensors_Analog();//To be deleted, for testing purposes
act_Call_Sensors_Analog_1();//To be deleted, for testing purposes
act_Call_ScaleFactor();//To be deleted, for testing purposes
act_Call_ProcessCntrl();

act_SetValves();
act_ClientPump_Select();
act_ClientStirrer_Select();
act_Call_Elements();
act_Call_Elements_Imp();
act_Call_Pumps();
prg_InterCon_Usage();
act_Sensors();
act_HeatExchenger();
act_Call_CIP();

act_Call_For_HMI();

g_SFC.fbSFC_Temp1();

//Temtprary Overweght protection!!!!! DO NOT DELETE
IF fTotalCIP_Volume >=1500 THEN;
	fbPis[E_Pis_Name.V1022].m_SetByRecipe(stPis:=stPis[E_Pis_Name.V1022], req:=E_Piston_Recipe_State.Release);
	fbPis[E_Pis_Name.V1019].m_SetByRecipe(stPis:=stPis[E_Pis_Name.V1019], req:=E_Piston_Recipe_State.Release);
	fbPis[E_Pis_Name.V1016].m_SetByRecipe(stPis:=stPis[E_Pis_Name.V1016], req:=E_Piston_Recipe_State.Release);
	fbPis[E_Pis_Name.V1011].m_SetByRecipe(stPis:=stPis[E_Pis_Name.V1011], req:=E_Piston_Recipe_State.Release);
END_IF

mElementList_SetName();

fbWritePersistent(
	NETID:= , 
	PORT:= 851, 
	START:= , 
	TMOUT:= T#3S, 
	MODE:= , 
	BUSY=> , 
	ERR=> , 
	ERRID=> );
]]></ST>
    </Implementation>
