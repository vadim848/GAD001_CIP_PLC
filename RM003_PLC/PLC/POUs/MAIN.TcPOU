  <POU Name="MAIN" Id="{3441d04c-1b6a-45f8-92c9-effbc902d265}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[prg_RealClock();
prg_Piston();

act_SetValves();
act_ClientPump_Select();
act_Call_Elements();
act_Call_Elements_Imp();
act_Call_TankTargets();
prg_InterCon_Usage();
act_Sensors();
act_HeatExchenger();

//fbCIP();
act_Call_CIP();


g_SFC.fbSFC_Temp1();

]]></ST>
