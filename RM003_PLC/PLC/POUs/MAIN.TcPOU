    <Action Name="act_ClientPump_Select" Id="{480df326-8779-4f2c-832e-de232bda0b87}">
      <Implementation>
        <ST><![CDATA[CASE arCIP_RequestBufer[0].eClient OF
	E_CIP_Usage.eTank_1,
	E_CIP_Usage.eTank_2:;
				eClientPump:=E_Pump_List.P3002;
	E_CIP_Usage.eTank_3,
	E_CIP_Usage.eTank_4:;
				eClientPump:=E_Pump_List.P4002;
	E_CIP_Usage.eLine_Marinada:;
				eClientPump:=E_Pump_List.P3001;
	E_CIP_Usage.eLine_Color:;
				eClientPump:=E_Pump_List.P4001;
	E_CIP_Usage.eTriBlender_Marinada,
	E_CIP_Usage.eTriBlender_Color:;
				eClientPump:=E_Pump_List.TB0001;
END_CASE]]></ST>
      </Implementation>
    </Action>
