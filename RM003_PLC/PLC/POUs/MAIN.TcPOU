    <Method Name="m_TankConus_Level_Calculation" Id="{a2410655-ac45-4982-beae-77afb1d1db8e}">
      <Declaration><![CDATA[METHOD m_TankConus_Level_Calculation : REAL
VAR_INPUT
	raw: REAL;

END_VAR
VAR
	kConus: REAL:=0.00000002149 ;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF raw<1230 THEN;
	//m_TankConus_Level_Calculation:=kConus*raw^3;
ELSE;
	m_TankConus_Level_Calculation:=raw;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="mElementList_SetName" Id="{fee97784-09c9-4c65-955f-9f389d44d720}">
      <Declaration><![CDATA[METHOD mElementList_SetName : BOOL
VAR_INPUT
END_VAR

VAR
	eASense_Name: E_ASense_Name;
	eProcCntrl: E_ProcessControl_Name;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR eASense_Name:=0 TO E_ASense_Name.last DO
	arAnalogSensorNameList[eASense_Name]:=TO_STRING(eASense_Name);
END_FOR

FOR eProcCntrl:=0 TO E_ProcessControl_Name.eProcCntrl_Last DO
	arr_ProcCntrl_NameList[eProcCntrl]:=TO_STRING(eProcCntrl);
	g_ProcControl.arr_stProcCntrl[eProcCntrl].idName:=TO_STRING(eProcCntrl);
END_FOR]]></ST>
      </Implementation>
    </Method>
