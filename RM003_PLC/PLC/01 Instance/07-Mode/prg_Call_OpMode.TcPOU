<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="prg_Call_OpMode" Id="{37ea252d-f7d6-4416-870e-8e42ec6784ac}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM prg_Call_OpMode
VAR
	fbModeMain:FB_ModeSelect;
	
	rt_HMI_Resume: R_TRIG;
	rt_ActError: R_TRIG;
	
	eModeZone: E_ModeZone;

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbModeMain(sModuleDescription:='Mode Select - Main',
	bInterlockBypass:=TRUE, //bIntZoneBypass[1]
	bLockedFB:=TRUE, //bIntZoneLocked[1]
	bPistonCheck:=FALSE,	
	bLockRequest=>,	//bReq_LockZone[1]
	eModeZone:=E_ModeZone.eMain,
	stMode:=stModeMain,
	stOperation:=stOpMain);
	
FOR eModeZone:=	E_ModeZone.eMain TO E_ModeZone.eLast DO
	fbMode[eModeZone](sModuleDescription:='Mode Select - ',
		bInterlockBypass:=TRUE, //bIntZoneBypass[eModeZone]
		bLockedFB:=TRUE, //bIntZoneLocked[eModeZone]
		bPistonCheck:=FALSE,	
		bLockRequest=>,	//bReq_LockZone[eModeZone]
		eModeZone:=eModeZone,
		stMode:=stMode[eModeZone],
		stOperation:=stOper[eModeZone]);	
END_FOR
	
PauseAll:=stOpMain.iActOperation=E_OperationButtons.ePauseAll;	
PauseAllDelayed:=stOpMain.bPauseOnDelayed;	
	
rt_HMI_Resume(CLK:=ResumeAll);
IF rt_HMI_Resume.Q THEN;
	stOpMain.bSetPlay:=TRUE;
	prg_Messages.act_ResumeSFC();
	ResumeAll:=FALSE;
END_IF

rt_ActError(CLK:=iActErrors<>0);
IF iActErrors<>0 THEN;
	stOpMain.bSetPause:=TRUE;
END_IF

prg_LightTower(
	bBuzzerBypass:=bBuzzerMute , 
	qLedGreen=> , //q_EL16[2].ch11
	qLedYellow=> , //q_EL16[2].ch10
	qLedRed=> , //q_EL16[2].ch9
	qBuzzer=> );//q_EL16[2].ch12

	]]></ST>
    </Implementation>
    <LineIds Name="prg_Call_OpMode">
      <LineId Id="202" Count="7" />
      <LineId Id="242" Count="1" />
      <LineId Id="249" Count="6" />
      <LineId Id="247" Count="1" />
      <LineId Id="210" Count="2" />
      <LineId Id="223" Count="3" />
      <LineId Id="256" Count="1" />
      <LineId Id="227" Count="13" />
      <LineId Id="186" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>