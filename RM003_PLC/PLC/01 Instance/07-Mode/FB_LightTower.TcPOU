    <Property Name="pState" Id="{88d147a0-4679-47f6-a24a-a7b90f823d80}">
      <Declaration><![CDATA[PROPERTY pState : E_LightTowerState]]></Declaration>
      <Get Name="Get" Id="{40bac962-88f1-4e9f-ac5e-956f192760cd}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[pState:=eLightTowerState;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{6db856c8-700b-4b17-af46-01ec428eba79}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eLightTowerState:=pState;]]></ST>
        </Implementation>
      </Set>
    </Property>
