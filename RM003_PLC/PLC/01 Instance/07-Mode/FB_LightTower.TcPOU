<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_LightTower" Id="{d6cadccd-9ab2-46a9-9355-0d0444ba0b75}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LightTower
VAR_INPUT
	bBuzzerBypass: BOOL;
END_VAR
VAR_OUTPUT
	qLedGreen	: BOOL;
	qLedYellow	: BOOL;
	qLedRed		: BOOL;
	qLedBlue	: BOOL;
	qBuzzer		: BOOL;		
	
	qSignal_1: BOOL; //wire BN
	qSignal_2: BOOL; //wire GY
	qSignal_3: BOOL; //wire BK
	qSignal_4: BOOL; //wire WT

END_VAR
VAR
	eLightTowerState		: E_LightTowerState;
	
	ton_Blink				: TON;
	ton_Buzzer				: TON;
	t_Buzzer				: TIME:=T#2S;
	t_BuzzerShort			: TIME:=T#0.5S;
	t_BuzzerErrorDelay		: TIME:=T#10S;
	t_BuzzerWarningDelay	: TIME:=T#30S;
	//eLightTowerState_Last	: E_LightTowerState;
	bBuzzerMuteMemo: BOOL;	
	ton_MuteBuzzer: TON;
	ton_NoMessage: TON;
	ton_BuzzerLongTimeOn: TON;	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[ton_Blink(IN:=NOT ton_Blink.Q);
CASE eLightTowerState OF
	E_LightTowerState.eLightsOff:;
		qLedGreen	:=FALSE;
		qLedYellow	:=FALSE;
		qLedRed		:=FALSE;
		qLedBlue	:=FALSE;
		eBuzzerMode:=eBuzzerOff;	
		
	E_LightTowerState.eGreen:;
		qLedGreen	:=TRUE;
		qLedYellow	:=FALSE;
		qLedRed		:=FALSE;
		qLedBlue	:=FALSE;
		eBuzzerMode:=eBuzzerOff;	
		
	E_LightTowerState.eGreen_YellowBlink:;
		qLedGreen	:=TRUE;
		qLedYellow	:=TRUE;
		qLedRed		:=FALSE;
		qLedBlue	:=FALSE;
		IF bBuzzerMuteMemo THEN;
			eBuzzerMode:=eBuzzerOff;
		ELSE
			eBuzzerMode:=eBuzzerWarning;
		END_IF
		ton_Blink.PT:=T#1S;
		IF ton_Blink.ET>T#0.5S THEN; qLedYellow:=FALSE; ELSE;qLedGreen:=FALSE; END_IF	
		
	E_LightTowerState.eGreenBlink:;
		qLedGreen	:=TRUE;
		qLedYellow	:=FALSE;
		qLedRed		:=FALSE;
		qLedBlue	:=FALSE;
		eBuzzerMode:=eBuzzerOff;		
		ton_Blink.PT:=T#1S;
		IF ton_Blink.ET>T#0.5S THEN; qLedGreen:=FALSE; END_IF	

	E_LightTowerState.eGreenBlink_YellowBlink:;
		qLedGreen	:=TRUE;
		qLedYellow	:=TRUE;
		qLedRed		:=FALSE;
		qLedBlue	:=FALSE;
		IF bBuzzerMuteMemo THEN;
			eBuzzerMode:=eBuzzerOff;
		ELSE
			eBuzzerMode:=eBuzzerWarning;
		END_IF
		ton_Blink.PT:=T#1S;
		IF ton_Blink.ET>T#0.5S THEN; qLedYellow:=FALSE; ELSE;qLedGreen:=FALSE; END_IF

	E_LightTowerState.eGreenBlink_RedBlink:;
		qLedGreen	:=TRUE;
		qLedYellow	:=FALSE;
		qLedRed		:=TRUE;
		qLedBlue	:=FALSE;
		IF bBuzzerMuteMemo THEN;
			eBuzzerMode:=eBuzzerOff;
		ELSE
			eBuzzerMode:=eBuzzerError;
		END_IF
		ton_Blink.PT:=T#1S;
		IF ton_Blink.ET>T#0.5S THEN; qLedRed:=FALSE; ELSE;qLedGreen:=FALSE; END_IF
		
	E_LightTowerState.eYellow:;
		qLedGreen	:=FALSE;
		qLedYellow	:=TRUE;
		qLedRed		:=FALSE;
		qLedBlue	:=FALSE;
		eBuzzerMode:=eBuzzerOff;	
		
	E_LightTowerState.eRed:;
		qLedGreen	:=FALSE;
		qLedYellow	:=FALSE;
		qLedRed		:=TRUE;
		qLedBlue	:=FALSE;
		IF bBuzzerMuteMemo THEN;
			eBuzzerMode:=eBuzzerOff;
		ELSE
			eBuzzerMode:=eBuzzerError;
		END_IF
		
	E_LightTowerState.eBlue:;
		qLedGreen	:=FALSE;
		qLedYellow	:=FALSE;
		qLedRed		:=FALSE;
		qLedBlue	:=TRUE;
		eBuzzerMode:=eBuzzerOff;	
				
END_CASE

ton_NoMessage(PT:=T#5S,IN:=bBuzzerMuteMemo AND iActErrors=0 AND iActWarning=0);

IF (stOpMain.bSetPlay
	(*OR stOpLoad.bSetPlay
	OR stOpUnload.bSetPlay
	OR stOpManip.bSetPlay
	OR stOpHMI.bSetPlay
	OR prg_Call_OpMode.fbModeIndex.rt_Play.Q
	OR prg_Call_OpMode.fbModeLoad.rt_Play.Q
	OR prg_Call_OpMode.fbModeUnload.rt_Play.Q
	OR prg_Call_OpMode.fbModeManip.rt_Play.Q*)
	OR ton_NoMessage.Q	
)
THEN;
	ton_MuteBuzzer.IN:=TRUE;
END_IF
IF ton_MuteBuzzer.IN THEN;
	bBuzzerMuteMemo:=FALSE;
END_IF
ton_MuteBuzzer(PT:=T#1S);
IF ton_MuteBuzzer.Q THEN
	ton_MuteBuzzer.IN:=FALSE;
END_IF
IF prg_Messages.ResetErrors OR ton_BuzzerLongTimeOn.Q THEN;// iActErrors=0 AND iActWarning=0
	bBuzzerMuteMemo:=TRUE;
END_IF
ton_BuzzerLongTimeOn(PT:=T#30M,IN:=eBuzzerMode<>eBuzzerOff);

(*
TYPE E_BuzzerMode :
(
	eBuzzerOff := 0,
	eBuzzerError,		//Short Delay Off
	eBuzzerWarning		//Long Delay Off
);
END_TYPE
*)

IF NOT bBuzzerBypass THEN
	ton_Buzzer();
	CASE eBuzzerMode OF
		eBuzzerOff :;
			qBuzzer:=FALSE;
			
			ton_Buzzer.IN:=FALSE;
		eBuzzerError:;			//Short Delay Off
			qBuzzer:=TRUE;
			ton_Buzzer.PT:=t_BuzzerErrorDelay;
			ton_Buzzer.IN:=NOT ton_Buzzer.Q;
			IF ton_Buzzer.ET>t_Buzzer THEN; qBuzzer:=FALSE; END_IF
		eBuzzerWarning:;		//Long Delay Off
			qBuzzer:=TRUE;
			ton_Buzzer.PT:=t_BuzzerWarningDelay;
			ton_Buzzer.IN:=NOT ton_Buzzer.Q;
			IF ton_Buzzer.ET>t_BuzzerShort THEN; qBuzzer:=FALSE; END_IF
	END_CASE	
ELSE
	qBuzzer:=FALSE;
END_IF
]]></ST>
    </Implementation>
    <Method Name="m_Multi_Layer" Id="{f813da95-f288-460b-9d28-4c9b377be341}">
      <Declaration><![CDATA[METHOD m_Multi_Layer : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
