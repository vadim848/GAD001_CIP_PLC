  <POU Name="prg_Piston" Id="{eba97b3f-d16b-45b8-9de2-1b2adf72b256}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM prg_Piston
VAR
	fbPiston: FB_Piston;
	stPiston: ST_Piston;

	bPis_Next_P: BOOL;
	bPis_Next_N: BOOL;

	

	
	TON_0: TON;
	TON_1: TON;
	TON_2: TON;
	TON_3: TON;
	TON_4: TON;
	TON_5: TON;	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[act_InterLock();
act_Call_list_1_Manif1();

IF bPis_Next_P THEN;
	m_Get_Next_P(iSel:=iPis_sel);
	bPis_Next_P:=FALSE;
END_IF

IF bPis_Next_N THEN;
	m_Get_Next_N(iSel:=iPis_sel);
	bPis_Next_N:=FALSE;
END_IF]]></ST>
    </Implementation>
