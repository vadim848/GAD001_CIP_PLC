    <Action Name="act_InterLock" Id="{e49c5f92-de4c-4721-a52c-28fa14f1aa2b}">
      <Implementation>
        <ST><![CDATA[(*
IF TRUE 
AND stPis[E_Pis_Name.cheesy_cut].st_Deafult
AND stPis[E_Pis_Name.cheesy_down].st_Deafult
AND stPis[E_Pis_Name.cheesy_gripper].st_Deafult
AND stPis[E_Pis_Name.cheesy_turn].st_Deafult

AND stPis[E_Pis_Name.crown_down].st_Deafult
AND stPis[E_Pis_Name.crown_gripper].st_Deafult
AND stPis[E_Pis_Name.crown_press].st_Deafult
AND stPis[E_Pis_Name.crown_push].st_Deafult

AND stPis[E_Pis_Name.crust_down].st_Deafult
AND stPis[E_Pis_Name.crust_hold].st_Deafult
AND stPis[E_Pis_Name.crust_push].st_Deafult
AND stPis[E_Pis_Name.crust_roll].st_Deafult

AND stPis[E_Pis_Name.spikes_rotate_4].st_Deafult
AND stPis[E_Pis_Name.spikes_updown_4].st_Deafult

AND stPis[E_Pis_Name.door_4_2].st_Deafult

AND stPis[E_Pis_Name.trolley_down].st_Deafult

THEN;
	stPis[E_Pis_Name.trolley_move].b_InterLock:=TRUE;
ELSE;
	stPis[E_Pis_Name.trolley_move].b_InterLock:=FALSE;
END_IF
*)]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_Disable_All" Id="{b665308b-b8be-4e05-8254-345cdabd2498}">
      <Declaration><![CDATA[METHOD m_Disable_All : BOOL
VAR_INPUT
END_VAR

VAR
	i: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i:=1 TO E_Pis_Name.last DO;
	stPis[i].b_Enable:=FALSE;
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Enable_All" Id="{f3691701-a6da-42f9-99dd-4e95c02dcac5}">
      <Declaration><![CDATA[METHOD m_Enable_All : BOOL
VAR_INPUT
END_VAR

VAR
	i: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i:=1 TO E_Pis_Name.last DO;
	stPis[i].b_Enable:=TRUE;
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Get_Next_N" Id="{623cdac2-4a00-4f90-b1f2-1ef4145484fb}">
      <Declaration><![CDATA[METHOD m_Get_Next_N : BOOL
VAR_IN_OUT
	iSel: INT;
END_VAR

VAR
	i: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF iSel> 1 THEN;
	FOR i:=iSel-1 TO 1 BY -1 DO
		IF stPis[i].b_Exist THEN;
			iSel:=i;
			RETURN;
		END_IF		
	END_FOR
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Get_Next_P" Id="{9e1d4616-fcd8-437d-b6cf-6c896454aed6}">
      <Declaration><![CDATA[METHOD m_Get_Next_P : BOOL
VAR_IN_OUT
	iSel: INT;
END_VAR

VAR
	i: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//IF iSel< C_MAX_Pistons THEN;
//IF iSel< C_MAX_Pistons_Exist THEN;
IF iSel< E_Pis_Name.last THEN;
	FOR i:=iSel+1 TO E_Pis_Name.last BY 1 DO
		IF stPis[i].b_Exist THEN;
			iSel:=i;
			RETURN;
		END_IF		
	END_FOR
END_IF
]]></ST>
      </Implementation>
    </Method>
