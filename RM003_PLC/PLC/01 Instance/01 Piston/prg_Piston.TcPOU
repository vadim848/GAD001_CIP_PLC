<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="prg_Piston" Id="{eba97b3f-d16b-45b8-9de2-1b2adf72b256}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM prg_Piston
VAR
	fbPiston: FB_Piston;
	stPiston: ST_Piston;

	bPis_Next_P: BOOL;
	bPis_Next_N: BOOL;

	

	
	TON_0: TON;
	TON_1: TON;
	TON_2: TON;
	TON_3: TON;
	TON_4: TON;
	TON_5: TON;	
	i: INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[act_InterLock();
act_Call_list_TanksMarinade();
act_Call_list_TanksColor();
act_Call_list_TanksCoolant();
act_Call_List_LineSource();
act_Call_List_LineTarget();
act_Call_list_CIP_SourceNTarget();
act_Call_list_CIP_Client();
act_Call_list_CIP_Tanks();
act_Call_list_Water();
act_Call_list_TriBlender_Selector();


IF bPis_Next_P THEN;
	m_Get_Next_P(iSel:=iPis_sel);
	bPis_Next_P:=FALSE;
END_IF

IF bPis_Next_N THEN;
	m_Get_Next_N(iSel:=iPis_sel);
	bPis_Next_N:=FALSE;
END_IF

FOR i:=0 TO E_Pis_Name.last DO
	ePisNameList:=i;
	arPisNameList[i]:=TO_STRING(ePisNameList);
END_FOR]]></ST>
    </Implementation>
