    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_ASense_Name :
(
	enum_member := 0,
	//temperature sensors
	TT1001,
	TT1002,
	TT1003,
	TT1004,
	TT1005,
	TT1101,
	TT2001,
	TT3001,
	TT3002,
	TT4001,
	TT4002,
	
	//level sensors
	LT1001,
	LT1002,
	LT1003,
	LT1004,
	LT1061,
	LT1071,
	LT3001,
	LT3002,
	LT4001,
	LT4002,
	
	//Pressure sensors
	PT1001,
	PT3001,
	PT3002,
	PT4001,
	PT4002,
	PT9001,
	PT9002,
	
	//conductivity sensors
	CT1101,
	CT3101,
	
	//Flow
	FM1001,
	FM1002,
	
	//virtual list
	last
);
END_TYPE
]]></Declaration>
