<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="prg_MessageManager" Id="{95ae2e99-240d-4c04-a74a-5e6256dca08f}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM prg_MessageManager
VAR
	i_count         : INT;
	i_Reset         : INT;

	i_Buffer        : INT;
	i_Index         : INT;
	rtPressostat    : R_TRIG;
	PressostatFilter: TON;
	i               : INT;
	bAirPressureOk  : BOOL;
	ton_Error_201_Delay: TON;
	ton_Error_202_Delay: TON;
	ton_Error_251_Delay: TON;
	ton_Error_252_Delay: TON;
	ton_Error_253_Delay: TON;
	ton_Error_203_Delay: TON;
	ton_Error_204_Delay: TON;
	c_Unknown     : INT;
	iNumber       : INT;
	sNumber       : STRING(4);
	iNumber2      : INT;
	sNumber2      : STRING(4);
	iNumber4      : INT;
	sNumber4      : STRING(4);
	iNumber5      : INT;
	sNumber5      : STRING(4);
	rt_Print: R_TRIG;
	sModuleID: STRING(3);
	sModuleDescriptionHMI: STRING;
	testMessage: BOOL;
END_VAR

VAR_INPUT
	b_ResetAll    : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[prg_MessageManager.act_Count();
prg_MessageManager.act_GeneralMessage();
prg_MessageManager.act_Tanks_Lock();
//prg_MessageManager.act_AirPressure();

 m_AirPressure(aSense_Name:=E_ASense_Name.AP1001);
 m_AirPressure(aSense_Name:=E_ASense_Name.AP2001);
 m_AirPressure(aSense_Name:=E_ASense_Name.AP3001);
 m_AirPressure(aSense_Name:=E_ASense_Name.AP4001);
 
 // Motors
m_Motor(ePump_name:=E_Pump_List.P1001);
//m_Motor(ePump_name:=E_Pump_List.P3001);
//m_Motor(ePump_name:=E_Pump_List.P3002);
//m_Motor(ePump_name:=E_Pump_List.AG3001);
//m_Motor(ePump_name:=E_Pump_List.AG3002);
m_Motor(ePump_name:=E_Pump_List.P4001);
m_Motor(ePump_name:=E_Pump_List.P4002);
m_Motor(ePump_name:=E_Pump_List.AG4001);
m_Motor(ePump_name:=E_Pump_List.AG4002);
m_Motor(ePump_name:=E_Pump_List.TB0001);

]]></ST>
    </Implementation>
    <Action Name="act_AirPressure" Id="{6278f770-60d2-4a7f-8e91-a19dc59364e8}">
      <Implementation>
        <ST><![CDATA[
 m_AirPressure(aSense_Name:=E_ASense_Name.AP1001);
 m_AirPressure(aSense_Name:=E_ASense_Name.AP2001);
 m_AirPressure(aSense_Name:=E_ASense_Name.AP3001);
 m_AirPressure(aSense_Name:=E_ASense_Name.AP4001);
 ]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_Count" Id="{e1edd437-466a-4ed5-ba90-e55dbffd3223}">
      <Implementation>
        <ST><![CDATA[	iActErrors:=0;
	iActMessages:=0;
	iActWarning:=0;
FOR i_count:=1 TO 100 BY 1 DO

	IF Buffer_Act_Message[i_count].sLevel<>'' THEN
		IF Buffer_Act_Message[i_count].sLevel='Error' THEN
			iActErrors:=iActErrors+1;
		ELSIF Buffer_Act_Message[i_count].sLevel='Warning' OR Buffer_Act_Message[i_count].sLevel='Error temp'THEN
			iActWarning:=iActWarning+1;
		ELSIF Buffer_Act_Message[i_count].sLevel='Message' THEN
			iActMessages:=iActMessages+1;		
		END_IF
	END_IF

END_FOR


]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_GeneralMessage" Id="{e1df1325-0fb2-4d0d-8512-4981f93c1935}">
      <Implementation>
        <ST><![CDATA[;
			(*-------------------->Air Pressure<--------------------*)
	bAirPressureOk:= TRUE;  //i_EP[18].x0
	IF   NOT bAirPressureOk THEN //bAirPressureSensorExist AND
		//ar_Message[1].b_Active:=TRUE;	(*	Air_Pressure_Too_Low	*)
		fbPrintErrMessageByID(sModuleDescription:='General',sActErrorID:='050x000x001');
	ELSE;
		//ar_Message[1].b_Active:=FALSE;	(*	Air_Pressure_Too_Low	*)
	END_IF








			(*-------------------->Emergency<--------------------*)
	IF bES_Bypass THEN;
		//'106x000x060',   'Warning',    'Emergency Bypass activated,	
		fbPrintErrMessageByID(sModuleDescription:='Emergency',sActErrorID:='106x000x060');
	ELSE;	
		//IF NOT bStateSafe THEN
		
		IF NOT arSafe[1].stSafetyIn.ES1_State THEN
			fbPrintErrMessageByID(sModuleDescription:='Emergency 1',sActErrorID:='106x001x001');
			stOper[E_ModeZone.eCIP].bSetPause:=TRUE;
		END_IF
		
		IF NOT arSafe[1].stSafetyIn.ES2_State THEN
			fbPrintErrMessageByID(sModuleDescription:='Emergency 2',sActErrorID:='106x002x001');
			stOper[E_ModeZone.eTank3].bSetPause:=TRUE;
			stOper[E_ModeZone.eTank4].bSetPause:=TRUE;
			stOper[E_ModeZone.eProduction_Color].bSetPause:=TRUE;
		END_IF		
		
		IF NOT arSafe[1].stSafetyIn.ES3_State THEN
			fbPrintErrMessageByID(sModuleDescription:='Emergency 3',sActErrorID:='106x003x001');
			stOper[E_ModeZone.eTank1].bSetPause:=TRUE;
			stOper[E_ModeZone.eTank2].bSetPause:=TRUE;
			stOper[E_ModeZone.eProduction_Marinade].bSetPause:=TRUE;			
		END_IF	
	
		IF NOT arSafe[1].stSafetyIn.ES4_State THEN
			fbPrintErrMessageByID(sModuleDescription:='Emergency 4',sActErrorID:='106x004x001');
			stOper[E_ModeZone.eTriBlender_Color].bSetPause:=TRUE;
			stOper[E_ModeZone.eTriBlender_Marinade].bSetPause:=TRUE;
		END_IF
		
		
		//IF NOT bES_PB[1].State THEN
		IF NOT arSafe[1].stSafetyIn.ES1_PB_State THEN
			fbPrintErrMessageByID(sModuleDescription:='Emergency 1',sActErrorID:='106x001x002');
		END_IF
		IF NOT arSafe[1].stSafetyIn.ES2_PB_State THEN
			fbPrintErrMessageByID(sModuleDescription:='Emergency 2',sActErrorID:='106x002x002');
		END_IF
		IF NOT arSafe[1].stSafetyIn.ES3_PB1_State THEN
			fbPrintErrMessageByID(sModuleDescription:='Emergency 3',sActErrorID:='106x003x002');
		END_IF
		IF NOT arSafe[1].stSafetyIn.ES3_PB2_State THEN
			fbPrintErrMessageByID(sModuleDescription:='Emergency 3',sActErrorID:='106x003x003');
		END_IF		
		IF NOT arSafe[1].stSafetyIn.ES4_PB_State THEN
			fbPrintErrMessageByID(sModuleDescription:='Emergency 4',sActErrorID:='106x004x002');
		END_IF
		
	END_IF
	
//test
		IF testMessage THEN
			fbPrintErrMessageByID(sModuleDescription:='eTank1',sActErrorID:='000x000x999');
		END_IF	
			(*-------------------->Doors Closed<--------------------*)
	(*
	IF NOT bInterlock[1] THEN;
		ar_Message[1].b_Active:=TRUE;
		fbPrintErrMessageByID(sModuleDescription:='Doors',sActErrorID:='107x000x101');
	ELSE
		IF NOT bInterlock[2] THEN;
			ar_Message[2].b_Active:=TRUE;
			fbPrintErrMessageByID(sModuleDescription:='Doors',sActErrorID:='107x000x102');
		ELSE
			IF NOT bInterlock[3] THEN;
				ar_Message[3].b_Active:=TRUE;
				fbPrintErrMessageByID(sModuleDescription:='Doors',sActErrorID:='107x000x103');
			ELSE				
				ar_Message[3].b_Active:=FALSE;
			END_IF					
			ar_Message[2].b_Active:=FALSE;
		END_IF			
		ar_Message[1].b_Active:=FALSE;
	END_IF	
	*)
	(*		
	FOR i:=4 TO 8 DO
		IF NOT bInterlock[i] THEN
			ar_Message[100+i].b_Active:=TRUE;	(*	Door_Num_1_Not_Closed	*)
			iNumber := 100+i;
			sNumber := INT_TO_STRING (iNumber);
			
		ELSE
			ar_Message[100+i].b_Active:=FALSE;
		END_IF
	END_FOR
	*)
			(*-------------------->Doors Locked<--------------------*)
			
	FOR i:=1 TO 12 DO
		iNumber2 := 120+i;
		sNumber2 := INT_TO_STRING (iNumber2);		
		CASE i OF 
			//Zone1 
			1,2,6,7:;
				IF bReq_LockZone[1] AND NOT bDoorLocked[i] THEN
					fbPrintErrMessageByID(sModuleDescription:='Doors',sActErrorID:=concat ('107x000x', sNumber2));
				END_IF	
		END_CASE
		CASE i OF 		
			//Zone2
			2,3,4:;
				IF bReq_LockZone[2] AND NOT bDoorLocked[i] THEN
					fbPrintErrMessageByID(sModuleDescription:='Doors',sActErrorID:=concat ('107x000x', sNumber2));
				END_IF	
		END_CASE
		CASE i OF 			
			//Zone3
			5,6:;
				IF bReq_LockZone[3] AND NOT bDoorLocked[i] THEN
					fbPrintErrMessageByID(sModuleDescription:='Doors',sActErrorID:=concat ('107x000x', sNumber2));
				END_IF		
		END_CASE
		CASE i OF 					
			//Zone4
			3,4,5:;
				IF bReq_LockZone[4] AND NOT bDoorLocked[i] THEN
					fbPrintErrMessageByID(sModuleDescription:='Doors',sActErrorID:=concat ('107x000x', sNumber2));
				END_IF							
			
		END_CASE

	END_FOR
	
	
			(*-------------------->Intrlock Zones<--------------------*)
	FOR i:=1 TO 4 DO
		IF bReq_LockZone[1] AND (NOT bIntZoneLocked[i]) AND (NOT bIntZoneBypass[i]) THEN
			iNumber4 := 140+i;
			sNumber4 := INT_TO_STRING (iNumber4);
			fbPrintErrMessageByID(sModuleDescription:='Inter lock Zone',sActErrorID:=concat ('108x000x', sNumber4));
		END_IF
	END_FOR


]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_Tanks_Lock" Id="{33f4d09a-f1e9-4133-b68f-7c920adc8446}">
      <Implementation>
        <ST><![CDATA[

IF NOT gIO.arSafe[1].stSafetyIn.TankLocked_CIP_T91 THEN
	fbPrintErrMessageByID(sModuleDescription:='Tank Interlock',sActErrorID:='101x002xT91');
END_IF
IF NOT gIO.arSafe[1].stSafetyIn.TankLocked_CIP_T92 THEN
	fbPrintErrMessageByID(sModuleDescription:='Tank Interlock',sActErrorID:='101x002xT92');
END_IF
IF NOT gIO.arSafe[1].stSafetyIn.TankLocked_CIP_T93 THEN
	fbPrintErrMessageByID(sModuleDescription:='Tank Interlock',sActErrorID:='101x002xT93');
END_IF
IF NOT gIO.arSafe[1].stSafetyIn.TankLocked_CIP_T94 THEN
	fbPrintErrMessageByID(sModuleDescription:='Tank Interlock',sActErrorID:='101x002xT94');
END_IF

IF NOT gIO.arSafe[1].stSafetyIn.TankLocked_Marinade_T1 THEN
	//fbPrintErrMessageByID(sModuleDescription:='Tank Interlock',sActErrorID:='101x002xT01');
END_IF
IF NOT gIO.arSafe[1].stSafetyIn.TankLocked_Marinade_T2 THEN
	//fbPrintErrMessageByID(sModuleDescription:='Tank Interlock',sActErrorID:='101x002xT02');
END_IF

IF NOT gIO.arSafe[1].stSafetyIn.TankLocked_Color_T3 THEN
	fbPrintErrMessageByID(sModuleDescription:='Tank Interlock',sActErrorID:='101x002xT03');
END_IF
IF NOT gIO.arSafe[1].stSafetyIn.TankLocked_Color_T4 THEN
	fbPrintErrMessageByID(sModuleDescription:='Tank Interlock',sActErrorID:='101x002xT04');
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_AirPressure" Id="{0d4a249b-5a9a-4e82-96f9-5b2109911d5f}">
      <Declaration><![CDATA[METHOD m_AirPressure : BOOL
VAR_INPUT
	aSense_Name: E_ASense_Name;
END_VAR

VAR
	k: STRING(1);
	temp_string: STRING(3);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF TRUE
//AND __ISVALIDREF(fbAnalogSensor[aSense_Name]) 
THEN;
	
	temp_string:=TO_STRING(aSense_Name);
	k:=MID(temp_string, 3, 3);
	
	IF fbAnalogSensor[aSense_Name].bLL_Warning THEN;
		fbPrintErrMessageByID(sModuleDescription:='Air Pressure',sActErrorID:=concat ('101x003x01', k));
	END_IF
	
	IF fbAnalogSensor[aSense_Name].bHH_Warning THEN;
		fbPrintErrMessageByID(sModuleDescription:='Air Pressure',sActErrorID:=concat ('101x003x02', k));
	END_IF
	
	IF fbAnalogSensor[aSense_Name].bLL_Alarm THEN;
		fbPrintErrMessageByID(sModuleDescription:='Air Pressure',sActErrorID:=concat ('101x003x11', k));
	END_IF
	
	IF fbAnalogSensor[aSense_Name].bHH_Alarm THEN;
		fbPrintErrMessageByID(sModuleDescription:='Air Pressure',sActErrorID:=concat ('101x003x12', k));
	END_IF
	
	
ELSE;
	RETURN;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Motor" Id="{ac9b50dd-4470-451b-b667-000b344bf669}">
      <Declaration><![CDATA[METHOD m_Motor : BOOL
VAR_INPUT
	ePump_name: E_Pump_List;
END_VAR

VAR
	temp_string: STRING(6);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[temp_string:=TO_STRING(ePump_name);

IF g_Pump.fbPump[ePump_name].m_Error()<>'' THEN;
	fbPrintErrMessageByID(sModuleDescription:='Motor', sActErrorID:=g_Pump.fbPump[ePump_name].m_Error());
END_IF]]></ST>
      </Implementation>
    </Method>
