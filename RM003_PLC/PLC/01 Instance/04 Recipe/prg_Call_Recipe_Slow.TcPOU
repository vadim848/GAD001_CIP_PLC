<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="prg_Call_Recipe_Slow" Id="{e80a20ed-0f91-4c74-97d3-601d773194b4}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM prg_Call_Recipe_Slow
VAR
	i							: INT;
	bFirstScan					: BOOL:= TRUE;
	ton_RecipeReady				: TON;
	
	
	eRecipeName: E_Recipe_Name;

	r_trigAxisPoints_Loaded: R_TRIG;
	ton_WriteLoaded_Points: TON;
	r_trigRecipe3_loaded: R_TRIG;

	bAllRecipesLoaded: BOOL;
	iRecipeSwitchFrameVar: INT;
	bLoadDefForAll: BOOL;
	
	tPath: STRING(80);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[act_Set_StoragePath_For_All();
//act_LoadDeafult();

ton_RecipeReady(PT:=T#1S, IN:=GVL_Recipe.stRecipe[1].bInit AND bFirstScan);
IF ton_RecipeReady.Q THEN;
	bFirstScan:=FALSE;
	bLoadDefForAll:=TRUE;
END_IF




(********************  Other Instances Recipes******************************) // 
FOR eRecipeName:=1 TO E_Recipe_Name.R_Piston_Settings DO	
	fbRecipe[eRecipeName](pstRecipe:=ADR(GVL_Recipe.stRecipe[eRecipeName]), 
			bMemoRecipeUpdated:=, 
			sRecipeDef:=TO_STRING(eRecipeName),
			bLoadDefault:=ar_RecipesLoadDefault[eRecipeName],
			bHMI_FrameActive:=iRecipeSwitchFrameVar=eRecipeName-1,//changed
			sRecipesStoragePath:=ar_RecipesStoragePath[eRecipeName]);
END_FOR
(*			
IF (*fbRecipe_1.bMemoRecipeUpdated AND*) 
fbRecipe_2.bMemoRecipeUpdated 
AND fbRecipe_3.bMemoRecipeUpdated 
AND fbRecipe_4.bMemoRecipeUpdated 
AND fbRecipe_5.bMemoRecipeUpdated 
THEN;
	bAllRecipesLoaded:=TRUE;
ELSE;
	bAllRecipesLoaded:=FALSE;
END_IF
*)
]]></ST>
    </Implementation>
