    <Action Name="act_Set_StoragePath_For_All" Id="{ab44a9a9-b46c-4897-9f85-ed22925f62ec}">
      <Implementation>
        <ST><![CDATA[FOR eRecipeName:=1 TO E_Recipe_Name.R_Piston_Settings DO;
	GVL_Recipe.ar_RecipesStoragePath_Folder[eRecipeName]:=TO_STRING(eRecipeName);
	tPath:='';
	tPath:=CONCAT(tPath,GVL_Recipe.ar_RecipesStoragePath_Root[GVL_Recipe.eRecipeRootFolder]);
	tPath:=CONCAT(tPath,'\');
	tPath:=CONCAT(tPath,TO_STRING(eRecipeName));
	tPath:=CONCAT(tPath,'\');
	GVL_Recipe.ar_RecipesStoragePath[eRecipeName]:=tPath;
(*
	GVL_Recipe.ar_RecipesStoragePath[eRecipeName]:=
			CONCAT(	GVL_Recipe.ar_RecipesStoragePath_Root[GVL_Recipe.eRecipeRootFolder],'\'); 
	GVL_Recipe.ar_RecipesStoragePath[eRecipeName]:=		
			CONCAT(	GVL_Recipe.ar_RecipesStoragePath[eRecipeName],TO_STRING(eRecipeName));
	GVL_Recipe.ar_RecipesStoragePath[eRecipeName]:=		
			CONCAT(	GVL_Recipe.ar_RecipesStoragePath[eRecipeName],'1');				
	GVL_Recipe.ar_RecipesStoragePath[eRecipeName]:=		
			CONCAT(	GVL_Recipe.ar_RecipesStoragePath[eRecipeName],'\');		
*)	
END_FOR]]></ST>
      </Implementation>
    </Action>
