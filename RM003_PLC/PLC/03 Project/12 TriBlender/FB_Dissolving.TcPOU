<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Dissolving" Id="{61fb2bea-f425-42ba-8eea-35efb6847cdf}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK PUBLIC FB_Dissolving EXTENDS FB_SFC_Cycle IMPLEMENTS ITF_FB_SFC_Cycle
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	step: INT;
	i: INT;
END_VAR

VAR_IN_OUT
	fb_TriBlender			: FB_Pump;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[m_Set_SFCFlags_Reference();
act_Oper();]]></ST>
    </Implementation>
    <Action Name="_aChek_if_Done_active" Id="{28a6cd2f-fcb4-4026-979e-d8afebb2d7fb}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF g_HMI_Panel.stPLC_To_VisuPLC.iActual_Component >= 10 THEN;
	bStepDone:=TRUE;
END_IF]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aComponent_Blending_active" Id="{49c635d9-8cb2-43c9-af22-31b599cbdffb}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF Component_Blending.t > g_HMI_Panel.stPLC_To_VisuPLC.arr_Component[g_HMI_Panel.stPLC_To_VisuPLC.iActual_Component].tBlendingDuration THEN;
	bStepDone:=TRUE;
	g_HMI_Panel.stPLC_To_VisuPLC.bBlending_Active:=FALSE;
END_IF

fb_TriBlender.m_Run(RPM:=g_HMI_Panel.stPLC_To_VisuPLC.arr_Component[g_HMI_Panel.stPLC_To_VisuPLC.iActual_Component].rFlowRate_Blending);]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aComponent_Blending_entry" Id="{4c0e6d76-310b-4245-93e0-c7c557bef00e}">
      <Implementation>
        <ST><![CDATA[g_HMI_Panel.stPLC_To_VisuPLC.bDissolving_Active:=FALSE;
g_HMI_Panel.stPLC_To_VisuPLC.bBlending_Active:=TRUE;
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aDissolving_Done_entry" Id="{fb0791ee-288b-493f-9dec-4045da4634b4}">
      <Implementation>
        <ST><![CDATA[bDisolvingProcess_Done:=TRUE;]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aInit_Dissolve_exit" Id="{d2eef2f7-7f78-404f-8147-d7c62309e56f}">
      <Implementation>
        <ST><![CDATA[step:=0;
g_HMI_Panel.stPLC_To_VisuPLC.iActual_Component:=0;
g_HMI_Panel.stPLC_To_VisuPLC.bDissolving_Active:=FALSE;
g_HMI_Panel.stPLC_To_VisuPLC.bBlending_Active:=FALSE;
bRun:=FALSE;]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aReady_exit" Id="{9fefdedd-c232-4791-9377-8e14ef06db2d}">
      <Implementation>
        <ST><![CDATA[g_HMI_Panel.stPLC_To_VisuPLC.iActual_Component:=1;
g_HMI_Panel.stPLC_To_VisuPLC.bDissolving_Active:=FALSE;]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aSet_Next_Component_active" Id="{bdf66cc9-1360-4ca9-a4b1-8e42f5ad1b30}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF g_HMI_Panel.stVisuPLC_To_PLC.bActualComponentDisolving_Done THEN;
	bStepDone:=TRUE;
END_IF

IF g_HMI_Panel.stVisuPLC_To_PLC.bPauseTriBlender THEN;
	fb_TriBlender.m_Stop();
ELSE;
	fb_TriBlender.m_Run(RPM:=g_HMI_Panel.stVisuPLC_To_PLC.RPM_setPoint);
END_IF
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aSet_Next_Component_entry" Id="{0b708c24-9fee-4a9b-ba4f-f7202d8afeaa}">
      <Implementation>
        <ST><![CDATA[g_HMI_Panel.stPLC_To_VisuPLC.bDissolving_Active:=FALSE;
g_HMI_Panel.stPLC_To_VisuPLC.bBlending_Active:=FALSE;
g_HMI_Panel.stPLC_To_VisuPLC.iActual_Component:=g_HMI_Panel.stPLC_To_VisuPLC.iActual_Component+1;

FOR i:=g_HMI_Panel.stPLC_To_VisuPLC.iActual_Component TO 10 DO
	IF g_HMI_Panel.stPLC_To_VisuPLC.arr_Component[i].rWeight>0 THEN;
		g_HMI_Panel.stPLC_To_VisuPLC.iActual_Component:=i;
		g_HMI_Panel.stPLC_To_VisuPLC.bDissolving_Active:=TRUE;
		EXIT;
	END_IF
END_FOR]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
