<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="prg_PLCs_communication" Id="{c8c750e4-a3d0-48e9-b735-13193bff0498}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM prg_PLCs_communication
VAR
	fbAdsRead: ADSREAD;
	fbAdsWrite: ADSWRITE;

	ton_Update: TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[ton_Update(PT:=T#50MS, IN:=NOT ton_Update.Q);

IF ton_Update.Q THEN;
END_IF	

fbAdsRead(
	NETID:= , 
	PORT:= 852, 
	IDXGRP:= 16#4020,// 
	IDXOFFS:= 1000,// 
	LEN:= SIZEOF(g_HMI_Panel.stVisuPLC_To_PLC), 
	DESTADDR:= ADR(g_HMI_Panel.stVisuPLC_To_PLC), 
	READ:= ton_Update.Q, 
	TMOUT:= , 
	BUSY=> , 
	ERR=> , 
	ERRID=> );
	
fbAdsWrite(
	NETID:= , 
	PORT:= 852, 
	IDXGRP:= 16#4020,// 
	IDXOFFS:= 2000, //
	LEN:= SIZEOF(g_HMI_Panel.stPLC_To_VisuPLC), 
	SRCADDR:= ADR(g_HMI_Panel.stPLC_To_VisuPLC), 
	WRITE:= ton_Update.Q, 
	TMOUT:= , 
	BUSY=> , 
	ERR=> , 
	ERRID=> );
	
g_HMI_Panel.stPLC_To_VisuPLC.lifeBit:=NOT g_HMI_Panel.stVisuPLC_To_PLC.lifeBit;
]]></ST>
    </Implementation>
