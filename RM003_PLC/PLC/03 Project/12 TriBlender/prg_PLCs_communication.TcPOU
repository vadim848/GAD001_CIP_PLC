<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="prg_PLCs_communication" Id="{c8c750e4-a3d0-48e9-b735-13193bff0498}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM prg_PLCs_communication
VAR
	fbAdsRead: ADSREAD;
	fbAdsWrite: ADSWRITE;

	ton_Update: TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[ton_Update(PT:=T#50MS, IN:=NOT ton_Update.Q);

IF ton_Update.Q THEN;
END_IF	

fbAdsRead(
	NETID:= , 
	PORT:= 852, 
	IDXGRP:= 16#4020,// 
	IDXOFFS:= 1000,// 
	LEN:= SIZEOF(g_HMI_Panel.stVisuPLC_To_PLC), 
	DESTADDR:= ADR(g_HMI_Panel.stVisuPLC_To_PLC), 
	READ:= ton_Update.Q, 
	TMOUT:= , 
	BUSY=> , 
	ERR=> , 
	ERRID=> );
	
fbAdsWrite(
	NETID:= , 
	PORT:= 852, 
	IDXGRP:= 16#4020,// 
	IDXOFFS:= 2000, //
	LEN:= SIZEOF(g_HMI_Panel.stPLC_To_VisuPLC), 
	SRCADDR:= ADR(g_HMI_Panel.stPLC_To_VisuPLC), 
	WRITE:= ton_Update.Q, 
	TMOUT:= , 
	BUSY=> , 
	ERR=> , 
	ERRID=> );
	
g_HMI_Panel.stPLC_To_VisuPLC.lifeBit:=NOT g_HMI_Panel.stVisuPLC_To_PLC.lifeBit;

act_Send_To_HMI();
act_Get_From_HMI();
]]></ST>
    </Implementation>
    <Action Name="act_Get_From_HMI" Id="{13ec3ba9-f79a-4578-87d2-a6e89aa0102e}">
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_Send_To_HMI" Id="{e096d119-530b-4159-ac12-f66d71740ae1}">
      <Implementation>
        <ST><![CDATA[

CASE eTriBlenderUsage OF
	E_TriBlenderUsage.eMarinada_T1:;
		(*g_HMI_Panel.q_stPLC_To_VisuPLC.Description:=fbTank1.stProdParam.stRecipe.Description;
		g_HMI_Panel.q_stPLC_To_VisuPLC.prodType:=fbTank1.stProdParam.stRecipe.prodType;
		g_HMI_Panel.q_stPLC_To_VisuPLC.arr_Component:=fbTank1.stProdParam.stRecipe.arr_Component;
		g_HMI_Panel.q_stPLC_To_VisuPLC.:=fbTank1.stProdParam.stRecipe.Description;*)
		m_GetProductionInfo(fbProductionTank:=fbTank1);		
	E_TriBlenderUsage.eMarinada_T2:;
		m_GetProductionInfo(fbProductionTank:=fbTank2);
	E_TriBlenderUsage.eColor_T3:;
		m_GetProductionInfo(fbProductionTank:=fbTank3);
	E_TriBlenderUsage.eColor_T4:;
		m_GetProductionInfo(fbProductionTank:=fbTank4);
		
ELSE;
	
	m_CleanProductionInfo();
END_CASE

g_HMI_Panel.stPLC_To_VisuPLC.RPM_FeedBack:=g_Pump.fbPump[E_Pump_List.TB0001].nRPM;
g_HMI_Panel.stPLC_To_VisuPLC.Flow_FeedBack:=g_AnalogSensor.stAnalogSensor[E_ASense_Name.FT9012].Value;
]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_CleanProductionInfo" Id="{0d301ac4-158d-40ed-9874-25c8549a2e45}">
      <Declaration><![CDATA[METHOD m_CleanProductionInfo : BOOL
VAR
	stRecipe_Clean: ST_Prod_Recipe;	
	i: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
g_HMI_Panel.stPLC_To_VisuPLC.Description:='Not Loaded';
//g_HMI_Panel.stPLC_To_VisuPLC.prodType:=E_Prod_Type.Marinade;
FOR i:=1 TO 10 DO
	stRecipe_Clean.arr_Component[i].sDescription:='-*-*-';
END_FOR
g_HMI_Panel.stPLC_To_VisuPLC.arr_Component:=stRecipe_Clean.arr_Component;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_GetProductionInfo" Id="{17a1c15b-386c-4d7d-93da-5898c98b49c8}">
      <Declaration><![CDATA[METHOD m_GetProductionInfo : BOOL
VAR_INPUT
	fbProductionTank: FB_ProductionTank;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[g_HMI_Panel.q_stPLC_To_VisuPLC.Description:=fbProductionTank.stProdParam.stRecipe.Description;
g_HMI_Panel.q_stPLC_To_VisuPLC.prodType:=fbProductionTank.stProdParam.stRecipe.prodType;
g_HMI_Panel.q_stPLC_To_VisuPLC.arr_Component:=fbProductionTank.stProdParam.stRecipe.arr_Component;
		
g_HMI_Panel.stPLC_To_VisuPLC.Description:=fbProductionTank.stProdParam.stRecipe.Description;
g_HMI_Panel.stPLC_To_VisuPLC.prodType:=fbProductionTank.stProdParam.stRecipe.prodType;
g_HMI_Panel.stPLC_To_VisuPLC.arr_Component:=fbProductionTank.stProdParam.stRecipe.arr_Component;		]]></ST>
      </Implementation>
    </Method>
