<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_TriBlender_Select" Id="{9eeca8ec-03ab-4735-83e4-c97ea5515e09}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TriBlender_Select EXTENDS FB_SFC_Cycle IMPLEMENTS ITF_FB_SFC_Cycle
VAR_INPUT
	valInSelect		: E_Pis_Name;
	valInMarinade	: E_Pis_Name;
	valInColor		: E_Pis_Name;
	valOutSelect	: E_Pis_Name;	
	valOutMarinade	: E_Pis_Name;
	valOutColor		: E_Pis_Name;
	
END_VAR
VAR_OUTPUT
END_VAR
VAR
	//refElement		: REFERENCE TO FB_Element;
	//refState_Long		: REFERENCE TO E_Element_State_Long;
	eReq				: E_TriBlenderSelect;
	eProcess			: E_TriBlenderSelect;
	eStatus				: E_TriBlenderSelect;
	
	fbPis				: FB_Piston;
	stPis_InSelect		: REFERENCE TO ST_Piston;
	stPis_InMarinade	: REFERENCE TO ST_Piston;
	stPis_InColor		: REFERENCE TO ST_Piston;
	stPis_OutSelect		: REFERENCE TO ST_Piston;
	stPis_OutMarinade	: REFERENCE TO ST_Piston;
	stPis_OutColor		: REFERENCE TO ST_Piston;

	tonDrainTime: TON;
	rt_Req_Reset: R_TRIG;
	//bRun: BOOL;
	//bDone: BOOL;
	SFCReset: BOOL;
	//bStepDone: BOOL;
END_VAR
VAR_IN_OUT


END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[act_GetReference();

act_Oper();
IF NOT Init.x THEN;
	act_Status();
END_IF

tonDrainTime(PT:=T#1M, IN:=eStatus=E_TriBlenderSelect.eDrain);
IF tonDrainTime.Q 
AND eReq=E_TriBlenderSelect.eNone
AND eProcess=E_TriBlenderSelect.eNone
THEN;
	eReq:=E_TriBlenderSelect.eMarinade;
END_IF

m_Request_Reset(memo:=rt_Req_Reset);//
]]></ST>
    </Implementation>
    <Folder Name="Manage" Id="{e20a7cbd-7252-4410-8f32-fdf6c8d5cc66}" />
    <Action Name="_aColor_active" Id="{0e00c0e9-109c-44f6-b8b4-7e71627c84d3}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF TRUE 
AND eStatus=E_TriBlenderSelect.eColor
THEN;
	bStepDone:=TRUE;
END_IF

]]></ST>
      </Implementation>
