    <Action Name="_aReady_active" Id="{e9c65ea6-1cf6-4665-b228-f295655c142c}">
      <Implementation>
        <ST><![CDATA[
eStatus:=E_TriBlenderSelect.eNone;
CASE eReq OF
	E_TriBlenderSelect.eColor:;
			IF TRUE THEN;
				eProcess:=E_TriBlenderSelect.eColor;
			END_IF	
			
	E_TriBlenderSelect.eDrain:;
			IF TRUE THEN;
				eProcess:=E_TriBlenderSelect.eDrain;
			END_IF
			
	E_TriBlenderSelect.eMarinade:;
			IF TRUE THEN;
				eProcess:=E_TriBlenderSelect.eMarinade;
			END_IF

END_CASE
		
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
