            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="act_GetReference" Id="{1f7e6d9f-c733-467c-bd8d-99c3278d05fb}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[m_Set_SFCFlags_Reference();
//refElement REF= fbElement[eElementID];

stPis_InSelect	 REF= g_Piston.stPis[valInSelect];
stPis_InMarinade REF= g_Piston.stPis[valInMarinade];
stPis_InColor	 REF= g_Piston.stPis[valInColor];

stPis_OutSelect	  REF= g_Piston.stPis[valOutSelect];
stPis_OutMarinade REF= g_Piston.stPis[valOutMarinade];
stPis_OutColor	  REF= g_Piston.stPis[valOutColor];]]></ST>
      </Implementation>
    </Action>
