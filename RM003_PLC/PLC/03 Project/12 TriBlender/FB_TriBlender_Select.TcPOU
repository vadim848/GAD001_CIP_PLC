    <Action Name="_aColor_entry" Id="{b8924bfb-9851-4d09-8b08-65fd1d78ee0f}">
      <Implementation>
        <ST><![CDATA[fbPis.m_SetByRecipe(stPis:=stPis_InSelect, 			req:=E_Piston_Recipe_State.Act);
fbPis.m_SetByRecipe(stPis:=stPis_InMarinade, 		req:=E_Piston_Recipe_State.Release);
fbPis.m_SetByRecipe(stPis:=stPis_InColor, 			req:=E_Piston_Recipe_State.Release);
fbPis.m_SetByRecipe(stPis:=stPis_OutSelect, 		req:=E_Piston_Recipe_State.Act);
fbPis.m_SetByRecipe(stPis:=stPis_OutMarinade, 		req:=E_Piston_Recipe_State.Release);
fbPis.m_SetByRecipe(stPis:=stPis_OutColor, 			req:=E_Piston_Recipe_State.Release);]]></ST>
      </Implementation>
