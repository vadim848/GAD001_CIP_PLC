    <Action Name="act_Status" Id="{09075606-aba2-4421-aadf-8a8f6410b267}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[IF TRUE 
AND fbPis.m_CheckByRecipe(stPis:=stPis_InSelect, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_InMarinade, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_InColor, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_OutSelect, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_OutMarinade, 	req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_OutColor, 		req:=E_Piston_Recipe_State.Release)
THEN;
	eStatus:=E_TriBlenderSelect.eMarinade;
	
ELSIF TRUE 
AND fbPis.m_CheckByRecipe(stPis:=stPis_InSelect, 		req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_InMarinade, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_InColor, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_OutSelect, 		req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_OutMarinade, 	req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_OutColor, 		req:=E_Piston_Recipe_State.Release)
THEN;
	eStatus:=E_TriBlenderSelect.eColor;
	
ELSIF TRUE 
AND fbPis.m_CheckByRecipe(stPis:=stPis_InSelect, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_InMarinade, 		req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_InColor, 		req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_OutSelect, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_OutMarinade, 	req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_OutColor, 		req:=E_Piston_Recipe_State.Act)
THEN;
	eStatus:=E_TriBlenderSelect.eDrain;
	
ELSE
	eStatus:=E_TriBlenderSelect.eNone;
	
END_IF;]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_CheckStatus" Id="{3903e6c5-5909-4217-872b-04f94cc50c95}" FolderPath="Manage\">
      <Declaration><![CDATA[METHOD m_CheckStatus : BOOL
VAR_INPUT
	eReqStatus		: E_CIP_Return;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eStatus=eReqStatus 
AND eProcess=E_CIP_Return.eNone
AND eReq=E_CIP_Return.eNone
AND bReady
AND bDone
AND NOT bRun
THEN;
	m_CheckStatus:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Request_Reset" Id="{6dfb826e-0c5a-4b01-8291-56a11557903f}" FolderPath="Manage\">
      <Declaration><![CDATA[METHOD m_Request_Reset : BOOL
VAR_IN_OUT
	memo: R_TRIG;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[memo(CLK:=eReq=0);
IF TRUE 
AND memo.Q
THEN;
	SFCReset:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Run" Id="{a8b44bf2-fd16-4b21-9c83-6e8184bbb941}" FolderPath="Manage\">
      <Declaration><![CDATA[METHOD m_Run : BOOL
VAR_INPUT
	eReqProc			: E_TriBlenderSelect;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eProcess=E_TriBlenderSelect.eNone THEN;
	eProcess:=eReq:=eReqProc;
	bDone:=FALSE;
	m_Run:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Set_SFCFlags_Reference" Id="{40d7e9fd-d4fa-45bd-88e4-d85c0e80f0bc}" FolderPath="Manage\">
      <Declaration><![CDATA[{warning 'add method implementation '}
METHOD m_Set_SFCFlags_Reference : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Set reference to SFC flags

refSFC.SFCInit REF= SFCInit;
refSFC.SFCReset REF= SFCReset;
refSFC.SFCError REF= SFCError;
refSFC.SFCEnableLimit REF= SFCEnableLimit;
refSFC.SFCErrorStep REF= SFCErrorStep;
refSFC.SFCErrorPOU REF= SFCErrorPOU;
refSFC.SFCQuitError REF= SFCQuitError;
refSFC.SFCPause REF= SFCPause;
refSFC.SFCTrans REF= SFCTrans;
refSFC.SFCCurrentStep REF= SFCCurrentStep;
refSFC.SFCTip REF= SFCTip;
refSFC.SFCTipMode REF= SFCTipMode;

// Cycle handle for SFC
m_SFC_Handle();]]></ST>
      </Implementation>
    </Method>
