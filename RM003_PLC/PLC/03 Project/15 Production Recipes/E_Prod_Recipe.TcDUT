<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.14">
  <DUT Name="E_Prod_Recipe" Id="{30f796b6-4ad6-4488-9821-178c2ff4e475}">
    <Declaration><![CDATA[TYPE E_Prod_Recipe :
STRUCT
	
// General
	prodType				: E_Prod_Type;
	Temperature				: REAL;
	
	StirrerDissolving		: ST_Prod_Param_Stirer;
	StirrerProduction		: ST_Prod_Param_Stirer;
	StirrerStarage			: ST_Prod_Param_Stirer;

	ExperationTime			: TIME;
	Conductivity			: REAL;		// mSimons

	
// Water
	WaterPercentage			: REAL;
	WaterExperationTime		: TIME;
	
// Component
	arr_Component			: ARRAY [1..g_Data.MaxCompInProduct] OF ST_Prod_Ingredient;
	
// Water push to triblender color(Blood)
	rWeght_to_Collect		: REAL; // Kg
	rWeght_to_Drain			: REAL; // Kg
	rConductivity_limit		: REAL; //mSimons
	
	
	rFlowRate_Production	: REAL; //RPM
	rFlowRate_WaterPushing	: REAL; //RPM
	rFlowRate_Storage		: REAL; //RPM



END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>