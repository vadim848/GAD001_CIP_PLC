    </Action>
    <Action Name="Init_Init_act_MixingStates_active" Id="{5b96ca2f-dac9-4416-a4c9-760e9f673ad5}">
      <Implementation>
        <ST><![CDATA[sStateDescription	:='Triblender valve closed';
sStateInstructions	:= 'Close triblender valve';

bDisableAmount:=TRUE;
bDisableName:=TRUE;
bDisableTime:=TRUE;

wButtonColor:=16#FFC0C0C0;
stTriblender.bError:=FALSE;
stTriblender.bDisolvingDone:=FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="LastComp_active" Id="{2582a41b-802e-45c9-b5d0-7d9f66243cf9}">
      <Implementation>
        <ST><![CDATA[wButtonColor:=16#FF00FFFF;

sStateDescription	:=	'Finish';
sStateInstructions	:= 	'LastComponentMixed';

bDisableAmount	:=FALSE;
bDisableName	:=FALSE;
bDisableTime	:=FALSE;

]]></ST>
      </Implementation>
    </Action>
    <Action Name="LastComp_exit" Id="{adb66592-836d-46a4-a518-d754da30efe6}">
      <Implementation>
        <ST><![CDATA[VisuElems.CurrentVisu:= 'StartVisu';
stTriblender.bDisolvingDone:=TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="MixComponent_active" Id="{1cf67d45-d09f-49f5-ad87-5f9ec42fdf26}">
      <Implementation>
        <ST><![CDATA[sStateDescription	:=	'Component Inside';
sStateInstructions	:= 	'Insert component in
 the specified amount';]]></ST>
      </Implementation>
    </Action>
    <Action Name="MixComponent_entry" Id="{741dfb45-7e63-4493-9a19-e4aebedfdc46}">
      <Implementation>
        <ST><![CDATA[
bContinue:=FALSE;

bDisableAmount	:=FALSE;
bDisableName	:=FALSE;
bDisableTime	:=FALSE;

wButtonColor:=16#FFFF0000;
IF iCurrentMixingComponent<g_Data.MaxCompInTank-1 THEN
	stTriblender.bLastComponent:=NOT arrComponents[iCurrentMixingComponent+1].bComponentEnable;
END_IF
stTriblender.sComponenetAmount:=TO_STRING(arrComponents[iCurrentMixingComponent].rCompActWeight);
stTriblender.sComponenetName:=arrComponents[iCurrentMixingComponent].sDescription;
stTriblender.tComponenetMixingTime:=TO_TIME(arrComponents[iCurrentMixingComponent].iMixingTime*1000);
fb_TriBlenderPump.m_Run(RPM:=arrComponents[iCurrentMixingComponent].rRpmTarget);]]></ST>
      </Implementation>
    </Action>
    <Action Name="MixDoneWaitAnother_active" Id="{7d82f5bc-b6bc-4046-b841-839403eb7c9b}">
      <Implementation>
        <ST><![CDATA[sStateDescription	:='Triblender valve Opened';
sStateInstructions	:= 'Mix Component done,
 open triblender valve';]]></ST>
      </Implementation>
    </Action>
    <Action Name="MixDoneWaitAnother_entry" Id="{ef359ffe-0713-42c1-bf19-c582d7c20eb8}">
      <Implementation>
        <ST><![CDATA[bContinue:=FALSE;

bDisableAmount:=TRUE;
bDisableName:=TRUE;
bDisableTime:=TRUE;
bDisableButton:=FALSE;
VisuElems.CurrentVisu:= 'StartVisu';



wButtonColor:=16#FF00FF00;]]></ST>
      </Implementation>
    </Action>
    <Action Name="OpenValve_entry" Id="{0d91f935-6559-426a-8a27-b3291b9477d1}">
      <Implementation>
        <ST><![CDATA[bContinue:=FALSE;

bDisableAmount:=TRUE;
bDisableName:=TRUE;
bDisableTime:=TRUE;
bDisableButton:=FALSE;

tonStageCirculation(IN:=FALSE);


sStateDescription	:='Triblender valve Opened';
sStateInstructions	:= 'Open triblender valve';

wButtonColor:=16#FF00FF00;]]></ST>
      </Implementation>
    </Action>
    <Transition Name="trans_RpmInTarget" Id="{9c69763e-6f57-4306-994c-85c1a23b4746}">
      <Implementation>
        <ST><![CDATA[fb_TriBlenderPump.nRPM< arrComponents[i].rRpmTarget+10 and fb_TriBlenderPump.nRPM> arrComponents[i].rRpmTarget-10]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="transCircDone" Id="{c004dd09-02f8-4be2-a090-e7d683131b10}">
      <Implementation>
        <ST><![CDATA[tonStageCirculation.Q and stTriblender.rMaxAllowedPressure> stTriblender.rPressure and stTriblender.rMinAllowedFlow< stTriblender.rFlow]]></ST>
      </Implementation>
    </Transition>
    <Action Name="WaitForDone_active" Id="{b01908cf-9a52-4e61-956b-d173f0b8e957}">
      <Implementation>
        <ST><![CDATA[tonStageCirculation(IN:= TRUE,PT:=stTriblender.tComponenetMixingTime);
iCirculationTimeLeft:= TO_UINT(tonStageCirculation.PT - tonStageCirculation.ET)/1000;
bDisableButton:=TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="WaitForDone_entry" Id="{a6f41bb9-a823-4292-995c-7ece526c63aa}">
      <Implementation>
        <ST><![CDATA[wButtonColor:=16#FF0000FF;

sStateDescription	:=	'Waiting';
sStateInstructions	:= 	'Wait for mixing done';
bContinue:=FALSE;

bDisableAmount	:=FALSE;
bDisableName	:=FALSE;
bDisableTime	:=FALSE;


tonStageCirculation(IN:= FALSE);]]></ST>
      </Implementation>
    </Action>
    <Action Name="WaitForDone_exit" Id="{987162f7-5bc5-4025-8270-3ef2e2dd7475}">
      <Implementation>
        <ST><![CDATA[stTriblender.bComponenetMixDone:=TRUE;
wButtonColor:=16#FF00FF00;

bDisableAmount	:=TRUE;
bDisableName	:=TRUE;
bDisableTime	:=TRUE;


tonStageCirculation(IN:= FALSE);]]></ST>
      </Implementation>
    </Action>
    <Action Name="WaitForStartPump_active" Id="{ede2e026-6ebe-4290-b268-7d5f0ce1e1d3}">
      <Implementation>
        <ST><![CDATA[sStateDescription	:='Start Water Circulation';
sStateInstructions	:= 'Start water circulation, check for leaks';
iCurrentMixingComponent:=0;
bContinue:=FALSE;
FOR i:= 0 TO g_Data.MaxCompInTank-1 DO
	IF arrComponents[i].bIsWater THEN
		fb_TriBlenderPump.m_Run(RPM:=arrComponents[i].rRpmTarget);
	END_IF
END_FOR

wButtonColor:=16#FFFF0000;]]></ST>
      </Implementation>
    </Action>
    <Action Name="WaitForStartPump_entry" Id="{59115d06-ebf0-45e1-9214-3f31cd33f08b}">
      <Implementation>
        <ST><![CDATA[
stTriblender.bStartDisolving:=FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="WaterCirculation_active" Id="{4f4fcdfa-6e26-4f6f-8974-552317f91ea0}">
      <Implementation>
        <ST><![CDATA[tonStageCirculation(IN:= stTriblender.bPumpOnFdbk,PT:=stTriblender.tWaterCirculationTimeout);
iCirculationTimeLeft:= TO_UINT(tonStageCirculation.PT - tonStageCirculation.ET)/1000;

bDisableButton:=TRUE;

sStateDescription	:='Wait for pressure and flow';
sStateInstructions	:= 'Water circulation in progress,
 check for leaks';]]></ST>
      </Implementation>
    </Action>
    <Action Name="WaterCirculation_entry" Id="{a6b6879f-7055-4ce7-8b92-baa3c44e6dec}">
      <Implementation>
        <ST><![CDATA[bContinue:=FALSE;


bDisableAmount:=TRUE;
bDisableName:=TRUE;
bDisableTime:=FALSE;

tonStageCirculation(IN:=FALSE);


]]></ST>
      </Implementation>
    </Action>
    <Action Name="WaterCirculation_exit" Id="{a38de536-3fb4-4fcb-9003-5477db64c93a}">
      <Implementation>
        <ST><![CDATA[tonStageCirculation(IN:=FALSE);]]></ST>
      </Implementation>
    </Action>
