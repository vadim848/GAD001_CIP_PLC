<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="prg_TriBlender" Id="{9a86bf9e-8eae-4b5d-8890-d8083718f93d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM prg_TriBlender
VAR
	enumCurrentState	: ENUM_CurrentState;
	FB_SetProductionParams:FB_SetProductionParams;
//stTriBlender		: ST_TriBlender;
	
	sStateDescription		: STRING;
	sStateInstructions		: STRING;
	iCirculationTimeLeft	: UINT;
	bContinue				: BOOL;
	iCurrentMixingComponent	: INT;
	
	tonStageCirculation		: TON;
	
	///For Visu
	bDisableTime			: BOOL;
	bDisableAmount			: BOOL;
	bDisableName			: BOOL;
	bDisableButton			: BOOL;
	wButtonColor			: DWORD;
	
	trig_JumpToCirScreen	: R_TRIG;

	i						: INT;
END_VAR
VAR_IN_OUT
	stTriblender			: ST_TriBlender;
	fb_TriBlenderPump		: FB_Pump;
END_VAR
VAR_INPUT
	arrComponents	: ARRAY [0..g_Data.MaxCompInTank-1] OF ST_Component;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[trig_JumpToCirScreen(CLK:= stTriblender.bStartDisolving);

IF trig_JumpToCirScreen.Q THEN
	VisuElems.CurrentVisu:= 'Main';	
END_IF

Init_act_MixingStates();

stTriblender.bPumpOnFdbk:= fb_TriBlenderPump.bRun;

FB_SetProductionParams(stProdParams:=g_Data.arr_ProdTank[0],bTankInProduction:=bTesting,iActualWaterAmount:=100,stTriBlender:=g_Data.stTriBlender);
]]></ST>
    </Implementation>
    <Folder Name="Management" Id="{c4ddd0e8-5407-4334-a94a-0f41bc69fac1}" />
    <Action Name="CheckIfLast_entry" Id="{0ff06adb-60ce-46ea-a8ba-434fa5634d0f}">
      <Implementation>
        <ST><![CDATA[bDisableButton:=FALSE;

fb_TriBlenderPump.m_Stop();
bContinue:=FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="FlowOrPressureError_entry" Id="{35e66287-119c-40cd-b84f-fa3e256df670}">
      <Implementation>
        <ST><![CDATA[stTriblender.bError:=TRUE;
stTriblender.sErrorDescription:='Pressure or flow error';
VisuElems.CurrentVisu:= 'StartVisu';]]></ST>
      </Implementation>
    </Action>
