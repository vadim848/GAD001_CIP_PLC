	///Stirrer params
	iStirrerRpm		: UINT;
	iStirrerOnTime	: UINT;
	iStirrerOffTime	: UINT;
	
	//production
	iLitDrainBeforeProd	: UINT;
	rMinTempToStartProd	: REAL;
	rMaxTempToStartProd	: REAL;
	iShelfLife			: UINT;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
