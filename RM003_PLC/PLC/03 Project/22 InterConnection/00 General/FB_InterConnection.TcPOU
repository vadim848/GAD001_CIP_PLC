<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_InterConnection" Id="{cf5703e1-1088-4c69-a86c-87d02097d444}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_InterConnection
VAR_INPUT
	//eState_Tank		: E_Element_State_Short;
	//eState_Target	: E_Element_State_Short;
	//eProdType		: E_Product_Type;
	//eTargetTape		: E_Element_Type:=E_Element_Type.eNotSelected;
	reqConnect: BOOL;
	reqDisconnect: BOOL;

END_VAR
VAR_OUTPUT
	bAvalableToConnect: BOOL;
	bAvalableToDisconnect: BOOL;
	bActive: BOOL;
END_VAR
VAR



END_VAR

VAR_IN_OUT
	fbTankElement: FB_Element;
	fbTargetElement: FB_Element;	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[act_Avalable();
act_Active();




IF reqConnect THEN;
	m_Connect();
	reqConnect:=FALSE;
END_IF

IF reqDisconnect THEN;
	m_Disconnect();
	reqDisconnect:=FALSE;
END_IF

IF fbTankElement.eInterConnect <> E_InterConnection.NotConnected 
OR fbTargetElement.eInterConnect <> E_InterConnection.NotConnected
THEN;
	m_At_Connected_Pause();
	m_At_Connected_Play();
END_IF]]></ST>
    </Implementation>
    <Action Name="act_Active" Id="{053f14d0-d76f-455b-b23b-50bcb11975ff}">
      <Implementation>
        <ST><![CDATA[//fbTargetElement.eState_Long:=fbTankElement.eState_Long;
IF bActive THEN;
	fbTargetElement.m_InterConnected_State(eState_Long_Set:=fbTankElement.eState_Long);
	
	CASE fbTargetElement.eType OF		
		E_Element_Type.eLine:;
			//fbTankElement.m_InterConnect(value:=E_InterConnection.ConnToLine);
		E_Element_Type.eTriBlender:;
			//fbTankElement.m_InterConnect(value:=E_InterConnection.ConnToTriBlender);		
	END_CASE
	//fbTargetElement.m_InterConnect(value:=E_InterConnection.ConnToTank);
	

ELSE;
	//fbTankElement.m_Disconnect();
	//fbTargetElement.m_Disconnect();
END_IF



]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_At_Connected_Pause" Id="{8a5c8281-87c5-4765-a1db-14d41e4f1a8c}">
      <Implementation>
        <ST><![CDATA[
/// Master case
IF fbTankElement.m_Get_Oper_Pause_Puls() THEN;
	CASE fbTankElement.eInterConnect OF 
		E_InterConnection.NotConnected:;
		E_InterConnection.ConnToCIP:;
				// set pause to CIP
				stOper[E_ModeZone.eCIP].bSetPause:=TRUE;
				
		E_InterConnection.ConnToTank:;
				//Not avilble 
		E_InterConnection.ConnToLine:;
				IF fbTargetElement.m_Get_Type()=E_Element_Type.eLine THEN;
					fbTargetElement.m_Set_Oper_Pause();
				END_IF
		E_InterConnection.ConnToTriBlender:;
				IF fbTargetElement.m_Get_Type()=E_Element_Type.eTriBlender THEN;
					fbTargetElement.m_Set_Oper_Pause();
				END_IF				
	END_CASE	
END_IF


/// Slave case
IF fbTargetElement.m_Get_Oper_Pause_Puls() THEN;
	CASE fbTargetElement.eInterConnect OF 
		E_InterConnection.NotConnected:;
		E_InterConnection.ConnToCIP:;
				// set pause to CIP
				stOper[E_ModeZone.eCIP].bSetPause:=TRUE;
				
		E_InterConnection.ConnToTank:;
				IF TRUE
				AND fbTargetElement.m_Get_Type()=E_Element_Type.eLine
				AND fbTankElement.eInterConnect=E_InterConnection.ConnToLine THEN;
					fbTankElement.m_Set_Oper_Pause();
				END_IF
				
				IF TRUE
				AND fbTargetElement.m_Get_Type()=E_Element_Type.eTriBlender
				AND fbTankElement.eInterConnect=E_InterConnection.ConnToTriBlender THEN;
					fbTankElement.m_Set_Oper_Pause();
				END_IF
								
		E_InterConnection.ConnToLine:;
				//Not avilble 
		E_InterConnection.ConnToTriBlender:;
				//Not avilble 			
	END_CASE	
END_IF

// CIP Case
IF stOper[E_ModeZone.eCIP].b_rt_Pause 
AND	fbTankElement.eInterConnect=E_InterConnection.ConnToCIP
THEN;	
	fbTankElement.m_Set_Oper_Pause();
END_IF

IF stOper[E_ModeZone.eCIP].b_rt_Pause 
AND	fbTargetElement.eInterConnect=E_InterConnection.ConnToCIP
THEN;	
	fbTargetElement.m_Set_Oper_Pause();
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_At_Connected_Play" Id="{6c85ede9-1ee6-4e1a-9cc3-7303bdfa8993}">
      <Implementation>
        <ST><![CDATA[
/// Master case
IF fbTankElement.m_Get_Oper_Play_Puls() THEN;
	CASE fbTankElement.eInterConnect OF 
		E_InterConnection.NotConnected:;
		E_InterConnection.ConnToCIP:;
				// set Play to CIP
				//stOper[E_ModeZone.eCIP].bSetPlay:=TRUE;
				
		E_InterConnection.ConnToTank:;
				//Not avilble 
		E_InterConnection.ConnToLine:;
				IF fbTargetElement.m_Get_Type()=E_Element_Type.eLine THEN;
					fbTargetElement.m_Set_Oper_Play();
				END_IF
		E_InterConnection.ConnToTriBlender:;
				IF fbTargetElement.m_Get_Type()=E_Element_Type.eTriBlender THEN;
					fbTargetElement.m_Set_Oper_Play();
				END_IF				
	END_CASE	
END_IF


// CIP Case
IF stOper[E_ModeZone.eCIP].b_rt_Play 
AND	fbTankElement.eInterConnect=E_InterConnection.ConnToCIP
THEN;	
	fbTankElement.m_Set_Oper_Play();
END_IF

IF stOper[E_ModeZone.eCIP].b_rt_Play 
AND	fbTargetElement.eInterConnect=E_InterConnection.ConnToCIP
THEN;	
	fbTargetElement.m_Set_Oper_Play();
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_Avalable" Id="{bbb91644-6566-4503-82ff-100a461e35c3}">
      <Implementation>
        <ST><![CDATA[// To Connect
CASE fbTargetElement.eType OF
	E_Element_Type.eTriBlender:;
			IF (eTriBlenderUsage=E_TriBlenderUsage.eNotInUse 
			OR(eTriBlenderUsage=E_TriBlenderUsage.eMarinada_Standby 
				AND fbTankElement.eProdType=E_Product_Type.Marinada)
			OR(eTriBlenderUsage=E_TriBlenderUsage.eColor_Standby 
				AND fbTankElement.eProdType=E_Product_Type.Color))
			//AND fbElement[E_Element_List.eTriBlender_Marinada].eState_Short<>E_Element_State_Short.eNotClean	
			//AND fbElement[E_Element_List.eTriBlender_Color].eState_Short<>E_Element_State_Short.eNotClean
			AND fbTankElement.eInterConnect=E_InterConnection.NotConnected	
			
			// Pipe check
			(*AND ((fbTargetElement.eProdType=E_Product_Type.Marinada AND eTriBlenderPipe=E_TriBlenderPipe.eMarinada)
							OR
				(fbTargetElement.eProdType=E_Product_Type.Color AND eTriBlenderPipe=E_TriBlenderPipe.eColor))*)
		
			THEN;
				IF (fbTankElement.eState_Short=E_Element_State_Short.eClean 
					//OR fbTankElement.eState_Short=E_Element_State_Short.eProduct)
					)
				AND (fbTargetElement.eState_Short=E_Element_State_Short.eClean 
					OR fbTargetElement.eState_Short=E_Element_State_Short.eProduct)
				THEN;
					bAvalableToConnect:=TRUE;
				ELSE;
					bAvalableToConnect:=FALSE;
				END_IF	
			ELSE;
				bAvalableToConnect:=FALSE;
			END_IF
		
			IF eTriBlenderUsage=E_TriBlenderUsage.eMarinada_Standby
			AND fbTargetElement.eProdType=E_Product_Type.Marinada
			AND	fbTargetElement.eState_Short=E_Element_State_Short.eClean
			THEN;
				eTriBlenderUsage:=E_TriBlenderUsage.eNotInUse;
			END_IF

			IF eTriBlenderUsage=E_TriBlenderUsage.eColor_Standby
			AND fbTargetElement.eProdType=E_Product_Type.Color
			AND	fbTargetElement.eState_Short=E_Element_State_Short.eClean
			THEN;
				eTriBlenderUsage:=E_TriBlenderUsage.eNotInUse;
			END_IF
			
			CASE eTriBlenderUsage OF
				E_TriBlenderUsage.eMarinada_T1:;
			END_CASE
	
	E_Element_Type.eLine:;
	
			IF ((fbTankElement.eProdType=E_Product_Type.Marinada
				AND ePrL_M_Usage=E_PrLine_M_LineUsage.eNotInUse) 
			OR(fbTankElement.eProdType=E_Product_Type.Color
				AND ePrL_C_Usage=E_PrLine_C_Usage.eNotInUse)) 
			AND fbTankElement.eInterConnect=E_InterConnection.NotConnected
			AND TRUE 
			THEN;
				IF (fbTankElement.eState_Short=E_Element_State_Short.eProduct 
					//OR fbTankElement.eState_Short=E_Element_State_Short.eClean)
					)
				AND (fbTargetElement.eState_Short=E_Element_State_Short.eProduct 
					OR fbTargetElement.eState_Short=E_Element_State_Short.eClean)
				THEN;
					bAvalableToConnect:=TRUE;
				ELSE;
					bAvalableToConnect:=FALSE;
				END_IF			
			ELSE;
				bAvalableToConnect:=FALSE;
			END_IF
	
END_CASE

// To Disconnect
CASE fbTargetElement.eType OF
	E_Element_Type.eTriBlender:;
		IF bActive AND fbTankElement.eState_Long<>E_Element_State_Long.eProduction THEN;
			bAvalableToDisconnect:=TRUE;
		ELSE;
			bAvalableToDisconnect:=FALSE;
		END_IF
	E_Element_Type.eLine:;
		IF bActive AND fbTankElement.eState_Long<>E_Element_State_Long.eProduction THEN;
			bAvalableToDisconnect:=TRUE;
		ELSE;
			bAvalableToDisconnect:=FALSE;
		END_IF	
END_CASE
]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_At_Connected_Pause" Id="{7747a775-dfb4-4656-bd5a-5dfd2b984b22}">
      <Declaration><![CDATA[METHOD m_At_Connected_Pause : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
/// Master case
IF fbTankElement.m_Get_Oper_Pause_Puls() THEN;
	CASE fbTankElement.eInterConnect OF 
		E_InterConnection.NotConnected:;
		E_InterConnection.ConnToCIP:;
				// set pause to CIP
				stOper[E_ModeZone.eCIP].bSetPause:=TRUE;
				RETURN;
		E_InterConnection.ConnToTank:;
				//Not avilble 
		E_InterConnection.ConnToLine:;
				IF fbTargetElement.m_Get_Type()=E_Element_Type.eLine THEN;
					fbTargetElement.m_Set_Oper_Pause();
					RETURN;
				END_IF
		E_InterConnection.ConnToTriBlender:;
				IF fbTargetElement.m_Get_Type()=E_Element_Type.eTriBlender THEN;
					fbTargetElement.m_Set_Oper_Pause();
					RETURN;
				END_IF				
	END_CASE	
END_IF


/// Slave case
IF fbTargetElement.m_Get_Oper_Pause_Puls() THEN;
	CASE fbTargetElement.eInterConnect OF 
		E_InterConnection.NotConnected:;
		E_InterConnection.ConnToCIP:;
				// set pause to CIP
				stOper[E_ModeZone.eCIP].bSetPause:=TRUE;
				RETURN;
		E_InterConnection.ConnToTank:;
				IF TRUE
				AND fbTargetElement.m_Get_Type()=E_Element_Type.eLine
				AND fbTankElement.eInterConnect=E_InterConnection.ConnToLine THEN;
					fbTankElement.m_Set_Oper_Pause();
					RETURN;
				END_IF
				
				IF TRUE
				AND fbTargetElement.m_Get_Type()=E_Element_Type.eTriBlender
				AND fbTankElement.eInterConnect=E_InterConnection.ConnToTriBlender THEN;
					fbTankElement.m_Set_Oper_Pause();
					RETURN;
				END_IF
								
		E_InterConnection.ConnToLine:;
				//Not avilble 
		E_InterConnection.ConnToTriBlender:;
				//Not avilble 			
	END_CASE	
END_IF

// CIP Case
IF stOper[E_ModeZone.eCIP].b_rt_Pause 
AND	fbTankElement.eInterConnect=E_InterConnection.ConnToCIP
THEN;	
	fbTankElement.m_Set_Oper_Pause();
	RETURN;
END_IF

IF stOper[E_ModeZone.eCIP].b_rt_Pause 
AND	fbTargetElement.eInterConnect=E_InterConnection.ConnToCIP
THEN;	
	fbTargetElement.m_Set_Oper_Pause();
	RETURN;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_At_Connected_Play" Id="{60d5c48f-3e5b-453b-87d8-ad30a41d1883}">
      <Declaration><![CDATA[METHOD m_At_Connected_Play : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
/// Master case
IF fbTankElement.m_Get_Oper_Play_Puls() THEN;
	CASE fbTankElement.eInterConnect OF 
		E_InterConnection.NotConnected:;
		E_InterConnection.ConnToCIP:;
				// Not avilble				
		E_InterConnection.ConnToTank:;
				//Not avilble 
		E_InterConnection.ConnToLine:;
				IF fbTargetElement.m_Get_Type()=E_Element_Type.eLine THEN;
					fbTargetElement.m_Set_Oper_Play();
					RETURN;
				END_IF
		E_InterConnection.ConnToTriBlender:;
				IF fbTargetElement.m_Get_Type()=E_Element_Type.eTriBlender THEN;
					fbTargetElement.m_Set_Oper_Play();
					RETURN;
				END_IF				
	END_CASE	
END_IF


// CIP Case
IF stOper[E_ModeZone.eCIP].b_rt_Play 
AND	fbTankElement.eInterConnect=E_InterConnection.ConnToCIP
THEN;	
	fbTankElement.m_Set_Oper_Play();
	RETURN;
END_IF

IF stOper[E_ModeZone.eCIP].b_rt_Play 
AND	fbTargetElement.eInterConnect=E_InterConnection.ConnToCIP
THEN;	
	fbTargetElement.m_Set_Oper_Play();
	RETURN;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Connect" Id="{e7e6d898-ed15-47b5-b661-2b6aa3ec33b3}">
      <Declaration><![CDATA[METHOD m_Connect : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bAvalableToConnect THEN;
	
	CASE fbTankElement.eElementID OF
		E_Element_List.eTank_1:;
				CASE fbTargetElement.eElementID OF
					E_Element_List.eTriBlender_Marinada:;
						eTriBlenderUsage:=E_TriBlenderUsage.eMarinada_T1;
						fbTankElement.m_InterConnect(value:=E_InterConnection.ConnToTriBlender);
					E_Element_List.eLine_Marinada:;
						ePrL_M_Usage:=E_PrLine_M_LineUsage.eMarinada_T1;
						fbTankElement.m_InterConnect(value:=E_InterConnection.ConnToLine);
				END_CASE								
				
		E_Element_List.eTank_2:;		
				CASE fbTargetElement.eElementID OF
					E_Element_List.eTriBlender_Marinada:;
						eTriBlenderUsage:=E_TriBlenderUsage.eMarinada_T2;
						fbTankElement.m_InterConnect(value:=E_InterConnection.ConnToTriBlender);
					E_Element_List.eLine_Marinada:;
						ePrL_M_Usage:=E_PrLine_M_LineUsage.eMarinada_T2;
						fbTankElement.m_InterConnect(value:=E_InterConnection.ConnToLine);
				END_CASE		
		
				
		E_Element_List.eTank_3:;
				CASE fbTargetElement.eElementID OF
					E_Element_List.eTriBlender_Color:;
						eTriBlenderUsage:=E_TriBlenderUsage.eColor_T3;
						fbTankElement.m_InterConnect(value:=E_InterConnection.ConnToTriBlender);
					E_Element_List.eLine_Color:;
						ePrL_C_Usage:=E_PrLine_C_Usage.eColor_T3;
						fbTankElement.m_InterConnect(value:=E_InterConnection.ConnToLine);
				END_CASE
						
		E_Element_List.eTank_4:;
				CASE fbTargetElement.eElementID OF
					E_Element_List.eTriBlender_Color:;
						eTriBlenderUsage:=E_TriBlenderUsage.eColor_T4;
						fbTankElement.m_InterConnect(value:=E_InterConnection.ConnToTriBlender);
					E_Element_List.eLine_Color:;
						ePrL_C_Usage:=E_PrLine_C_Usage.eColor_T4;
						fbTankElement.m_InterConnect(value:=E_InterConnection.ConnToLine);
				END_CASE		
						
	END_CASE
	fbTargetElement.m_InterConnect(value:=E_InterConnection.ConnToTank);
	bActive:=TRUE;
ELSE;

END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Disconnect" Id="{8e7cefc8-01ec-43b9-a1a9-02ea327c2eac}">
      <Declaration><![CDATA[METHOD m_Disconnect : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bActive AND fbTankElement.eState_Long<>E_Element_State_Long.eProduction THEN;
	IF fbTargetElement.eType=E_Element_Type.eTriBlender THEN;
		IF fbTargetElement.eState_Short=E_Element_State_Short.eProduct THEN;
			IF fbTankElement.eProdType=E_Product_Type.Marinada 
			AND fbTargetElement.memoDissolving_active
			THEN;
				eTriBlenderUsage:=E_TriBlenderUsage.eMarinada_Standby;
			END_IF
			IF fbTankElement.eProdType=E_Product_Type.Color 
			AND fbTargetElement.memoDissolving_active
			THEN;
				eTriBlenderUsage:=E_TriBlenderUsage.eColor_Standby;
			END_IF
		ELSE;
			eTriBlenderUsage:=E_TriBlenderUsage.eNotInUse;
		END_IF
		
		
	ELSIF fbTargetElement.eType=E_Element_Type.eLine THEN;
		IF fbTankElement.eProdType=E_Product_Type.Marinada THEN;
			ePrL_M_Usage:=E_PrLine_M_LineUsage.eNotInUse;
		END_IF
		IF fbTankElement.eProdType=E_Product_Type.Color THEN;
			ePrL_C_Usage:=E_PrLine_C_Usage.eNotInUse;
		END_IF		
	END_IF
	
	fbTankElement.m_Disconnect();
	fbTargetElement.m_Disconnect();
	bActive:=FALSE;
END_IF

]]></ST>
      </Implementation>
    </Method>
