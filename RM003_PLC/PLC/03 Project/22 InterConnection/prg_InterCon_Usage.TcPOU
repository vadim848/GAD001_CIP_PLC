<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="prg_InterCon_Usage" Id="{24fec81d-d792-4666-bec4-7cc918d6b551}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM prg_InterCon_Usage
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// TriBlender  

IF fbElement[E_Element_List.eTank_1].eState_Short=E_Element_State_Short.eClean 
AND fbElement[E_Element_List.eTriBlender_Marinada].eState_Short=E_Element_State_Short.eClean
THEN;
	//eIntCon_TriB_T1_Marin:=E_InterConnection.Avalable;
END_IF

act_Call_InterConnection();

CASE eTriBlenderUsage OF
	E_TriBlenderUsage.eMarinada_T1,E_TriBlenderUsage.eMarinada_T2,
	E_TriBlenderUsage.eColor_T3,E_TriBlenderUsage.eColor_T4:;
	
		fbElement[E_Element_List.eTriBlender_Marinada].m_StateUpdate_Limit(value:=TRUE);		
		fbElement[E_Element_List.eTriBlender_Color].m_StateUpdate_Limit(value:=TRUE);	
ELSE;
		fbElement[E_Element_List.eTriBlender_Marinada].m_StateUpdate_Limit(value:=FALSE);
		fbElement[E_Element_List.eTriBlender_Color].m_StateUpdate_Limit(value:=FALSE);	
	
		
END_CASE]]></ST>
    </Implementation>
