    <Action Name="act_Status" Id="{3024ea02-87ce-4d11-b8f4-5b8eb6467f35}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[IF TRUE 
AND fbPis.m_CheckByRecipe(stPis:=stPis_TankA, 			req:=E_Piston_Recipe_State.Release)		
AND fbPis.m_CheckByRecipe(stPis:=stPis_TankB, 			req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_TapWater, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_TapWater_Drain, 	req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 			req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_CIP, 			req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_BlockWater, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_WaterSource, 	req:=E_Piston_Recipe_State.Release)
THEN;
	eStatus:=E_Line_Source.eDrain;
ELSIF TRUE 
AND fbPis.m_CheckByRecipe(stPis:=stPis_TankA, 			req:=E_Piston_Recipe_State.Act)		
AND fbPis.m_CheckByRecipe(stPis:=stPis_TankB, 			req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_TapWater, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_TapWater_Drain, 	req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 			req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_CIP, 			req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_BlockWater, 		req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_WaterSource, 	req:=E_Piston_Recipe_State.Release)
THEN;
	eStatus:=E_Line_Source.eTank_A;
ELSIF TRUE 
AND fbPis.m_CheckByRecipe(stPis:=stPis_TankA, 			req:=E_Piston_Recipe_State.Release)		
AND fbPis.m_CheckByRecipe(stPis:=stPis_TankB, 			req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_TapWater, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_TapWater_Drain, 	req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 			req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_CIP, 			req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_BlockWater, 		req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_WaterSource, 	req:=E_Piston_Recipe_State.Release)
THEN;
	eStatus:=E_Line_Source.eTank_B;
ELSIF TRUE 
AND fbPis.m_CheckByRecipe(stPis:=stPis_TankA, 			req:=E_Piston_Recipe_State.Release)		
AND fbPis.m_CheckByRecipe(stPis:=stPis_TankB, 			req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_TapWater, 		req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_TapWater_Drain, 	req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 			req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_CIP, 			req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_BlockWater, 		req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_WaterSource, 	req:=E_Piston_Recipe_State.Release)
THEN;
	eStatus:=E_Line_Source.eTapWater;
ELSIF TRUE 
AND fbPis.m_CheckByRecipe(stPis:=stPis_TankA, 			req:=E_Piston_Recipe_State.Release)		
AND fbPis.m_CheckByRecipe(stPis:=stPis_TankB, 			req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_TapWater, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_TapWater_Drain, 	req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 			req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_CIP, 			req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_BlockWater, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_WaterSource, 	req:=E_Piston_Recipe_State.Act)
THEN;
	eStatus:=E_Line_Source.eFillWater;
ELSIF TRUE 
AND fbPis.m_CheckByRecipe(stPis:=stPis_TankA, 			req:=E_Piston_Recipe_State.Release)		
AND fbPis.m_CheckByRecipe(stPis:=stPis_TankB, 			req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_TapWater, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_TapWater_Drain, 	req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 			req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_CIP, 			req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_BlockWater, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_WaterSource, 	req:=E_Piston_Recipe_State.Release)
THEN;
	eStatus:=E_Line_Source.eCIP;
END_IF ]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_CheckStatus" Id="{4048b8d2-9673-4029-84b4-7685ad242031}">
      <Declaration><![CDATA[METHOD m_CheckStatus : BOOL
VAR_INPUT
	eReqStatus		: E_Line_Source;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eStatus=eReqStatus 
AND eProcess=E_Line_Source.eNone
AND eReq=E_Line_Source.eNone
AND bDone
AND NOT bRun
THEN;
	m_CheckStatus:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Run" Id="{b3f2817c-37d1-47ea-82d9-76c7c92e82ed}">
      <Declaration><![CDATA[METHOD m_Run : BOOL
VAR_INPUT
	eReqProc			: E_Line_Source;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eProcess=E_Line_Source.eNone THEN;
	eProcess:=eReq:=eReqProc;
	bDone:=FALSE;
	m_Run:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Set_SFCFlags_Reference" Id="{1d953b94-b8b7-4eef-b8a4-b7c9f4438caf}">
      <Declaration><![CDATA[{warning 'add method implementation '}
METHOD m_Set_SFCFlags_Reference : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Set reference to SFC flags

refSFC.SFCInit REF= SFCInit;
refSFC.SFCReset REF= SFCReset;
refSFC.SFCError REF= SFCError;
refSFC.SFCEnableLimit REF= SFCEnableLimit;
refSFC.SFCErrorStep REF= SFCErrorStep;
refSFC.SFCErrorPOU REF= SFCErrorPOU;
refSFC.SFCQuitError REF= SFCQuitError;
refSFC.SFCPause REF= SFCPause;
refSFC.SFCTrans REF= SFCTrans;
refSFC.SFCCurrentStep REF= SFCCurrentStep;
//refSFC.SFCTip REF= SFCTip;
//refSFC.SFCTipMode REF= SFCTipMode;

// Cycle handle for SFC
m_SFC_Handle();]]></ST>
      </Implementation>
    </Method>
