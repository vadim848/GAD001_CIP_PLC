<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_Line_Source" Id="{137ed242-9f5e-44a3-a945-e1d43cf34d59}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Line_Source EXTENDS FB_SFC_Cycle IMPLEMENTS ITF_FB_SFC_Cycle
VAR_INPUT
	valTankA				:	E_Pis_Name	;
	valTankB				:	E_Pis_Name	;
	valTapWater				:	E_Pis_Name	;
	valTapWater_Drain		:	E_Pis_Name	;	
	valDrain				:	E_Pis_Name	;
	valCIP					:	E_Pis_Name	;
	valBlockWater			:	E_Pis_Name	;	
	valWaterSource			:	E_Pis_Name	;
END_VAR
VAR_OUTPUT
END_VAR
VAR
	eReq				: E_Line_Source;
	eProcess			: E_Line_Source;
	eStatus				: E_Line_Source;
	
	fbPis				: FB_Piston;
	
	stPis_TankA				: REFERENCE TO ST_Piston;
	stPis_TankB				: REFERENCE TO ST_Piston;
	stPis_TapWater			: REFERENCE TO ST_Piston;
	stPis_TapWater_Drain	: REFERENCE TO ST_Piston;
	stPis_Drain				: REFERENCE TO ST_Piston;
	stPis_CIP				: REFERENCE TO ST_Piston;
	stPis_BlockWater		: REFERENCE TO ST_Piston;
	stPis_WaterSource		: REFERENCE TO ST_Piston;
	
	stPis_Outlet: ST_Piston;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[act_GetReference();

act_Oper();
//IF NOT Init.x THEN
	act_Status();
//END_IF
]]></ST>
    </Implementation>
