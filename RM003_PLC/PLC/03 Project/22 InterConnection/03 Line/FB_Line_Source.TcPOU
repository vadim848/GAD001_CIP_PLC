//refState_Long REF= fbElement[eElementID].eState_Long;

stPis_TankA				REF= g_Piston.stPis[valTankA];
stPis_TankB				REF= g_Piston.stPis[valTankB];
stPis_TapWater			REF= g_Piston.stPis[valTapWater];
stPis_TapWater_Drain	REF= g_Piston.stPis[valTapWater_Drain];
stPis_BlockWater		REF= g_Piston.stPis[valBlockWater];
