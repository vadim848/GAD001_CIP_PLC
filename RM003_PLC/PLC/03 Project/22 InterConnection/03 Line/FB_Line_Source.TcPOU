    <Action Name="_aReady_active" Id="{0e401379-cf24-47d0-855d-d82202d84006}">
      <Implementation>
        <ST><![CDATA[CASE eReq OF
	E_Line_Source.eDrain:;
			IF TRUE THEN;
				eProcess:=E_Line_Source.eDrain;
			END_IF

	E_Line_Source.eTank_A:;
			IF TRUE THEN;
				eProcess:=E_Line_Source.eTank_A;
			END_IF	
			
	E_Line_Source.eTank_B:;
			IF TRUE THEN;
				eProcess:=E_Line_Source.eTank_B;
			END_IF	

	E_Line_Source.eTapWater:;
			IF TRUE THEN;
				eProcess:=E_Line_Source.eTapWater;
			END_IF	
			
	E_Line_Source.eFillWater:;
			IF TRUE THEN;
				eProcess:=E_Line_Source.eFillWater;
			END_IF	
			
	E_Line_Source.eCIP:;
			IF TRUE THEN;
				eProcess:=E_Line_Source.eCIP;
			END_IF	

END_CASE]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
