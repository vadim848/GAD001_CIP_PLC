    <Action Name="_aReady_active" Id="{11ea1fd0-5021-4a91-99b3-72574a941116}">
      <Implementation>
        <ST><![CDATA[
eStatus:=E_Tank_Target.eNone;
CASE eReq OF
	E_Tank_Target.eClose:;
			IF TRUE THEN;
				eProcess:=E_Tank_Target.eClose;
			END_IF

	E_Tank_Target.eOpen:;
			IF TRUE THEN;
				eProcess:=E_Tank_Target.eOpen;
			END_IF	
			
	E_Tank_Target.eDrain:;
			IF TRUE THEN;
				eProcess:=E_Tank_Target.eDrain;
			END_IF
	
	E_Tank_Target.eClose_DrainPipe:;
			IF TRUE THEN;
				eProcess:=E_Tank_Target.eClose_DrainPipe;
			END_IF	
			
	E_Tank_Target.eCIP:;
			IF TRUE THEN;
				eProcess:=E_Tank_Target.eCIP;
			END_IF	

END_CASE
		
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
