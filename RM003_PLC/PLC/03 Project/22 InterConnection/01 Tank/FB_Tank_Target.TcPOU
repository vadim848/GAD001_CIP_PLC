<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_Tank_Target" Id="{e77bc243-ef67-4877-849d-f4a841448420}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Tank_Target EXTENDS FB_SFC_Cycle IMPLEMENTS ITF_FB_SFC_Cycle
VAR_INPUT
	//eElementID			: E_Element_List;
	valOutlet		: E_Pis_Name;
	valLine			: E_Pis_Name;
	valTriBlender	: E_Pis_Name;
	valDrain		: E_Pis_Name;	
	valCIP			: E_Pis_Name;	
END_VAR
VAR_OUTPUT
END_VAR
VAR
	//refElement		: REFERENCE TO FB_Element;
	//refState_Long		: REFERENCE TO E_Element_State_Long;
	eReq				: E_Tank_Target;
	eProcess			: E_Tank_Target;
	eStatus				: E_Tank_Target;
	
	fbPis				: FB_Piston;
	stPis_Outlet		: REFERENCE TO ST_Piston;
	stPis_Line			: REFERENCE TO ST_Piston;
	stPis_TriBlender	: REFERENCE TO ST_Piston;
	stPis_Drain			: REFERENCE TO ST_Piston;
	stPis_CIP			: REFERENCE TO ST_Piston;

	tonDrainTime: TON;
END_VAR
VAR_IN_OUT


END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[act_GetReference();

act_Oper();
IF NOT Init.x THEN;
	act_Status();
END_IF

tonDrainTime(PT:=T#1M, IN:=eStatus=E_Tank_Target.eDrain OR eStatus=E_Tank_Target.eClose_DrainPipe);
IF tonDrainTime.Q 
AND eReq=E_Tank_Target.eNone
AND eProcess=E_Tank_Target.eNone
THEN;
	eReq:=E_Tank_Target.eClose;
END_IF]]></ST>
    </Implementation>
    <Folder Name="Manage" Id="{e461fcff-545d-4d57-a27d-4174ff6e3a51}" />
