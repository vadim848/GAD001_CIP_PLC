    <Action Name="act_Status" Id="{0d6b2513-8aec-4f27-b7af-4e0f232d3f1f}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[

IF TRUE 
AND fbPis.m_CheckByRecipe(stPis:=stPis_Outlet, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_Line, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_TriBlender, 	req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_CIP, 		req:=E_Piston_Recipe_State.Release)
THEN;
	eStatus:=E_Tank_Target.eClose;
	
ELSIF TRUE 
AND fbPis.m_CheckByRecipe(stPis:=stPis_Outlet, 		req:=E_Piston_Recipe_State.Act)
//AND fbPis.m_CheckByRecipe(stPis:=valLine, 		req:=E_Piston_Recipe_State.Release)
//AND fbPis.m_CheckByRecipe(stPis:=valTriBlender, 	req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_CIP, 		req:=E_Piston_Recipe_State.Release)
THEN;
	eStatus:=E_Tank_Target.eOpen;
	
ELSIF TRUE 
AND fbPis.m_CheckByRecipe(stPis:=stPis_Outlet, 		req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_Line, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_TriBlender, 	req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 		req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_CIP, 		req:=E_Piston_Recipe_State.Release)
THEN;
	eStatus:=E_Tank_Target.eDrain;
	
ELSIF TRUE 
AND fbPis.m_CheckByRecipe(stPis:=stPis_Outlet, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_Line, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_TriBlender, 	req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 		req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_CIP, 		req:=E_Piston_Recipe_State.Release)
THEN;
	eStatus:=E_Tank_Target.eClose_DrainPipe;
	
ELSIF TRUE 
AND fbPis.m_CheckByRecipe(stPis:=stPis_Outlet, 		req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_Line, 		req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_TriBlender, 	req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 		req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_CIP, 		req:=E_Piston_Recipe_State.Act)
THEN;
	eStatus:=E_Tank_Target.eCIP;
	
ELSE;
	eStatus:=E_Tank_Target.eNone;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_CheckStatus" Id="{730e0eab-fcbe-441f-8132-795becd278a2}">
      <Declaration><![CDATA[METHOD m_CheckStatus : BOOL
VAR_INPUT
	eReqStatus		: E_Tank_Target;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eStatus=eReqStatus 
AND eProcess=E_Tank_Target.eNone
AND eReq=E_Tank_Target.eNone
AND bReady
AND bDone
AND NOT bRun
THEN;
	m_CheckStatus:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Run" Id="{7ffc4675-e14a-4e0d-a035-300d182aa227}">
      <Declaration><![CDATA[METHOD m_Run : BOOL
VAR_INPUT
	eReqProc			: E_Tank_Target;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eProcess=E_Tank_Target.eNone THEN;
	eProcess:=eReq:=eReqProc;
	bDone:=FALSE;
	m_Run:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Set_SFCFlags_Reference" Id="{f4d4034f-fbcd-4ba0-9568-d6c2136b33ee}">
      <Declaration><![CDATA[METHOD m_Set_SFCFlags_Reference : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Set reference to SFC flags

refSFC.SFCInit REF= SFCInit;
refSFC.SFCReset REF= SFCReset;
refSFC.SFCError REF= SFCError;
refSFC.SFCEnableLimit REF= SFCEnableLimit;
refSFC.SFCErrorStep REF= SFCErrorStep;
refSFC.SFCErrorPOU REF= SFCErrorPOU;
refSFC.SFCQuitError REF= SFCQuitError;
refSFC.SFCPause REF= SFCPause;
refSFC.SFCTrans REF= SFCTrans;
refSFC.SFCCurrentStep REF= SFCCurrentStep;
refSFC.SFCTip REF= SFCTip;
refSFC.SFCTipMode REF= SFCTipMode;

// Cycle handle for SFC
m_SFC_Handle();]]></ST>
      </Implementation>
    </Method>
