    <Action Name="act_StateChange_WatchGog" Id="{4dafd2ba-8022-4674-a1d5-a6952dfd70bd}">
      <Implementation>
        <ST><![CDATA[IF eState_Long<>eState_Long_last THEN;
	eState_Long_last:=eState_Long;
	stStateChange:=stSystemTime;
END_IF

sState_Time:=prg_RealClock.m_DeltaTime(stStartTime:=stStateChange);]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_StateMachine" Id="{f33c6159-2800-4ae4-981a-4a8c5e4774dd}">
      <Implementation>
        <ST><![CDATA[

CASE eState_Long OF
	E_Element_State_Long.eOff,
	E_Element_State_Long.eStandby,
	E_Element_State_Long.eNotClean,
	E_Element_State_Long.eCIP_1_Rinzed,
	E_Element_State_Long.eCIP_2_Deterged,
	E_Element_State_Long.eCIP_3_Deterged_Clean,	
	E_Element_State_Long.eCIP_4_Sanitized:;
				eState_Short:=E_Element_State_Short.eNotClean;

	E_Element_State_Long.eCIP_5_Done,	
	E_Element_State_Long.eWaterReady:;	
				eState_Short:=E_Element_State_Short.eClean;

	E_Element_State_Long.eReady,
	E_Element_State_Long.eProduction,
	E_Element_State_Long.eEmpty,	
	E_Element_State_Long.eExpired:;
				eState_Short:=E_Element_State_Short.eProduct;
	
END_CASE

]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_Tank" Id="{2dddeb0d-68bf-4477-8840-0824af0883b1}">
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_Disconnect" Id="{20e4c919-f24b-4fbd-ae5c-73c93cc7bd42}">
      <Declaration><![CDATA[METHOD m_Disconnect : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eInterConnect:=E_InterConnection.NotConnected;
//bInterConnectedToLine:=FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_InterConnect" Id="{72ff53e2-bb5f-4090-a2e6-ef10be06eb5a}">
      <Declaration><![CDATA[METHOD m_InterConnect : BOOL
VAR_INPUT
	value: E_InterConnection;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eInterConnect:=value;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_InterConnected_State" Id="{5873be97-3110-49a4-84ea-a94cd608159b}">
      <Declaration><![CDATA[METHOD m_InterConnected_State : BOOL
VAR_INPUT
	eState_Long_Set			: E_Element_State_Long;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eState_Long:=eState_Long_Set;
//bInterConnected:=TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_StateUpdate_Limit" Id="{fb1d1185-6118-48f5-8cfa-978fe0325d17}">
      <Declaration><![CDATA[METHOD m_StateUpdate_Limit : BOOL
VAR_INPUT
	value: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF value THEN;
	bStataUpdate_Limited:=TRUE;
ELSE;
	bStataUpdate_Limited:=FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
