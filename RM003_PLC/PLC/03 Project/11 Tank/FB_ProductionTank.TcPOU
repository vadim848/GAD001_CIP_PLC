    <Action Name="act_TempCntrl" Id="{fa8d9f6d-7d99-4287-8414-2085c4b68d07}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[CASE eElementID OF 
	E_Element_List.eTank_1:
		//Marinada Tank 1
		st_TempCntrl 	REF=g_ProcControl.arr_stProcCntrl[E_ProcessControl_Name.eMarinTank1_Temp];
		pc_TempCntrl 	REF= g_ProcControl.arr_fbProcCntrl[E_ProcessControl_Name.eMarinTank1_Temp];
		//tolerance
	E_Element_List.eTank_2:
		//Marinada Tank 2
		st_TempCntrl 	REF=g_ProcControl.arr_stProcCntrl[E_ProcessControl_Name.eMarinTank2_Temp];
		pc_TempCntrl 	REF= g_ProcControl.arr_fbProcCntrl[E_ProcessControl_Name.eMarinTank2_Temp];
	E_Element_List.eTank_3:
		//Color Tank 1
		st_TempCntrl 	REF=g_ProcControl.arr_stProcCntrl[E_ProcessControl_Name.eColorTank1_Temp];
		pc_TempCntrl 	REF= g_ProcControl.arr_fbProcCntrl[E_ProcessControl_Name.eColorTank1_Temp];
	E_Element_List.eTank_4:
		//Color Tank 2
		st_TempCntrl 	REF=g_ProcControl.arr_stProcCntrl[E_ProcessControl_Name.eColorTank2_Temp];
		pc_TempCntrl 	REF= g_ProcControl.arr_fbProcCntrl[E_ProcessControl_Name.eColorTank2_Temp];
END_CASE
st_TempCntrl.rValue:=g_AnalogSensor.stAnalogSensor[sens_TankTemp].Value;//sensor
//st_TempCntrl.rValue:=rTest;//sensor test
st_TempCntrl.rSetPoint:=stProdParam.stRecipe.Temperature;//value from recipe
st_TempCntrl.fHystLow:=stProdParam.stRecipe.Temperature-1;
st_TempCntrl.fHystHigh:=stProdParam.stRecipe.Temperature+0.5;
//st_TempCntrl.ToleranceHigh:=5;
//st_TempCntrl.ToleravceLow:=-55;



bCntrlTemp:=stProdParam.eStatus=E_Prod_Status.Active;

IF bCntrlTemp AND NOT bRunCIP THEN
	//pc_TempCntrl.mRun_Hyst();
	pc_TempCntrl(stProcessControl:=st_TempCntrl);
	
 	IF TRUE 
	AND (NOT st_TempCntrl.bHystOut)
	AND  stPis_CWOut.st_Close
	THEN
		stPis_CWOut.req_Open:=TRUE;
		
	ELSIF (st_TempCntrl.bHystOut)
	AND stPis_CWOut.st_Open THEN;
		stPis_CWOut.req_Close:=TRUE;
		
	END_IF
		
	IF NOT stPis_CWIn.st_Open THEN
		stPis_CWIn.req_Open:=TRUE;
	END_IF
	
ELSE
	IF NOT stPis_CWOut.st_Close THEN;
		stPis_CWOut.req_Close:=TRUE;
	END_IF
	
	IF NOT stPis_CWIn.st_Close THEN
		stPis_CWIn.req_Close:=TRUE;
	END_IF
END_IF	


]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_Get_TriBlender_Clean" Id="{13b7f4ac-db6a-45d8-9c4a-691ded0763a9}" FolderPath="Manage\">
      <Declaration><![CDATA[METHOD m_Get_TriBlender_Clean : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eElementID OF
	E_Element_List.eTank_1,E_Element_List.eTank_2:;
		m_Get_TriBlender_Clean:=fbElement[E_Element_List.eTriBlender_Color].m_Get_State_Short()=E_Element_State_Short.eClean;
	E_Element_List.eTank_3,E_Element_List.eTank_4:;
		m_Get_TriBlender_Clean:=fbElement[E_Element_List.eTriBlender_Marinada].m_Get_State_Short()=E_Element_State_Short.eClean;
	
ELSE;
	m_Get_TriBlender_Clean:=FALSE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_HMI" Id="{eaa75ffd-8860-40ef-b20b-3b03fd8650af}" FolderPath="Manage\">
