    <Action Name="_aInit_Production_Line_active" Id="{f29a22dd-dba6-4c18-ad45-eb5a9205bc2c}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF TRUE
AND refState_Long<>E_Element_State_Long.eProduction
AND fbTarget.m_CheckStatus(eReqStatus:=E_Tank_Target.eClose_DrainPipe) 
AND fbLineSource.m_CheckStatus(eReqStatus:=E_Line_Source.eDrain)
AND fbLineTarget.m_CheckStatus(eReqStatus:=E_Line_Target.eDrain)
AND (NOT fbInterConnection_ProL.bActive)
AND TRUE
THEN;
	bStepDone:=TRUE;
ELSIF refState_Long=E_Element_State_Long.eProduction THEN;
	bStepDone:=TRUE;
END_IF]]></ST>
      </Implementation>
