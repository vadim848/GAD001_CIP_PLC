    <Action Name="_aTank_Drain_active" Id="{850e8108-4146-442b-badb-cf02346f4c47}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF fbTarget.m_CheckStatus(eReqStatus:=E_Tank_Target.eDrain) THEN;
	bTON_Active:=TRUE;
	
ELSIF Tank_Drain.t>=T#3S THEN; // max time to detect drain open
	bStepDone:=TRUE;
END_IF
IF Call_TON.Q THEN
	bStepDone:=TRUE;
END_IF]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
