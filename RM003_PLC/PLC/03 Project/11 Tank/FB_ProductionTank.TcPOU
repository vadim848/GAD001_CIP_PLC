    <Action Name="act_TempCntrl" Id="{fa8d9f6d-7d99-4287-8414-2085c4b68d07}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[CASE eElementID OF 
	E_Element_List.eTank_1:
		//Marinada Tank 1
		st_TempCntrl 	REF=g_ProcControl.arr_stProcCntrl[E_ProcessControl_Name.eMarinTank1_Temp];
		pc_TempCntrl 	REF= g_ProcControl.arr_fbProcCntrl[E_ProcessControl_Name.eMarinTank1_Temp];
		st_TempCntrl.rSetPoint:=-10;//value from recipe
		//tolerance
	E_Element_List.eTank_2:
		//Marinada Tank 2
		st_TempCntrl 	REF=g_ProcControl.arr_stProcCntrl[E_ProcessControl_Name.eMarinTank2_Temp];
		pc_TempCntrl 	REF= g_ProcControl.arr_fbProcCntrl[E_ProcessControl_Name.eMarinTank2_Temp];
		st_TempCntrl.rSetPoint:=-10;//value from recipe
	E_Element_List.eTank_3:
		//Color Tank 1
		st_TempCntrl 	REF=g_ProcControl.arr_stProcCntrl[E_ProcessControl_Name.eColorTank1_Temp];
		pc_TempCntrl 	REF= g_ProcControl.arr_fbProcCntrl[E_ProcessControl_Name.eColorTank1_Temp];
		st_TempCntrl.rSetPoint:=-10;//value from recipe
	E_Element_List.eTank_4:
		//Color Tank 2
		st_TempCntrl 	REF=g_ProcControl.arr_stProcCntrl[E_ProcessControl_Name.eColorTank2_Temp];
		pc_TempCntrl 	REF= g_ProcControl.arr_fbProcCntrl[E_ProcessControl_Name.eColorTank2_Temp];
		st_TempCntrl.rSetPoint:=-10;//value from recipe
END_CASE
st_TempCntrl.rValue:=g_AnalogSensor.stAnalogSensor[sens_TankTemp].Value;//sensor
st_TempCntrl.fHystLow:=-10;
st_TempCntrl.fHystHigh:=30;
st_TempCntrl.ToleranceHigh:=5;
st_TempCntrl.ToleravceLow:=-55;

IF bCntrlTemp AND NOT bRunCIP THEN
	pc_TempCntrl.mRun_Hyst();
	
 	IF TRUE 
	AND st_TempCntrl.bHystOut
	AND  stPis_CWOut.st_Close
	THEN
		stPis_CWOut.req_Open:=TRUE;
		//stPis_CWOut.req_Close:=FALSE;
	ELSIF stPis_CWOut.st_Open THEN;
		stPis_CWOut.req_Close:=TRUE;
		//stPis_CWOut.req_Open:=FALSE;
	END_IF
	
ELSE
	IF NOT stPis_CWOut.st_Close THEN;
		stPis_CWOut.req_Close:=TRUE;
	END_IF
	
	IF NOT stPis_CWIn.st_Close THEN
		stPis_CWIn.req_Close:=TRUE;
	END_IF
END_IF	


]]></ST>
      </Implementation>
    </Action>
    <Action Name="Drain_TapWater_01_active" Id="{30b94932-29a4-4643-a735-a63304d5897d}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF TRUE 
AND fbPis.m_CheckByRecipe(stPis:=stPis_DrainTapWater, req:=E_Piston_Recipe_State.Act)
THEN;
	bStepDone:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="Drain_TapWater_01_entry" Id="{10380ff9-5c82-470f-8a08-64600773637a}">
      <Implementation>
        <ST><![CDATA[fbPis.m_SetByRecipe(stPis:=stPis_DrainTapWater, req:=E_Piston_Recipe_State.Act);]]></ST>
      </Implementation>
    </Action>
    <Action Name="Drain_TapWater_02_active" Id="{4acaeef2-76dc-474e-a51d-030223dd5ff5}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF TRUE 
AND fbPis.m_CheckByRecipe(stPis:=stPis_DrainTapWater, req:=E_Piston_Recipe_State.Act)
THEN;
	bStepDone:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="Drain_TapWater_02_entry" Id="{2ca056a0-ed02-4d3e-b277-57193498b756}">
      <Implementation>
        <ST><![CDATA[fbPis.m_SetByRecipe(stPis:=stPis_DrainTapWater, req:=E_Piston_Recipe_State.Act);]]></ST>
      </Implementation>
    </Action>
    <Action Name="Drain_Water_active" Id="{861ce898-9936-45d9-aef3-f54358e07190}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF TRUE 
AND fbPis.m_CheckByRecipe(stPis:=stPis_FillWaterDrain, 		req:=E_Piston_Recipe_State.Act)
AND fbPis.m_CheckByRecipe(stPis:=stPis_FillWater, 			req:=E_Piston_Recipe_State.Act) 
THEN;
	bStepDone:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="Drain_Water_entry" Id="{7eb23368-a8ab-4179-9315-ebe70b83bdf1}">
      <Implementation>
        <ST><![CDATA[fbPis.m_SetByRecipe(stPis:=stPis_FillWaterDrain, 			req:=E_Piston_Recipe_State.Act);
fbPis.m_SetByRecipe(stPis:=stPis_FillWater, 			req:=E_Piston_Recipe_State.Act);]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_Set_SFCFlags_Reference" Id="{e572de0c-3d24-464d-bb17-5deb316affd4}">
      <Declaration><![CDATA[METHOD m_Set_SFCFlags_Reference : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Set reference to SFC flags

refSFC.SFCInit REF= SFCInit;
refSFC.SFCReset REF= SFCReset;
refSFC.SFCError REF= SFCError;
refSFC.SFCEnableLimit REF= SFCEnableLimit;
refSFC.SFCErrorStep REF= SFCErrorStep;
refSFC.SFCErrorPOU REF= SFCErrorPOU;
refSFC.SFCQuitError REF= SFCQuitError;
refSFC.SFCPause REF= SFCPause;
refSFC.SFCTrans REF= SFCTrans;
refSFC.SFCCurrentStep REF= SFCCurrentStep;
refSFC.SFCTip REF= SFCTip;
refSFC.SFCTipMode REF= SFCTipMode;

// Cycle handle for SFC
m_SFC_Handle();]]></ST>
      </Implementation>
    </Method>
    <Transition Name="trn_Tank_A" Id="{7f0e7518-f66a-4b4a-b16b-a3f65f501415}">
      <Implementation>
        <ST><![CDATA[trn_Tank_A:=(eElementID=E_Element_List.eTank_1 OR eElementID=E_Element_List.eTank_3) AND bStepDone;]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="trn_Tank_B" Id="{e4cef271-82c6-43c9-bc0b-ff7cff0b1929}">
      <Implementation>
        <ST><![CDATA[trn_Tank_B:=(eElementID=E_Element_List.eTank_2 OR eElementID=E_Element_List.eTank_4)  AND bStepDone;]]></ST>
      </Implementation>
    </Transition>
