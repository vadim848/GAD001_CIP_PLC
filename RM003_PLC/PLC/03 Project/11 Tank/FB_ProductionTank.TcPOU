<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_ProductionTank" Id="{7ce7ab69-2020-4b39-9932-dc5de2cb0022}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ProductionTank EXTENDS FB_SFC_Cycle IMPLEMENTS ITF_FB_SFC_Cycle
VAR_INPUT
	eElementID		: E_Element_List;
	
	stTankValves				:	st_TankValves		;
	stLineSourceValves			:	st_LineSourceValves	;
	stTriBlenderSourceValves	:	st_LineSourceValves	;
	stLineTargetValves			:	st_LineTargetValves	;
	stfbTriBlenderTargetValves	:	st_LineTargetValves	;
	
	
	//valOutlet		: E_Pis_Name;//Comment?
	//valLine			: E_Pis_Name;//Comment?
	//valTriBlender	: E_Pis_Name;//Comment?
	//valDrain		: E_Pis_Name;//Comment?
	//valCIP			: E_Pis_Name;//Comment?
	
	valFillWater			: E_Pis_Name;
	valFillWaterDrain		: E_Pis_Name;
	valDrainTapWater		: E_Pis_Name;
	
	eTank_Name: E_Tank_Name;

	
	sens_TankTemp			: E_ASense_Name	;//Tenk temperature sensor ID
	
	valCW_In				:	E_Pis_Name	;//Valve to control tank temperature In
	valCW_Out				:	E_Pis_Name	;//Valve to control tank temperature Out (always at 100 open)
	
	//pumpEnum			:	E_Pump_List	;
	
END_VAR
VAR_OUTPUT
END_VAR
VAR
	refElement			: REFERENCE TO FB_Element;
	refState_Long		: REFERENCE TO E_Element_State_Long;
	eReq				: E_Request_List;		
	eProcess			: E_Element_Process;
	eStatus				: E_Element_State_Long; // for HMI only as status
	
	fbPis				: FB_Piston;	
	
	//stPis_FillWater			: REFERENCE TO ST_Piston;
	//stPis_FillWaterDrain		: REFERENCE TO ST_Piston;
	//stPis_DrainTapWater		: REFERENCE TO ST_Piston;
	
	stPis_CWIn				: REFERENCE TO ST_Piston;
	stPis_CWOut				: REFERENCE TO ST_Piston;
	
	bTestingMode	:	BOOL	;//For testing purposes, to be deleted 
	bMoveStep		:	BOOL	;//For testing purposes, to be deleted 
	
	Call_TON	:	TON	;//Call ton for double request same object
	bTON_Active	:	BOOL	;
	
	// Temperature process control
	pc_TempCntrl	: REFERENCE TO FB_ProcessControl	;
	st_TempCntrl	: REFERENCE TO ST_ProcessControl	;
	bCntrlTemp		: BOOL	;
	bRunCIP			: BOOL	;
	
	ref_fbTankSensors			: REFERENCE TO FB_TankSensors;
	stTank_Level				: ST_Tank_Level;

	//888888888888888888888888888888888888888888
	stProdParam		: ST_Production_Parameter;
	//888888888888888888888888888888888888888888
	tonStirrer_time: TON;
	rTest: REAL := 16;
	bStirrerDirectionPositive: BOOL;
	
	delta_Tank_Volume		: REAL;
	memo_Tank_Level_start	: REAL;
	bRunOffline: BOOL;
	
	event_state_Update: INT;

END_VAR
VAR_IN_OUT

	fbTarget				: FB_Tank_Target;
	fbLineSource			: FB_Line_Source;
	fbLineTarget			: FB_Line_Target;
	fbTriBlenderSource		: FB_Line_Source;
	fbTriBlenderTarget		: FB_Line_Target;
	
	fbInterConnection_TriB	: FB_InterConnection;
	fbInterConnection_ProL	: FB_InterConnection;

	

	fb_PumpLine				: FB_Pump;
	fb_PumpTriBlender		: FB_Pump;
	fb_Stirrer				: FB_Pump;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[act_GetReference();
act_Oper();
act_Call_Interface(); //There is no need to Call block if it comes from the outside
act_TempCntrl();

IF bTestingMode THEN;
	IF bMoveStep THEN;
		bMoveStep:=FALSE; 
	END_IF	
ELSE;
	bMoveStep:=TRUE; 
END_IF


IF stProdParam.bGetRecipe THEN;
	stProdParam.bGetRecipe:=FALSE;
	mGet_Recipe(indexRecipe:=stProdParam.hmiRecipeIndex+1);
END_IF
CASE eElementID	OF 
	E_Element_List.eTank_1,E_Element_List.eTank_2:;
		stProdParam.listRecipe:=g_Prod.listRecipe_Marinade;
	E_Element_List.eTank_3,E_Element_List.eTank_4:;
  		stProdParam.listRecipe:=g_Prod.listRecipe_Color;
END_CASE

stProdParam.timeRemainToStart:=mTimeRemainToStart();
stProdParam.timeProductionDuration:=mTimeProductionDuration();
refElement.ProdStatus:=stProdParam.eStatus;
m_Stirrer();
m_HMI();]]></ST>
    </Implementation>
    <Folder Name="Manage" Id="{4859bb81-2525-4c2b-a781-1bdd74a1527c}" />
    <Action Name="_aCheck_Condition_Prod_End_active" Id="{ea934447-c608-4b2d-8492-54e27aff23a1}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF fbInterConnection_ProL.bAvalableToDisconnect 
AND stProdParam.eStatus=E_Prod_Status.Active
