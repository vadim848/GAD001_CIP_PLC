    <Action Name="act_GetReference" Id="{441efe70-cf26-4ab6-bfdc-65d8c989c307}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[m_Set_SFCFlags_Reference();
refElement REF= fbElement[eElementID];
refState_Long REF= fbElement[eElementID].eState_Long;
//stPis_FillWater REF= stPis[valFillWater];
//stPis_FillWaterDrain REF= stPis[valFillWaterDrain];
//stPis_DrainTapWater REF= stPis[valDrainTapWater];

ref_fbTankSensors REF= g_Data.arrTanksSens[eTank_Name];
stTank_Level:=ref_fbTankSensors.get_stTankLevel();
fbTarget.set_TankLevel(set_stTankLevel:=stTank_Level);

stPis_CWIn REF= stPis[valCW_In];
stPis_CWOut	 REF= stPis[valCW_Out];

eStatus:=refState_Long;

//bRunCIP :=g_Data.b_CIP_Run;
bRunCIP := g_Data.fbElement[eElementID].m_Get_InterConnection() = E_InterConnection.ConnToCIP;
(*
stPis_Outlet		REF= g_Piston.stPis[valOutlet];
stPis_Line			REF= g_Piston.stPis[valOutlet];
stPis_TriBlender	REF= g_Piston.stPis[valOutlet];
stPis_Drain			REF= g_Piston.stPis[valOutlet];
stPis_CIP			REF= g_Piston.stPis[valOutlet];
*)]]></ST>
      </Implementation>
    </Action>
