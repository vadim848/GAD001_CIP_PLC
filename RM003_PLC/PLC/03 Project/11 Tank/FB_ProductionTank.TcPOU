    <Action Name="_aReady_active" Id="{86749ddf-3c7e-4ecc-9e5a-16e85de1cefc}">
      <Implementation>
        <ST><![CDATA[

CASE refElement.eState_Long OF
	E_Element_State_Long.eOff,E_Element_State_Long.eStandby:;
			IF eReq=E_Request_List.eDrain THEN;
				eProcess:=E_Element_Process.eDrain;
			END_IF

	E_Element_State_Long.eCIP_5_Done:;
			IF eReq=E_Request_List.eWaterPrepare THEN;
				eProcess:=E_Element_Process.eFill_Water;
			END_IF	
			
	E_Element_State_Long.eWaterReady:;
			IF eReq=E_Request_List.eDissolve THEN;
				eProcess:=E_Element_Process.eDissolving;
			END_IF	

	E_Element_State_Long.eReady:;
			IF eReq=E_Request_List.eProduction THEN;
				eProcess:=E_Element_Process.eConnectionToLine;
			END_IF	

	E_Element_State_Long.eProduction:;
			IF eReq=E_Request_List.eDisconnectTank THEN;
				eProcess:=E_Element_Process.eDisconnection;
			END_IF			

END_CASE
		
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
