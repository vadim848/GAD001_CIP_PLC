        <ST><![CDATA[bStepDone:=FALSE;
IF TRUE
AND fbTarget.m_CheckStatus(eReqStatus:=E_Tank_Target.eClose_DrainPipe) 
AND fbTriBlenderSource.m_CheckStatus(eReqStatus:=E_Line_Source.eDrain)
AND fbTriBlenderTarget.m_CheckStatus(eReqStatus:=E_Line_Target.eDrain)
AND fbTriBlender_Select.m_CheckStatus(eReqStatus:=E_TriBlenderSelect.eDrain)
AND (NOT fbInterConnection_TriB.bActive)
