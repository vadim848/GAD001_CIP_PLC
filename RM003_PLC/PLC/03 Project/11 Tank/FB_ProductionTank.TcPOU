VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TRUE THEN;
	
END_IF

event_state_Update:= TO_INT(eStatus) + TO_INT(stProdParam.eStatus) + TO_INT(eProcess);]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Set_SFCFlags_Reference" Id="{e572de0c-3d24-464d-bb17-5deb316affd4}" FolderPath="Manage\">
      <Declaration><![CDATA[METHOD m_Set_SFCFlags_Reference : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Set reference to SFC flags

refSFC.SFCInit REF= SFCInit;
refSFC.SFCReset REF= SFCReset;
refSFC.SFCError REF= SFCError;
refSFC.SFCEnableLimit REF= SFCEnableLimit;
refSFC.SFCErrorStep REF= SFCErrorStep;
refSFC.SFCErrorPOU REF= SFCErrorPOU;
refSFC.SFCQuitError REF= SFCQuitError;
refSFC.SFCPause REF= SFCPause;
refSFC.SFCTrans REF= SFCTrans;
refSFC.SFCCurrentStep REF= SFCCurrentStep;
refSFC.SFCTip REF= SFCTip;
refSFC.SFCTipMode REF= SFCTipMode;

// Cycle handle for SFC
m_SFC_Handle();]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Stirrer" Id="{1b833e49-1ddd-4651-b81e-debe24950272}" FolderPath="Manage\">
      <Declaration><![CDATA[METHOD m_Stirrer : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eStatus>=E_Element_State_Long.eCIP_5_Done THEN;
	IF stProdParam.eStatus=E_Prod_Status.Active THEN;
		IF fbInterConnection_TriB.bActive THEN;
			m_Stirrer_run(param:=stProdParam.stRecipe.StirrerDissolving);
		ELSIF fbInterConnection_ProL.bActive THEN;
			m_Stirrer_run(param:=stProdParam.stRecipe.StirrerProduction);
		ELSE;
			m_Stirrer_run(param:=stProdParam.stRecipe.StirrerStorage);
		END_IF
	ELSE;
		fb_Stirrer.m_Run(RPM:=stProdParam.stRecipe.StirrerStorage.Speed);
	END_IF
ELSIF refElement.m_Get_InterConnection()=E_InterConnection.ConnToCIP THEN;
	// controled by CIP
ELSE;
	fb_Stirrer.m_Stop();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Stirrer_run" Id="{307ad28f-b5d2-4fb4-8a9d-9a8b36372bf8}" FolderPath="Manage\">
      <Declaration><![CDATA[METHOD m_Stirrer_run : BOOL
VAR_INPUT
	param: ST_Prod_Param_Stirrer;
END_VAR

VAR
	time_on: TIME;
	time_off: TIME;
	time_cycle: TIME;
	
	dint_temp: DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[dint_temp:=param.tON*60000;
time_on:=TO_TIME(dint_temp);
dint_temp:=param.tOFF*60000;
time_off:=TO_TIME(dint_temp);
time_cycle:=time_on+time_off;
tonStirrer_time(PT:=time_cycle, IN:=NOT tonStirrer_time.Q);
IF tonStirrer_time.Q THEN;
	IF bStirrerDirectionPositive THEN;
		bStirrerDirectionPositive:=FALSE;
	ELSE;
		bStirrerDirectionPositive:=TRUE;
	END_IF
END_IF
CASE param.Mode OF 
	E_Stirrer_mode.continues:;
						fb_Stirrer.m_Run(RPM:=param.Speed);
	E_Stirrer_mode.cyclic:;
					IF tonStirrer_time.ET<time_on THEN;
						IF param.Flip_mode AND trn_Tank_Marinade THEN;
							IF bStirrerDirectionPositive THEN;
								fb_Stirrer.m_Run(RPM:=param.Speed);
							ELSE;
								fb_Stirrer.m_Run(RPM:=-param.Speed);
							END_IF							
						ELSE;
							fb_Stirrer.m_Run(RPM:=param.Speed);
						END_IF
						
					ELSE
						fb_Stirrer.m_Stop();
					END_IF
	E_Stirrer_mode.off:;
						fb_Stirrer.m_Stop();
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="mClearProduction" Id="{58c4c9c9-8cf2-41f1-b206-eaacde8cd18f}" FolderPath="Manage\">
      <Declaration><![CDATA[METHOD mClearProduction : BOOL
VAR_INPUT
	state: E_Element_State_Long:=E_Element_State_Long.eOff;

END_VAR

VAR
	stRecipeEmpty: ST_Prod_Recipe;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stProdParam.eStatus:=E_Prod_Status.Not_Active;
stProdParam.stRecipe:=stRecipeEmpty;
eReq:=E_Request_List.eNone;

IF state<>E_Element_State_Long.eOff THEN;
	refState_Long:=state;
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="mGet_Recipe" Id="{b8cd2ec5-ec05-4d19-a0b3-16991b77e5a1}" FolderPath="Manage\">
      <Declaration><![CDATA[METHOD mGet_Recipe : BOOL
VAR_INPUT
	indexRecipe: INT;

END_VAR

VAR
	i: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF indexRecipe <0 OR indexRecipe > g_Prod.cMax_Prod_Recipe THEN;
	RETURN;
END_IF

CASE eElementID	OF 
	E_Element_List.eTank_1,E_Element_List.eTank_2:;
		stProdParam.stRecipe:=g_Prod.arrRecipeMarinade[indexRecipe];
	E_Element_List.eTank_3,E_Element_List.eTank_4:;
  		stProdParam.stRecipe:=g_Prod.arrRecipeColor[indexRecipe];
END_CASE

FOR i:=1 TO g_Prod.cMaxCompInProduct DO
	stProdParam.arrWeightIng[i]:=stProdParam.stRecipe.arr_Component[i].rWeightPercentage/100 * stProdParam.WeightOrder;
	stProdParam.stRecipe.arr_Component[i].rWeight:=stProdParam.stRecipe.arr_Component[i].rWeightPercentage/100 * stProdParam.WeightOrder;
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="mTimeProductionDuration" Id="{b2a492d8-93d6-4df6-bd37-f2e46985a2d9}" FolderPath="Manage\">
      <Declaration><![CDATA[METHOD mTimeProductionDuration : TIME
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF dtRealTime > stProdParam.prodDT 
AND stProdParam.eStatus=E_Prod_Status.Active
THEN;
	mTimeProductionDuration:=dtRealTime - stProdParam.prodDT;
ELSE;
	mTimeProductionDuration:=T#0S;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="mTimeRemainToStart" Id="{7d6f306c-e772-4eb3-a87e-556a8ea27eb4}" FolderPath="Manage\">
      <Declaration><![CDATA[METHOD mTimeRemainToStart : TIME
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stProdParam.eStatus=E_Prod_Status.Activation_Pending_Shift THEN;
	stProdParam.eStatus:=E_Prod_Status.Activation_Pending;
	stProdParam.prodDT:=g_Prod.dtProdTimePicker+T#2h;
END_IF


IF stProdParam.eStatus=E_Prod_Status.Activation_Pending THEN;
	IF stProdParam.prodDT > dtRealTime THEN;
		mTimeRemainToStart:=stProdParam.prodDT - dtRealTime;
	ELSIF eStatus=E_Element_State_Long.eCIP_5_Done THEN;
		stProdParam.eStatus:=E_Prod_Status.Active;
		eReq:=E_Request_List.eWaterPrepare;
	END_IF
ELSE;
	mTimeRemainToStart:=T#0S;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Transition Name="trn_Tank_A" Id="{7f0e7518-f66a-4b4a-b16b-a3f65f501415}">
