      <Implementation>
        <ST><![CDATA[fb_PumpTriBlender.m_Stop();
fbTarget.m_Run(eReqProc:=E_Tank_Target.eClose_DrainPipe);
fbTriBlenderSource.m_Run(eReqProc:=E_Line_Source.eDrain);
fbTriBlenderTarget.m_Run(eReqProc:=E_Line_Target.eDrain);
fbTriBlender_Select.m_Set_Request(eSetReg:=E_TriBlenderSelect.eDrain);
fbInterConnection_TriB.reqDisconnect:=TRUE;
fbDissolving.mResetCycle();
]]></ST>
