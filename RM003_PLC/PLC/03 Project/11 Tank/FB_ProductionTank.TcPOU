    <Action Name="_aInit_Production_Line_entry" Id="{7623fe03-ad8a-4fe3-b8ee-3df8e1092a34}">
      <Implementation>
        <ST><![CDATA[IF refState_Long<>E_Element_State_Long.eProduction THEN;	
	fb_PumpLine.m_Stop();
	fbTarget.m_Run(eReqProc:=E_Tank_Target.eClose_DrainPipe);
	fbLineSource.m_Run(eReqProc:=E_Line_Source.eDrain);
	fbLineTarget.m_Run(eReqProc:=E_Line_Target.eDrain);
	fbInterConnection_ProL.reqDisconnect:=TRUE;
END_IF
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
