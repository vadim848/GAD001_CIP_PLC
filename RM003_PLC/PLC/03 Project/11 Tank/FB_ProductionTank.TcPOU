  <POU Name="FB_ProductionTank" Id="{7ce7ab69-2020-4b39-9932-dc5de2cb0022}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ProductionTank EXTENDS FB_SFC_Cycle IMPLEMENTS ITF_FB_SFC_Cycle
VAR_INPUT
	eElementID			: E_Element_List;
END_VAR
VAR_OUTPUT
END_VAR
VAR
	refElement			: REFERENCE TO FB_Element;
	refState_Long		: REFERENCE TO E_Element_State_Long;
	eReq				: E_Request_List;
	eProcess			: E_Element_Process;	
	
	fbTarget			: FB_Tank_Target;

END_VAR
VAR_IN_OUT
	valOutlet		: ST_Piston;
	valLine			: ST_Piston;
	valTriBlender	: ST_Piston;
	valDrain		: ST_Piston;
	valCIP			: ST_Piston;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[act_GetReference();
act_Oper();
act_Call_Interface();]]></ST>
    </Implementation>
