    <Action Name="_aInit_Base_entry" Id="{7eb9d8e6-0b86-4869-b8a2-92e36347cd42}">
      <Implementation>
        <ST><![CDATA[IF refState_Long<>E_Element_State_Long.eProduction THEN;	
	fb_PumpLine.m_Stop();
	fbTarget.m_Run(eReqProc:=E_Tank_Target.eClose_DrainPipe);
END_IF
]]></ST>
      </Implementation>
