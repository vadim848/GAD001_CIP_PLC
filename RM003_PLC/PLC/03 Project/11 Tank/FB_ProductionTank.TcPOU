    <Action Name="_aCollect_From_Prod_Line_active" Id="{771b979b-2440-42f1-b9e3-8aa05f11371c}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
delta_Tank_Volume:=ref_fbTankSensors.volume-memo_Tank_Level_start;
IF FALSE 
OR delta_Tank_Volume>=stProdParam.stRecipe.Weight_to_Collect
OR Collect_From_Prod_Line.t>=T#40S
THEN;
	bStepDone:=TRUE;
END_IF]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
