    <Action Name="DefaultCommand_Entry" Id="{fdc9c316-7914-4767-bd3f-eeabdb22e4ed}" FolderPath="Piston\">
      <Implementation>
        <ST><![CDATA[	(*FOR Pis:=1 TO 24 BY 1 DO
		db_Lat[Pis].req_DefaultPos:=TRUE;
	END_FOR*)
	
	FOR Pis:=1 TO C_Max_Pistons BY 1 DO
		IF db_Pis[Pis].b_PistonActive THEN;
			db_Pis[Pis].req_Init:=TRUE;
		END_IF		
	END_FOR]]></ST>
      </Implementation>
    </Action>
    <Action Name="GeneralDone_Action" Id="{4ae0d015-5eba-445b-b0a9-b27b0373604b}" FolderPath="General\">
      <Implementation>
        <ST><![CDATA[init_General:=FALSE;
bGeneralDone:=TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="InitAllPistons_entry" Id="{a53759c3-dcb0-4bf9-85b7-1602b3b3a1ff}" FolderPath="Piston\">
      <Implementation>
        <ST><![CDATA[prg_Pistons.bInitAllPiston:=TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="InitGeneral_Action" Id="{eaf7217d-7f1e-4ed4-86e4-c1ca1deb192f}" FolderPath="General\">
      <Implementation>
        <ST><![CDATA[SFCReset:=FALSE;

init_AllPiston   :=FALSE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="InitPiston_Exit" Id="{81262ffa-94cd-4f77-9823-01220b89dabe}" FolderPath="Piston\">
      <Implementation>
        <ST><![CDATA[	b_AllPisInitPos:=FALSE;
	bPistonDone:=FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="InitPistonDone_Exit" Id="{cb2326a3-f022-4764-85dc-08418fc4a3b0}" FolderPath="Piston\">
      <Implementation>
        <ST><![CDATA[	init_AllPiston:=FALSE;
	bPistonDone:=TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="InitPosCheck_Action" Id="{e21c5f29-a93c-4aed-a871-e52f1086b9f9}" FolderPath="Piston\">
      <Implementation>
        <ST><![CDATA[			c_PisInitCheck:=0;
	FOR Pis:=1 TO C_Max_Pistons BY 1 DO
		IF fb_Pis[Pis].SFCCurrentStep<>'Ready' AND fb_Pis[Pis].SFCCurrentStep<>''THEN
			c_PisInitCheck:=c_PisInitCheck+1;
		END_IF
	END_FOR

			c_PisResetCleare:=0;
	FOR Pis:=1 TO C_Max_Pistons BY 1 DO
		IF db_Pis[Pis].b_Reset THEN
			c_PisResetCleare:=c_PisResetCleare+1;
		END_IF
	END_FOR

	(*		c_LatInitCheck:=0;
	FOR Pis:=1 TO 24 BY 1 DO
		IF fb_Lat[Pis].SFCCurrentStep<>'Ready' AND fb_Lat[Pis].SFCCurrentStep<>'' THEN
			c_LatInitCheck:=c_LatInitCheck+1;
		END_IF
	END_FOR*)


		IF 	c_PisInitCheck=0  AND c_LatInitCheck=0 (*AND 	c_PisResetCleare=0*) THEN
			b_AllPisInitPos:=TRUE;
		ELSE
			b_AllPisInitPos:=FALSE;
		END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="PistonInitCMD_Entry" Id="{630e0a63-f239-4dbc-8c6a-f04b1ad153af}" FolderPath="General\">
      <Implementation>
        <ST><![CDATA[init_AllPiston:=TRUE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="PistonInitCMD_exit" Id="{64c55cf3-63af-406c-b170-3461aabacc57}" FolderPath="General\">
      <Implementation>
        <ST><![CDATA[Global_Variables.ResumeAll :=TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Ready_Action" Id="{92f1df72-5324-423e-8850-d013024f6f59}" FolderPath="General\">
      <Implementation>
        <ST><![CDATA[IF TRUE
AND	bPistonDone
(*AND	b_StationDone
AND	bLoadConvDone
AND	bUnloadConvDone
AND	bTableDone
AND (bManipulatorDone OR NOT b_ManipulatorExist)
AND	(bStackerDone OR NOT b_StackerExist)*)
THEN
	bGeneralDone:=TRUE;

ELSE
	bGeneralDone:=FALSE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Ready_Exit" Id="{60c681e3-4bcf-4070-ae7f-84b907b0ee02}" FolderPath="General\">
      <Implementation>
        <ST><![CDATA[bGeneralDone:=FALSE;
bPistonDone:=FALSE;
b_StationDone:=FALSE;
bLoadConvDone:=FALSE;
bUnloadConvDone:=FALSE;
bTableDone:=FALSE;
bStackerDone:=FALSE;

bManipulatorDone:=FALSE; //shachar
iResumeCount:=0;]]></ST>
      </Implementation>
    </Action>
    <Action Name="ResetOldCommand_Entry" Id="{6847173e-ff86-4ed0-a862-24256ccb17c1}" FolderPath="Piston\">
      <Implementation>
        <ST><![CDATA[	(*FOR Pis:=1 TO 24 BY 1 DO
		db_Lat[Pis].req_Reset:=TRUE;
	END_FOR*)
	FOR Pis:=1 TO C_Max_Pistons BY 1 DO
		db_Pis[Pis].b_Reset:=TRUE;
	END_FOR]]></ST>
      </Implementation>
    </Action>
    <Action Name="ResumeErrors_Entry" Id="{655a0cf4-61f8-4a22-8784-f3b9adc39cbe}" FolderPath="Piston\">
      <Implementation>
        <ST><![CDATA[	(*FOR Pis:=1 TO 24 BY 1 DO
		db_Lat[Pis].req_Resume:=TRUE;
	END_FOR*)
	FOR Pis:=1 TO C_Max_Pistons BY 1 DO
		db_Pis[Pis].b_Resume:=TRUE;
	END_FOR]]></ST>
      </Implementation>
    </Action>
