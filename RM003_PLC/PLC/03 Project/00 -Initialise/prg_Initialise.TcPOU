    <Action Name="act_GetErrorID" Id="{d06921cf-a63e-4173-a9f9-7618dff90d12}" FolderPath="General\">
      <Implementation>
        <ST><![CDATA[IF ErrorSFC THEN;
	// Initialization
	IF    Last_SFCErrorStep='WatingForEmergencyOK' 			THEN sActErrorID:='001';
	ELSIF Last_SFCErrorStep='WatingForInterlockOK' 		    THEN sActErrorID:='002';
	ELSIF Last_SFCErrorStep='WatingForMotorsOK' 			THEN sActErrorID:='003';
	ELSIF Last_SFCErrorStep='CheckInitStationDone' 			THEN sActErrorID:='004';
	ELSIF Last_SFCErrorStep='Station_Initialization' 		THEN sActErrorID:='005';
	ELSIF Last_SFCErrorStep='Loader_Initialization' 		THEN sActErrorID:='006';
	ELSIF Last_SFCErrorStep='Unload_Station' 			    THEN sActErrorID:='007';
	ELSIF Last_SFCErrorStep='Measuring_Station' 			THEN sActErrorID:='008';
	ELSIF Last_SFCErrorStep='Gripper_Oriantation' 			THEN sActErrorID:='009';
	ELSIF Last_SFCErrorStep='Index_Homming' 			    THEN sActErrorID:='010';
	ELSIF Last_SFCErrorStep='PaletBypasCheck_1' 			THEN sActErrorID:='011';
	ELSIF Last_SFCErrorStep='PaletCheck_1' 			        THEN sActErrorID:='012';
	ELSIF Last_SFCErrorStep='Cover_Station' 			    THEN sActErrorID:='023';	
	ELSE;
		 sActErrorID:='999';
	END_IF
//ELSIF bWarning THEN;
	// Leave the warning message to print
ELSE;
		 sActErrorID:='000';
END_IF
//*** Error Format ***
fbFormatString(
	sFormat:= '%.3sx%.3sx%.3s', 
	arg1:= F_STRINGEx(sFB_ID), 
	arg2:= F_STRINGEx(sFB_Num), 
	arg3:= F_STRINGEx(sActErrorID), 
	sOut=>sFullErrorId );
	
//(*Clean Last ErrID*)IF NOT SFCPause THEN	sFullErrorId:='';END_IF]]></ST>
      </Implementation>
    </Action>
