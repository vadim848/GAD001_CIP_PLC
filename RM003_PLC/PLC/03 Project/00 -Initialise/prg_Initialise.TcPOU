<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="prg_Initialise" Id="{547dfe07-e15f-49a5-8906-1a326ec23637}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM prg_Initialise
VAR_INPUT
	ResumeSFC       : BOOL; 		(*	not automatic	*)
	//Added SFC Cycle handle Variables
	
	SFCInit             : BOOL;  //shachar
END_VAR

VAR


(* 8888888888888888   SFC   8888888888888888888888*)
	sCycleName	        : STRING;
	SFCCurrentStep      : STRING;
	SFCErrorPOU         : STRING;
	SFCErrorStep        : STRING;
	SFCError            : BOOL;
	SFCPause            : BOOL;
	
	SFCTipMode          : BOOL;
	SFCTip              : BOOL;
	SFCEnableLimit		: BOOL:=TRUE;
	// Reset Error
	SFCReset			: BOOL;
	ErrorSFC            : BOOL; 	(*	not automatic	*)

	ResetError          : BOOL; 	(*	not automatic	*)
	Last_SFCErrorStep   : STRING; 	(*	not automatic	*)
	//ErrorToPrint        : STRING; 	(*	not automatic	*)
	//Last_ErrorToPrint   : STRING; 	(*	not automatic	*)

 //   stSafety			:ST_BasicCycle;  //shachar
(* 8888888888888888   SFC   8888888888888888888888*)




	Pis             : INT;
	c_PisInitCheck  : INT;
	b_AllPisInitPos : BOOL;

	i               : INT;
	c_LatInitCheck  : INT;

	c_PisResetCleare: INT;

	k               : INT;

	bGeneralDone    : BOOL;
	bPistonDone     : BOOL;
	b_StationDone   : BOOL;
	bLoadConvDone   : BOOL;
	bUnloadConvDone : BOOL;
	bTableDone      : BOOL;
	bStackerDone    : BOOL;
    bManipulatorDone: BOOL;

	init_General    : BOOL;
	init_AllPiston  : BOOL;
	init_AllStation : BOOL;
	init_Table      : BOOL;
	init_LoadConv   : BOOL;
	init_UnloadConv : BOOL;
	init_Stacker    : BOOL;
	init_Manipulator: BOOL;

	bMessLoadInit   : BOOL;
	bMessUnloadInit : BOOL;
	
	sFB_ID          : STRING(4):='004';
	sFB_Num         : STRING(4):='000';
	sActErrorID     : STRING;
	//Added SFC Cycle handle Variables
	fb_SFC_Cycle		    : FB_SFC_Cycle;
	fbFormatString	    	: FB_FORMATSTRING;
	sFullErrorId		    : STRING(12);//sAAAxBBBxEEE
	bReset					: BOOL;

	bIntZoneOk: BOOL;
	bNotPrepare: BOOL;
	p_ManipReset: POINTER TO BOOL;
	p_PowerMotorOn: POINTER TO BOOL;
	p_SafetyStart: POINTER TO BOOL;
   // fbPowerMotorOn			:FB_PowerMotorOn;

	IndexOn: BOOL;
	LoadOn: BOOL;
	UnloadOn: BOOL;
	ManipOn: BOOL;
	p_PowerMotorPower: POINTER TO BOOL;
	p_PowerMotorOff: POINTER TO BOOL;
	iResumeCount: INT;
	iIndexCount: INT;
	iLoadCount: INT;
	iUnloadCount: INT;
	iManipCount: INT;
	p_ManipResume: POINTER TO BOOL;
END_VAR

VAR_IN_OUT
	stOperation	: ST_OperationButtons;	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[act_General();
act_Piston();
act_GetErrorID();
fb_SFC_Cycle
( 
	sCycleName:= 'Initialize', 
	bSFCError:= SFCError, 
	sSFCCurrentStep:=SFCCurrentStep , 
	sSFCErrorStep:= SFCErrorStep, 
	sSFCErrorPOU:=SFCErrorPOU , 
	sActErrorID:=sFullErrorId,
	sFB_ModuleDescription:= fb_SFC_Cycle.sCycleName, 
	sLast_SFCErrorStep=>Last_SFCErrorStep , 
	bErrorSFC_Occured=> ErrorSFC, 
	//sErrorToPrint=>ErrorToPrint , 
	//sLast_ErrorToPrint=>Last_ErrorToPrint,
    bSFCInit=>SFCInit , 
	stOperation:= stOperation,
	bResumeSFC:=ResumeSFC , 
	bResetError:=ResetError , 
	bSFCPause:= SFCPause, 
	bResetCycle:=SFCReset
);



IF NOT bStateSafe	
OR init_AllPiston
THEN;
	bGeneralDone:=FALSE;
	bPistonDone:=FALSE;
	b_StationDone:=FALSE;
	bLoadConvDone:=FALSE;
	bUnloadConvDone:=FALSE;
	bTableDone:=FALSE;
	bStackerDone:=FALSE;
	bManipulatorDone:=FALSE;  //shachar
END_IF
]]></ST>
    </Implementation>
