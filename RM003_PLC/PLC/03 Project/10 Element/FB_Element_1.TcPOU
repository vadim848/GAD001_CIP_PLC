    <Action Name="act_StateChange_WatchGog" Id="{c16d49dc-334d-49fe-813a-17142978f429}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[IF eState_Long<>eState_Long_last THEN;
	eState_Long_last:=eState_Long;
	stStateChange:=stSystemTime;
END_IF

sState_Time:=prg_RealClock.m_DeltaTime(stStartTime:=stStateChange);]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_StateMachine" Id="{b706c936-cbcf-4a3a-9be1-20180bdd8aa1}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[

CASE eState_Long OF
	E_Element_State_Long.eOff,
	E_Element_State_Long.eStandby,
	E_Element_State_Long.eNotClean,
	E_Element_State_Long.eCIP_1_Rinzed,
	E_Element_State_Long.eCIP_2_Deterged,
	E_Element_State_Long.eCIP_3_Deterged_Clean,	
	E_Element_State_Long.eCIP_4_Sanitized:;
				eState_Short:=E_Element_State_Short.eNotClean;

	E_Element_State_Long.eCIP_5_Done,	
	E_Element_State_Long.eWaterReady:;	
				eState_Short:=E_Element_State_Short.eClean;

	E_Element_State_Long.eReady,
	E_Element_State_Long.eProduction,
	E_Element_State_Long.eEmpty,	
	E_Element_State_Long.eExpired:;
				eState_Short:=E_Element_State_Short.eProduct;
	
END_CASE

]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_Tank" Id="{6200ac69-7f3b-413b-a098-3397c80ffe69}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[act_Oper_Tank();]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_TriBlender" Id="{16b91cbd-73ec-4a6a-930a-0161124493e4}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[IF eInterConnect=E_InterConnection.ConnToCIP 
AND eElementID=E_Element_List.eTriBlender_Marinada
AND eTriBlenderPipe<>E_TriBlenderPipe.eMarinada
THEN;
	bError:=TRUE;
ELSE;
	bError:=FALSE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_Disconnect" Id="{f6370718-b114-4e04-a5b7-17ebbef5b212}">
      <Declaration><![CDATA[METHOD m_Disconnect : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eInterConnect:=E_InterConnection.NotConnected;
//bInterConnectedToLine:=FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_InterConnect" Id="{297c1053-5f16-4296-99d3-3cca348c0902}">
      <Declaration><![CDATA[METHOD m_InterConnect : BOOL
VAR_INPUT
	value: E_InterConnection;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eInterConnect:=value;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_InterConnected_State" Id="{47b4c791-7b17-48f2-9da1-481769db6a71}">
      <Declaration><![CDATA[METHOD m_InterConnected_State : BOOL
VAR_INPUT
	eState_Long_Set			: E_Element_State_Long;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF eState_Long_Set>eState_Long 
OR eState_Long_Set=E_Element_State_Long.eNotClean
THEN;
	eState_Long:=eState_Long_Set;
END_IF


]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Set_SFCFlags_Reference" Id="{843fc4cc-8e41-43dd-8aa7-4e962c29228c}">
      <Declaration><![CDATA[{warning 'add method implementation '}
METHOD m_Set_SFCFlags_Reference : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Set reference to SFC flags

refSFC.SFCInit REF= SFCInit;
refSFC.SFCReset REF= SFCReset;
refSFC.SFCError REF= SFCError;
refSFC.SFCEnableLimit REF= SFCEnableLimit;
refSFC.SFCErrorStep REF= SFCErrorStep;
refSFC.SFCErrorPOU REF= SFCErrorPOU;
refSFC.SFCQuitError REF= SFCQuitError;
refSFC.SFCPause REF= SFCPause;
refSFC.SFCTrans REF= SFCTrans;
refSFC.SFCCurrentStep REF= SFCCurrentStep;
//refSFC.SFCTip REF= SFCTip;
//refSFC.SFCTipMode REF= SFCTipMode;

// Cycle handle for SFC
m_SFC_Handle();]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_StateUpdate_Limit" Id="{100144a5-3c55-4e4c-8c08-914b0d81d778}">
      <Declaration><![CDATA[METHOD m_StateUpdate_Limit : BOOL
VAR_INPUT
	value: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF value THEN;
	bStataUpdate_Limited:=TRUE;
ELSE;
	bStataUpdate_Limited:=FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
