      <Declaration><![CDATA[METHOD m_Get_CIP_Avilable : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TRUE 
AND (eInterConnect=E_InterConnection.NotConnected OR eInterConnect=E_InterConnection.ConnToCIP)
AND TRUE
THEN;
	m_Get_CIP_Avilable:=TRUE;
ELSE;
	m_Get_CIP_Avilable:=FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
