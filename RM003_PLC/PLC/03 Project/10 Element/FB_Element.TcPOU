    </Property>
    <Method Name="m_Disconnect" Id="{20e4c919-f24b-4fbd-ae5c-73c93cc7bd42}">
      <Declaration><![CDATA[METHOD m_Disconnect : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eInterConnect:=E_InterConnection.NotConnected;
CASE eType OF
	E_Element_Type.eTank:;					
			//
	E_Element_Type.eTriBlender,
	E_Element_Type.eLine:;
			tsProductionLineStby:=stSystemTime;
END_CASE
]]></ST>
      </Implementation>
    </Method>
