      <Set Name="Set" Id="{79374df6-a9bd-428c-a0c7-b15c90bc1b1d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[
CASE eState_Long OF 
	E_Element_State_Long.eOff..			
	E_Element_State_Long.eCIP_5_Done:;
				tsStateChange:=StateTime;
				
				
	//E_Element_State_Long.eOff:;
	//E_Element_State_Long.eOff:;
	//E_Element_State_Long.eOff:;
	
END_CASE

]]></ST>
