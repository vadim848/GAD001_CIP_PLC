    </Method>
    <Method Name="m_TimeToExperation" Id="{b592f2a7-8b80-4b25-9040-91bd7248992a}">
      <Declaration><![CDATA[METHOD m_TimeToExperation : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF tExperationTime>tStateTime THEN;
	tTimeToExperation:=tExperationTime-tStateTime;
ELSE;
	tTimeToExperation:=T#0S;
END_IF

]]></ST>
      </Implementation>
    </Method>
