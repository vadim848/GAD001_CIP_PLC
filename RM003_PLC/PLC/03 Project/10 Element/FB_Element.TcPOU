IF eState_Long_Set>eState_Long 
OR eState_Long_Set=E_Element_State_Long.eNotClean
THEN;
	eState_Long:=eState_Long_Set;
END_IF
*)
eState_Long:=eState_Long_Set;

]]></ST>
      </Implementation>
    </Method>
