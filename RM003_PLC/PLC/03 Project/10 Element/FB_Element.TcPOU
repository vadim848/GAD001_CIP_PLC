<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Element" Id="{700358c5-37aa-4b9c-88fa-65bcc8fcf7eb}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Element// EXTENDS FB_SFC_Cycle IMPLEMENTS ITF_FB_SFC_Cycle
VAR_INPUT
	eElementID			: E_Element_List;

END_VAR
VAR_OUTPUT
	event_StateUpdate	: INT; // for HMI
END_VAR



VAR
	eType				: E_Element_Type;
	eProdType			: E_Product_Type;
	eState_Long			: E_Element_State_Long;
	eState_Short		: E_Element_State_Short;
	eState_Long_last	: E_Element_State_Long;





	i: INT;
	sState_Time			: STRING;
	sTimeToExparation	: STRING;
	tTimeToExperation	: TIME;
	tStateTime			: TIME;

	
	sElementID			: STRING;
	eInterConnect		: E_InterConnection;
	bStataUpdate_Limited: BOOL;
	memoDissolving_active: BOOL;


	stCIP_Request		: ST_CIP_Request;
	stCIP_RequestActive	: ST_CIP_Request;

	bTakePosInCIPBuffer_Partial: BOOL;
	bTakePosInCIPBuffer_Full: BOOL;
	bTakePosInCIPBuffer_Detergent: BOOL;
	bError: BOOL;	
	
	eProdStatus: E_Prod_Status;
	
	fbEvent_echo: FB_Event_echo;

END_VAR

VAR PERSISTENT
	stStateChange		: TimeStruct;
	tExperationTime		: TIME:=T#48H;

END_VAR


VAR_IN_OUT
	stOperation		: ST_OperationButtons;	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[i:=i+1;
//m_Set_SFCFlags_Reference();
//SUPER^();
fbEvent_echo(echo=>event_StateUpdate);
act_StateMachine();
act_StateChange_WatchGog();

sElementID:=TO_STRING(eElementID);

CASE eType OF 
	E_Element_Type.eTank:;
				act_Tank();
	E_Element_Type.eTriBlender:;
				act_TriBlender();
	E_Element_Type.eLine:;
				act_Line();

END_CASE

CASE eElementID OF
	E_Element_List.eTank_1:;
				eType:=E_Element_Type.eTank;
				eProdType:=E_Product_Type.Marinada;
				stCIP_Request.eClient:=E_CIP_Usage.eTank_1;
	E_Element_List.eTank_2:;
				eType:=E_Element_Type.eTank;
				eProdType:=E_Product_Type.Marinada;
				stCIP_Request.eClient:=E_CIP_Usage.eTank_2;
	E_Element_List.eTank_3:;
				eType:=E_Element_Type.eTank;
				eProdType:=E_Product_Type.Color;
				stCIP_Request.eClient:=E_CIP_Usage.eTank_3;
	E_Element_List.eTank_4:;
				eType:=E_Element_Type.eTank;
				eProdType:=E_Product_Type.Color;
				stCIP_Request.eClient:=E_CIP_Usage.eTank_4;
	E_Element_List.eTriBlender_Marinada:;
				eType:=E_Element_Type.eTriBlender;
				eProdType:=E_Product_Type.Marinada;		
				stCIP_Request.eClient:=E_CIP_Usage.eTriBlender_Marinada;
	E_Element_List.eTriBlender_Color:;
				eType:=E_Element_Type.eTriBlender;
				eProdType:=E_Product_Type.Color;
				stCIP_Request.eClient:=E_CIP_Usage.eTriBlender_Color;
	E_Element_List.eLine_Marinada:;
				eType:=E_Element_Type.eLine;
				eProdType:=E_Product_Type.Marinada;
				stCIP_Request.eClient:=E_CIP_Usage.eLine_Marinada;
	E_Element_List.eLine_Color:;
				eType:=E_Element_Type.eLine;
				eProdType:=E_Product_Type.Color;
				stCIP_Request.eClient:=E_CIP_Usage.eLine_Color;
END_CASE


IF bTakePosInCIPBuffer_Partial THEN;
	stCIP_Request.eType:=E_CIP_Type.R_Water;
	fbCIP.m_TakePosInCIPBuffer(stCIP_Request:=stCIP_Request);
	bTakePosInCIPBuffer_Partial:=FALSE;
END_IF

IF bTakePosInCIPBuffer_Detergent THEN;
	stCIP_Request.eType:=E_CIP_Type.Detergent;
	fbCIP.m_TakePosInCIPBuffer(stCIP_Request:=stCIP_Request);
	bTakePosInCIPBuffer_Detergent:=FALSE;
END_IF

IF bTakePosInCIPBuffer_Full THEN;
	stCIP_Request.eType:=E_CIP_Type.Full;
	fbCIP.m_TakePosInCIPBuffer(stCIP_Request:=stCIP_Request);
	bTakePosInCIPBuffer_Full:=FALSE;
END_IF

stCIP_RequestActive.eType:=E_CIP_Type.NotSelected;
FOR i:=0 TO 9 DO
	IF arCIP_RequestBufer[i].eClient=stCIP_Request.eClient
	AND arCIP_RequestBufer[i].eType>stCIP_RequestActive.eType THEN;
		stCIP_RequestActive.eType:=arCIP_RequestBufer[i].eType;
	END_IF
END_FOR

m_TimeToExperation();
]]></ST>
    </Implementation>
    <Folder Name="Manage" Id="{c1bad6aa-d321-46fa-921e-00f6b446e0b8}" />
    <Action Name="act_Line" Id="{7224f2cd-9678-4b86-88f6-72fd19bfe71e}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_StateChange_WatchGog" Id="{4dafd2ba-8022-4674-a1d5-a6952dfd70bd}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[IF eState_Long<>eState_Long_last THEN;
	eState_Long_last:=eState_Long;
	stStateChange:=stSystemTime;
	fbEvent_echo.event(); // for HMI
END_IF

tStateTime:=TO_TIME(SYSTEMTIME_TO_DT(stSystemTime)-SYSTEMTIME_TO_DT(stStateChange));

sState_Time:=prg_RealClock.m_DeltaTime(stStartTime:=stStateChange);
sTimeToExparation:=prg_RealClock.mTime_to_String_HMI(tInputTime:=tTimeToExperation, iSecondDisplay:=TRUE);

sState_Time:= CONCAT(sState_Time, '(');
sState_Time:= CONCAT(sState_Time, sTimeToExparation);
sState_Time:= CONCAT(sState_Time, ')');

]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_StateMachine" Id="{f33c6159-2800-4ae4-981a-4a8c5e4774dd}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[

CASE eState_Long OF
	E_Element_State_Long.eOff,
	E_Element_State_Long.eStandby,
	E_Element_State_Long.eNotClean,
	E_Element_State_Long.eCIP_1_Rinzed,
	E_Element_State_Long.eCIP_2_Deterged,
	E_Element_State_Long.eCIP_3_Deterged_Clean,	
	E_Element_State_Long.eCIP_4_Sanitized:;
				eState_Short:=E_Element_State_Short.eNotClean;

	E_Element_State_Long.eCIP_5_Done:;
				eState_Short:=E_Element_State_Short.eClean;
					memoDissolving_active:=FALSE;
	E_Element_State_Long.eWaterReady:;	
				IF memoDissolving_active THEN;
					eState_Short:=E_Element_State_Short.eProduct;
				ELSE;
					eState_Short:=E_Element_State_Short.eClean;
				END_IF
	E_Element_State_Long.eReady,
	E_Element_State_Long.eProduction,
	E_Element_State_Long.eEmpty,	
	E_Element_State_Long.eExpired:;
				eState_Short:=E_Element_State_Short.eProduct;
	
END_CASE

]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_Tank" Id="{2dddeb0d-68bf-4477-8840-0824af0883b1}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[;]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_TriBlender" Id="{26031c10-f211-4816-a500-dc05d95c74de}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[(*
IF eInterConnect=E_InterConnection.ConnToCIP 
AND eElementID=E_Element_List.eTriBlender_Marinada
AND eTriBlenderPipe<>E_TriBlenderPipe.eMarinada
THEN;
	bError:=TRUE;
ELSE;
	bError:=FALSE;
END_IF
*)]]></ST>
      </Implementation>
    </Action>
