    <Method Name="m_Get_TimeToExpirationMode" Id="{d304daf3-a250-4e31-b078-0f17be3d063d}">
      <Declaration><![CDATA[METHOD m_Get_TimeToExpirationMode : TIME
VAR_INPUT
	eExTime_check		: E_ExTime;
END_VAR

VAR
	tsStateChange_local				: TimeStruct;
	tModeTime		: TIME;
	tModeDuration	: TIME;

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eExTime_check OF
	E_ExTime.eCIP:;
			tsStateChange_local:=tsCIP;
			tModeDuration:=ExDuration_Default;
	E_ExTime.eWater:;
			tsStateChange_local:=tsWater;
			tModeDuration:=ExDuration_Water;
	E_ExTime.eProduct:;
			tsStateChange_local:=tsProduction;	
			tModeDuration:=ExDuration_Product;
	E_ExTime.eLine :;
			tsStateChange_local:=tsProductionLine;
			tModeDuration:=ExDuration_Default_Line;
	E_ExTime.eLineStby:;
			tsStateChange_local:=tsProductionLineStby;
			tModeDuration:=ExDuration_Default_LineStandby;
END_CASE
tModeTime:=TO_TIME(SYSTEMTIME_TO_DT(stSystemTime)-SYSTEMTIME_TO_DT(tsStateChange_local));
m_Get_TimeToExpirationMode:=tModeDuration-tModeTime;


]]></ST>
      </Implementation>
    </Method>
