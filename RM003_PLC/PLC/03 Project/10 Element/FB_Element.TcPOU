        <ST><![CDATA[m_Get_Type:=eType;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_InterConnect" Id="{72ff53e2-bb5f-4090-a2e6-ef10be06eb5a}">
      <Declaration><![CDATA[METHOD m_InterConnect : BOOL
VAR_INPUT
	value: E_InterConnection;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eInterConnect=E_InterConnection.NotConnected 
OR eInterConnect=value
THEN;
	eInterConnect:=value;
	m_InterConnect:=TRUE;
ELSE;
	m_InterConnect:=FALSE;
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_InterConnected_State" Id="{c4bb22d1-79f1-477b-b979-1591791ba3b1}">
      <Declaration><![CDATA[METHOD m_InterConnected_State : BOOL
VAR_INPUT
	eState_Long_Set			: E_Element_State_Long;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF (eState_Long_Set>eState_Long 
OR eState_Long_Set=E_Element_State_Long.eNotClean)
AND eState_Long_Set<=E_Element_State_Long.eProduction
THEN;
	eState_Long:=eState_Long_Set;
END_IF


]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Set_Dissolveng_active_memo" Id="{55ab6cb4-4a2f-4aab-971f-9547041e4c7f}">
      <Declaration><![CDATA[METHOD m_Set_Dissolveng_active_memo : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT memoDissolving_active THEN;
	
	
	IF eInterConnect=E_InterConnection.ConnToTank THEN;
		tsProductionLine:=stSystemTime;
	ELSE; //element is production tank
		tsProduction:=stSystemTime;
	END_IF
	
END_IF
memoDissolving_active:=TRUE;
fbEvent_echo.event();]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Set_ExpirationDuration" Id="{d852322c-ba1c-43fa-ac6b-bcfdfd4889f5}" FolderPath="Manage\">
      <Declaration><![CDATA[METHOD m_Set_ExpirationDuration : BOOL
VAR_INPUT
	eExTime_set		: E_ExTime;
	setTime			: TIME;

END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eExTime_set OF
	E_ExTime.eCIP:;
			
	E_ExTime.eWater:;
			ExDuration_Product:=setTime;
			m_Set_ExpirationDuration:=TRUE;
	E_ExTime.eProduct:;
			ExDuration_Product:=setTime;	
			m_Set_ExpirationDuration:=TRUE;
	E_ExTime.eLine :;
			
	E_ExTime.eLineStby:;
			
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Set_Oper_Pause" Id="{31bfa777-0c86-4838-93b6-ec28e092b686}">
      <Declaration><![CDATA[METHOD m_Set_Oper_Pause
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stOperation.iActOperation<>E_OperationButtons.ePauseAll THEN;
	stOperation.bSetPause:=TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Set_Oper_Play" Id="{6a6aba07-12dd-441c-945b-5a5009b81ef4}">
      <Declaration><![CDATA[METHOD m_Set_Oper_Play
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stOperation.iActOperation<>E_OperationButtons.ePlayAll THEN;
	stOperation.bSetPlay:=TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Set_SFCFlags_Reference" Id="{173e8058-adb0-4138-b5d3-8a3b87ec3293}">
      <Declaration><![CDATA[METHOD m_Set_SFCFlags_Reference : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Set reference to SFC flags

refSFC.SFCInit REF= SFCInit;
refSFC.SFCReset REF= SFCReset;
refSFC.SFCError REF= SFCError;
refSFC.SFCEnableLimit REF= SFCEnableLimit;
refSFC.SFCErrorStep REF= SFCErrorStep;
refSFC.SFCErrorPOU REF= SFCErrorPOU;
refSFC.SFCQuitError REF= SFCQuitError;
refSFC.SFCPause REF= SFCPause;
refSFC.SFCTrans REF= SFCTrans;
refSFC.SFCCurrentStep REF= SFCCurrentStep;
refSFC.SFCTip REF= SFCTip;
refSFC.SFCTipMode REF= SFCTipMode;

// Cycle handle for SFC
m_SFC_Handle();]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Set_State" Id="{5873be97-3110-49a4-84ea-a94cd608159b}">
      <Declaration><![CDATA[METHOD m_Set_State : BOOL
VAR_INPUT
	eState_Long_Set			: E_Element_State_Long;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*
IF eState_Long_Set>eState_Long 
OR eState_Long_Set=E_Element_State_Long.eNotClean
THEN;
	eState_Long:=eState_Long_Set;
END_IF
*)
eState_Long:=eState_Long_Set;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_StateUpdate_Limit" Id="{fb1d1185-6118-48f5-8cfa-978fe0325d17}">
      <Declaration><![CDATA[METHOD m_StateUpdate_Limit : BOOL
VAR_INPUT
	value: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF value THEN;
	bStataUpdate_Limited:=TRUE;
ELSE;
	bStataUpdate_Limited:=FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_TimeExpiered" Id="{0e06182a-e09e-4ec2-920d-88b3137754d2}">
      <Declaration><![CDATA[METHOD m_TimeExpiered : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eType OF
	E_Element_Type.eTank:;			
	E_Element_Type.eTriBlender:;
	E_Element_Type.eLine:;
	
END_CASE
	
// Rolling Down option
CASE eInterConnect OF
	E_InterConnection.NotConnected:;
				m_TimeExpiredState_RollDown();
	E_InterConnection.ConnToCIP:;
				//do nothing
	E_InterConnection.ConnToLine,
	E_InterConnection.ConnToTriBlender:;
				// Type Tank
				m_TimeExpiredState_RollDown();
	E_InterConnection.ConnToTank:;
				//do nothing
	
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_TimeExpiredState_RollDown" Id="{2f9443d7-fd06-45c2-8331-f1b6d4473c16}">
      <Declaration><![CDATA[METHOD m_TimeExpiredState_RollDown : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eState_Long OF
	E_Element_State_Long.eCIP_1_Rinzed:;
				//
	E_Element_State_Long.eCIP_2_Deterged,
	E_Element_State_Long.eCIP_3_Deterged_Clean,
	E_Element_State_Long.eCIP_4_Sanitized,
	E_Element_State_Long.eCIP_5_Done:;	
				State:=E_Element_State_Long.eCIP_1_Rinzed;
	E_Element_State_Long.eWaterReady,
	E_Element_State_Long.eReady,
	E_Element_State_Long.eProduction,
	E_Element_State_Long.eEmpty:;	
			IF eType=E_Element_Type.eTank THEN;
				//State:=E_Element_State_Long.eExpired;
				CASE eElementID OF 
					E_Element_List.eTank_1:;
						IF fbTank1.bReady THEN;
							State:=E_Element_State_Long.eExpired;
						END_IF
						
					E_Element_List.eTank_2:;
						IF fbTank2.bReady THEN;
							State:=E_Element_State_Long.eExpired;
						END_IF
						
					E_Element_List.eTank_3:;
						IF fbTank3.bReady THEN;
							State:=E_Element_State_Long.eExpired;
						END_IF
						
					E_Element_List.eTank_4:;
						IF fbTank4.bReady THEN;
							State:=E_Element_State_Long.eExpired;
						END_IF
												
				END_CASE
				
			ELSE;
				State:=E_Element_State_Long.eNotClean;
			END_IF
			
		E_Element_State_Long.eExpired:;
				IF eType=E_Element_Type.eLine OR eType=E_Element_Type.eTriBlender THEN;
					State:=E_Element_State_Long.eNotClean;
				END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_TimeToExpiration" Id="{b592f2a7-8b80-4b25-9040-91bd7248992a}">
      <Declaration><![CDATA[METHOD m_TimeToExpiration : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF tExpirationTime>tStateTime THEN;
	tTimeToExpiration:=tExpirationTime-tStateTime;
ELSE;
	tTimeToExpiration:=T#0S;
	m_TimeExpiered();
END_IF

IF State=E_Element_State_Long.eExpired THEN;
	m_TimeExpiered();	
END_IF

IF State=E_Element_State_Long.eNotClean THEN;
	tTimeToExpiration:=T#0S;
END_IF


CASE eType OF
	E_Element_Type.eTank:;		
			CASE eState_Short OF
				E_Element_State_Short.eNotClean:;
						ExpirationTime:=ExDuration_Default;
						eExTime:=E_ExTime.eCIP;
				E_Element_State_Short.eClean:;
						IF eState_Long=E_Element_State_Long.eWaterReady 
						OR (eState_Long=E_Element_State_Long.eExpired
							AND eState_Long_Expiered=E_Element_State_Long.eWaterReady)
						THEN;
							ExpirationTime:=ExDuration_Water;
							eExTime:=E_ExTime.eWater;
						ELSE;
							ExpirationTime:=ExDuration_Default;
							eExTime:=E_ExTime.eCIP;
						END_IF
				E_Element_State_Short.eProduct:;
						ExpirationTime:=ExDuration_Product;
						eExTime:=E_ExTime.eProduct;
			END_CASE			
			
	E_Element_Type.eTriBlender,
	E_Element_Type.eLine:;
			CASE eInterConnect OF
				E_InterConnection.NotConnected:;
					CASE eState_Short OF
						E_Element_State_Short.eNotClean,
						E_Element_State_Short.eClean:;
								ExpirationTime:=ExDuration_Default;
								eExTime:=E_ExTime.eCIP;
	
						E_Element_State_Short.eProduct:;
								IF m_Get_TimeToExpirationMode(eExTime_check:=E_ExTime.eLine)<ExDuration_Default_LineStandby THEN; // line remain time less then 2 hours
									ExpirationTime:=ExDuration_Default_Line;
									eExTime:=E_ExTime.eLine;
								ELSE;
									ExpirationTime:=ExDuration_Default_LineStandby;
									eExTime:=E_ExTime.eLineStby;
								END_IF								
					END_CASE
			
				E_InterConnection.ConnToCIP:;
						ExpirationTime:=ExDuration_Default;
						eExTime:=E_ExTime.eCIP;
						
				E_InterConnection.ConnToTank:;
					CASE eState_Short OF
						E_Element_State_Short.eNotClean,
						E_Element_State_Short.eClean:;
								ExpirationTime:=ExDuration_Default;
								eExTime:=E_ExTime.eCIP;
	
						E_Element_State_Short.eProduct:;		
								ExpirationTime:=ExDuration_Default_Line;
								eExTime:=E_ExTime.eLine;				
					END_CASE
	
						
			ELSE;
		END_CASE
END_CASE


CASE eExTime OF
	E_ExTime.eCIP:;
			tsStateChange:=tsCIP;
	E_ExTime.eWater:;
			tsStateChange:=tsWater;
	E_ExTime.eProduct:;
			tsStateChange:=tsProduction;			
	E_ExTime.eLine :;
			tsStateChange:=tsProductionLine;
	E_ExTime.eLineStby:;
			tsStateChange:=tsProductionLineStby;
END_CASE

CASE eInterConnect OF
	E_InterConnection.NotConnected:;
	E_InterConnection.ConnToCIP:;
	E_InterConnection.ConnToTank:;
	E_InterConnection.ConnToLine:;
	E_InterConnection.ConnToTriBlender:;
END_CASE

]]></ST>
      </Implementation>
    </Method>
