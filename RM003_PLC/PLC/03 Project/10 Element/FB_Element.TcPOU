END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ExpirationMode:=eExTime;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{8ef68865-931e-45f9-90dd-d20b3c5e284e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eExTime:=ExpirationMode;]]></ST>
        </Implementation>
      </Set>
