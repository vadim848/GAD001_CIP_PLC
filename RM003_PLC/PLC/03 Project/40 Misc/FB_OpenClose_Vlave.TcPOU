<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_OpenClose_Vlave" Id="{ee22d19d-71e8-4576-8a06-4d683eae0d16}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_OpenClose_Vlave
VAR_INPUT
	val_AfterPump	: E_Pis_Name;
	Pump_ID			: E_Pump_List:=E_Pump_List.eNotSelected;
END_VAR
VAR_OUTPUT
END_VAR
VAR
	stPist	: REFERENCE TO ST_Piston;
	stPump	: REFERENCE TO ST_Pump	;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF (stPump.bRun_Auto OR stPump.bRun_Man) THEN
	IF NOT stPist.st_Open THEN
		stPist.req_Open:=TRUE;
	END_IF
ELSE
	IF NOT stPist.st_Close THEN
		stPist.req_Close:=TRUE;
	END_IF
END_IF]]></ST>
    </Implementation>
    <Action Name="act_SetReference" Id="{ffb6f6bd-25a2-4260-b172-60c0ca3a9d6f}">
      <Implementation>
        <ST><![CDATA[stPist REF= stPis[val_AfterPump];
stPump REF= g_Pump.arr_st_Pump[Pump_ID];]]></ST>
      </Implementation>
    </Action>
    <LineIds Name="FB_OpenClose_Vlave">
      <LineId Id="9" Count="0" />
      <LineId Id="19" Count="0" />
      <LineId Id="15" Count="0" />
      <LineId Id="20" Count="0" />
      <LineId Id="17" Count="0" />
      <LineId Id="21" Count="2" />
      <LineId Id="16" Count="0" />
    </LineIds>
    <LineIds Name="FB_OpenClose_Vlave.act_SetReference">
      <LineId Id="2" Count="0" />
      <LineId Id="1" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>