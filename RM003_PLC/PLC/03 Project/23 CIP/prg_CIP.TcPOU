      </ObjectProperties>
    </Action>
    <Action Name="_aCIP1_Done_entry" Id="{5876c70f-a066-4ad6-a135-a5384197da92}">
      <Implementation>
        <ST><![CDATA[eRefClient_fbElement.m_InterConnected_State(eState_Long_Set:=E_Element_State_Long.eCIP_1_Rinzed);
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
