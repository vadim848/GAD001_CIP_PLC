        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_ainit_exit" Id="{ad983d6a-a390-4862-a949-8cf9f36606ae}">
      <Implementation>
        <ST><![CDATA[bRun:=FALSE;
eReq:=eReqBlank;
eRun:=E_CIP_Source.eNone;

eRefClient_fbElement REF= fbElement_Blank;]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
