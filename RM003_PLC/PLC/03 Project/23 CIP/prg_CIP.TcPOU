<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="prg_CIP" Id="{14cc32b0-9432-4cf7-99d2-9b696d5c02b0}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM prg_CIP
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	bRun: BOOL;
	eRun: E_CIP_Source;


	eCIP_Return		: E_CIP_Return;
	eCIP_Source		: E_CIP_Source;
	eReq			: ST_CIP_Request;
	eReqBlank		: ST_CIP_Request;
	eReqLocal		: ST_CIP_Request;

	bStepDone: BOOL;
	
	iPosSelect_HMI: INT;

	rtPosMoveHMI_Up		: R_TRIG;
	rtPosMoveHMI_Down	: R_TRIG;
	rtPosDeleteHMI		: R_TRIG;
	
	eRefClient_fbElement		: REFERENCE TO FB_Element; // FB_Element // E_Element_State_Long
	fbElement_Blank				: FB_Element;
	eState_Long_Blank			: E_Element_State_Long;

	
	rtReqLocalCIP_HMI: R_TRIG;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[

act_Oper();
act_ReqBuffer();
]]></ST>
    </Implementation>
    <Action Name="_a_aWatingTo_Start_active" Id="{560e86d1-cd11-44bd-aed6-a8db9be9b76c}">
      <Implementation>
        <ST><![CDATA[IF TRUE 
AND bRun 
AND arCIP_RequestBufer[0].eClient<>E_CIP_Usage.eNotInUse

THEN;
	bStepDone:=TRUE;
ELSE;
	bStepDone:=FALSE;
	//bRun:=FALSE;
END_IF]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
