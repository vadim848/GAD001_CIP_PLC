            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aWatingTo_Start_exit" Id="{fe06bbde-dba2-4c36-8b83-7a6e8089b6a1}">
      <Implementation>
        <ST><![CDATA[eReq:=arCIP_RequestBufer[0];
arCIP_RequestBufer[0]:=eReqBlank;

CASE eReq.eClient OF
	E_CIP_Usage.eLocal:;
		eRefClient_fbElement REF= fbElement_Blank;
		eRefClient_fbElement.m_InterConnected_State(eState_Long_Set:=E_Element_State_Long.eNotClean);
		
	E_CIP_Usage.eTank_1:;
		eRefClient_fbElement REF= fbElement[E_Element_List.eTank_1];

	E_CIP_Usage.eTank_2:;
		eRefClient_fbElement REF= fbElement[E_Element_List.eTank_2];
		
	E_CIP_Usage.eTank_3:;
		eRefClient_fbElement REF= fbElement[E_Element_List.eTank_3];
		
	E_CIP_Usage.eTank_4:;
		eRefClient_fbElement REF= fbElement[E_Element_List.eTank_4];
		
	E_CIP_Usage.eTriBlender_Marinada:;
		eRefClient_fbElement REF= fbElement[E_Element_List.eTriBlender_Marinada];
		
	E_CIP_Usage.eTriBlender_Color:;
		eRefClient_fbElement REF= fbElement[E_Element_List.eTriBlender_Color];
		
	E_CIP_Usage.eLine_Marinada:;
		eRefClient_fbElement REF= fbElement[E_Element_List.eLine_Marinada];
		
	E_CIP_Usage.eLine_Color:;
		eRefClient_fbElement REF= fbElement[E_Element_List.eLine_Color];

END_CASE

]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
