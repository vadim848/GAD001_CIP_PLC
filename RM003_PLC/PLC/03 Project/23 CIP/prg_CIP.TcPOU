            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aCIP_Done_entry" Id="{65c51eeb-ff71-4a7b-932e-5755a43e7ba7}">
      <Implementation>
        <ST><![CDATA[eRefClient_fbElement.m_InterConnect(value:=E_InterConnection.NotConnected);
]]></ST>
      </Implementation>
