    <Action Name="act_ReqBuffer" Id="{1b81a7d5-6e97-4216-8c50-f77668c87ac0}">
      <Implementation>
        <ST><![CDATA[rtPosMoveHMI_Up(Q=>);
IF rtPosMoveHMI_Up.Q THEN;
	m_PosMove_Up_HMI();
END_IF
rtPosMoveHMI_Down(Q=>);
IF rtPosMoveHMI_Down.Q THEN;
	m_PosMove_Down_HMI();
END_IF
rtPosDeleteHMI(Q=>);
IF rtPosDeleteHMI.Q THEN;
	m_PosDelete_HMI();
END_IF

rtReqLocalCIP_HMI(Q=>);
IF rtReqLocalCIP_HMI.Q THEN;
	eReqLocal.eClient:=E_CIP_Usage.eLocal;
	eReqLocal.eType:=E_CIP_Type.Full;
	m_TakePosInCIPBuffer(stCIP_Request:=eReqLocal);
END_IF



]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_PosDelete_HMI" Id="{5ecfed30-e439-4aa1-8486-4d270c40480b}">
      <Declaration><![CDATA[METHOD m_PosDelete_HMI : BOOL
VAR_INPUT
END_VAR
VAR
	stCIP_Request_Temp: ST_CIP_Request;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF iPosSelect_HMI>=0 AND iPosSelect_HMI<9 THEN;
	arCIP_RequestBufer[iPosSelect_HMI]:=stCIP_Request_Temp;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PosMove_Down_HMI" Id="{c114e84d-a8ed-4e16-9653-147f733c0d8b}">
      <Declaration><![CDATA[METHOD m_PosMove_Down_HMI : BOOL
VAR_INPUT
END_VAR
VAR
	stCIP_Request_Temp: ST_CIP_Request;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF iPosSelect_HMI>=0 AND iPosSelect_HMI<9 THEN;
	stCIP_Request_Temp:=arCIP_RequestBufer[iPosSelect_HMI+1];
	arCIP_RequestBufer[iPosSelect_HMI+1]:=arCIP_RequestBufer[iPosSelect_HMI];
	arCIP_RequestBufer[iPosSelect_HMI]:=stCIP_Request_Temp;
	iPosSelect_HMI:=iPosSelect_HMI+1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PosMove_Up_HMI" Id="{882d4194-9591-429b-a6de-feb8c47cbd4c}">
      <Declaration><![CDATA[METHOD m_PosMove_Up_HMI : BOOL
VAR_INPUT
END_VAR
VAR
	stCIP_Request_Temp: ST_CIP_Request;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF iPosSelect_HMI>0 AND iPosSelect_HMI<=9 THEN;
	stCIP_Request_Temp:=arCIP_RequestBufer[iPosSelect_HMI-1];
	arCIP_RequestBufer[iPosSelect_HMI-1]:=arCIP_RequestBufer[iPosSelect_HMI];
	arCIP_RequestBufer[iPosSelect_HMI]:=stCIP_Request_Temp;
		iPosSelect_HMI:=iPosSelect_HMI-1;

END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_TakePosInCIPBuffer" Id="{b2dcb157-1d24-4a20-a9df-81a455a5e4d3}">
      <Declaration><![CDATA[METHOD m_TakePosInCIPBuffer : BOOL
VAR_INPUT
	stCIP_Request: ST_CIP_Request;
END_VAR

VAR
	i: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stCIP_Request.eClient<>E_CIP_Usage.eNotInUse
AND stCIP_Request.eType<>E_CIP_Type.NotSelected
THEN;
	FOR i:=0 TO 9 DO
		IF arCIP_RequestBufer[i].eClient=E_CIP_Usage.eNotInUse THEN;
			arCIP_RequestBufer[i]:=stCIP_Request;
			EXIT;
		END_IF
	END_FOR	
END_IF

]]></ST>
      </Implementation>
    </Method>
