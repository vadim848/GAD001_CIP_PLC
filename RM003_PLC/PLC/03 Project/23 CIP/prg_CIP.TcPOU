        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aCIP4_Done_entry" Id="{2c90a1c0-9583-407e-b51f-9727c492c562}">
      <Implementation>
        <ST><![CDATA[

CASE eRefClient_fbElement.eState_Long OF
	E_Element_State_Long.eNotClean:;
			//
	E_Element_State_Long.eCIP_1_Rinzed:;
			//
	E_Element_State_Long.eCIP_2_Deterged:;
			eRefClient_fbElement.m_InterConnected_State(eState_Long_Set:=E_Element_State_Long.eCIP_3_Deterged_Clean);	
		
	E_Element_State_Long.eCIP_3_Deterged_Clean:;
			//
	E_Element_State_Long.eCIP_4_Sanitized:;
			eRefClient_fbElement.m_InterConnected_State(eState_Long_Set:=E_Element_State_Long.eCIP_5_Done);			
	
END_CASE]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aEnd_Check_active" Id="{98177335-fdd1-4c16-8092-a4d30c9fc2e4}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF TRUE 
AND eRefClient_fbElement.eState_Long = E_Element_State_Long.eCIP_1_Rinzed
AND eReq.eType = E_CIP_Type.Partial
THEN;
	bStepDone:=TRUE;
	
ELSIF TRUE 
AND eRefClient_fbElement.eState_Long = E_Element_State_Long.eCIP_5_Done
AND TRUE
THEN;
	bStepDone:=TRUE;
END_IF	
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aGet_Client_active" Id="{18e627b5-82b2-485b-93fe-c20af040d1ae}">
      <Implementation>
        <ST><![CDATA[


CASE eRefClient_fbElement.eState_Long OF
	E_Element_State_Long.eNotClean:;
			eRun:=E_CIP_Source.eT93_R_Water;	
		
	E_Element_State_Long.eCIP_1_Rinzed:;
			eRun:=E_CIP_Source.eT92_Detergent;	
		
	E_Element_State_Long.eCIP_2_Deterged:;
			eRun:=E_CIP_Source.eT94_Water;	
		
	E_Element_State_Long.eCIP_3_Deterged_Clean:;
			eRun:=E_CIP_Source.eT91_Sanitation;		
	
	E_Element_State_Long.eCIP_4_Sanitized:;
			eRun:=E_CIP_Source.eT94_Water;			
	
END_CASE

eRefClient_fbElement.m_InterConnect(value:=E_InterConnection.ConnToCIP);

]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_ainit_active" Id="{d9c96ab0-b559-49a2-afe8-ff94a774e454}">
      <Implementation>
        <ST><![CDATA[SFCReset:=FALSE;]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
