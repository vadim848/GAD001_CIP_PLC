<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_CIP_ClientTank" Id="{ec4051e0-f8dc-45bc-bf46-7adcfec692af}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_CIP_ClientTank EXTENDS FB_SFC_Cycle IMPLEMENTS ITF_FB_SFC_Cycle
VAR_INPUT	
	valTank_A				: E_Pis_Name;
	valTank_A_Sprinkler		: E_Pis_Name;
	valTank_B				: E_Pis_Name;
	valTank_B_Sprinkler		: E_Pis_Name;	
	valDrain				: E_Pis_Name;
END_VAR
VAR_OUTPUT
END_VAR
VAR

	eReq				: E_CIP_ClientTank;
	eProcess			: E_CIP_ClientTank;
	eStatus				: E_CIP_ClientTank;
	
	fbPis					: FB_Piston;
	stPis_Tank_A			: REFERENCE TO ST_Piston;
	stPis_Tank_A_Sprinkler	: REFERENCE TO ST_Piston;
	stPis_Tank_B			: REFERENCE TO ST_Piston;
	stPis_Tank_B_Sprinkler	: REFERENCE TO ST_Piston;
	stPis_Drain				: REFERENCE TO ST_Piston;

END_VAR
VAR_IN_OUT


END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[act_GetReference();

act_Oper();
IF NOT Init.x THEN;
	act_Status();
END_IF

]]></ST>
    </Implementation>
