    <Action Name="_aReady_active" Id="{b8a80171-ccbc-439a-bcf2-0bdb246c8206}">
      <Implementation>
        <ST><![CDATA[

CASE eReq OF
	E_CIP_ClientTank.eClose:;
			IF TRUE THEN;
				eProcess:=E_CIP_ClientTank.eClose;
			END_IF

	E_CIP_ClientTank.eTank_A:;
			IF TRUE THEN;
				eProcess:=E_CIP_ClientTank.eTank_A;
			END_IF	
			
	E_CIP_ClientTank.eTank_A_Sprinkler:;
			IF TRUE THEN;
				eProcess:=E_CIP_ClientTank.eTank_A_Sprinkler;
			END_IF
			
	E_CIP_ClientTank.eTank_B:;
			IF TRUE THEN;
				eProcess:=E_CIP_ClientTank.eTank_B;
			END_IF	
	
	E_CIP_ClientTank.eTank_B_Sprinkler:;
			IF TRUE THEN;
				eProcess:=E_CIP_ClientTank.eTank_B_Sprinkler;
			END_IF	

	E_CIP_ClientTank.eDrain:;
			IF TRUE THEN;
				eProcess:=E_CIP_ClientTank.eDrain;
			END_IF	
	

END_CASE
		
]]></ST>
      </Implementation>
