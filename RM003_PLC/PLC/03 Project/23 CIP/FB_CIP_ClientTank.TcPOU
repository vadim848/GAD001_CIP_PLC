    <Action Name="act_Status" Id="{ea2c6eb6-6b5f-44a7-aec7-310eecd35922}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[IF bReady AND bDone OR TRUE THEN;
	IF TRUE 
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_A, 				req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_A_Sprinkler, 	req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_B, 				req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_B_Sprinkler, 	req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 				req:=E_Piston_Recipe_State.Release)
	THEN;
		eStatus:=E_CIP_ClientTank.eClose;
	
	ELSIF TRUE 
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_A, 				req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_A_Sprinkler, 	req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_B, 				req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_B_Sprinkler, 	req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 				req:=E_Piston_Recipe_State.Release)
	THEN;
		eStatus:=E_CIP_ClientTank.eTank_A;
		
	ELSIF TRUE 
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_A, 				req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_A_Sprinkler, 	req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_B, 				req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_B_Sprinkler, 	req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 				req:=E_Piston_Recipe_State.Release)
	THEN;
		eStatus:=E_CIP_ClientTank.eTank_B;
		
	ELSIF TRUE 	
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_A, 				req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_A_Sprinkler, 	req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_B, 				req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_B_Sprinkler, 	req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 				req:=E_Piston_Recipe_State.Act)
	THEN;
		eStatus:=E_CIP_ClientTank.eDrain;
		
	ELSE;
		eStatus:=E_CIP_ClientTank.eNone;
	END_IF
ELSE;
	eStatus:=E_CIP_ClientTank.eNone;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_CheckStatus" Id="{cd38da1d-87fa-4c25-8cd1-074243f17cb1}">
      <Declaration><![CDATA[METHOD m_CheckStatus : BOOL
VAR_INPUT
	eReqStatus		: E_CIP_ClientTank;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eStatus=eReqStatus 
AND eProcess=E_CIP_ClientTank.eNone
AND eReq=E_CIP_ClientTank.eNone
AND bReady
AND bDone
AND NOT bRun
THEN;
	m_CheckStatus:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Run" Id="{ec4b68e6-5819-4865-ba29-867baa0dec5e}">
      <Declaration><![CDATA[METHOD m_Run : BOOL
VAR_INPUT
	eReqProc			: E_CIP_ClientTank;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eProcess=E_CIP_ClientTank.eNone THEN;
	eProcess:=eReq:=eReqProc;
	bDone:=FALSE;
	m_Run:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Set_SFCFlags_Reference" Id="{7e38792a-dc64-4fa1-bbd1-b9c8a5df9f5d}">
      <Declaration><![CDATA[METHOD m_Set_SFCFlags_Reference : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Set reference to SFC flags

refSFC.SFCInit REF= SFCInit;
refSFC.SFCReset REF= SFCReset;
refSFC.SFCError REF= SFCError;
refSFC.SFCEnableLimit REF= SFCEnableLimit;
refSFC.SFCErrorStep REF= SFCErrorStep;
refSFC.SFCErrorPOU REF= SFCErrorPOU;
refSFC.SFCQuitError REF= SFCQuitError;
refSFC.SFCPause REF= SFCPause;
refSFC.SFCTrans REF= SFCTrans;
refSFC.SFCCurrentStep REF= SFCCurrentStep;
refSFC.SFCTip REF= SFCTip;
refSFC.SFCTipMode REF= SFCTipMode;

// Cycle handle for SFC
m_SFC_Handle();]]></ST>
      </Implementation>
    </Method>
