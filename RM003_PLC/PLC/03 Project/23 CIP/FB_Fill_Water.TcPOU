<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_Fill_Water" Id="{4e23a055-3326-4a30-9218-74dcf7eb4b47}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Fill_Water EXTENDS FB_SFC_Cycle
VAR_INPUT
	valve : E_Pis_Name;;
	reqLevel: REAL;
	actLevel: REAL;
	
	fillCondition: BOOL;


END_VAR
VAR_OUTPUT
END_VAR
VAR
	fbHysteresis: FB_Hysteresis_REAL;
	stValve: REFERENCE TO ST_Piston;

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[stValve REF= stPis[valve];
IF NOT __ISVALIDREF(stValve) THEN;
	RETURN;
END_IF

fbHysteresis(
	fIn:= , 
	fHigh:= reqLevel, 
	fLow:= reqLevel-50.0, 
	iDigitsAfterDot:= , 
	bOut=> );

IF stValve.st_Open 
AND (NOT fbHysteresis.bOut
OR NOT fillCondition)
THEN;
	stValve.req_Close:=TRUE;
	
ELSIF stValve.st_Close 
AND fbHysteresis.bOut
THEN;
	stValve.req_Open:=TRUE;
END_IF
 

	
	]]></ST>
    </Implementation>
