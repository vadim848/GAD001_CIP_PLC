        <ST><![CDATA[bStepDone:=FALSE;
fb_PumpCIP.m_Run(RPM:=pcFlow1_Rate.mRun_PID(Set_Point:=st_CIP_Param.r_CIP_Pump,controlManual:=NOT(fb_PumpCIP.modeAuto)));
fb_PumpClient.m_Run(RPM:=st_CIP_Param.r_CIP_Client_Pump);

IF TRUE //Future condition
AND StartPump_CIP2_RPM_04.t>SECOND_TO_TIME(st_CIP_Param.t_PumpInitRun) 
THEN;
	bStepDone:=TRUE;
END_IF
]]></ST>
