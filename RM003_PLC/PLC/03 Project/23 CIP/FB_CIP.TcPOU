    <Action Name="_aConnect_CIP4_active" Id="{588b6467-3c69-4e91-bbae-17dceb39c081}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF fbCIP_Source.m_CheckStatus(eReqStatus:=E_CIP_Source.eT94_Water) 
AND fbCIP_Usage.m_CheckStatus(eReqStatus:=eReq.eClient)  
//AND fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eDrain) 
AND mCIP_Clients_status(command:=E_CIP_Client_Command.eCIP)
THEN;

	CASE eReq.eClient OF
	
		E_CIP_Usage.eTank_1:;
					bStepDone:=fbCIP_ClientTank_Marinade.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_A);
		E_CIP_Usage.eTank_2:;
					bStepDone:=fbCIP_ClientTank_Marinade.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_B);	
		E_CIP_Usage.eTank_3:;
					bStepDone:=fbCIP_ClientTank_Color.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_A);
		E_CIP_Usage.eTank_4:;
					bStepDone:=fbCIP_ClientTank_Color.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_A);	
	ELSE;				
		bStepDone:=TRUE;
	END_CASE
	
END_IF

IF bStepDone THEN;
	CASE eRefClient_fbElement.eState_Long OF
		E_Element_State_Long.eCIP_2_Deterged:;
				//fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eT92_Detergent);
				bStepDone:=fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eT92_Detergent);
		E_Element_State_Long.eCIP_4_Sanitized:;
				//fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eT91_Sanitation);	
				bStepDone:=fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eT91_Sanitation);
	END_CASE	
END_IF]]></ST>
      </Implementation>
