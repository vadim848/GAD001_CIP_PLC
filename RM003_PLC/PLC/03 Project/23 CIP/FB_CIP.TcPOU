    <Action Name="_aFill_Water_T94_active" Id="{69b06cae-7ea8-4e4a-93f0-c2b1370a9df2}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF fbCIP_Source.m_CheckStatus(eReqStatus:=E_CIP_Source.eClose) 
AND fbCIP_Usage.m_CheckStatus(eReqStatus:=E_CIP_Usage.eLocal)  
AND fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eDrain)  
THEN;//need something in case there are error in level sensor, should jump into error step and close all valves

	//IF eReq.eClient=E_CIP_Usage.eLocal 
	IF TRUE 
	AND (lvlTank_T94.e_state=E_Tank_Level.eLL OR TRUE)
	AND lvlTank_T94.rTankLevel>st_CIP_Param.r_Tank94_Volume//st_CIP_Param.r_Water_TankLvl_Lcl_1 // Client requered Level
	THEN;	
		bStepDone:=TRUE;
		fbPis.m_SetByRecipe(stPis:=stPis_FillWater_T94, req:=E_Piston_Recipe_State.Release);
	ELSE;
		//Fill water
		IF NOT arrTanksSens[E_Tank_Name.T94].get_stTankLevel_OverFlow() THEN;
			fbPis.m_SetByRecipe(stPis:=stPis_FillWater_T94, req:=E_Piston_Recipe_State.Act);			
		END_IF	END_IF	

END_IF
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
