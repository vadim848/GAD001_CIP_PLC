    <Action Name="_aCIP3_If_ClientIsTank_active" Id="{e5c94bea-403b-4ee1-a03c-d5388d877ad2}">
      <Implementation>
        <ST><![CDATA[CASE eReq.eClient OF
	E_CIP_Usage.eTank_1,
	E_CIP_Usage.eTank_2,
	E_CIP_Usage.eTank_3,
	E_CIP_Usage.eTank_4:;
		bStepDone:=TRUE;
		m_DashState_done(stage:=E_CIP_DashStage_List.e16_CIP4_Client_DisInfection_Condition_Sprinkler);
ELSE;
		bStepDone:=FALSE;
		m_DashState_done(stage:=E_CIP_DashStage_List.e15_CIP4_Client_DisInfection_Condition_Pipe);
END_CASE]]></ST>
      </Implementation>
