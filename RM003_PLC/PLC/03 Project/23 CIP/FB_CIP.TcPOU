    <Action Name="_aFill_Water_T92_active" Id="{24710a65-e152-4b5e-946e-ece3bbec20c5}">
      <Implementation>
        <ST><![CDATA[//Reset
nDeter_CondActTime_Lcl:=0;
nDeter_CondActTime_Clnt:=0;
bDeter_CondActTime_Lcl_Done:=FALSE;
bDeter_CondActTime_Clnt_Done:=FALSE;

bStepDone:=FALSE;
IF fbCIP_Source.m_CheckStatus(eReqStatus:=E_CIP_Source.eClose) 
AND fbCIP_Usage.m_CheckStatus(eReqStatus:=E_CIP_Usage.eLocal)  
AND fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eDrain)  
THEN;
	//IF eReq.eClient=E_CIP_Usage.eLocal 
	IF lvlTank_T92.e_state=E_Tank_Level.eLL
	AND lvlTank_T92.rTankLevel>st_CIP_Param.r_Tank92_Volume//st_CIP_Param.r_TankLevel_1//st_CIP_Param.r_Deter_92_TankLvl_1 // Local requered Level
	THEN;	
		bStepDone:=TRUE;
		fbPis.m_SetByRecipe(stPis:=stPis_FillWater_T92, req:=E_Piston_Recipe_State.Release);
	(*ELSIF lvlTank_T92.e_state=E_Tank_Level.eLL
	AND lvlTank_T92.rTankLevel>st_CIP_Param.r_TankVolume_1//Client requered Level
	THEN;
		//Level OK
		bStepDone:=TRUE;
		fbPis.m_SetByRecipe(stPis:=stPis_FillWater_T92, req:=E_Piston_Recipe_State.Release);*)
	ELSE;
		//Fill water
		IF NOT arrTanksSens[E_Tank_Name.T92].get_stTankLevel_OverFlow() THEN;
			fbPis.m_SetByRecipe(stPis:=stPis_FillWater_T92, req:=E_Piston_Recipe_State.Act);			
		END_IF	
	END_IF	
END_IF]]></ST>
      </Implementation>
