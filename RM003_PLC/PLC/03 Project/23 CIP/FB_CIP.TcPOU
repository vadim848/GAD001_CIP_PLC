    <Action Name="_aCondition_CIP3_Client_active" Id="{c8b10d3e-d2df-4479-877a-926158cbaf79}">
      <Implementation>
        <ST><![CDATA[fb_PumpCIP.m_Run(RPM:=pcFlow1_Rate.mRun_PID(Set_Point:=fFlowRate,controlManual:=NOT(fb_PumpCIP.modeAuto)));
fb_PumpClient.m_Run(RPM:=st_CIP_Param.r_CIP_Client_Pump);

IF bSprinkler THEN;
	IF TRUE 
	AND pcFlow1_Rate.mRun(mRun=>_cond[1])
	AND pcFlow3_Rate.mRun(mRun=>_cond[2])
	THEN;
		//
	ELSE;
		bCIP_Condition_Failed:=TRUE;
	END_IF
ELSE;
	IF TRUE 
	AND pcFlow1_Rate.mRun(mRun=>_cond[1])
	AND pcFlow2_Rate.mRun(mRun=>_cond[2])
	THEN;
		//
	ELSE;
		bCIP_Condition_Failed:=TRUE;
	END_IF	
END_IF

pcHeatExchanger.mRun_PID(Set_Point:=st_CIP_Param.r_Temper_DisInfection, controlManual:=g_Data.stHeatExchanger.bManual ,mRun_PID=>_temp);
tonr_CIP_Condition(PT:=SECOND_TO_TIME(tConditionTime));
IF TRUE 
AND pcHeatExchanger.mRun_With_SP(Set_Point:=st_CIP_Param.r_Temper_DisInfection, mRun_With_SP=>_cond[3])
//AND pcTemperature_Dis.mRun_With_SP(Set_Point:=st_CIP_Param.r_Temper_DisInfection, mRun_With_SP=>_cond[4])
AND pcTemp_ClntReturn.mRun_With_SP(Set_Point:=st_CIP_Param.r_Temper_DisInfection, mRun_With_SP=>_cond[5])
AND measure_Dis_2.x
AND TRUE
THEN;
	tonr_CIP_Condition.IN:=TRUE;
	m_run_MixProof();
ELSE;
	tonr_CIP_Condition.IN:=FALSE;
END_IF

IF NOT bSprinkler THEN;
	IF pcDisInfectant.mRun_With_SP(Set_Point:=st_CIP_Param.r_DisInfectionConcentration, mRun_With_SP=>_cond[6])
	AND tonr_CIP_Condition.IN
	THEN;
		//tonr_CIP_Condition.IN:=TRUE;
	ELSIF bSprinkler THEN;
		tonr_CIP_Condition.IN:=TRUE;
	ELSE;
		tonr_CIP_Condition.IN:=FALSE;
	END_IF	
END_IF	


IF tonr_CIP_Condition.Q 
AND bValveCleanDone
THEN
	bCIP_Condition_Done:=TRUE;
ELSE;
	bCIP_Condition_Done:=FALSE;	
END_IF


ton_Concentration_Filter(PT:=T#30S, IN:=stDisInfectant.Control_ON AND (NOT stDisInfectant.OverFlow) AND (NOT bSprinkler));
IF TRUE 	
AND ton_Concentration_Filter.Q	
THEN;
	bConcentration_correct:=TRUE;
ELSE;
	bConcentration_correct:=FALSE;
END_IF

// Reverce function
(*
IF Disinfct_Conc_Client_Done.x 
AND NOT pcDisInfectant.mRun()
AND NOT pcTemp_ClntReturn.mRun()
THEN;
	bCIP_Condition_Failed:=TRUE;
END_IF

IF Temperature_Dis_2_Done.x 
AND NOT pcTemperature_Dis.mRun()
THEN;
	bCIP_Condition_Failed:=TRUE;
END_IF


//ton_CIP_Condition(PT:=T#30S);
IF tConditionTime-nDisInf_CondActTime_Clnt>0 THEN
	tonr_CIP_Condition(PT:=SECOND_TO_TIME(tConditionTime-nDisInf_CondActTime_Clnt));
	bDisInf_CondActTime_Clnt_Done:=FALSE;
ELSE
	bDisInf_CondActTime_Clnt_Done:=TRUE;
END_IF
IF TRUE 
AND Disinfct_Conc_Client_Done.x
AND Temperature_Dis_2_Done.x
AND NOT bDisInf_CondActTime_Clnt_Done
AND TRUE
THEN;
	tonr_CIP_Condition.IN:=TRUE;
ELSE;
	nDisInf_CondActTime_Clnt:=TIME_TO_INT(tonr_CIP_Condition.ET)/1000;
	tonr_CIP_Condition.IN:=FALSE;
END_IF

IF tonr_CIP_Condition.Q 
OR bDisInf_CondActTime_Clnt_Done 
THEN;
	bCIP_Condition_Done:=TRUE;
ELSE;
	bCIP_Condition_Done:=FALSE;	
END_IF
*)]]></ST>
      </Implementation>
