    <Action Name="act_ReqBuffer" Id="{1b81a7d5-6e97-4216-8c50-f77668c87ac0}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[rtPosMoveHMI_Up(Q=>);
IF rtPosMoveHMI_Up.Q THEN;
	m_PosMove_Up_HMI();
END_IF
rtPosMoveHMI_Down(Q=>);
IF rtPosMoveHMI_Down.Q THEN;
	m_PosMove_Down_HMI();
END_IF
rtPosDeleteHMI(Q=>);
IF rtPosDeleteHMI.Q THEN;
	m_PosDelete_HMI();
END_IF
rtPosDeleteAllHMI(Q=>);
IF rtPosDeleteAllHMI.Q THEN;
	m_PosDeleteAll_HMI();
END_IF

rtReqLocalCIP_Full_HMI(Q=>);
IF rtReqLocalCIP_Full_HMI.Q THEN;
	eReqLocal.eClient:=E_CIP_Usage.eLocal;
	eReqLocal.eType:=E_CIP_Type.Full;
	m_TakePosInCIPBuffer(stCIP_Request:=eReqLocal);
END_IF

rtReqLocalCIP_Detergent_HMI(Q=>);
IF rtReqLocalCIP_Detergent_HMI.Q THEN;
	eReqLocal.eClient:=E_CIP_Usage.eLocal;
	eReqLocal.eType:=E_CIP_Type.Detergent;
	m_TakePosInCIPBuffer(stCIP_Request:=eReqLocal);
END_IF

rtReqCleanEmpty_HMI(Q=>);
IF rtReqCleanEmpty_HMI.Q THEN;
	m_CleanEmpty_Spaces();
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_Run" Id="{1474794e-dde4-4a3c-8164-060b43f4cb22}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[IF __ISVALIDREF(eRefClient_fbElement) THEN
	IF eRefClient_fbElement.bError AND SFCCurrentStep<>'Ready' THEN;
		m_Set_LastStepBeforeError();
		sError_Message:='Client Error';
		//mResetCycle();
	END_IF	
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_SprinklerCondition" Id="{44149426-1a6f-4c5f-80b5-37350a655a40}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[

IF __ISVALIDREF(eRefClient_fbElement) THEN;
	IF TRUE
	AND eRefClient_fbElement.eState_Long>=E_Element_State_Long.eCIP_1_Rinzed 
	AND eRefClient_fbElement.eState_Long<=E_Element_State_Long.eCIP_2_Deterged 
	THEN;
		IF NOT bSprinkler THEN // Pipe
			tConditionTime	:=st_CIP_Param.t_ConditionDetergent;
			fFlowRate		:=st_CIP_Param.r_Flow_Pipe;
		ELSE // Sprinkler
			tConditionTime	:=st_CIP_Param.t_ConditionDetergent_Sprinkler;
			fFlowRate		:=st_CIP_Param.r_Flow_Sprinkler;
		END_IF	
		//rVolume_Collect :=st_CIP_Param.r_Volume_Collect_Detergent;
		//rVolume_Drain	:=st_CIP_Param.r_Volume_Drain_Detergent;
		//rVolume_Recycle	:=st_CIP_Param.r_Volume_Recycle_Detergent;
		
	ELSIF TRUE
	AND eRefClient_fbElement.eState_Long>=E_Element_State_Long.eCIP_3_Deterged_Clean 
	AND eRefClient_fbElement.eState_Long<=E_Element_State_Long.eCIP_4_Sanitized 
	THEN;
		IF NOT bSprinkler THEN // Pipe
			tConditionTime	:=st_CIP_Param.t_ConditionDisInfection;
			fFlowRate		:=st_CIP_Param.r_Flow_Pipe;
		ELSE // Sprinkler
			tConditionTime	:=st_CIP_Param.t_ConditionDisInfection_Sprinkler;
			fFlowRate		:=st_CIP_Param.r_Flow_Sprinkler;
		END_IF	
		//rVolume_Collect :=st_CIP_Param.r_Volume_Collect_DisInfection;
		//rVolume_Drain	:=st_CIP_Param.r_Volume_Drain_DisInfection;
		//rVolume_Recycle	:=st_CIP_Param.r_Volume_Recycle_DisInfection;
	END_IF	
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_ValveUpLow_Cntrl" Id="{767e74fb-6b96-4e97-bf7c-883c8d6e0955}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[tOn(IN:= , PT:=T#0.5S , Q=> , ET=> );
tOff(IN:= , PT:=T#10S , Q=> , ET=> );
nClient:=eCIP_Usage:=eReq.eClient;

//To be deleted just for testing
//***************************************************************************************
gCIP_ValvUL[1,1]:=E_Pis_Name.V3004;
gCIP_ValvUL[1,2]:=E_Pis_Name.V3017;
gCIP_ValvUL[1,3]:=E_Pis_Name.V3023;
gCIP_ValvUL[1,4]:=E_Pis_Name.e0_not_in_use;
gCIP_ValvUL[1,5]:=E_Pis_Name.e0_not_in_use;
gCIP_ValvUL[1,6]:=E_Pis_Name.e0_not_in_use;
																
gCIP_ValvUL[2,1]:=E_Pis_Name.V3010;
gCIP_ValvUL[2,2]:=E_Pis_Name.V3027;
gCIP_ValvUL[2,3]:=E_Pis_Name.V3028;
gCIP_ValvUL[2,4]:=E_Pis_Name.e0_not_in_use;
gCIP_ValvUL[2,5]:=E_Pis_Name.e0_not_in_use;
gCIP_ValvUL[2,6]:=E_Pis_Name.e0_not_in_use;
																
gCIP_ValvUL[3,1]:=E_Pis_Name.V4034;
gCIP_ValvUL[3,2]:=E_Pis_Name.V4004;
gCIP_ValvUL[3,3]:=E_Pis_Name.V4017;
gCIP_ValvUL[3,4]:=E_Pis_Name.v4023;
gCIP_ValvUL[3,5]:=E_Pis_Name.e0_not_in_use;
gCIP_ValvUL[3,6]:=E_Pis_Name.e0_not_in_use;
																
gCIP_ValvUL[4,1]:=E_Pis_Name.V4033;
gCIP_ValvUL[4,2]:=E_Pis_Name.V4010;
gCIP_ValvUL[4,3]:=E_Pis_Name.V4027;
gCIP_ValvUL[4,4]:=E_Pis_Name.V4028;
gCIP_ValvUL[4,5]:=E_Pis_Name.e0_not_in_use;
gCIP_ValvUL[4,6]:=E_Pis_Name.e0_not_in_use;
																
gCIP_ValvUL[5,1]:=E_Pis_Name.V3113;
gCIP_ValvUL[5,2]:=E_Pis_Name.V3004;
gCIP_ValvUL[5,3]:=E_Pis_Name.V3010;
gCIP_ValvUL[5,4]:=E_Pis_Name.V3023;
gCIP_ValvUL[5,5]:=E_Pis_Name.V3028;
gCIP_ValvUL[5,6]:=E_Pis_Name.e0_not_in_use;
																
gCIP_ValvUL[6,1]:=E_Pis_Name.v2114;
gCIP_ValvUL[6,2]:=E_Pis_Name.V4004;
gCIP_ValvUL[6,3]:=E_Pis_Name.V4010;
gCIP_ValvUL[6,4]:=E_Pis_Name.V2116;
gCIP_ValvUL[6,5]:=E_Pis_Name.V4023;
gCIP_ValvUL[6,6]:=E_Pis_Name.V4028;
																
gCIP_ValvUL[7,1]:=E_Pis_Name.V3017;
gCIP_ValvUL[7,2]:=E_Pis_Name.V3027;
gCIP_ValvUL[7,3]:=E_Pis_Name.e0_not_in_use;
gCIP_ValvUL[7,4]:=E_Pis_Name.e0_not_in_use;
gCIP_ValvUL[7,5]:=E_Pis_Name.e0_not_in_use;
gCIP_ValvUL[7,6]:=E_Pis_Name.e0_not_in_use;

gCIP_ValvUL[8,1]:=E_Pis_Name.V4017;
gCIP_ValvUL[8,2]:=E_Pis_Name.v4027;
gCIP_ValvUL[8,3]:=E_Pis_Name.V2115;
gCIP_ValvUL[8,4]:=E_Pis_Name.V4034;
gCIP_ValvUL[8,5]:=E_Pis_Name.V4033;
gCIP_ValvUL[8,6]:=E_Pis_Name.e0_not_in_use;	

gCIP_ValvUL_Seat[1,1]:=0;
gCIP_ValvUL_Seat[1,2]:=1;
gCIP_ValvUL_Seat[1,3]:=1;
gCIP_ValvUL_Seat[1,4]:=0;
gCIP_ValvUL_Seat[1,5]:=0;
gCIP_ValvUL_Seat[1,6]:=0;

gCIP_ValvUL_Seat[2,1]:=0;
gCIP_ValvUL_Seat[2,2]:=1;
gCIP_ValvUL_Seat[2,3]:=1;
gCIP_ValvUL_Seat[2,4]:=0;
gCIP_ValvUL_Seat[2,5]:=0;
gCIP_ValvUL_Seat[2,6]:=0; // Client 2 eTank_2,
															
gCIP_ValvUL_Seat[3,1]:=0;
gCIP_ValvUL_Seat[3,2]:=0;
gCIP_ValvUL_Seat[3,3]:=1;
gCIP_ValvUL_Seat[3,4]:=1;
gCIP_ValvUL_Seat[3,5]:=0;
gCIP_ValvUL_Seat[3,6]:=0; // Client 3 eTank_3,
															
gCIP_ValvUL_Seat[4,1]:=0;
gCIP_ValvUL_Seat[4,2]:=0;
gCIP_ValvUL_Seat[4,3]:=1;
gCIP_ValvUL_Seat[4,4]:=1;
gCIP_ValvUL_Seat[4,5]:=0;
gCIP_ValvUL_Seat[4,6]:=0; // Client 4 eTank_4,
															
gCIP_ValvUL_Seat[5,1]:=0;
gCIP_ValvUL_Seat[5,2]:=1;
gCIP_ValvUL_Seat[5,3]:=1;
gCIP_ValvUL_Seat[5,4]:=0;
gCIP_ValvUL_Seat[5,5]:=0;
gCIP_ValvUL_Seat[5,6]:=0; // Client 5
															
gCIP_ValvUL_Seat[6,1]:=0;
gCIP_ValvUL_Seat[6,2]:=1;
gCIP_ValvUL_Seat[6,3]:=1;
gCIP_ValvUL_Seat[6,4]:=0;
gCIP_ValvUL_Seat[6,5]:=0;
gCIP_ValvUL_Seat[6,6]:=0; // Client 6
															
gCIP_ValvUL_Seat[7,1]:=0;
gCIP_ValvUL_Seat[7,2]:=0;
gCIP_ValvUL_Seat[7,3]:=0;
gCIP_ValvUL_Seat[7,4]:=0;
gCIP_ValvUL_Seat[7,5]:=0;
gCIP_ValvUL_Seat[7,6]:=0; // Client 7
									
gCIP_ValvUL_Seat[8,1]:=0;
gCIP_ValvUL_Seat[8,2]:=0;
gCIP_ValvUL_Seat[8,3]:=0;
gCIP_ValvUL_Seat[8,4]:=1;
gCIP_ValvUL_Seat[8,5]:=1;
gCIP_ValvUL_Seat[8,6]:=0; // Client 8 	
//***************************************************************************************											

CASE nStep_Vlv OF
	0:
		//waiting step
		IF bClean_MixProof 
		AND nClient<=8 
		AND nClient>0 
		AND tonr_CIP_Condition.IN
		THEN
			bValveCleanDone:=FALSE;
			sState:='Busy';
			nI_1_act_valve:=1;//active valve
			nI_2_act_pulses:=1;//active number of pulses
			nI_3_act_repeats:=1;//active number of retries
			tOn.IN:=FALSE;
			tOff.IN:=FALSE;
			nStep_Vlv:=1;
		ELSIF bClean_MixProof AND (nClient>8 OR nClient<=0) THEN
			nStep_Vlv:=999;
		END_IF
	1:
		bClean_MixProof:=FALSE;
		nI_2_act_pulses:=1;

		IF TRUE 
		AND gCIP_ValvUL[nClient,nI_1_act_valve]<E_Pis_Name.last 
		AND nI_1_act_valve<=nMaxValves 
		AND gCIP_ValvUL[nClient,nI_1_act_valve]>E_Pis_Name.e0_not_in_use THEN
			//existing step
			nStep_Vlv:=2;
		ELSE
			//DONE
			nStep_Vlv:=10;
		END_IF
		
	2:
		ActvValve:=gCIP_ValvUL[nClient,nI_1_act_valve];
		bSeatStatus:=gCIP_ValvUL_Seat[nClient,nI_1_act_valve];
		nStep_Vlv:=3;
	3:
		
		//Open Valve
			//
			
		IF bSeatStatus THEN
			//Upper
			g_Piston.stPis_U_L[ActvValve].req_Upper:=TRUE;
		ELSE
			//Lower 
			g_Piston.stPis_U_L[ActvValve].req_Lower:=TRUE;
		END_IF
			
		tOn.IN:=TRUE;
		tOff.IN:=FALSE;
		
		IF tOn.Q 
		AND ((g_Piston.stPis_U_L[ActvValve].st_Upper AND g_Piston.stPis_U_L[ActvValve].req_Upper)
				OR 
			(g_Piston.stPis_U_L[ActvValve].st_Lower AND g_Piston.stPis_U_L[ActvValve].req_Lower))
		THEN;
			nStep_Vlv:=4;
		END_IF
		
	4:
		//Close valve
			//
			
		IF bSeatStatus THEN
			//Upper
			g_Piston.stPis_U_L[ActvValve].req_Upper:=FALSE;
		ELSE
			//Lower 
			g_Piston.stPis_U_L[ActvValve].req_Lower:=FALSE;
		END_IF
			
		tOn.IN:=FALSE;
		tOff.IN:=TRUE;
		
		IF tOff.Q
		AND g_Piston.stPis_U_L[ActvValve].st_Released
		AND nI_2_act_pulses>=nNumOfPulses 
		THEN
			//fetch another valve
			IF nI_1_act_valve < nMaxValves THEN;
				nI_1_act_valve:=nI_1_act_valve+1;
				nStep_Vlv:=1;	
			ELSE;
				//DONE
				nStep_Vlv:=10;	
			END_IF

		ELSIF tOff.Q
		AND g_Piston.stPis_U_L[ActvValve].st_Released		
		AND nI_2_act_pulses<nNumOfPulses 
		AND TRUE THEN
			//return to open
			nI_2_act_pulses:=nI_2_act_pulses+1;
			nStep_Vlv:=3;
		END_IF
	10:
		IF nI_3_act_repeats<nNumOfRetries THEN
			//returnng to repeat
			nI_3_act_repeats:=nI_3_act_repeats+1;
			nI_1_act_valve:=1;
			nStep_Vlv:=1;
		ELSE
			//Done
			nStep_Vlv:=100;
		END_IF
	100:
		//Done
		bValveCleanDone:=TRUE;
		sState:='Done';
		nStep_Vlv:=0;
	999:
		//error incorrect Client number
		sState:='Error. Incorect Client name';
		
END_CASE 

IF nStep_Vlv<>0 
AND (NOT Ready.x)
AND (stOper[E_ModeZone.eCIP].iActOperation=E_OperationButtons.ePauseAll
	OR NOT tonr_CIP_Condition.IN)
THEN;
	m_MixProof_Release_All();
	nStep_Vlv:=0;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_Check_ProductionTank_Low_Level" Id="{b48f9a03-2e2f-4f01-a8db-812c2687100f}" FolderPath="Meth\">
      <Declaration><![CDATA[METHOD m_Check_ProductionTank_Low_Level : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TRUE
AND __ISVALIDREF(fbTank1.ref_fbTankSensors) 
AND __ISVALIDREF(fbTank2.ref_fbTankSensors) 
AND __ISVALIDREF(fbTank3.ref_fbTankSensors) 
AND __ISVALIDREF(fbTank4.ref_fbTankSensors) 
THEN;
	
	CASE eReq.eClient OF
		E_CIP_Usage.eTank_1:;
					IF NOT fbTank1.ref_fbTankSensors.senLL THEN;
						tonTankLowLevel.IN:=TRUE;
					ELSE;
						tonTankLowLevel.IN:=FALSE;
					END_IF
		E_CIP_Usage.eTank_2:;
					IF NOT fbTank2.ref_fbTankSensors.senLL THEN;
						tonTankLowLevel.IN:=TRUE;
					ELSE;
						tonTankLowLevel.IN:=FALSE;
					END_IF
		E_CIP_Usage.eTank_3:;
					IF NOT fbTank3.ref_fbTankSensors.senLL THEN;
						tonTankLowLevel.IN:=TRUE;
					ELSE;
						tonTankLowLevel.IN:=FALSE;
					END_IF
		E_CIP_Usage.eTank_4:;
					IF NOT fbTank4.ref_fbTankSensors.senLL THEN;
						tonTankLowLevel.IN:=TRUE;
					ELSE;
						tonTankLowLevel.IN:=FALSE;
					END_IF
		E_CIP_Usage.eLine_Marinada:;
		E_CIP_Usage.eLine_Color:;
		E_CIP_Usage.eTriBlender_Marinada,
		E_CIP_Usage.eTriBlender_Color:;
					
	END_CASE	
	
	tonTankLowLevel(PT:=T#2S);
	IF bClientTypeIs_Tank 
	AND tonTankLowLevel.Q
	THEN;
		m_Check_ProductionTank_Low_Level:=TRUE;
		fb_PumpClient.m_Stop();
	ELSIF NOT bClientTypeIs_Tank 
	THEN;
		m_Check_ProductionTank_Low_Level:=TRUE;
		fb_PumpClient.m_Stop();
	ELSE;
		m_Check_ProductionTank_Low_Level:=FALSE;
	END_IF
	
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_CleanEmpty_Spaces" Id="{a02513cf-5921-4270-b511-66d8a68458f2}" FolderPath="Meth\HMI_queue_pos\">
      <Declaration><![CDATA[METHOD m_CleanEmpty_Spaces : BOOL
VAR_INPUT
END_VAR

VAR
	i: INT;
	j: INT;
	stCIP_Request_Empty: ST_CIP_Request;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i:=0 TO 9 DO
	IF i<>0 OR NOT bRun THEN;
		IF arCIP_RequestBufer[i].eClient=E_CIP_Usage.eNotInUse THEN;
			FOR j:=i+1 TO 9 DO
				IF arCIP_RequestBufer[j].eClient<>E_CIP_Usage.eNotInUse THEN;
					arCIP_RequestBufer[i]:=arCIP_RequestBufer[j];
					arCIP_RequestBufer[j]:=stCIP_Request_Empty;
					EXIT;
				END_IF
			END_FOR
		END_IF		
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_ClientTank_IsEmpty" Id="{b35dd6ac-5e7d-4daa-9425-98b1cad5f40d}" FolderPath="Meth\">
      <Declaration><![CDATA[METHOD m_ClientTank_IsEmpty : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF __ISVALIDREF(ref_lvlTank_Client) 
AND bClientTypeIs_Tank
THEN;
	m_ClientTank_IsEmpty:=ref_lvlTank_Client.e_state=E_Tank_Level.eEmpty;
ELSE;
	m_ClientTank_IsEmpty:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_DashState_activate" Id="{02085a65-a2cd-4364-8e33-72b46cf78751}" FolderPath="Meth\Dashboard\">
      <Declaration><![CDATA[METHOD m_DashState_activate : BOOL
VAR_INPUT
	stage		: E_CIP_DashStage_List;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[	IF arCIP_DashStage_list[stage] = E_CIP_DashStage.eCIPStage_ToBeDone THEN;
		arCIP_DashStage_list[stage]:=E_CIP_DashStage.eCIPStage_Active;
		eCIP_DashStage_actual:=stage;
		sCIP_DashStage_actual:=TO_STRING(eCIP_DashStage_actual);	
		RETURN;
	END_IF

(*
FOR stage:=m_DashState_from() TO m_DashState_to() DO
	IF arCIP_DashStage_list[stage] = E_CIP_DashStage.eCIPStage_ToBeDone THEN;
		arCIP_DashStage_list[stage]:=E_CIP_DashStage.eCIPStage_Active;
		eCIP_DashStage_actual:=stage;
		sCIP_DashStage_actual:=TO_STRING(eCIP_DashStage_actual);	
		RETURN;
	END_IF
END_FOR
*)]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_DashState_done" Id="{7bac3818-529e-4a54-9082-0edd1812249d}" FolderPath="Meth\Dashboard\">
      <Declaration><![CDATA[METHOD m_DashState_done : BOOL
VAR_INPUT
	stage	: E_CIP_DashStage_List;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF arCIP_DashStage_list[stage] = E_CIP_DashStage.eCIPStage_Active THEN;
	arCIP_DashStage_list[stage]:=E_CIP_DashStage.eCIPStage_Done;
	RETURN;
END_IF

(*
FOR stage:=m_DashState_from() TO m_DashState_to() DO
	IF arCIP_DashStage_list[stage] = E_CIP_DashStage.eCIPStage_Active THEN;
		arCIP_DashStage_list[stage]:=E_CIP_DashStage.eCIPStage_Done;
		RETURN;
	END_IF
END_FOR
*)]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_DashState_from" Id="{517ea0a0-c223-471a-a5e8-76eedc4a5a7a}" FolderPath="Meth\Dashboard\">
      <Declaration><![CDATA[METHOD m_DashState_from : E_CIP_DashStage_List
VAR
	eActCIP_State	: E_Element_State_Long;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eActCIP_State:=eRefClient_fbElement.eState_Long;

CASE eActCIP_State OF
	E_Element_State_Long.eNotClean:;
		m_DashState_from:=E_CIP_DashStage_List.e01_CIP1_Client_Drain_Product_Rest_Pipe;	
		
	E_Element_State_Long.eCIP_1_Rinzed:;
		m_DashState_from:=E_CIP_DashStage_List.e03_CIP2_Local_Detergent_Fill;	
	
	E_Element_State_Long.eCIP_2_Deterged:;
		m_DashState_from:=E_CIP_DashStage_List.e08_CIP3_Detergent_Collect;	
	
	E_Element_State_Long.eCIP_3_Deterged_Clean:;
		m_DashState_from:=E_CIP_DashStage_List.e12_CIP4_Local_DisInfection_Fill;	
	
	E_Element_State_Long.eCIP_4_Sanitized:;
		m_DashState_from:=E_CIP_DashStage_List.e17_CIP5_DisInfection_Collect;	
	
ELSE;
	//???
		m_DashState_from:=E_CIP_DashStage_List.eLast;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_DashState_Get_ToBeDone_List" Id="{d256d03e-5646-4a44-97db-829d1963e250}" FolderPath="Meth\Dashboard\">
      <Declaration><![CDATA[METHOD m_DashState_Get_ToBeDone_List : BOOL
VAR
	//eActCIP_State	: E_Element_State_Long;
	//eCIP_req		: ST_CIP_Request;	
	stage			: E_CIP_DashStage_List;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//eActCIP_State:=eRefClient_fbElement.eState_Long;
//eCIP_req:=eReq;

//init
FOR stage:=E_CIP_DashStage_List.e00_NotSelected TO E_CIP_DashStage_List.eLast DO
	arCIP_DashStage_list[stage]:=E_CIP_DashStage.eCIPStage_NotAvalable;
END_FOR

//Start done condition stages
FOR stage:=E_CIP_DashStage_List.e00_NotSelected TO m_DashState_from()-1 DO
	IF m_DashState_Sprinkler(stage:=stage) THEN;
		IF bClientTypeIs_Tank THEN;
			arCIP_DashStage_list[stage]:=E_CIP_DashStage.eCIPStage_Done;
		ELSE;
			arCIP_DashStage_list[stage]:=E_CIP_DashStage.eCIPStage_NotAvalable;
		END_IF
	ELSE;
		arCIP_DashStage_list[stage]:=E_CIP_DashStage.eCIPStage_Done;
	END_IF
END_FOR

// Request conditions
FOR stage:=m_DashState_from() TO m_DashState_to() DO
	IF m_DashState_Sprinkler(stage:=stage) THEN;
		IF bClientTypeIs_Tank THEN;
			arCIP_DashStage_list[stage]:=E_CIP_DashStage.eCIPStage_ToBeDone;
		ELSE;
			arCIP_DashStage_list[stage]:=E_CIP_DashStage.eCIPStage_NotAvalable;
		END_IF
	ELSE;
		arCIP_DashStage_list[stage]:=E_CIP_DashStage.eCIPStage_ToBeDone;
	END_IF
END_FOR

//Do not requested 
FOR stage:=m_DashState_to()+1 TO E_CIP_DashStage_List.eLast DO
	IF m_DashState_Sprinkler(stage:=stage) THEN;
		IF bClientTypeIs_Tank THEN;
			arCIP_DashStage_list[stage]:=E_CIP_DashStage.eCIPStage_NotInUse;
		ELSE;
			arCIP_DashStage_list[stage]:=E_CIP_DashStage.eCIPStage_NotAvalable;
		END_IF
	ELSE;
		arCIP_DashStage_list[stage]:=E_CIP_DashStage.eCIPStage_NotInUse;
	END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_DashState_MixProof_set" Id="{ba88b8f4-7cb8-4ee8-ab8e-9017339c8295}" FolderPath="Meth\Dashboard\">
      <Declaration><![CDATA[METHOD m_DashState_MixProof_set : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(eRefClient_fbElement) THEN;
	RETURN;
END_IF
CASE eCIP_Usage OF
	E_CIP_Usage.eNotInUse,
	E_CIP_Usage.eLocal:;
		FOR i:=1 TO 6 DO
			g_HMI.arCIP_DashStage_MixProof[i].sName:='';
			g_HMI.arCIP_DashStage_MixProof[i].bUpper:=FALSE;
			g_HMI.arCIP_DashStage_MixProof[i].bLower:=FALSE;
			g_HMI.arCIP_DashStage_MixProof[i].bRunning:=FALSE;
			g_HMI.arCIP_DashStage_MixProof[i].bDone:=FALSE;
		END_FOR	
ELSE;
		FOR i:=1 TO 6 DO
			g_HMI.arCIP_DashStage_MixProof[i].sName:=TO_STRING(gCIP_ValvUL[eCIP_Usage,i]);
			g_HMI.arCIP_DashStage_MixProof[i].bUpper:=gCIP_ValvUL_Seat[eCIP_Usage,i];
			g_HMI.arCIP_DashStage_MixProof[i].bLower:=NOT gCIP_ValvUL_Seat[eCIP_Usage,i];
			g_HMI.arCIP_DashStage_MixProof[i].bRunning:= nI_1_act_valve=i AND nStep_Vlv<>0;
			g_HMI.arCIP_DashStage_MixProof[i].bDone:= (nI_1_act_valve>i AND nStep_Vlv<>0) OR bValveCleanDone;
		END_FOR	
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_DashState_Sprinkler" Id="{306d9d0f-c147-419d-8576-035700b09af5}" FolderPath="Meth\Dashboard\">
      <Declaration><![CDATA[METHOD m_DashState_Sprinkler : BOOL
VAR_INPUT
	stage: E_CIP_DashStage_List;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE stage OF 
	E_CIP_DashStage_List.e02_CIP1_Client_Drain_Product_Rest_Sprinkler,
	E_CIP_DashStage_List.e07_CIP2_Client_Detergent_Condition_Sprinkler,
	E_CIP_DashStage_List.e11_CIP3_Detergent_Clean_Sprinkler,
	E_CIP_DashStage_List.e16_CIP4_Client_DisInfection_Condition_Sprinkler,
	E_CIP_DashStage_List.e20_CIP5_DisInfection_Clean_Sprinkler:;
		m_DashState_Sprinkler:=TRUE;
ELSE;
		m_DashState_Sprinkler:=FALSE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_DashState_to" Id="{90469f15-32d0-4753-bd08-fb0af69e8ea7}" FolderPath="Meth\Dashboard\">
      <Declaration><![CDATA[METHOD m_DashState_to : E_CIP_DashStage_List
VAR
	eCIP_req		: ST_CIP_Request;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eCIP_req:=eReq;

CASE eCIP_req.eType OF
	E_CIP_Type.R_Water:;
		m_DashState_to:=E_CIP_DashStage_List.e02_CIP1_Client_Drain_Product_Rest_Sprinkler;
		
	E_CIP_Type.Detergent:;
		m_DashState_to:=E_CIP_DashStage_List.e11_CIP3_Detergent_Clean_Sprinkler;
	
	E_CIP_Type.Full:;
		m_DashState_to:=E_CIP_DashStage_List.e20_CIP5_DisInfection_Clean_Sprinkler;

ELSE;
	//???
		m_DashState_to:=E_CIP_DashStage_List.eLast;	
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_DashState_ToString_convertion" Id="{ac0b670d-4de4-4707-89c6-0875fdc96ae9}" FolderPath="Meth\Dashboard\">
      <Declaration><![CDATA[METHOD m_DashState_ToString_convertion : BOOL
VAR_INPUT
END_VAR

VAR
	eDashboard_CIP_State: E_CIP_DashStage_List:=E_CIP_DashStage_List.eLast;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR eDashboard_CIP_State:=0 TO E_CIP_DashStage_List.eLast DO
	//g_HMI.arCIP_DashStage_list[eDashboard_CIP_State]:=E_CIP_DashStage.eCIPStage_NotInUse;
	g_HMI.arCIP_DashStage_string[eDashboard_CIP_State]:=TO_STRING(eDashboard_CIP_State);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_MeasureTimeToHMI" Id="{6c49de4b-95a1-4fe1-b1b1-55f4c051916f}" FolderPath="Meth\">
      <Declaration><![CDATA[METHOD m_MeasureTimeToHMI : TIME
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF SFCCurrentStep='measureDelay_CIP2_1' THEN;
	m_MeasureTimeToHMI:=measureDelay_CIP2_1.t;
	
ELSIF SFCCurrentStep='measureDelay_CIP2_2' THEN;
	m_MeasureTimeToHMI:=measureDelay_CIP2_2.t;
	
ELSIF SFCCurrentStep='measureDelay_CIP3_1' THEN;
	m_MeasureTimeToHMI:=measureDelay_CIP3_1.t;
	
ELSIF SFCCurrentStep='measureDelay_CIP3_2' THEN;
	m_MeasureTimeToHMI:=measureDelay_CIP3_2.t;

ELSE;
	m_MeasureTimeToHMI:=T#0S;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_MixProof_Release_All" Id="{1ab3387d-433c-48b8-b836-ebaa8cac6bd9}">
      <Declaration><![CDATA[METHOD m_MixProof_Release_All : BOOL
VAR_INPUT
END_VAR
VAR
	i: INT;
	j: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i:=1 TO 8 DO
	FOR j:=1 TO 6 DO
		ActvValve:=gCIP_ValvUL[i,j];
		g_Piston.stPis_U_L[ActvValve].req_Lower:=FALSE;
		g_Piston.stPis_U_L[ActvValve].req_Upper:=FALSE;
	END_FOR
END_FOR


FOR i:=1 TO 8 DO
	FOR j:=1 TO 6 DO
		ActvValve:=gCIP_ValvUL[i,j];
		IF g_Piston.stPis_U_L[ActvValve].exist
		AND NOT g_Piston.stPis_U_L[ActvValve].st_Released THEN;
			m_MixProof_Release_All:=FALSE;
			RETURN;
		END_IF
	END_FOR
END_FOR

m_MixProof_Release_All:=TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_OverFlowCorrect" Id="{3d927e50-569d-481a-ab49-43c1ca44dff1}" FolderPath="Meth\">
      <Declaration><![CDATA[METHOD m_OverFlowCorrect : REAL
VAR_INPUT
	rTc		:	REAL	;//Target concentration
	rAv		:	REAL	;//Actual volume
	rAc		:	REAL	;//Actual concentration
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Calculating the additional valume of fresh water to dalute the concentration
IF rTc=0 THEN;
	m_OverFlowCorrect:=0;
ELSE;
	m_OverFlowCorrect:=((rAv*rAc/100)/(rTc/100))-(rAv*rAc/100)-rAv+(rAv*rAc/100);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PosDelete_HMI" Id="{5ecfed30-e439-4aa1-8486-4d270c40480b}" FolderPath="Meth\HMI_queue_pos\">
      <Declaration><![CDATA[METHOD m_PosDelete_HMI : BOOL
VAR_INPUT
END_VAR
VAR
	stCIP_Request_Empty: ST_CIP_Request;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF iPosSelect_HMI>=0 AND iPosSelect_HMI<9 THEN;
	IF iPosSelect_HMI<>0 OR NOT bRun THEN;
		arCIP_RequestBufer[iPosSelect_HMI]:=stCIP_Request_Empty;
	END_IF		
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PosDeleteAll_HMI" Id="{0565b103-e72e-4e42-86f5-de0bd5b6f5d7}" FolderPath="Meth\HMI_queue_pos\">
      <Declaration><![CDATA[METHOD m_PosDeleteAll_HMI : BOOL
VAR_INPUT
END_VAR
VAR
	stCIP_Request_Empty: ST_CIP_Request;
	i: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
FOR i:=0 TO 9 DO
	IF i<>0 OR NOT bRun THEN;
		arCIP_RequestBufer[i]:=stCIP_Request_Empty;
	END_IF	
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PosMove_Down_HMI" Id="{c114e84d-a8ed-4e16-9653-147f733c0d8b}" FolderPath="Meth\HMI_queue_pos\">
      <Declaration><![CDATA[METHOD m_PosMove_Down_HMI : BOOL
VAR_INPUT
END_VAR
VAR
	stCIP_Request_Temp: ST_CIP_Request;
	i: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF iPosSelect_HMI>=0 AND iPosSelect_HMI<9 THEN;
	IF iPosSelect_HMI<>0 OR NOT bRun THEN;		
			IF ((arCIP_RequestBufer[iPosSelect_HMI].eType=E_CIP_Type.R_Water 
				AND (arCIP_RequestBufer[iPosSelect_HMI+1].eType=E_CIP_Type.Detergent 
				OR arCIP_RequestBufer[iPosSelect_HMI+1].eType=E_CIP_Type.Full)) 
			OR (arCIP_RequestBufer[iPosSelect_HMI].eType=E_CIP_Type.Detergent 				
				AND arCIP_RequestBufer[iPosSelect_HMI+1].eType=E_CIP_Type.Full))
			AND (arCIP_RequestBufer[iPosSelect_HMI+1].eClient=arCIP_RequestBufer[iPosSelect_HMI].eClient) 
			THEN
				;
			ELSE
				stCIP_Request_Temp:=arCIP_RequestBufer[iPosSelect_HMI+1];
				arCIP_RequestBufer[iPosSelect_HMI+1]:=arCIP_RequestBufer[iPosSelect_HMI];
				arCIP_RequestBufer[iPosSelect_HMI]:=stCIP_Request_Temp;
				iPosSelect_HMI:=iPosSelect_HMI+1;	
			END_IF	
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PosMove_Up_HMI" Id="{882d4194-9591-429b-a6de-feb8c47cbd4c}" FolderPath="Meth\HMI_queue_pos\">
      <Declaration><![CDATA[METHOD m_PosMove_Up_HMI : BOOL
VAR_INPUT
END_VAR
VAR
	stCIP_Request_Temp: ST_CIP_Request;
	i: INT;
	m: bool;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF iPosSelect_HMI>0 AND iPosSelect_HMI<=9 THEN;
	IF iPosSelect_HMI<>1 OR NOT bRun THEN;			
			IF ((arCIP_RequestBufer[iPosSelect_HMI].eType=e_cip_type.Full 
				AND (arCIP_RequestBufer[iPosSelect_HMI-1].eType=E_CIP_Type.Detergent 
				OR arCIP_RequestBufer[iPosSelect_HMI-1].eType=E_CIP_Type.R_Water)) 
			OR (arCIP_RequestBufer[iPosSelect_HMI].eType=E_CIP_Type.Detergent 
				AND arCIP_RequestBufer[iPosSelect_HMI-1].eType=E_CIP_Type.R_Water))
			AND (arCIP_RequestBufer[iPosSelect_HMI-1].eClient=arCIP_RequestBufer[iPosSelect_HMI].eClient) 
			THEN
				;
			ELSE
				stCIP_Request_Temp:=arCIP_RequestBufer[iPosSelect_HMI-1];
				arCIP_RequestBufer[iPosSelect_HMI-1]:=arCIP_RequestBufer[iPosSelect_HMI];
				arCIP_RequestBufer[iPosSelect_HMI]:=stCIP_Request_Temp;
				iPosSelect_HMI:=iPosSelect_HMI-1;
			END_IF	
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_run_MixProof" Id="{85b46243-a5be-4f92-aac7-41082da3dd8d}" FolderPath="Manage\">
      <Declaration><![CDATA[METHOD m_run_MixProof : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bValveCleanDone THEN;
	m_run_MixProof:=TRUE;
	bClean_MixProof:=FALSE;
ELSE;
	bClean_MixProof:=TRUE;
END_IF

m_DashState_MixProof_set();]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Set_SFCFlags_Reference" Id="{3959a842-c714-4552-9594-b319ee26bb78}" FolderPath="Meth\">
      <Declaration><![CDATA[METHOD m_Set_SFCFlags_Reference : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Set reference to SFC flags

refSFC.SFCInit REF= SFCInit;
refSFC.SFCReset REF= SFCReset;
refSFC.SFCError REF= SFCError;
refSFC.SFCEnableLimit REF= SFCEnableLimit;
refSFC.SFCErrorStep REF= SFCErrorStep;
refSFC.SFCErrorPOU REF= SFCErrorPOU;
refSFC.SFCQuitError REF= SFCQuitError;
refSFC.SFCPause REF= SFCPause;
refSFC.SFCTrans REF= SFCTrans;
refSFC.SFCCurrentStep REF= SFCCurrentStep;
refSFC.SFCTip REF= SFCTip;
refSFC.SFCTipMode REF= SFCTipMode;

// Cycle handle for SFC
m_SFC_Handle();]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_TakePosInCIPBuffer" Id="{b2dcb157-1d24-4a20-a9df-81a455a5e4d3}" FolderPath="Meth\HMI_queue_pos\">
      <Declaration><![CDATA[METHOD m_TakePosInCIPBuffer : BOOL
VAR_INPUT
	stCIP_Request: ST_CIP_Request;
END_VAR

VAR
	i: INT;
	m: bool;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stCIP_Request.eClient<>E_CIP_Usage.eNotInUse
AND stCIP_Request.eType<>E_CIP_Type.NotSelected
AND g_data.fbElement[stCIP_Request.eClient].eState_Long>E_Element_State_Long.eStandby 
AND ((stCIP_Request.eType=E_CIP_Type.R_Water AND g_data.fbElement[stCIP_Request.eClient].eState_Long<E_Element_State_Long.eCIP_1_Rinzed)
	OR (stCIP_Request.eType=E_CIP_Type.Detergent AND g_data.fbElement[stCIP_Request.eClient].eState_Long<E_Element_State_Long.eCIP_3_Deterged_Clean)
	OR (stCIP_Request.eType=E_CIP_Type.Full AND g_data.fbElement[stCIP_Request.eClient].eState_Long<E_Element_State_Long.eCIP_5_Done))

THEN
	FOR i:=0 TO 9 DO
		IF arCIP_RequestBufer[i].eClient=stCIP_Request.eClient 
			AND arCIP_RequestBufer[i].eType>=stCIP_Request.eType 
		THEN 	
				m:=FALSE;
				EXIT;
			ELSE
				m:=TRUE;
		END_IF
	END_FOR	
	IF m=TRUE THEN
		FOR i:=0 TO 9 DO
			IF arCIP_RequestBufer[i].eClient=E_CIP_Usage.eNotInUse 
			THEN;
				arCIP_RequestBufer[i]:=stCIP_Request;
				m:=FALSE;
				EXIT;
			END_IF
		END_FOR	
	END_IF
ELSIF stCIP_Request.eClient=E_CIP_Usage.eLocal
AND stCIP_Request.eType<>E_CIP_Type.NotSelected
THEN;
		FOR i:=0 TO 9 DO
			IF arCIP_RequestBufer[i].eClient=E_CIP_Usage.eNotInUse 
			THEN;
				arCIP_RequestBufer[i]:=stCIP_Request;
				m:=FALSE;
				EXIT;
			END_IF
		END_FOR		
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="mCIP_Clients_command" Id="{80c84e09-bced-4039-86dd-22d66f3f838c}" FolderPath="Meth\">
      <Declaration><![CDATA[METHOD mCIP_Clients_command : BOOL
VAR_INPUT
	command: E_CIP_Client_Command ;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
//eReq.eClient<>E_CIP_Usage.eLocal
IF command=E_CIP_Client_Command.eDrain THEN;
	CASE eReq.eClient OF
		E_CIP_Usage.eTank_1:;
			g_Data.fbTankTarget_1.m_Run(eReqProc:=E_Tank_Target.eDrain);
		E_CIP_Usage.eTank_2:;
			g_Data.fbTankTarget_2.m_Run(eReqProc:=E_Tank_Target.eDrain);	
		E_CIP_Usage.eTank_3:;
			g_Data.fbTankTarget_3.m_Run(eReqProc:=E_Tank_Target.eDrain);	
		E_CIP_Usage.eTank_4:;
			g_Data.fbTankTarget_4.m_Run(eReqProc:=E_Tank_Target.eDrain);	
		E_CIP_Usage.eTriBlender_Marinada:;
			g_Data.fbTriBlenderSource_Marinade.m_Run(eReqProc:=E_Line_Source.eDrain);	
			g_Data.fbTriBlenderTarget_Marinade.m_Run(eReqProc:=E_Line_Target.eDrain);	
		E_CIP_Usage.eTriBlender_Color:;
			g_Data.fbTriBlenderSource_Color.m_Run(eReqProc:=E_Line_Source.eDrain);	
			g_Data.fbTriBlenderTarget_Color.m_Run(eReqProc:=E_Line_Target.eDrain);		
		E_CIP_Usage.eLine_Marinada:;
			g_Data.fbLineSource_Marinade.m_Run(eReqProc:=E_Line_Source.eDrain);	
			g_Data.fbLineTarget_Marinade.m_Run(eReqProc:=E_Line_Target.eDrain);	
		E_CIP_Usage.eLine_Color:;
			g_Data.fbLineSource_Color.m_Run(eReqProc:=E_Line_Source.eDrain);	
			g_Data.fbLineTarget_Color.m_Run(eReqProc:=E_Line_Target.eDrain);	
	ELSE;
		//wrong, - local
	END_CASE	
ELSIF command=E_CIP_Client_Command.eCIP THEN;
	CASE eReq.eClient OF
		E_CIP_Usage.eTank_1:;
			g_Data.fbTankTarget_1.m_Run(eReqProc:=E_Tank_Target.eCIP);
		E_CIP_Usage.eTank_2:;
			g_Data.fbTankTarget_2.m_Run(eReqProc:=E_Tank_Target.eCIP);	
		E_CIP_Usage.eTank_3:;
			g_Data.fbTankTarget_3.m_Run(eReqProc:=E_Tank_Target.eCIP);	
		E_CIP_Usage.eTank_4:;
			g_Data.fbTankTarget_4.m_Run(eReqProc:=E_Tank_Target.eCIP);	
		E_CIP_Usage.eTriBlender_Marinada:;
			g_Data.fbTriBlenderSource_Marinade.m_Run(eReqProc:=E_Line_Source.eCIP);	
			g_Data.fbTriBlenderTarget_Marinade.m_Run(eReqProc:=E_Line_Target.eCIP);	
		E_CIP_Usage.eTriBlender_Color:;
			g_Data.fbTriBlenderSource_Color.m_Run(eReqProc:=E_Line_Source.eCIP);	
			g_Data.fbTriBlenderTarget_Color.m_Run(eReqProc:=E_Line_Target.eCIP);		
		E_CIP_Usage.eLine_Marinada:;
			g_Data.fbLineSource_Marinade.m_Run(eReqProc:=E_Line_Source.eCIP);	
			g_Data.fbLineTarget_Marinade.m_Run(eReqProc:=E_Line_Target.eCIP);	
		E_CIP_Usage.eLine_Color:;
			g_Data.fbLineSource_Color.m_Run(eReqProc:=E_Line_Source.eCIP);	
			g_Data.fbLineTarget_Color.m_Run(eReqProc:=E_Line_Target.eCIP);	
	ELSE;
		//wrong, - local
	END_CASE	
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mCIP_Clients_status" Id="{ef5af15a-35a7-4e4b-8e95-aba37ca0b182}" FolderPath="Meth\">
      <Declaration><![CDATA[METHOD mCIP_Clients_status : BOOL
VAR_INPUT
	command: E_CIP_Client_Command ;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
//eReq.eClient<>E_CIP_Usage.eLocal
IF command=E_CIP_Client_Command.eDrain THEN;
	CASE eReq.eClient OF
		E_CIP_Usage.eTank_1:;
			IF g_Data.fbTankTarget_1.m_CheckStatus(eReqStatus:=E_Tank_Target.eDrain) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF
		E_CIP_Usage.eTank_2:;
			IF g_Data.fbTankTarget_2.m_CheckStatus(eReqStatus:=E_Tank_Target.eDrain) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
		E_CIP_Usage.eTank_3:;
			IF g_Data.fbTankTarget_3.m_CheckStatus(eReqStatus:=E_Tank_Target.eDrain) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
		E_CIP_Usage.eTank_4:;
			IF g_Data.fbTankTarget_4.m_CheckStatus(eReqStatus:=E_Tank_Target.eDrain) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
		E_CIP_Usage.eTriBlender_Marinada:;
			IF  g_Data.fbTriBlenderSource_Marinade.m_CheckStatus(eReqStatus:=E_Line_Source.eDrain) 
			AND g_Data.fbTriBlenderTarget_Marinade.m_CheckStatus(eReqStatus:=E_Line_Target.eDrain) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF
		E_CIP_Usage.eTriBlender_Color:;
			IF  g_Data.fbTriBlenderSource_Color.m_CheckStatus(eReqStatus:=E_Line_Source.eDrain) 
			AND g_Data.fbTriBlenderTarget_Color.m_CheckStatus(eReqStatus:=E_Line_Target.eDrain) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF		
		E_CIP_Usage.eLine_Marinada:;
			IF  g_Data.fbLineSource_Marinade.m_CheckStatus(eReqStatus:=E_Line_Source.eDrain) 
			AND g_Data.fbLineTarget_Marinade.m_CheckStatus(eReqStatus:=E_Line_Target.eDrain) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
		E_CIP_Usage.eLine_Color:;
			IF  g_Data.fbLineSource_Color.m_CheckStatus(eReqStatus:=E_Line_Source.eDrain) 
			AND g_Data.fbLineTarget_Color.m_CheckStatus(eReqStatus:=E_Line_Target.eDrain) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
	ELSE;// local
		mCIP_Clients_status:=TRUE;
	END_CASE	
ELSIF command=E_CIP_Client_Command.eCIP THEN;
	CASE eReq.eClient OF
		E_CIP_Usage.eTank_1:;
			IF g_Data.fbTankTarget_1.m_CheckStatus(eReqStatus:=E_Tank_Target.eCIP) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF
		E_CIP_Usage.eTank_2:;
			IF g_Data.fbTankTarget_2.m_CheckStatus(eReqStatus:=E_Tank_Target.eCIP) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
		E_CIP_Usage.eTank_3:;
			IF g_Data.fbTankTarget_3.m_CheckStatus(eReqStatus:=E_Tank_Target.eCIP) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
		E_CIP_Usage.eTank_4:;
			IF g_Data.fbTankTarget_4.m_CheckStatus(eReqStatus:=E_Tank_Target.eCIP) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
		E_CIP_Usage.eTriBlender_Marinada:;
			IF  g_Data.fbTriBlenderSource_Marinade.m_CheckStatus(eReqStatus:=E_Line_Source.eCIP) 
			AND g_Data.fbTriBlenderTarget_Marinade.m_CheckStatus(eReqStatus:=E_Line_Target.eCIP) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF
		E_CIP_Usage.eTriBlender_Color:;
			IF  g_Data.fbTriBlenderSource_Color.m_CheckStatus(eReqStatus:=E_Line_Source.eCIP) 
			AND g_Data.fbTriBlenderTarget_Color.m_CheckStatus(eReqStatus:=E_Line_Target.eCIP) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF		
		E_CIP_Usage.eLine_Marinada:;
			IF  g_Data.fbLineSource_Marinade.m_CheckStatus(eReqStatus:=E_Line_Source.eCIP) 
			AND g_Data.fbLineTarget_Marinade.m_CheckStatus(eReqStatus:=E_Line_Target.eCIP) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
		E_CIP_Usage.eLine_Color:;
			IF  g_Data.fbLineSource_Color.m_CheckStatus(eReqStatus:=E_Line_Source.eCIP) 
			AND g_Data.fbLineTarget_Color.m_CheckStatus(eReqStatus:=E_Line_Target.eCIP) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
	ELSE;// local
		mCIP_Clients_status:=TRUE;
	END_CASE	
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mFillWater" Id="{c38e9eb6-e5ec-4b46-a443-d362a1ec1959}" FolderPath="Meth\">
      <Declaration><![CDATA[METHOD mFillWater : BOOL
VAR_INPUT
END_VAR

VAR
	reqVolume: REAL;	
	valve : E_Pis_Name;;
	actLevel: REAL;
	fillCondition: BOOL;	
	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TRUE 
AND fbPis.m_CheckByRecipe(stPis:=stPis_FillWater_T91, req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_FillWater_T92, req:=E_Piston_Recipe_State.Release)
AND fbPis.m_CheckByRecipe(stPis:=stPis_FillWater_T93, req:=E_Piston_Recipe_State.Release)
AND bStateSafe
AND MAIN.bTemp_Water_Overweight_check
THEN;
	fillCondition:=TRUE;
ELSE;
	fillCondition:=FALSE;
END_IF

reqVolume:=st_CIP_Param.r_Tank94_Volume;
IF g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Tank94_Volume>reqVolume THEN;
	reqVolume:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Tank94_Volume;
END_IF

fbHysteresisFillT94(
	fIn:= lvlTank_T94.rTankLevel, 
	fHigh:= reqVolume, 
	fLow:= reqVolume-50.0, 
	iDigitsAfterDot:= 1, 
	bOut=> );

IF eMode<>E_CIP_Mode.eOff THEN;
	IF fbPis.m_CheckByRecipe(stPis:=stPis_FillWater_T94, req:=E_Piston_Recipe_State.Act) 
	AND (NOT fbHysteresisFillT94.bOut
	OR NOT fillCondition)
	THEN;
		//stPis_FillWater_T94.req_Close:=TRUE;
		fbPis.m_SetByRecipe(stPis:=stPis_FillWater_T94, req:=E_Piston_Recipe_State.Release);
		
	ELSIF fbPis.m_CheckByRecipe(stPis:=stPis_FillWater_T94, req:=E_Piston_Recipe_State.Release) 
	AND fbHysteresisFillT94.bOut
	AND fillCondition
	THEN;
		IF NOT arrTanksSens[E_Tank_Name.T94].get_stTankLevel_OverFlow() THEN;
			fbPis.m_SetByRecipe(stPis:=stPis_FillWater_T94, req:=E_Piston_Recipe_State.Act);			
		END_IF	
	END_IF	
END_IF
	
	
(*
fbFillT94(	
		valve:= valFillWater_T94, 
		reqLevel:= reqVolume, 
		actLevel:= lvlTank_T94.rTankLevel, 
		fillCondition:= );
*)		]]></ST>
      </Implementation>
    </Method>
    <Method Name="mLoadDefProcessSetPoints" Id="{6622ea5b-b543-4ab8-8397-ed9f64ee15e5}" FolderPath="Meth\">
      <Declaration><![CDATA[METHOD mLoadDefProcessSetPoints : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
	stDetergent.ToleranceHigh:=0.05;
	stDetergent.ToleravceLow:=0.05;
	stTemperature_Deterg.ToleranceHigh:=1;
	stTemperature_Deterg.ToleravceLow:=1;
	stDisInfectant.ToleranceHigh:=0.05;
	stDisInfectant.ToleravceLow:=0.05;
	stTemperature_Dis.ToleranceHigh:=1;//0.5
	stTemperature_Dis.ToleravceLow:=1;//0.5
	stFlow1_Rate.ToleranceHigh:=10;
	stFlow1_Rate.ToleravceLow:=10;
	stFlow2_Rate.ToleranceHigh:=10;
	stFlow2_Rate.ToleravceLow:=10;
	stColor_Level.ToleranceHigh:=10;
	stColor_Level.ToleravceLow:=10;
	stMarinada_Level.ToleranceHigh:=10;
	stMarinada_Level.ToleravceLow:=10;
	stPressure.ToleranceHigh:=1;
	stPressure.ToleravceLow:=1;
	]]></ST>
      </Implementation>
    </Method>
    <Method Name="mProcessDeviation" Id="{7347b3a8-56cd-4c5d-bbbb-7da59378f31e}" FolderPath="Meth\">
      <Declaration><![CDATA[METHOD mProcessDeviation : REAL
VAR_INPUT
	reqValue: REAL;
	processValue: REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[mProcessDeviation:=reqValue-processValue;]]></ST>
      </Implementation>
