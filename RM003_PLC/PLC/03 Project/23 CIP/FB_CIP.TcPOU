    <Action Name="_aStartPump_CIP2_RPM_01_active" Id="{926fdc44-d8f2-4656-9732-79a85aef1568}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
fb_PumpCIP.m_Run(RPM:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_CIP_Pump);//1500

IF TRUE //Future condition
AND StartPump_CIP2_RPM_01.t>SECOND_TO_TIME(g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].t_PumpInitRun) 
AND fb_PumpCIP.nRPM=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_CIP_Pump
//AND stAnalogSensor[E_ASense_Name.FT1001].Value>=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Flow_Pipe // 
//AND stAnalogSensor[E_ASense_Name.FT1002].Value>=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Flow_Pipe // 
THEN;
	bStepDone:=TRUE;
END_IF
]]></ST>
