    <Action Name="_aCIP4_Conn_Sprinkler_active" Id="{e4186464-92a5-4be4-b6cb-cca91a77c405}">
      <Implementation>
        <ST><![CDATA[//Connect client tank to sprinkler
CASE eReq.eClient OF
	
	E_CIP_Usage.eTank_1:;
				bStepDone:=fbCIP_ClientTank_Marinade.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_A_Sprinkler);
	E_CIP_Usage.eTank_2:;
				bStepDone:=fbCIP_ClientTank_Marinade.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_B_Sprinkler);	
	E_CIP_Usage.eTank_3:;
				bStepDone:=fbCIP_ClientTank_Color.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_A_Sprinkler);
	E_CIP_Usage.eTank_4:;
				bStepDone:=fbCIP_ClientTank_Color.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_B_Sprinkler);	

ELSE;				
	bStepDone:=FALSE;
END_CASE
]]></ST>
      </Implementation>
