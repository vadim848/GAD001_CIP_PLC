			AND g_Data.fbLineTarget_Color.m_CheckStatus(eReqStatus:=E_Line_Target.eCIP) THEN;
				bStepDone:=TRUE;
			ELSE;
				bStepDone:=FALSE;	
			END_IF	
	ELSE;
