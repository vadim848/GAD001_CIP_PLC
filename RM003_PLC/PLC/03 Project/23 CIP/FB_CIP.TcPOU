    <Action Name="_aCIP3_Conn_Sprinkler_entry" Id="{2d20e61c-61b4-4d4d-a421-445dee37edfa}">
      <Implementation>
        <ST><![CDATA[bSprinkler:=TRUE;
CASE eReq.eClient OF

	E_CIP_Usage.eTank_1:;
				fbCIP_ClientTank_Marinade.m_Run(eReqProc:=E_CIP_ClientTank.eTank_A_Sprinkler);
	E_CIP_Usage.eTank_2:;
				fbCIP_ClientTank_Marinade.m_Run(eReqProc:=E_CIP_ClientTank.eTank_B_Sprinkler);	
	E_CIP_Usage.eTank_3:;
				fbCIP_ClientTank_Color.m_Run(eReqProc:=E_CIP_ClientTank.eTank_A_Sprinkler);
	E_CIP_Usage.eTank_4:;
				fbCIP_ClientTank_Color.m_Run(eReqProc:=E_CIP_ClientTank.eTank_B_Sprinkler);	

END_CASE
tonr_CIP_Condition(ResetTime:=TRUE);]]></ST>
