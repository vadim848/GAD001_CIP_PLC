    <Action Name="_aDisconnect_CIP_Client_active" Id="{0908cf68-67b7-4a91-b7fc-e2282fd9e163}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;

IF fbCIP_Source.m_CheckStatus(eReqStatus:=E_CIP_Source.eClose) 
AND fbCIP_Usage.m_CheckStatus(eReqStatus:=E_CIP_Usage.eLocal) 
AND fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eDrain)
AND mCIP_Clients_status(command:=E_CIP_Client_Command.eDrain)
THEN

	CASE eReq.eClient OF
	
		E_CIP_Usage.eTank_1:;
					bStepDone:=fbCIP_ClientTank_Marinade.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eDrain);
		E_CIP_Usage.eTank_2:;
					bStepDone:=fbCIP_ClientTank_Marinade.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eDrain);	
		E_CIP_Usage.eTank_3:;
					bStepDone:=fbCIP_ClientTank_Color.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eDrain);
		E_CIP_Usage.eTank_4:;
					bStepDone:=fbCIP_ClientTank_Color.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eDrain);	
		E_CIP_Usage.eTriBlender_Color,
		E_CIP_Usage.eTriBlender_Marinada:;
					bStepDone:=fbTriBlender_Select.m_CheckStatus(eReqStatus:=E_TriBlenderSelect.eDrain);											
	ELSE;				
		bStepDone:=TRUE;
	END_CASE
	
END_IF]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
