    <Action Name="_aCIP2_Flow_Sprincler_active" Id="{2abfbe97-fb20-494a-be0b-de7a5d389ef0}">
      <Implementation>
        <ST><![CDATA[fb_PumpCIP.m_Run(RPM:=pcFlow1_Rate.mRun_PID(Set_Point:=fFlowRate, controlManual:=NOT(fb_PumpCIP.modeAuto)));
fb_PumpClient.m_Run(RPM:=st_CIP_Param.r_CIP_Client_Pump);

IF TRUE 
AND pcFlow1_Rate.mRun()
AND pcFlow2_Rate.mRun()
//AND pcPressure.mRun()
THEN;
	tonStepConditionTime.IN:=TRUE;
ELSE;
	tonStepConditionTime.IN:=FALSE;
END_IF

tonStepConditionTime(PT:=T#10S);
IF tonStepConditionTime.Q THEN;
	bStepDone:=TRUE;
ELSE;
	bStepDone:=FALSE;
END_IF

]]></ST>
      </Implementation>
