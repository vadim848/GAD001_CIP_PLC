AND stAnalogSensor[E_ASense_Name.FT1002].Value>=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Flow_2 // 
AND stAnalogSensor[E_ASense_Name.PT1001].Value>=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Pressure // 
THEN;
	bStepDone:=TRUE;
ELSE;
	bStepDone:=FALSE;
END_IF


IF TRUE //Future condition
AND StartPump_CIP2_01.t>TO_TIME(g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].t_PumpStartTime*1000) THEN;
	fb_PumpCIP.m_Run(RPM:=pcFlow_Rate.mRun_PID(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Flow_1));
END_IF]]></ST>
