      <Implementation>
        <ST><![CDATA[fbCIP_Source.m_Run(eReqProc:=E_CIP_Source.eT94_Water);
fbCIP_Usage.m_Run(eReqProc:=eReq.eClient);

mCIP_Clients_command(command:=E_CIP_Client_Command.eCIP);



CASE eRefClient_fbElement.eState_Long OF
	E_Element_State_Long.eCIP_2_Deterged:;
			fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eT92_Detergent);
		
	E_Element_State_Long.eCIP_4_Sanitized:;
			fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eT91_Sanitation);				
END_CASE

CASE eReq.eClient OF

	E_CIP_Usage.eTank_1:;
				fbCIP_ClientTank_Marinade.m_Run(eReqProc:=E_CIP_ClientTank.eTank_A);
	E_CIP_Usage.eTank_2:;
				fbCIP_ClientTank_Marinade.m_Run(eReqProc:=E_CIP_ClientTank.eTank_B);	
	E_CIP_Usage.eTank_3:;
				fbCIP_ClientTank_Color.m_Run(eReqProc:=E_CIP_ClientTank.eTank_A);
	E_CIP_Usage.eTank_4:;
				fbCIP_ClientTank_Color.m_Run(eReqProc:=E_CIP_ClientTank.eTank_A);	

END_CASE
]]></ST>
