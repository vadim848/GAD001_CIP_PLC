      <Implementation>
        <ST><![CDATA[fb_PumpCIP.m_Run(RPM:=st_CIP_Param.r_CIP_Pump);
fb_PumpClient.m_Run(RPM:=st_CIP_Param.r_CIP_Client_Pump);

bStepDone:=FALSE;
volume_Requered:= REAL_TO_INT(st_CIP_Param.r_Volume_Solution_Fill);
volume_Actual:= REAL_TO_INT(-delta_T91_Volume);

IF volume_Actual >= volume_Requered THEN;
	bStepDone:=TRUE;
END_IF]]></ST>
