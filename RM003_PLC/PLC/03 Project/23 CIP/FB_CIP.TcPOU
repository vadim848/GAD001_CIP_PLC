    <Action Name="_aConnect_CIP1_Drain_active" Id="{027bf863-1ae4-4bdd-8945-394ab7bb998b}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;

IF fbCIP_Source.m_CheckStatus(eReqStatus:=E_CIP_Source.eT93_R_Water) 
AND fbCIP_Usage.m_CheckStatus(eReqStatus:=eReq.eClient)
AND mCIP_Clients_status(command:=E_CIP_Client_Command.eCIP)
THEN

	CASE eReq.eClient OF
	
		E_CIP_Usage.eTank_1:;
					bStepDone:=fbCIP_ClientTank_Marinade.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_A);
		E_CIP_Usage.eTank_2:;
					bStepDone:=fbCIP_ClientTank_Marinade.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_B);	
		E_CIP_Usage.eTank_3:;
					bStepDone:=fbCIP_ClientTank_Color.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_A);
		E_CIP_Usage.eTank_4:;
					bStepDone:=fbCIP_ClientTank_Color.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_B);	
	ELSE;				
		bStepDone:=TRUE;
	END_CASE
	
END_IF

]]></ST>
      </Implementation>
