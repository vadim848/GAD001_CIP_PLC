    <Action Name="_aStartPump_CIP3_02_active" Id="{f64d81b7-93d0-4d81-9b19-fca829dbaa54}">
      <Implementation>
        <ST><![CDATA[IF TRUE 
(*AND stAnalogSensor[E_ASense_Name.FT1001].Value>=st_CIP_Param.r_Flow_1 // 
AND stAnalogSensor[E_ASense_Name.FT1002].Value>=st_CIP_Param.r_Flow_2 // 
AND stAnalogSensor[E_ASense_Name.PT1001].Value>=st_CIP_Param.r_Pressure // *)
AND pcFlow1_Rate.mRun()
AND pcFlow2_Rate.mRun()
//AND pcPressure.mRun()
THEN;
	bStepDone:=TRUE;
ELSE;
	bStepDone:=FALSE;
END_IF

//fb_PumpCIP.m_Run(RPM:=pcFlow1_Rate.mRun_PID(Set_Point:=fFlowRate,controlManual:=NOT(fb_PumpCIP.modeAuto)));
//fb_PumpClient.m_Run(RPM:=pcFlow2_Rate.mRun_PID(Set_Point:=fFlowRate,controlManual:=NOT(fb_PumpCIP.modeAuto)));

IF TRUE //Future condition
AND StartPump_CIP3_02.t>SECOND_TO_TIME(st_CIP_Param.t_PumpInitRun) THEN;
	fb_PumpCIP.m_Run(RPM:=pcFlow1_Rate.mRun_PID(Set_Point:=fFlowRate,controlManual:=NOT(fb_PumpCIP.modeAuto)));
	fb_PumpClient.m_Run(RPM:=st_CIP_Param.r_CIP_Client_Pump);
END_IF

IF NOT bSprinkler THEN
	//pipe
	tConditionTime	:=st_CIP_Param.t_ConditionDisInfection;
	fFlowRate		:=st_CIP_Param.r_Flow_Pipe;
	//rVolume_Collect :=st_CIP_Param.r_Volume_Collect_DisInfection;
	//rVolume_Drain	:=st_CIP_Param.r_Volume_Drain_DisInfection;
	//rVolume_Recycle	:=st_CIP_Param.r_Volume_Recycle_DisInfection;
ELSE
	//sprinkler
	tConditionTime	:=st_CIP_Param.t_ConditionDisInfection_Sprinkler;
	fFlowRate		:=st_CIP_Param.r_Flow_Sprinkler;
	//rVolume_Collect :=st_CIP_Param.r_Volume_Collect_DisInfection*st_CIP_Param.r_Volume_Sprinkler_Ratio;
	//rVolume_Drain	:=st_CIP_Param.r_Volume_Drain_DisInfection*st_CIP_Param.r_Volume_Sprinkler_Ratio;
	//rVolume_Recycle	:=st_CIP_Param.r_Volume_Recycle_DisInfection*st_CIP_Param.r_Volume_Sprinkler_Ratio;
END_IF]]></ST>
      </Implementation>
