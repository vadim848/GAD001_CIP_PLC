    <Action Name="_aStop_Pump_entry" Id="{48014272-55b2-4c31-adb6-2d01f6affd95}">
      <Implementation>
        <ST><![CDATA[eReq:=eReqBlank;
eRun:=E_CIP_Source.eNone;
m_CleanEmpty_Spaces();
