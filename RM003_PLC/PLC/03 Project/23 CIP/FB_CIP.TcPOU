    <Action Name="act_ReqBuffer" Id="{1b81a7d5-6e97-4216-8c50-f77668c87ac0}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[rtPosMoveHMI_Up(Q=>);
IF rtPosMoveHMI_Up.Q THEN;
	m_PosMove_Up_HMI();
END_IF
rtPosMoveHMI_Down(Q=>);
IF rtPosMoveHMI_Down.Q THEN;
	m_PosMove_Down_HMI();
END_IF
rtPosDeleteHMI(Q=>);
IF rtPosDeleteHMI.Q THEN;
	m_PosDelete_HMI();
END_IF
rtPosDeleteAllHMI(Q=>);
IF rtPosDeleteAllHMI.Q THEN;
	m_PosDeleteAll_HMI();
END_IF

rtReqLocalCIP_Full_HMI(Q=>);
IF rtReqLocalCIP_Full_HMI.Q THEN;
	eReqLocal.eClient:=E_CIP_Usage.eLocal;
	eReqLocal.eType:=E_CIP_Type.Full;
	m_TakePosInCIPBuffer(stCIP_Request:=eReqLocal);
END_IF

rtReqLocalCIP_Detergent_HMI(Q=>);
IF rtReqLocalCIP_Detergent_HMI.Q THEN;
	eReqLocal.eClient:=E_CIP_Usage.eLocal;
	eReqLocal.eType:=E_CIP_Type.Detergent;
	m_TakePosInCIPBuffer(stCIP_Request:=eReqLocal);
END_IF

rtReqCleanEmpty_HMI(Q=>);
IF rtReqCleanEmpty_HMI.Q THEN;
	m_CleanEmpty_Spaces();
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_Run" Id="{1474794e-dde4-4a3c-8164-060b43f4cb22}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[IF __ISVALIDREF(eRefClient_fbElement) THEN
	IF eRefClient_fbElement.bError AND SFCCurrentStep<>'Ready' THEN;
		m_Set_LastStepBeforeError();
		sError_Message:='Client Error';
		mResetCycle();
	END_IF	
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="Disconnect_CIP2_active" Id="{6c342fb0-8951-4a9d-a15f-8f43db5966a3}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF fbCIP_Source.m_CheckStatus(eReqStatus:=E_CIP_Source.eClose) 
AND fbCIP_Usage.m_CheckStatus(eReqStatus:=E_CIP_Usage.eLocal)  
AND fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eDrain) THEN;
	bStepDone:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="Disconnect_CIP2_entry" Id="{063aa44f-748e-4cfe-96a2-f6b465218f8a}">
      <Implementation>
        <ST><![CDATA[fbCIP_Source.m_Run(eReqProc:=E_CIP_Source.eClose);
fbCIP_Usage.m_Run(eReqProc:=E_CIP_Usage.eLocal);
fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eDrain);]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_CleanEmpty_Spaces" Id="{a02513cf-5921-4270-b511-66d8a68458f2}">
      <Declaration><![CDATA[METHOD m_CleanEmpty_Spaces : BOOL
VAR_INPUT
END_VAR

VAR
	i: INT;
	j: INT;
	stCIP_Request_Empty: ST_CIP_Request;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i:=0 TO 9 DO
	IF i<>0 OR NOT bRun THEN;
		IF arCIP_RequestBufer[i].eClient=E_CIP_Usage.eNotInUse THEN;
			FOR j:=i+1 TO 9 DO
				IF arCIP_RequestBufer[j].eClient<>E_CIP_Usage.eNotInUse THEN;
					arCIP_RequestBufer[i]:=arCIP_RequestBufer[j];
					arCIP_RequestBufer[j]:=stCIP_Request_Empty;
					EXIT;
				END_IF
			END_FOR
		END_IF		
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PosDelete_HMI" Id="{5ecfed30-e439-4aa1-8486-4d270c40480b}">
      <Declaration><![CDATA[METHOD m_PosDelete_HMI : BOOL
VAR_INPUT
END_VAR
VAR
	stCIP_Request_Empty: ST_CIP_Request;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF iPosSelect_HMI>=0 AND iPosSelect_HMI<9 THEN;
	IF iPosSelect_HMI<>0 OR NOT bRun THEN;
		arCIP_RequestBufer[iPosSelect_HMI]:=stCIP_Request_Empty;
	END_IF		
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PosDeleteAll_HMI" Id="{0565b103-e72e-4e42-86f5-de0bd5b6f5d7}">
      <Declaration><![CDATA[METHOD m_PosDeleteAll_HMI : BOOL
VAR_INPUT
END_VAR
VAR
	stCIP_Request_Empty: ST_CIP_Request;
	i: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
FOR i:=0 TO 9 DO
	IF i<>0 OR NOT bRun THEN;
		arCIP_RequestBufer[i]:=stCIP_Request_Empty;
	END_IF	
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PosMove_Down_HMI" Id="{c114e84d-a8ed-4e16-9653-147f733c0d8b}">
      <Declaration><![CDATA[METHOD m_PosMove_Down_HMI : BOOL
VAR_INPUT
END_VAR
VAR
	stCIP_Request_Temp: ST_CIP_Request;
	i: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF iPosSelect_HMI>=0 AND iPosSelect_HMI<9 THEN;
	IF iPosSelect_HMI<>0 OR NOT bRun THEN;		
			IF ((arCIP_RequestBufer[iPosSelect_HMI].eType=E_CIP_Type.R_Water 
				AND (arCIP_RequestBufer[iPosSelect_HMI+1].eType=E_CIP_Type.Detergent 
				OR arCIP_RequestBufer[iPosSelect_HMI+1].eType=E_CIP_Type.Full)) 
			OR (arCIP_RequestBufer[iPosSelect_HMI].eType=E_CIP_Type.Detergent 				
				AND arCIP_RequestBufer[iPosSelect_HMI+1].eType=E_CIP_Type.Full))
			AND (arCIP_RequestBufer[iPosSelect_HMI+1].eClient=arCIP_RequestBufer[iPosSelect_HMI].eClient) 
			THEN
				;
			ELSE
				stCIP_Request_Temp:=arCIP_RequestBufer[iPosSelect_HMI+1];
				arCIP_RequestBufer[iPosSelect_HMI+1]:=arCIP_RequestBufer[iPosSelect_HMI];
				arCIP_RequestBufer[iPosSelect_HMI]:=stCIP_Request_Temp;
				iPosSelect_HMI:=iPosSelect_HMI+1;	
			END_IF	
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PosMove_Up_HMI" Id="{882d4194-9591-429b-a6de-feb8c47cbd4c}">
      <Declaration><![CDATA[METHOD m_PosMove_Up_HMI : BOOL
VAR_INPUT
END_VAR
VAR
	stCIP_Request_Temp: ST_CIP_Request;
	i: INT;
	m: bool;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF iPosSelect_HMI>0 AND iPosSelect_HMI<=9 THEN;
	IF iPosSelect_HMI<>1 OR NOT bRun THEN;			
			IF ((arCIP_RequestBufer[iPosSelect_HMI].eType=e_cip_type.Full 
				AND (arCIP_RequestBufer[iPosSelect_HMI-1].eType=E_CIP_Type.Detergent 
				OR arCIP_RequestBufer[iPosSelect_HMI-1].eType=E_CIP_Type.R_Water)) 
			OR (arCIP_RequestBufer[iPosSelect_HMI].eType=E_CIP_Type.Detergent 
				AND arCIP_RequestBufer[iPosSelect_HMI-1].eType=E_CIP_Type.R_Water))
			AND (arCIP_RequestBufer[iPosSelect_HMI-1].eClient=arCIP_RequestBufer[iPosSelect_HMI].eClient) 
			THEN
				;
			ELSE
				stCIP_Request_Temp:=arCIP_RequestBufer[iPosSelect_HMI-1];
				arCIP_RequestBufer[iPosSelect_HMI-1]:=arCIP_RequestBufer[iPosSelect_HMI];
				arCIP_RequestBufer[iPosSelect_HMI]:=stCIP_Request_Temp;
				iPosSelect_HMI:=iPosSelect_HMI-1;
			END_IF	
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Set_SFCFlags_Reference" Id="{3959a842-c714-4552-9594-b319ee26bb78}">
      <Declaration><![CDATA[METHOD m_Set_SFCFlags_Reference : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Set reference to SFC flags

refSFC.SFCInit REF= SFCInit;
refSFC.SFCReset REF= SFCReset;
refSFC.SFCError REF= SFCError;
refSFC.SFCEnableLimit REF= SFCEnableLimit;
refSFC.SFCErrorStep REF= SFCErrorStep;
refSFC.SFCErrorPOU REF= SFCErrorPOU;
refSFC.SFCQuitError REF= SFCQuitError;
refSFC.SFCPause REF= SFCPause;
refSFC.SFCTrans REF= SFCTrans;
refSFC.SFCCurrentStep REF= SFCCurrentStep;
refSFC.SFCTip REF= SFCTip;
refSFC.SFCTipMode REF= SFCTipMode;

// Cycle handle for SFC
m_SFC_Handle();]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_TakePosInCIPBuffer" Id="{b2dcb157-1d24-4a20-a9df-81a455a5e4d3}">
      <Declaration><![CDATA[METHOD m_TakePosInCIPBuffer : BOOL
VAR_INPUT
	stCIP_Request: ST_CIP_Request;
END_VAR

VAR
	i: INT;
	m: bool;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stCIP_Request.eClient<>E_CIP_Usage.eNotInUse
AND stCIP_Request.eType<>E_CIP_Type.NotSelected
AND g_data.fbElement[stCIP_Request.eClient].eState_Long>E_Element_State_Long.eStandby 
AND ((stCIP_Request.eType=E_CIP_Type.R_Water AND g_data.fbElement[stCIP_Request.eClient].eState_Long<E_Element_State_Long.eCIP_1_Rinzed)
	OR (stCIP_Request.eType=E_CIP_Type.Detergent AND g_data.fbElement[stCIP_Request.eClient].eState_Long<E_Element_State_Long.eCIP_3_Deterged_Clean)
	OR (stCIP_Request.eType=E_CIP_Type.Full AND g_data.fbElement[stCIP_Request.eClient].eState_Long<E_Element_State_Long.eCIP_5_Done))

THEN
	FOR i:=0 TO 9 DO
		IF arCIP_RequestBufer[i].eClient=stCIP_Request.eClient 
			AND arCIP_RequestBufer[i].eType>=stCIP_Request.eType 
		THEN 	
				m:=FALSE;
				EXIT;
			ELSE
				m:=TRUE;
		END_IF
	END_FOR	
	IF m=TRUE THEN
		FOR i:=0 TO 9 DO
			IF arCIP_RequestBufer[i].eClient=E_CIP_Usage.eNotInUse 
			THEN;
				arCIP_RequestBufer[i]:=stCIP_Request;
				m:=FALSE;
				EXIT;
			END_IF
		END_FOR	
	END_IF
ELSIF stCIP_Request.eClient=E_CIP_Usage.eLocal
AND stCIP_Request.eType<>E_CIP_Type.NotSelected
THEN;
		FOR i:=0 TO 9 DO
			IF arCIP_RequestBufer[i].eClient=E_CIP_Usage.eNotInUse 
			THEN;
				arCIP_RequestBufer[i]:=stCIP_Request;
				m:=FALSE;
				EXIT;
			END_IF
		END_FOR		
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="mCIP_Clients_command" Id="{80c84e09-bced-4039-86dd-22d66f3f838c}" FolderPath="Manage\">
      <Declaration><![CDATA[METHOD mCIP_Clients_command : BOOL
VAR_INPUT
	command: E_CIP_Client_Command ;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
//eReq.eClient<>E_CIP_Usage.eLocal
IF command=E_CIP_Client_Command.eDrain THEN;
	CASE eReq.eClient OF
		E_CIP_Usage.eTank_1:;
			g_Data.fbTankTarget_1.m_Run(eReqProc:=E_Tank_Target.eDrain);
		E_CIP_Usage.eTank_2:;
			g_Data.fbTankTarget_2.m_Run(eReqProc:=E_Tank_Target.eDrain);	
		E_CIP_Usage.eTank_3:;
			g_Data.fbTankTarget_3.m_Run(eReqProc:=E_Tank_Target.eDrain);	
		E_CIP_Usage.eTank_4:;
			g_Data.fbTankTarget_4.m_Run(eReqProc:=E_Tank_Target.eDrain);	
		E_CIP_Usage.eTriBlender_Marinada:;
			g_Data.fbTriBlenderSource_Marinade.m_Run(eReqProc:=E_Line_Source.eDrain);	
			g_Data.fbTriBlenderTarget_Marinade.m_Run(eReqProc:=E_Line_Target.eDrain);	
		E_CIP_Usage.eTriBlender_Color:;
			g_Data.fbTriBlenderSource_Color.m_Run(eReqProc:=E_Line_Source.eDrain);	
			g_Data.fbTriBlenderTarget_Color.m_Run(eReqProc:=E_Line_Target.eDrain);		
		E_CIP_Usage.eLine_Marinada:;
			g_Data.fbLineSource_Marinade.m_Run(eReqProc:=E_Line_Source.eDrain);	
			g_Data.fbLineTarget_Marinade.m_Run(eReqProc:=E_Line_Target.eDrain);	
		E_CIP_Usage.eLine_Color:;
			g_Data.fbLineSource_Color.m_Run(eReqProc:=E_Line_Source.eDrain);	
			g_Data.fbLineTarget_Color.m_Run(eReqProc:=E_Line_Target.eDrain);	
	ELSE;
		//wrong, - local
	END_CASE	
ELSIF command=E_CIP_Client_Command.eCIP THEN;
	CASE eReq.eClient OF
		E_CIP_Usage.eTank_1:;
			g_Data.fbTankTarget_1.m_Run(eReqProc:=E_Tank_Target.eCIP);
		E_CIP_Usage.eTank_2:;
			g_Data.fbTankTarget_2.m_Run(eReqProc:=E_Tank_Target.eCIP);	
		E_CIP_Usage.eTank_3:;
			g_Data.fbTankTarget_3.m_Run(eReqProc:=E_Tank_Target.eCIP);	
		E_CIP_Usage.eTank_4:;
			g_Data.fbTankTarget_4.m_Run(eReqProc:=E_Tank_Target.eCIP);	
		E_CIP_Usage.eTriBlender_Marinada:;
			g_Data.fbTriBlenderSource_Marinade.m_Run(eReqProc:=E_Line_Source.eCIP);	
			g_Data.fbTriBlenderTarget_Marinade.m_Run(eReqProc:=E_Line_Target.eCIP);	
		E_CIP_Usage.eTriBlender_Color:;
			g_Data.fbTriBlenderSource_Color.m_Run(eReqProc:=E_Line_Source.eCIP);	
			g_Data.fbTriBlenderTarget_Color.m_Run(eReqProc:=E_Line_Target.eCIP);		
		E_CIP_Usage.eLine_Marinada:;
			g_Data.fbLineSource_Marinade.m_Run(eReqProc:=E_Line_Source.eCIP);	
			g_Data.fbLineTarget_Marinade.m_Run(eReqProc:=E_Line_Target.eCIP);	
		E_CIP_Usage.eLine_Color:;
			g_Data.fbLineSource_Color.m_Run(eReqProc:=E_Line_Source.eCIP);	
			g_Data.fbLineTarget_Color.m_Run(eReqProc:=E_Line_Target.eCIP);	
	ELSE;
		//wrong, - local
	END_CASE	
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mCIP_Clients_status" Id="{ef5af15a-35a7-4e4b-8e95-aba37ca0b182}" FolderPath="Manage\">
      <Declaration><![CDATA[METHOD mCIP_Clients_status : BOOL
VAR_INPUT
	command: E_CIP_Client_Command ;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
//eReq.eClient<>E_CIP_Usage.eLocal
IF command=E_CIP_Client_Command.eDrain THEN;
	CASE eReq.eClient OF
		E_CIP_Usage.eTank_1:;
			IF g_Data.fbTankTarget_1.m_CheckStatus(eReqStatus:=E_Tank_Target.eDrain) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF
		E_CIP_Usage.eTank_2:;
			IF g_Data.fbTankTarget_2.m_CheckStatus(eReqStatus:=E_Tank_Target.eDrain) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
		E_CIP_Usage.eTank_3:;
			IF g_Data.fbTankTarget_3.m_CheckStatus(eReqStatus:=E_Tank_Target.eDrain) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
		E_CIP_Usage.eTank_4:;
			IF g_Data.fbTankTarget_4.m_CheckStatus(eReqStatus:=E_Tank_Target.eDrain) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
		E_CIP_Usage.eTriBlender_Marinada:;
			IF  g_Data.fbTriBlenderSource_Marinade.m_CheckStatus(eReqStatus:=E_Line_Source.eDrain) 
			AND g_Data.fbTriBlenderTarget_Marinade.m_CheckStatus(eReqStatus:=E_Line_Target.eDrain) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF
		E_CIP_Usage.eTriBlender_Color:;
			IF  g_Data.fbTriBlenderSource_Color.m_CheckStatus(eReqStatus:=E_Line_Source.eDrain) 
			AND g_Data.fbTriBlenderTarget_Color.m_CheckStatus(eReqStatus:=E_Line_Target.eDrain) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF		
		E_CIP_Usage.eLine_Marinada:;
			IF  g_Data.fbLineSource_Marinade.m_CheckStatus(eReqStatus:=E_Line_Source.eDrain) 
			AND g_Data.fbLineTarget_Marinade.m_CheckStatus(eReqStatus:=E_Line_Target.eDrain) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
		E_CIP_Usage.eLine_Color:;
			IF  g_Data.fbLineSource_Color.m_CheckStatus(eReqStatus:=E_Line_Source.eDrain) 
			AND g_Data.fbLineTarget_Color.m_CheckStatus(eReqStatus:=E_Line_Target.eDrain) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
	ELSE;// local
		mCIP_Clients_status:=TRUE;
	END_CASE	
ELSIF command=E_CIP_Client_Command.eCIP THEN;
	CASE eReq.eClient OF
		E_CIP_Usage.eTank_1:;
			IF g_Data.fbTankTarget_1.m_CheckStatus(eReqStatus:=E_Tank_Target.eCIP) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF
		E_CIP_Usage.eTank_2:;
			IF g_Data.fbTankTarget_2.m_CheckStatus(eReqStatus:=E_Tank_Target.eCIP) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
		E_CIP_Usage.eTank_3:;
			IF g_Data.fbTankTarget_3.m_CheckStatus(eReqStatus:=E_Tank_Target.eCIP) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
		E_CIP_Usage.eTank_4:;
			IF g_Data.fbTankTarget_4.m_CheckStatus(eReqStatus:=E_Tank_Target.eCIP) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
		E_CIP_Usage.eTriBlender_Marinada:;
			IF  g_Data.fbTriBlenderSource_Marinade.m_CheckStatus(eReqStatus:=E_Line_Source.eCIP) 
			AND g_Data.fbTriBlenderTarget_Marinade.m_CheckStatus(eReqStatus:=E_Line_Target.eCIP) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF
		E_CIP_Usage.eTriBlender_Color:;
			IF  g_Data.fbTriBlenderSource_Color.m_CheckStatus(eReqStatus:=E_Line_Source.eCIP) 
			AND g_Data.fbTriBlenderTarget_Color.m_CheckStatus(eReqStatus:=E_Line_Target.eCIP) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF		
		E_CIP_Usage.eLine_Marinada:;
			IF  g_Data.fbLineSource_Marinade.m_CheckStatus(eReqStatus:=E_Line_Source.eCIP) 
			AND g_Data.fbLineTarget_Marinade.m_CheckStatus(eReqStatus:=E_Line_Target.eCIP) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
		E_CIP_Usage.eLine_Color:;
			IF  g_Data.fbLineSource_Color.m_CheckStatus(eReqStatus:=E_Line_Source.eCIP) 
			AND g_Data.fbLineTarget_Color.m_CheckStatus(eReqStatus:=E_Line_Target.eCIP) THEN;
				mCIP_Clients_status:=TRUE;
			ELSE;
				mCIP_Clients_status:=FALSE;	
			END_IF	
	ELSE;// local
		mCIP_Clients_status:=TRUE;
	END_CASE	
END_IF
]]></ST>
      </Implementation>
