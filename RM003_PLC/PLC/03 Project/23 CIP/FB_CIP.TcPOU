      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eT93_R_Water)  
THEN;
	bStepDone:=TRUE;
END_IF



]]></ST>
      </Implementation>
