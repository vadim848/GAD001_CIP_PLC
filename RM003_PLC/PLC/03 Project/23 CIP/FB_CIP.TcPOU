            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aTriBlender_Selection_entry" Id="{0a68dd9d-1aca-4b6e-aa9d-fe1899267007}">
      <Implementation>
        <ST><![CDATA[
IF eRefClient_fbElement.eElementID=E_Element_List.eTriBlender_Marinada THEN;
	fbTriBlender_Select.m_Run(eReqProc:=E_TriBlenderSelect.eMarinade);
END_IF

IF eRefClient_fbElement.eElementID=E_Element_List.eTriBlender_Color THEN;
	fbTriBlender_Select.m_Run(eReqProc:=E_TriBlenderSelect.eColor);
END_IF
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
