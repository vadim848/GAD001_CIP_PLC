            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aClient_Validation_check_active" Id="{944b4ef3-9c09-45a7-92e7-559823a6a540}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
	
IF eRefClient_fbElement.m_Get_Type()=E_Element_Type.eTriBlender THEN;
	IF TRUE 
	AND fbElement[E_Element_List.eTriBlender_Color].m_Get_CIP_Avilable()
	AND fbElement[E_Element_List.eTriBlender_Marinada].m_Get_CIP_Avilable()
	AND eRun<>E_CIP_Source.eNone
	AND TRUE
	THEN;
		bStepDone:=eRefClient_fbElement.m_InterConnect(value:=E_InterConnection.ConnToCIP);		
	END_IF		
ELSE;
	IF TRUE 
	AND eRefClient_fbElement.m_Get_CIP_Avilable()
	AND eRun<>E_CIP_Source.eNone
	AND TRUE
	THEN;
		bStepDone:=eRefClient_fbElement.m_InterConnect(value:=E_InterConnection.ConnToCIP);
	END_IF
END_IF]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aClientReference_IsValid_entry" Id="{a12df6dc-c969-4946-9c7b-d8b72cd2928a}">
      <Implementation>
        <ST><![CDATA[IF bClientTypeIs_Tank THEN;
	fb_Stirrer.m_Run(RPM:=1200);
END_IF
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aCondition_CIP1_Client_active" Id="{9c9aa498-c10a-4f64-a491-9b8cc01cad7d}">
      <Implementation>
        <ST><![CDATA[IF NOT bSprinkler THEN
	//pipe
	tConditionTime	:=st_CIP_Param.t_ConditionR_Water;
	fFlowRate		:=st_CIP_Param.r_Flow_Pipe;
	
ELSE
	//sprinkler
	tConditionTime	:=st_CIP_Param.t_ConditionR_Water_Sprinkler;
	fFlowRate		:=st_CIP_Param.r_Flow_Sprinkler;
END_IF

IF Condition_CIP1_Client.t > SECOND_TO_TIME(st_CIP_Param.t_PumpInitRun) THEN;
	fb_PumpCIP.m_Run(RPM:=pcFlow1_Rate.mRun_PID(Set_Point:=fFlowRate,controlManual:=NOT(fb_PumpCIP.modeAuto)));
END_IF


tonr_CIP_Condition(PT:=SECOND_TO_TIME(tConditionTime));
//
IF bSprinkler THEN;
	IF TRUE 
	AND pcFlow1_Rate.mRun(mRun=>_cond[1])
	//AND pcFlow3_Rate.mRun(mRun=>_cond[2])
	THEN;
		tonr_CIP_Condition.IN:=TRUE;
	ELSE;
		tonr_CIP_Condition.IN:=FALSE;
	END_IF
ELSE;
	IF TRUE 
	AND pcFlow1_Rate.mRun(mRun=>_cond[1])
	//AND pcFlow2_Rate.mRun(mRun=>_cond[2])
	THEN;
		tonr_CIP_Condition.IN:=TRUE;
	ELSE;
		tonr_CIP_Condition.IN:=FALSE;
	END_IF	
	
END_IF
//

IF tonr_CIP_Condition.Q THEN
	bCIP_Condition_Done:=TRUE;
ELSE;
	bCIP_Condition_Done:=FALSE;	
END_IF

IF FALSE  
//AND delta_T93_Volume < -st_CIP_Param.r_Volume_Drain_R_Water 
OR lvlTank_T93.rTankLevel < 250
THEN;
	bCIP_Condition_Failed:=TRUE;
END_IF



(*
// Connect return to R_Water
IF TRUE 
AND lvlTank_T93.rTankLevel<450 
AND fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eDrain)
THEN;
	fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eT93_R_Water);
ELSE;
	
END_IF



// Connect return to Drain

IF TRUE 
AND lvlTank_T93.rTankLevel>500 // The tank is full
AND fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eT93_R_Water)
THEN;
	fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eDrain);
ELSE;
	
END_IF
*)


(*
IF TRUE 
AND bCIP_Condition_Done
OR bCIP_Condition_Failed
THEN;

ELSE;
	
END_IF

IF TRUE 
AND pcFlow1_Rate.mRun(mRun=>_cond[1])
AND pcFlow2_Rate.mRun(mRun=>_cond[2])
//AND pcPressure.mRun()
THEN;
	//
ELSE;
	bCIP_Condition_Failed:=TRUE;
END_IF
*)]]></ST>
