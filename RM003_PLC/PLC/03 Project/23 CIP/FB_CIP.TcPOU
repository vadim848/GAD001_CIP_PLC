    <Action Name="_aFill_Water_T91_active" Id="{5095c3b6-e26a-419b-998b-d45425bd5a3c}">
      <Implementation>
        <ST><![CDATA[nDisInf_CondActTime_Lcl:=0;
nDisInf_CondActTime_Clnt:=0;
bDisInf_CondActTime_Lcl_Done:=FALSE;
bDisInf_CondActTime_Clnt_Done:=FALSE;

bStepDone:=FALSE;
IF fbCIP_Source.m_CheckStatus(eReqStatus:=E_CIP_Source.eClose) 
AND fbCIP_Usage.m_CheckStatus(eReqStatus:=E_CIP_Usage.eLocal)  
AND fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eDrain)  
//AND fbPis.m_CheckByRecipe(stPis:=stPis_FillWater_T91, req:=E_Piston_Recipe_State.Act) 
THEN;
	//IF eReq.eClient=E_CIP_Usage.eLocal 
	IF lvlTank_T91.e_state=E_Tank_Level.eLL
	AND lvlTank_T91.rTankLevel>g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Tank91_Volume//250 // Local requered Level
	THEN;	
		bStepDone:=TRUE;
		fbPis.m_SetByRecipe(stPis:=stPis_FillWater_T91, req:=E_Piston_Recipe_State.Release);
	(*ELSIF lvlTank_T91.e_state=E_Tank_Level.eLL
	AND lvlTank_T91.rTankLevel>g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_TankLevel_2//300 // Client requered Level
	THEN;
		//Level OK
		bStepDone:=TRUE;
		fbPis.m_SetByRecipe(stPis:=stPis_FillWater_T91, req:=E_Piston_Recipe_State.Release);*)
	ELSE;
		//Fill water
		IF NOT arrTanksSens[E_Tank_Name.T91].get_stTankLevel_OverFlow() THEN;
			fbPis.m_SetByRecipe(stPis:=stPis_FillWater_T91, req:=E_Piston_Recipe_State.Act);			
		END_IF	
	END_IF	
END_IF
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aFill_Water_T91_entry" Id="{9e52c220-fb12-4b0d-9ba6-fd0ad192da08}">
      <Implementation>
        <ST><![CDATA[fbCIP_Source.m_Run(eReqProc:=E_CIP_Source.eClose);
fbCIP_Usage.m_Run(eReqProc:=E_CIP_Usage.eLocal);
fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eDrain);
bSprinkler:=FALSE;
bClean_MixProof:=FALSE;
bValveCleanDone:=FALSE;
m_DashState_activate(stage:=E_CIP_DashStage_List.e12_CIP4_Local_DisInfection_Fill);
	
]]></ST>
      </Implementation>
