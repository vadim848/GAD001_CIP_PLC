<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_CIP" Id="{14cc32b0-9432-4cf7-99d2-9b696d5c02b0}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_CIP EXTENDS FB_SFC_Cycle IMPLEMENTS ITF_FB_SFC_Cycle
VAR_INPUT
	valFillWater_T91	: E_Pis_Name;
	valFillWater_T92	: E_Pis_Name;
	valFillWater_T93	: E_Pis_Name;
	valFillWater_T94	: E_Pis_Name;
	
	lvlTank_T91			: ST_Tank_Level	;
	lvlTank_T92			: ST_Tank_Level	;
	lvlTank_T93			: ST_Tank_Level	;
	lvlTank_T94			: ST_Tank_Level	;

END_VAR
VAR_OUTPUT
END_VAR
VAR
	//bRun: BOOL;
	eRun: E_CIP_Source;

	eMode			: E_CIP_Mode;
	eCIP_Return		: E_CIP_Return;
	eCIP_Source		: E_CIP_Source;
	eCIP_Usage		: E_CIP_Usage;
	eReq			: ST_CIP_Request;
	eReqBlank		: ST_CIP_Request;
	eReqLocal		: ST_CIP_Request;
	
	ref_lvlTank_Client		: REFERENCE TO ST_Tank_Level	;

	//bStepDone: BOOL;
	
	iPosSelect_HMI: INT;

	rtPosMoveHMI_Up		: R_TRIG;
	rtPosMoveHMI_Down	: R_TRIG;
	rtPosDeleteHMI		: R_TRIG;
	rtPosDeleteAllHMI	: R_TRIG;
	
	eRefClient_fbElement		: REFERENCE TO FB_Element; // FB_Element // E_Element_State_Long
	bClientRef_done				: BOOL;
	fbElement_Blank				: FB_Element;
	eState_Long_Blank			: E_Element_State_Long;
	
	fbPis						: FB_Piston;
	stPis_FillWater_T91			: REFERENCE TO ST_Piston;
	stPis_FillWater_T92			: REFERENCE TO ST_Piston;
	stPis_FillWater_T93			: REFERENCE TO ST_Piston;
	stPis_FillWater_T94			: REFERENCE TO ST_Piston;
	
	rtReqLocalCIP_Full_HMI: R_TRIG;
	rtReqLocalCIP_Detergent_HMI: R_TRIG;
	rtReqCleanEmpty_HMI: R_TRIG;
	rtModeOff: R_TRIG;
	rtModeManual: R_TRIG;
	rtModeAuto: R_TRIG;
	bTemp: BOOL;
		
	//Process Control
	//concentration
	stDetergent					:	REFERENCE TO ST_ProcessControl	;
	pcDetergent					: 	REFERENCE TO FB_ProcessControl	;	//detergent local
	stDisInfectant				:	REFERENCE TO ST_ProcessControl	;
	pcDisInfectant				: 	REFERENCE TO FB_ProcessControl	;	//detergent local
    //temperature
	stHeatExchanger					:	REFERENCE TO ST_ProcessControl	;
	pcHeatExchanger					: 	REFERENCE TO FB_ProcessControl	;	//	
	stTemperature_Deterg			:	REFERENCE TO ST_ProcessControl	;
	pcTemperature_Deterg			: 	REFERENCE TO FB_ProcessControl	;	//detergent Client	
	stTemperature_Dis				:	REFERENCE TO ST_ProcessControl	;
	pcTemperature_Dis				: 	REFERENCE TO FB_ProcessControl	;//disinfectant local/client
	//temperature client return
	stTemp_ClntReturn				:	REFERENCE TO ST_ProcessControl	;//Client return temperature
	pcTemp_ClntReturn				: 	REFERENCE TO FB_ProcessControl	;//Client return temperature
	
	//flow rate
	stFlow1_Rate					:	REFERENCE TO ST_ProcessControl	;//CIP
	pcFlow1_Rate					: 	REFERENCE TO FB_ProcessControl	;//disinfectant local/client
	stFlow2_Rate					:	REFERENCE TO ST_ProcessControl	;//CIP send
	pcFlow2_Rate					: 	REFERENCE TO FB_ProcessControl	;//disinfectant local/client	return 
	stFlow3_Rate					:	REFERENCE TO ST_ProcessControl	;//CIP send
	pcFlow3_Rate					: 	REFERENCE TO FB_ProcessControl	;//disinfectant local/client	return 
	
	stColor_Level					:	REFERENCE TO ST_ProcessControl	;//CLient CIP //level control 
	pcColor_Level					: 	REFERENCE TO FB_ProcessControl	;//disinfectant local/client //level control 
	stMarinada_Level				:	REFERENCE TO ST_ProcessControl	;//CLient CIP //level control 
	pcMarinada_Level				: 	REFERENCE TO FB_ProcessControl	;//disinfectant local/client //level control 
	
	
	//colar marinade 
	//pressure
	stPressure						:	REFERENCE TO ST_ProcessControl	;
	pcPressure						: 	REFERENCE TO FB_ProcessControl	;//CIP //Client	

	
	
		//OldOne to be deleted
		iStepDone: INT;
		fDetergTarget: REAL:=0.7;
		fDetergDeviation: REAL;
		fDetergLowTolerance: LREAL;
		fDetergHighTolerance: LREAL;
	

	
	bCIP_Condition_Failed: BOOL;
	testTemperature: REAL := 26.0;
	tonr_CIP_Condition: TONR;
	bCIP_Condition_Done: BOOL;
	fReqVolumeT93: REAL := 250;
	delta_T91_Volume: REAL;	// DisInfection
	delta_T92_Volume: REAL;	// Detergent
	delta_T93_Volume: REAL;	// Recycle Water
	delta_T94_Volume: REAL;	// Water
	memo_T91_Level_start: REAL;
	memo_T92_Level_start: REAL;
	memo_T93_Level_start: REAL;
	memo_T94_Level_start: REAL;	
	
	nStepHeat	:	INT		;
	
	bTestPID: BOOL;
	st_CIP_Param		:	ST_CIP_Param	;
	hystCIP_SetPoint: FB_Hysteresis_REAL;
	a: REAL := 0.8;
	b: REAL := 1.2;
	i: E_CIP_Usage;
	tMeasureDelayTime: TIME;
	bLoadDefSetPoints: BOOL;


	
	//Additional water valume if the solution concentration is too high
	rDeltaWater_DeterLocal		:	REAL	;
	rDeltaWater_DeterClient		:	REAL	;
	rDeltaWater_DisInfLocal		:	REAL	;
	rDeltaWater_DisInfClient	:	REAL	;

	rDeluteVolume				: REAL;
	rDeluteVolume_max			: REAL:=900;

	//accumulative actual time for desinfection and detergent condition
	nDeter_CondActTime_Lcl		:	INT	;//Actual condition time in seconds, for local client, detergent
	nDeter_CondActTime_Clnt		:	INT	;//Actual condition time in seconds, for client, detergent
	nDisInf_CondActTime_Lcl		:	INT	;//Actual condition time in seconds, for local client, disinfection
	nDisInf_CondActTime_Clnt	:	INT	;//Actual condition time in seconds, for client, disinfection
	
	bDeter_CondActTime_Lcl_Done		:	BOOL	;
	bDeter_CondActTime_Clnt_Done	:	BOOL	;
	bDisInf_CondActTime_Lcl_Done	:	BOOL	;
	bDisInf_CondActTime_Clnt_Done	:	BOOL	;

	fbHysteresisFillT94: FB_Hysteresis_REAL;
	
	//Choose pipe or sprinkler
	bSprinkler			:	BOOL:=FALSE	;
	tConditionTime		:	INT		;
	//tConditionTemper:	REAL	;
	fFlowRate			:	REAL	;
	//rVolume_Collect	:	REAL	;
	//rVolume_Drain		:	REAL	;
	//rVolume_Recycle	:	REAL	;
	
	_temp: REAL;
	_cond: ARRAY[0..9] OF BOOL;
	tonStepConditionTime: TON;
	bClientTypeIs_Tank: BOOL;
	t_ActMeasureTime: TIME;
	
	volume_Requered	: INT;
	volume_Actual	: INT;

	ton_Concentration_Filter: TON;
	bConcentration_correct: BOOL;
	tonTankLowLevel: TON;
	iCheck: INT;
	bMixProof_Release_All: BOOL;
	iConcentrationDeluteCounter: INT;
END_VAR
//upper lower control
VAR
	nClient			:	INT:=1		;
	bClean_MixProof	:	BOOL:=FALSE	;
	nNumOfRetries	:	INT:=5		;
	nNumOfPulses	:	INT:=5		;//Number of pulses per valve seat clean
	nStep_Vlv		:	INT:=0		;
	bValveCleanDone	:	BOOL:=FALSE	;
	nI_1_act_valve			:	INT:=1		;
	nI_2_act_pulses			:	INT:=0		;
	nI_3_act_repeats		:	INT:=1		;//number of repeats
	ActvValve		:	E_Pis_Name	;
	bSeatStatus		:	BOOL:=FALSE	;
	sState			:	STRING		;
	tOn				:	TON			;
	tOff			:	TON			;
	
	nMaxValves		:	INT:=6		;
	
	arTestOverflow: ARRAY[0..5] OF REAL;

END_VAR

VAR_IN_OUT
	fbCIP_Source	: FB_CIP_Source	;
	fbCIP_Return	: FB_CIP_Return	;
	fbCIP_Usage		: FB_CIP_Client	;
	
	//fbTarget					: FB_Tank_Target	;
	//fbLineSource				: FB_Line_Source	;
	//fbLineTarget				: FB_Line_Target	;
	//fbTriBlenderSource		: FB_Line_Source	;
	//fbTriBlenderTarget		: FB_Line_Target	;

	//fb_PumpLine				: FB_Pump	;
	//fb_PumpTriBlender			: FB_Pump	;
	fbTank1	:	FB_ProductionTank	;
	fbTank2	:	FB_ProductionTank	;
	fbTank3	:	FB_ProductionTank	;
	fbTank4	:	FB_ProductionTank	;
	
	//Pumps
	fb_PumpCIP				: FB_Pump;
	fb_PumpClient			: FB_Pump;
	fb_Stirrer				: FB_Pump;
	fb_PumpDetergent		: FB_DosingPump;
	fb_PumpDisinfection		: FB_DosingPump;
	
	//Heat Exchenger	
	fb_HeatExchenger	:	FB_HeatExchanger	;
	

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[m_Set_SFCFlags_Reference();
act_GetReference();
act_CallProcessControl();
//act_HeatExchng();
act_SprinklerCondition();
//SUPER^();

//Selecting client for CIP parameters
st_CIP_Param:=g_Data.arr_CIP_Param[eReq.eClient];
FOR i:=1 TO E_CIP_Usage.eLocal DO
	g_Data.arr_CIP_Param[i].sName:=TO_STRING(i);
END_FOR

act_Oper();
act_ReqBuffer();
mVolumeMeter();
act_ValveUpLow_Cntrl();

rtModeOff(CLK:=eMode=E_CIP_Mode.eOff);
IF rtModeOff.Q THEN;
	SFCReset:=TRUE;
END_IF

rtModeManual(CLK:=eMode=E_CIP_Mode.eManual);
IF rtModeManual.Q THEN;
	bTemp:=TRUE;
END_IF

rtModeAuto(CLK:=eMode=E_CIP_Mode.eAuto);
IF rtModeAuto.Q THEN;
	//SFCReset:=TRUE;
END_IF

IF bRun AND bClientRef_done THEN;
	act_Run();
END_IF


t_ActMeasureTime:=m_MeasureTimeToHMI();
mFillWater();
//IF bMoveStep THEN bMoveStep:=FALSE; END_IF
IF bMixProof_Release_All THEN;
	IF m_MixProof_Release_All() THEN;
		bMixProof_Release_All:=FALSE;
	END_IF
END_IF

(*
arTestOverflow[0]:=m_OverFlowCorrect(
rTc:=arTestOverflow[1], 
rAv:=arTestOverflow[2], 
rAc:=arTestOverflow[3]);
*)
]]></ST>
    </Implementation>
    <Folder Name="Manage" Id="{8cb05385-d8fc-420c-9505-d8b2a8121243}" />
    <Folder Name="Meth" Id="{3ff852d5-11b9-4725-a976-204de9549283}">
      <Folder Name="Dashboard" Id="{9e04f67f-2723-4849-a13e-a86c894f0a2f}" />
