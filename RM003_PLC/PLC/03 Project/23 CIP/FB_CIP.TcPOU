    <Action Name="_aDeterg_Dose_2_active" Id="{409e36b4-ce3e-45aa-93de-65e556464419}">
      <Implementation>
        <ST><![CDATA[
bStepDone:=fb_PumpDetergent.m_RunVolume(Volume:=0.9*(lvlTank_T92.rTankLevel*stDetergent.Deviation*10)); // 10= 1Litr*1000cc/100%]]></ST>
