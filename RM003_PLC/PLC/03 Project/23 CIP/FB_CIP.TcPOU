    <Action Name="_aConnect_CIP2_02_entry" Id="{33d6d086-4738-4f54-a47b-198c1283b35e}">
      <Implementation>
        <ST><![CDATA[fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eT92_Detergent);
fbPis.m_SetByRecipe(stPis:=stPis_FillWater_T92, req:=E_Piston_Recipe_State.Release);
//fb_PumpDetergent.m_Auto();
fb_HeatExchenger.m_Auto();]]></ST>
      </Implementation>
      <ObjectProperties>
