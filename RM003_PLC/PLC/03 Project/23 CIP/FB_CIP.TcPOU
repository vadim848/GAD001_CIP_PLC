    <Action Name="_aStartPump_CIP2_RPM_02_active" Id="{a603ceb3-2a59-40c6-b08d-10619fb883a4}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;

fb_PumpCIP.m_Run(RPM:=st_CIP_Param.r_CIP_Pump);
fb_PumpClient.m_Run(RPM:=st_CIP_Param.r_CIP_Client_Pump);
bStepDone:=TRUE;

// to stas question ? deference:
//fb_PumpCIP.m_Run(RPM:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_CIP_Pmp_1);//1500
//fb_PumpCIP.m_Run(RPM:=st_CIP_Param.r_CIP_Pmp_1);
(*
IF TRUE //Future condition
AND delta_T92_Volume < - st_CIP_Param.r_Volume_Solution_Fill // Volume 
//AND StartPump_CIP2_RPM_02.t>SECOND_TO_TIME(g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].t_PumpInitRun) 
THEN;
	bStepDone:=TRUE;
END_IF
*)



]]></ST>
      </Implementation>
