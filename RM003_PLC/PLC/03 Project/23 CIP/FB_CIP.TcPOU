fb_PumpClient.m_Run(RPM:=st_CIP_Param.r_CIP_Client_Pmp_1);*)
//fb_PumpDisinfection.m_Auto();
	
//Heat Exchenger	
fb_HeatExchenger.m_Auto();

bCIP_Condition_Failed:=FALSE;
bCIP_Condition_Done:=FALSE;
iConcentrationDeluteCounter:=0;

nStepHeat:=20;]]></ST>
      </Implementation>
