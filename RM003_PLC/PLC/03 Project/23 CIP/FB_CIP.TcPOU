    <Action Name="_aCondition_CIP3_Local_active" Id="{df016d92-2d66-4702-a496-5eb5a36fcd94}">
      <Implementation>
        <ST><![CDATA[
IF TRUE 
AND stAnalogSensor[E_ASense_Name.FT1001].Value>=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Flow_1//st_CIP_Param.st_DisInf_Local.r_Flow_Pmp1_1 // 
AND stAnalogSensor[E_ASense_Name.FT1002].Value>=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Flow_2//st_CIP_Param.st_DisInf_Local.r_Flow_Pmp1_2 // 
AND stAnalogSensor[E_ASense_Name.PT1001].Value>=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Pressure//st_CIP_Param.st_DisInf_Local.r_Pressure_Pmp1_1 // 
THEN;
	//
ELSE;
	bCIP_Condition_Failed:=TRUE;
END_IF


IF Disinfct_Conc_Local_Done.x 
AND NOT pcDisinfectant.mRun()
THEN;
	bCIP_Condition_Failed:=TRUE;
END_IF

IF Temperature_Dis_1_Done.x 
AND NOT pcTemperature_Dis.mRun()
THEN;
	bCIP_Condition_Failed:=TRUE;
END_IF


ton_CIP_Condition(PT:=T#30S);
IF TRUE 
AND Disinfct_Conc_Local_Done.x
AND Temperature_Dis_1_Done.x
AND TRUE
THEN;
	ton_CIP_Condition.IN:=TRUE;
ELSE;
	ton_CIP_Condition.IN:=FALSE;
END_IF

IF ton_CIP_Condition.Q THEN;
	bCIP_Condition_Done:=TRUE;
ELSE;
	bCIP_Condition_Done:=FALSE;	
END_IF
]]></ST>
