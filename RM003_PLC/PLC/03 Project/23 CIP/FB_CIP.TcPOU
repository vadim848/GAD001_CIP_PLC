    <Action Name="_aConnect_CIP1_Drain_active" Id="{027bf863-1ae4-4bdd-8945-394ab7bb998b}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;

IF fbCIP_Source.m_CheckStatus(eReqStatus:=E_CIP_Source.eT93_R_Water) 
AND fbCIP_Usage.m_CheckStatus(eReqStatus:=eReq.eClient)
AND fbPis.m_CheckByRecipe(stPis:=stPis_FillWater_T93, 	req:=E_Piston_Recipe_State.Release) 
AND mCIP_Clients_status(command:=E_CIP_Client_Command.eCIP)
THEN

	CASE eReq.eClient OF
	
		E_CIP_Usage.eTank_1:;
					bStepDone:=fbCIP_ClientTank_Marinade.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_A);
		E_CIP_Usage.eTank_2:;
					bStepDone:=fbCIP_ClientTank_Marinade.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_B);	
		E_CIP_Usage.eTank_3:;
					bStepDone:=fbCIP_ClientTank_Color.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_A);
		E_CIP_Usage.eTank_4:;
					bStepDone:=fbCIP_ClientTank_Color.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_A);	
	ELSE;				
		bStepDone:=TRUE;
	END_CASE
	
END_IF

]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aConnect_CIP1_Drain_entry" Id="{f8896680-aaad-4c37-8e47-205e55062b9d}">
      <Implementation>
        <ST><![CDATA[fbCIP_Source.m_Run(eReqProc:=E_CIP_Source.eT93_R_Water);
fbCIP_Usage.m_Run(eReqProc:=eReq.eClient);
fbPis.m_SetByRecipe(stPis:=stPis_FillWater_T93, req:=E_Piston_Recipe_State.Release);
mCIP_Clients_command(command:=E_CIP_Client_Command.eCIP);

CASE eReq.eClient OF

	E_CIP_Usage.eTank_1:;
				fbCIP_ClientTank_Marinade.m_Run(eReqProc:=E_CIP_ClientTank.eTank_A);
	E_CIP_Usage.eTank_2:;
				fbCIP_ClientTank_Marinade.m_Run(eReqProc:=E_CIP_ClientTank.eTank_B);	
	E_CIP_Usage.eTank_3:;
				fbCIP_ClientTank_Color.m_Run(eReqProc:=E_CIP_ClientTank.eTank_A);
	E_CIP_Usage.eTank_4:;
				fbCIP_ClientTank_Color.m_Run(eReqProc:=E_CIP_ClientTank.eTank_A);	

END_CASE

(*
CASE eReq.eClient OF
	E_CIP_Usage.eLocal:;
				//
	E_CIP_Usage.eTank_1:;
				fbCIP_ClientTank_Marinade.m_Run(eReqProc:=E_CIP_ClientTank.eTank_A);
	E_CIP_Usage.eTank_2:;
				fbCIP_ClientTank_Marinade.m_Run(eReqProc:=E_CIP_ClientTank.eTank_B);	
	E_CIP_Usage.eTank_3:;
				fbCIP_ClientTank_Color.m_Run(eReqProc:=E_CIP_ClientTank.eTank_A);
	E_CIP_Usage.eTank_4:;
				fbCIP_ClientTank_Color.m_Run(eReqProc:=E_CIP_ClientTank.eTank_A);	
	E_CIP_Usage.eTriBlender_Marinada,
	E_CIP_Usage.eLine_Marinada:;
				//
	E_CIP_Usage.eTriBlender_Color,
	E_CIP_Usage.eLine_Color:;
				//		
END_CASE
*)
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aConnect_CIP2_01_active" Id="{44126bcf-d2e3-4d19-8c41-62bc81f03fcf}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF fbCIP_Source.m_CheckStatus(eReqStatus:=E_CIP_Source.eT92_Detergent)  
AND fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eT92_Detergent)  
AND fbPis.m_CheckByRecipe(stPis:=stPis_FillWater_T92, req:=E_Piston_Recipe_State.Release) THEN;
