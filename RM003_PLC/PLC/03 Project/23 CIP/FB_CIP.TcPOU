            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aFill_Solution_CIP2_active" Id="{9d6ff8fa-91bd-4c22-8820-620f672402fa}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
volume_Requered:= REAL_TO_INT(st_CIP_Param.r_Volume_Solution_Fill);
volume_Actual:= REAL_TO_INT(-delta_T92_Volume);

IF volume_Actual >= volume_Requered THEN;
	bStepDone:=TRUE;
END_IF]]></ST>
