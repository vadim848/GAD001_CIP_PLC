    <Action Name="_aClient_Check_CIP4_active" Id="{c2925bad-5269-44c9-9030-e5d2adb33994}">
      <Implementation>
        <ST><![CDATA[bStepDone:=TRUE;]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
