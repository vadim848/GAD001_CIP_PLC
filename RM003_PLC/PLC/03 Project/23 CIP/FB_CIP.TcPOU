            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aDeterg_Overflow_2_active" Id="{885afaf6-dc59-4f6b-8c27-9f845d09afe7}">
      <Implementation>
        <ST><![CDATA[IF lvlTank_T92.rTankLevel>=rDeluteVolume OR bCIP_Condition_Failed THEN;	
	bStepDone:=TRUE;
	fbPis.m_SetByRecipe(stPis:=stPis_FillWater_T92, req:=E_Piston_Recipe_State.Release);
ELSE;
	//Fill water
	bStepDone:=FALSE;
	IF NOT arrTanksSens[E_Tank_Name.T92].get_stTankLevel_OverFlow() THEN;
		fbPis.m_SetByRecipe(stPis:=stPis_FillWater_T92, req:=E_Piston_Recipe_State.Act);			
	END_IF	
END_IF]]></ST>
      </Implementation>
