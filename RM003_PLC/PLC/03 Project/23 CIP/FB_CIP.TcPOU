    <Action Name="_aSprinkler_Request_CIP1_active" Id="{4acc4cf2-f228-4f13-bdcd-db4a92bd7344}">
      <Implementation>
        <ST><![CDATA[

IF TRUE // Type Tank
AND bClientTypeIs_Tank	
AND bSprinkler
THEN;	
	bStepDone:=TRUE;
	m_DashState_done(stage:=E_CIP_DashStage_List.e02_CIP1_Client_Drain_Product_Rest_Sprinkler);
	
ELSIF TRUE // Type Pine
AND NOT bClientTypeIs_Tank	
THEN;	
	bStepDone:=TRUE;
	m_DashState_done(stage:=E_CIP_DashStage_List.e01_CIP1_Client_Drain_Product_Rest_Pipe);
	
ELSE;
	//continue with sprinkler
	bStepDone:=FALSE;
	m_DashState_done(stage:=E_CIP_DashStage_List.e01_CIP1_Client_Drain_Product_Rest_Pipe);
	m_DashState_activate(stage:=E_CIP_DashStage_List.e02_CIP1_Client_Drain_Product_Rest_Sprinkler);
	
END_IF	


]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aSprinkler_Request_CIP4_active" Id="{7bbffa29-9878-4026-a507-cc50b1b5b319}">
      <Implementation>
        <ST><![CDATA[

IF TRUE // Type Tank
AND bClientTypeIs_Tank	
AND bSprinkler
THEN;	
	bStepDone:=TRUE;
	CASE eRefClient_fbElement.eState_Long OF
	
		E_Element_State_Long.eCIP_2_Deterged:;
				m_DashState_done(stage:=E_CIP_DashStage_List.e11_CIP3_Detergent_Clean_Sprinkler);
	
		E_Element_State_Long.eCIP_4_Sanitized:;
				m_DashState_done(stage:=E_CIP_DashStage_List.e20_CIP5_DisInfection_Clean_Sprinkler);
				
	END_CASE	
	
ELSIF TRUE // Type Pine
AND NOT bClientTypeIs_Tank	
THEN;	
	bStepDone:=TRUE;
	CASE eRefClient_fbElement.eState_Long OF
	
		E_Element_State_Long.eCIP_2_Deterged:;
				m_DashState_done(stage:=E_CIP_DashStage_List.e10_CIP3_Detergent_Clean_Pipe);
	
		E_Element_State_Long.eCIP_4_Sanitized:;
				m_DashState_done(stage:=E_CIP_DashStage_List.e19_CIP5_DisInfection_Clean_Pipe);
				
	END_CASE	
	
ELSE;
	//continue with sprinkler
	bStepDone:=FALSE;
	CASE eRefClient_fbElement.eState_Long OF
	
		E_Element_State_Long.eCIP_2_Deterged:;
				m_DashState_done(stage:=E_CIP_DashStage_List.e10_CIP3_Detergent_Clean_Pipe);
				m_DashState_activate(stage:=E_CIP_DashStage_List.e11_CIP3_Detergent_Clean_Sprinkler);
	
		E_Element_State_Long.eCIP_4_Sanitized:;
				m_DashState_done(stage:=E_CIP_DashStage_List.e19_CIP5_DisInfection_Clean_Pipe);
				m_DashState_activate(stage:=E_CIP_DashStage_List.e20_CIP5_DisInfection_Clean_Sprinkler);
				
	END_CASE	
	
END_IF	]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aStartPump_CIP1_01_active" Id="{e50e4f65-8145-4f79-b69c-1a7d9a136df2}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
(*
IF StartPump_CIP1_01.t>SECOND_TO_TIME(st_CIP_Param.t_PumpInitRun) 
OR lvlTank_T93.rTankLevel<st_CIP_Param.r_Tank93_Volume//st_CIP_Param.r_RWater_93_TankLvl
THEN//Time+flow+water volume
	bStepDone:=TRUE;
END_IF
*)
bStepDone:=TRUE;]]></ST>
      </Implementation>
