            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aCIP2_Flow_Sprincler_entry" Id="{4454f205-0cdf-4ef6-883c-72552e22abc1}">
      <Implementation>
        <ST><![CDATA[tonStepConditionTime(IN:=FALSE);

m_DashState_done(stage:=E_CIP_DashStage_List.e06_CIP2_Client_Detergent_Condition_Pipe);
m_DashState_activate(stage:=E_CIP_DashStage_List.e07_CIP2_Client_Detergent_Condition_Sprinkler);]]></ST>
      </Implementation>
