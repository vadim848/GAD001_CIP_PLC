    <Action Name="_aConnect_CIP3_Drain_entry" Id="{0ac31c05-8c73-425f-955c-b721846a3dd9}">
      <Implementation>
        <ST><![CDATA[fbCIP_Usage.m_Run(eReqProc:=eReq.eClient);
fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eDrain);
fb_HeatExchenger.m_Auto();

mCIP_Clients_command(command:=E_CIP_Client_Command.eCIP);

CASE eReq.eClient OF

	E_CIP_Usage.eTank_1:;
				fbCIP_ClientTank_Marinade.m_Run(eReqProc:=E_CIP_ClientTank.eTank_A);
	E_CIP_Usage.eTank_2:;
				fbCIP_ClientTank_Marinade.m_Run(eReqProc:=E_CIP_ClientTank.eTank_B);	
	E_CIP_Usage.eTank_3:;
				fbCIP_ClientTank_Color.m_Run(eReqProc:=E_CIP_ClientTank.eTank_A);
	E_CIP_Usage.eTank_4:;
				fbCIP_ClientTank_Color.m_Run(eReqProc:=E_CIP_ClientTank.eTank_B);	

END_CASE

m_DashState_activate(stage:=E_CIP_DashStage_List.e14_CIP4_Client_DisInfection_Fill);
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
