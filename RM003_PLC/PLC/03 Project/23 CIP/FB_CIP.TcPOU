    <Action Name="_aStartPump_CIP3_01_active" Id="{e6aa8b88-0a3e-4980-90b3-b28e3208ca1c}">
      <Implementation>
        <ST><![CDATA[IF TRUE 
(*AND stAnalogSensor[E_ASense_Name.FT1001].Value>=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Flow_1//200 // 
AND stAnalogSensor[E_ASense_Name.FT1002].Value>=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Flow_2//200 // 
AND stAnalogSensor[E_ASense_Name.PT1001].Value>=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Pressure//0.5 //*)
AND pcFlow1_Rate.mRun()
AND pcFlow2_Rate.mRun()
//AND pcPressure.mRun()
THEN;
	bStepDone:=TRUE;
ELSE;
	bStepDone:=FALSE;
END_IF

fb_PumpCIP.m_Run(RPM:=pcFlow1_Rate.mRun_PID(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Flow_Pipe,controlManual:=NOT(fb_PumpCIP.modeAuto)));
]]></ST>
      </Implementation>
