    <Action Name="_ameasure_Deterg_active" Id="{d799421a-ef3e-49bb-9855-5dc9b4059ecb}">
      <Implementation>
        <ST><![CDATA[(*iStepDone:=0;
fDetergDeviation:=mProcessDeviation(reqValue:=fDetergTarget,processValue:=g_AnalogSensor.stAnalogSensor[E_ASense_Name.CT1101_3].Value);
fDetergLowTolerance:=0.05;
fDetergHighTolerance:=0.05;

IF fDetergDeviation>fDetergLowTolerance THEN;
	iStepDone:=2;
//ELSIF fDetergDeviation>fDetergHighTolerance+0.5 THEN;
ELSIF fDetergDeviation<-fDetergHighTolerance THEN;
	iStepDone:=3;	
	//OverFlow
ELSE;
	iStepDone:=1;
END_IF*)
;
]]></ST>
      </Implementation>
