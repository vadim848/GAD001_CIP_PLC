    <Action Name="_aConnect_CIP2_02_active" Id="{5c33287a-5ed2-41db-9467-cde15126c9e4}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eT92_Detergent)  
