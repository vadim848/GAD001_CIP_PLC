    <Action Name="act_CallProcessControl" Id="{ba2500c4-7891-45b7-bd60-804b421a62c3}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[//Detergent Local
stProcessControl_DtrgLcl.rValue:=g_AnalogSensor.stAnalogSensor[E_ASense_Name.CT1101_3].Value;
stProcessControl_DtrgLcl.ToleranceHigh:=0.05;
stProcessControl_DtrgLcl.ToleravceLow:=0.05;
stProcessControl_DtrgLcl.rSetPoint:=0.7;
Call_ProcControl_DtrgLcl(stProcessControl:=stProcessControl_DtrgLcl );
	
//Detergent Client
stProcessControl_DtrgClnt.rValue:=g_AnalogSensor.stAnalogSensor[E_ASense_Name.CT1101_3].Value;
stProcessControl_DtrgClnt.ToleranceHigh:=0.5;
stProcessControl_DtrgClnt.ToleravceLow:=0.5;
stProcessControl_DtrgClnt.rSetPoint:=0.7;
Call_ProcControl_DtrgClnt(stProcessControl:=stProcessControl_DtrgClnt );]]></ST>
      </Implementation>
    </Action>
