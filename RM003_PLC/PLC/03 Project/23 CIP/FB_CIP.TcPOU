    <Action Name="_aStartPump_CIP1_01_entry" Id="{d05b04cb-ad28-4d2f-b50e-f58a7739d4a3}">
      <Implementation>
        <ST><![CDATA[fb_PumpCIP.m_Run(RPM:=st_CIP_Param.r_CIP_Pump);
fb_PumpClient.m_Run(RPM:=st_CIP_Param.r_CIP_Client_Pump);

mVolumeReset_All();

tonr_CIP_Condition(ResetTime:=TRUE);
]]></ST>
      </Implementation>
