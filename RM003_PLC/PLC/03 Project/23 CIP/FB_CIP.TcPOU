    <Action Name="_aCIP4_Collect_active" Id="{245a31fa-2345-490d-951c-e73052de6876}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF eRefClient_fbElement.eState_Long=E_Element_State_Long.eCIP_2_Deterged THEN;
	volume_Requered:= REAL_TO_INT(st_CIP_Param.r_Volume_Collect_Detergent);
	volume_Actual:= REAL_TO_INT(delta_T92_Volume);
ELSIF eRefClient_fbElement.eState_Long=E_Element_State_Long.eCIP_4_Sanitized THEN;
	volume_Requered:= REAL_TO_INT(st_CIP_Param.r_Volume_Collect_DisInfection);
	volume_Actual:= REAL_TO_INT(delta_T91_Volume);
END_IF

IF volume_Actual >= volume_Requered THEN;
	bStepDone:=TRUE;
END_IF

(*
IF TRUE 
OR (delta_T94_Volume < -st_CIP_Param.r_Volume_Collect_Detergent AND eRefClient_fbElement.eState_Long=E_Element_State_Long.eCIP_2_Deterged)
OR (delta_T94_Volume < -st_CIP_Param.r_Volume_Collect_DisInfection AND eRefClient_fbElement.eState_Long=E_Element_State_Long.eCIP_4_Sanitized)

OR (delta_T92_Volume > st_CIP_Param.r_Volume_Collect_Detergent AND eRefClient_fbElement.eState_Long=E_Element_State_Long.eCIP_2_Deterged)
OR (delta_T91_Volume > st_CIP_Param.r_Volume_Collect_DisInfection AND eRefClient_fbElement.eState_Long=E_Element_State_Long.eCIP_4_Sanitized)
THEN
	bStepDone:=TRUE;
END_IF
*)]]></ST>
      </Implementation>
