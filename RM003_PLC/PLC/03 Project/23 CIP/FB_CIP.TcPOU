    <Action Name="_aReady_active" Id="{560e86d1-cd11-44bd-aed6-a8db9be9b76c}">
      <Implementation>
        <ST><![CDATA[CASE eMode OF
	E_CIP_Mode.eOff:;
		bRun:=FALSE;
		bStepDone:=FALSE;
	E_CIP_Mode.eManual:;
		IF TRUE 
		AND bRun 
		AND arCIP_RequestBufer[0].eClient<>E_CIP_Usage.eNotInUse
		
		THEN;
			bStepDone:=TRUE;
		ELSE;
			bStepDone:=FALSE;
		END_IF	
	E_CIP_Mode.eAuto:;
		IF TRUE 
		//AND bRun 
		AND arCIP_RequestBufer[0].eClient<>E_CIP_Usage.eNotInUse
		
		THEN;
			bRun:=TRUE;
			bStepDone:=TRUE;
		ELSE;
			bStepDone:=FALSE;
		END_IF		
END_CASE
	
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aReady_exit" Id="{fe06bbde-dba2-4c36-8b83-7a6e8089b6a1}">
      <Implementation>
        <ST><![CDATA[eReq:=arCIP_RequestBufer[0];

CASE eReq.eClient OF
	E_CIP_Usage.eLocal:;
		eRefClient_fbElement REF= fbElement_Blank;
		IF eReq.eType=E_CIP_Type.Full THEN;
			eRefClient_fbElement.m_Set_State(eState_Long_Set:=E_Element_State_Long.eNotClean);
		ELSE;
			eRefClient_fbElement.m_Set_State(eState_Long_Set:=E_Element_State_Long.eCIP_1_Rinzed);
		END_IF	
		
	E_CIP_Usage.eTank_1:;
		eRefClient_fbElement REF= fbElement[E_Element_List.eTank_1];

	E_CIP_Usage.eTank_2:;
		eRefClient_fbElement REF= fbElement[E_Element_List.eTank_2];
		
	E_CIP_Usage.eTank_3:;
		eRefClient_fbElement REF= fbElement[E_Element_List.eTank_3];
		
	E_CIP_Usage.eTank_4:;
		eRefClient_fbElement REF= fbElement[E_Element_List.eTank_4];
		
	E_CIP_Usage.eTriBlender_Marinada:;
		eRefClient_fbElement REF= fbElement[E_Element_List.eTriBlender_Marinada];
		
	E_CIP_Usage.eTriBlender_Color:;
		eRefClient_fbElement REF= fbElement[E_Element_List.eTriBlender_Color];
		
	E_CIP_Usage.eLine_Marinada:;
		eRefClient_fbElement REF= fbElement[E_Element_List.eLine_Marinada];
		
	E_CIP_Usage.eLine_Color:;
		eRefClient_fbElement REF= fbElement[E_Element_List.eLine_Color];

END_CASE

bClientRef_done:=TRUE;]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
