    <Action Name="_aCIP4_Drain_active" Id="{d7aa4e20-df54-48dd-9a3c-3664a01991e5}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;

IF eRefClient_fbElement.eState_Long=E_Element_State_Long.eCIP_2_Deterged THEN;
	volume_Requered:= REAL_TO_INT(st_CIP_Param.r_Volume_Drain_Detergent);
	volume_Actual:= REAL_TO_INT(-delta_T94_Volume);
ELSIF eRefClient_fbElement.eState_Long=E_Element_State_Long.eCIP_4_Sanitized THEN;
	volume_Requered:= REAL_TO_INT(st_CIP_Param.r_Volume_Drain_DisInfection);
	volume_Actual:= REAL_TO_INT(-delta_T94_Volume);
END_IF

IF volume_Actual >= volume_Requered THEN;
	bStepDone:=TRUE;
END_IF


(*
IF fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eDrain)  
AND ((delta_T94_Volume < -st_CIP_Param.r_Volume_Drain_Detergent AND eRefClient_fbElement.eState_Long=E_Element_State_Long.eCIP_2_Deterged)
OR (delta_T94_Volume < -st_CIP_Param.r_Volume_Drain_DisInfection AND eRefClient_fbElement.eState_Long=E_Element_State_Long.eCIP_4_Sanitized))
//TEMP T93
//OR (delta_T93_Volume < -st_CIP_Param.r_Volume_Drain_Detergent AND eRefClient_fbElement.eState_Long=E_Element_State_Long.eCIP_2_Deterged)
//OR (delta_T93_Volume < -st_CIP_Param.r_Volume_Drain_DisInfection AND eRefClient_fbElement.eState_Long=E_Element_State_Long.eCIP_4_Sanitized))
THEN;
	bStepDone:=TRUE;
END_IF
*)]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aCIP4_Drain_entry" Id="{048a2c59-3991-477e-82b6-2061ef66a49f}">
      <Implementation>
        <ST><![CDATA[fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eDrain);
mVolumeReset_All();

CASE eRefClient_fbElement.eState_Long OF

	E_Element_State_Long.eCIP_2_Deterged:;
			m_DashState_done(stage:=E_CIP_DashStage_List.e08_CIP3_Detergent_Collect);
			m_DashState_activate(stage:=E_CIP_DashStage_List.e09_CIP3_Detergent_Drain);

	E_Element_State_Long.eCIP_4_Sanitized:;
			m_DashState_done(stage:=E_CIP_DashStage_List.e17_CIP5_DisInfection_Collect);
			m_DashState_activate(stage:=E_CIP_DashStage_List.e18_CIP5_DisInfection_Drain);
			
END_CASE
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aClient_tank_IsEmpty_active" Id="{becf051e-545c-47b6-9688-7e31c59b9a42}">
      <Implementation>
        <ST><![CDATA[bStepDone:=m_ClientTank_IsEmpty();

(*
IF bClientTypeIs_Tank THEN;
	//
END_IF
CASE eCIP_Usage OF
	E_CIP_Usage.eTank_1:;
			IF stTanksSens[E_Tank_Name.T1].e_state=E_Tank_Level.eEmpty THEN;
				bStepDone:=TRUE;	
			END_IF	
	E_CIP_Usage.eTank_2:;
			IF stTanksSens[E_Tank_Name.T2].e_state=E_Tank_Level.eEmpty THEN;
				bStepDone:=TRUE;	
			END_IF	
	E_CIP_Usage.eTank_3:;
			IF stTanksSens[E_Tank_Name.T3].e_state=E_Tank_Level.eEmpty THEN;
				bStepDone:=TRUE;	
			END_IF	
	E_CIP_Usage.eTank_4:;
			IF stTanksSens[E_Tank_Name.T4].e_state=E_Tank_Level.eEmpty THEN;
				bStepDone:=TRUE;	
			END_IF
ELSE;
	bStepDone:=TRUE;	
END_CASE
*)]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
