AND fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eDrain)  
AND fbPis.m_CheckByRecipe(stPis:=stPis_FillWater_T94, 		req:=E_Piston_Recipe_State.Act) 
AND  lvlTank_T94.bIn_HL_signal THEN;//need something in case there are error in level sensor, should jump into error step and close all valves
	bStepDone:=TRUE;
END_IF]]></ST>
