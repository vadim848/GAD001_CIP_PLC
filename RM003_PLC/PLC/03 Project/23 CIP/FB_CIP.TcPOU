    </Method>
    <Method Name="m_TakePosInCIPBuffer" Id="{b2dcb157-1d24-4a20-a9df-81a455a5e4d3}" FolderPath="Meth\">
      <Declaration><![CDATA[METHOD m_TakePosInCIPBuffer : BOOL
VAR_INPUT
	stCIP_Request: ST_CIP_Request;
END_VAR

VAR
	i: INT;
	m: bool;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stCIP_Request.eClient<>E_CIP_Usage.eNotInUse
AND stCIP_Request.eType<>E_CIP_Type.NotSelected
AND g_data.fbElement[stCIP_Request.eClient].eState_Long>E_Element_State_Long.eStandby 
AND ((stCIP_Request.eType=E_CIP_Type.R_Water AND g_data.fbElement[stCIP_Request.eClient].eState_Long<E_Element_State_Long.eCIP_1_Rinzed)
	OR (stCIP_Request.eType=E_CIP_Type.Detergent AND g_data.fbElement[stCIP_Request.eClient].eState_Long<E_Element_State_Long.eCIP_3_Deterged_Clean)
	OR (stCIP_Request.eType=E_CIP_Type.Full AND g_data.fbElement[stCIP_Request.eClient].eState_Long<E_Element_State_Long.eCIP_5_Done))

THEN
	FOR i:=0 TO 9 DO
		IF arCIP_RequestBufer[i].eClient=stCIP_Request.eClient 
			AND arCIP_RequestBufer[i].eType>=stCIP_Request.eType 
		THEN 	
				m:=FALSE;
				EXIT;
			ELSE
				m:=TRUE;
		END_IF
	END_FOR	
	IF m=TRUE THEN
		FOR i:=0 TO 9 DO
			IF arCIP_RequestBufer[i].eClient=E_CIP_Usage.eNotInUse 
			THEN;
				arCIP_RequestBufer[i]:=stCIP_Request;
				m:=FALSE;
				EXIT;
			END_IF
		END_FOR	
	END_IF
ELSIF stCIP_Request.eClient=E_CIP_Usage.eLocal
AND stCIP_Request.eType<>E_CIP_Type.NotSelected
THEN;
		FOR i:=0 TO 9 DO
			IF arCIP_RequestBufer[i].eClient=E_CIP_Usage.eNotInUse 
			THEN;
				arCIP_RequestBufer[i]:=stCIP_Request;
				m:=FALSE;
				EXIT;
			END_IF
		END_FOR		
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="mCIP_Clients_command" Id="{80c84e09-bced-4039-86dd-22d66f3f838c}" FolderPath="Meth\">
      <Declaration><![CDATA[METHOD mCIP_Clients_command : BOOL
VAR_INPUT
	command: E_CIP_Client_Command ;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
//eReq.eClient<>E_CIP_Usage.eLocal
IF command=E_CIP_Client_Command.eDrain THEN;
	CASE eReq.eClient OF
		E_CIP_Usage.eTank_1:;
			g_Data.fbTankTarget_1.m_Run(eReqProc:=E_Tank_Target.eDrain);
		E_CIP_Usage.eTank_2:;
			g_Data.fbTankTarget_2.m_Run(eReqProc:=E_Tank_Target.eDrain);	
		E_CIP_Usage.eTank_3:;
			g_Data.fbTankTarget_3.m_Run(eReqProc:=E_Tank_Target.eDrain);	
		E_CIP_Usage.eTank_4:;
			g_Data.fbTankTarget_4.m_Run(eReqProc:=E_Tank_Target.eDrain);	
		E_CIP_Usage.eTriBlender_Marinada:;
			g_Data.fbTriBlenderSource_Marinade.m_Run(eReqProc:=E_Line_Source.eDrain);	
			g_Data.fbTriBlenderTarget_Marinade.m_Run(eReqProc:=E_Line_Target.eDrain);	
		E_CIP_Usage.eTriBlender_Color:;
			g_Data.fbTriBlenderSource_Color.m_Run(eReqProc:=E_Line_Source.eDrain);	
			g_Data.fbTriBlenderTarget_Color.m_Run(eReqProc:=E_Line_Target.eDrain);		
		E_CIP_Usage.eLine_Marinada:;
			g_Data.fbLineSource_Marinade.m_Run(eReqProc:=E_Line_Source.eDrain);	
			g_Data.fbLineTarget_Marinade.m_Run(eReqProc:=E_Line_Target.eDrain);	
		E_CIP_Usage.eLine_Color:;
			g_Data.fbLineSource_Color.m_Run(eReqProc:=E_Line_Source.eDrain);	
			g_Data.fbLineTarget_Color.m_Run(eReqProc:=E_Line_Target.eDrain);	
	ELSE;
		//wrong, - local
	END_CASE	
ELSIF command=E_CIP_Client_Command.eCIP THEN;
	CASE eReq.eClient OF
		E_CIP_Usage.eTank_1:;
			g_Data.fbTankTarget_1.m_Run(eReqProc:=E_Tank_Target.eCIP);
		E_CIP_Usage.eTank_2:;
			g_Data.fbTankTarget_2.m_Run(eReqProc:=E_Tank_Target.eCIP);	
		E_CIP_Usage.eTank_3:;
			g_Data.fbTankTarget_3.m_Run(eReqProc:=E_Tank_Target.eCIP);	
		E_CIP_Usage.eTank_4:;
			g_Data.fbTankTarget_4.m_Run(eReqProc:=E_Tank_Target.eCIP);	
		E_CIP_Usage.eTriBlender_Marinada:;
			g_Data.fbTriBlenderSource_Marinade.m_Run(eReqProc:=E_Line_Source.eCIP);	
			g_Data.fbTriBlenderTarget_Marinade.m_Run(eReqProc:=E_Line_Target.eCIP);	
		E_CIP_Usage.eTriBlender_Color:;
			g_Data.fbTriBlenderSource_Color.m_Run(eReqProc:=E_Line_Source.eCIP);	
			g_Data.fbTriBlenderTarget_Color.m_Run(eReqProc:=E_Line_Target.eCIP);		
		E_CIP_Usage.eLine_Marinada:;
			g_Data.fbLineSource_Marinade.m_Run(eReqProc:=E_Line_Source.eCIP);	
			g_Data.fbLineTarget_Marinade.m_Run(eReqProc:=E_Line_Target.eCIP);	
		E_CIP_Usage.eLine_Color:;
			g_Data.fbLineSource_Color.m_Run(eReqProc:=E_Line_Source.eCIP);	
			g_Data.fbLineTarget_Color.m_Run(eReqProc:=E_Line_Target.eCIP);	
	ELSE;
		//wrong, - local
	END_CASE	
END_IF
]]></ST>
      </Implementation>
    </Method>
