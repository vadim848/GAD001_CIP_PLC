    <Action Name="_aCIP2_If_ClientIsTank_active" Id="{4a9144df-9ae3-4d28-9b85-5b9ce93c547e}">
      <Implementation>
        <ST><![CDATA[CASE eReq.eClient OF
	E_CIP_Usage.eTank_1,
	E_CIP_Usage.eTank_2,
	E_CIP_Usage.eTank_3,
	E_CIP_Usage.eTank_4:;
			bStepDone:=TRUE;
			m_DashState_done(stage:=E_CIP_DashStage_List.e07_CIP2_Client_Detergent_Condition_Sprinkler);
			
ELSE;
			bStepDone:=FALSE;
			m_DashState_done(stage:=E_CIP_DashStage_List.e06_CIP2_Client_Detergent_Condition_Pipe);
END_CASE]]></ST>
      </Implementation>
