    <Action Name="_aCondition_CIP2_Client_active" Id="{4c374eda-5cab-4d42-be48-b4cc4764cc7c}">
      <Implementation>
        <ST><![CDATA[fb_PumpCIP.m_Run(RPM:=pcFlow1_Rate.mRun_PID(Set_Point:=fFlowRate, controlManual:=NOT(fb_PumpCIP.modeAuto)));
fb_PumpClient.m_Run(RPM:=st_CIP_Param.r_CIP_Client_Pump);

IF bSprinkler THEN;
	IF TRUE 
	AND pcFlow1_Rate.mRun(mRun=>_cond[1])
	AND pcFlow3_Rate.mRun(mRun=>_cond[2])
	THEN;
		//
	ELSE;
		bCIP_Condition_Failed:=TRUE;
	END_IF
ELSE;
	IF TRUE 
	AND pcFlow1_Rate.mRun(mRun=>_cond[1])
	AND pcFlow2_Rate.mRun(mRun=>_cond[2])
	THEN;
		//
	ELSE;
		bCIP_Condition_Failed:=TRUE;
	END_IF	
END_IF

pcHeatExchanger.mRun_PID(Set_Point:=st_CIP_Param.r_Temper_Detergent, controlManual:=g_Data.stHeatExchanger.bManual ,mRun_PID=>_temp);
tonr_CIP_Condition(PT:=SECOND_TO_TIME(tConditionTime));
IF TRUE 
AND pcHeatExchanger.mRun_With_SP(Set_Point:=st_CIP_Param.r_Temper_Detergent, mRun_With_SP=>_cond[3])
//AND pcTemperature_Deterg.mRun_With_SP(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Temper_Detergent, mRun_With_SP=>_cond[4])
AND pcTemp_ClntReturn.mRun_With_SP(Set_Point:=st_CIP_Param.r_Temper_Detergent, mRun_With_SP=>_cond[5])
AND pcDetergent.mRun_With_SP(Set_Point:=st_CIP_Param.r_DetergentConcentration, mRun_With_SP=>_cond[6])
AND measure_Deterg_2.x
AND TRUE
THEN;
	tonr_CIP_Condition.IN:=TRUE;
	m_run_MixProof();
ELSE;
	tonr_CIP_Condition.IN:=FALSE;
END_IF

IF tonr_CIP_Condition.Q 
AND bValveCleanDone
THEN;
	bCIP_Condition_Done:=TRUE;
ELSE;
	bCIP_Condition_Done:=FALSE;
END_IF



ton_Concentration_Filter(PT:=T#30S, IN:=stDetergent.Control_ON AND NOT stDetergent.OverFlow);
IF TRUE 
AND ton_Concentration_Filter.Q	
THEN;
 bConcentration_correct:=TRUE;
ELSE;
 bConcentration_correct:=FALSE;
END_IF

// Reverce function
(*
IF Deterg_Conc_Client_Done.x 
AND NOT pcDetergent.mRun() 
THEN;
	bCIP_Condition_Failed:=TRUE;
END_IF

IF Temperature_2_Done.x 
//AND NOT pcTemperature_Deterg.mRun()
AND NOT pcTemp_ClntReturn.mRun()
THEN;
	bCIP_Condition_Failed:=TRUE;
END_IF
*)
(*
//ton_CIP_Condition(PT:=T#30S);
IF tConditionTime-nDeter_CondActTime_Clnt>0 THEN
	tonr_CIP_Condition(PT:=SECOND_TO_TIME(tConditionTime-nDeter_CondActTime_Clnt));
	bDeter_CondActTime_Clnt_Done:=FALSE;
ELSE
	bDeter_CondActTime_Clnt_Done:=TRUE;
END_IF

IF TRUE 
AND Deterg_Conc_Client_Done.x
AND Temperature_2_Done.x
AND NOT bDeter_CondActTime_Clnt_Done
AND TRUE
THEN;
	tonr_CIP_Condition.IN:=TRUE;
ELSE;
	nDeter_CondActTime_Clnt:=TIME_TO_INT(tonr_CIP_Condition.ET)/1000;
	tonr_CIP_Condition.IN:=FALSE;
END_IF

IF tonr_CIP_Condition.Q
OR bDeter_CondActTime_Clnt_Done THEN;
	bCIP_Condition_Done:=TRUE;
ELSE;
	bCIP_Condition_Done:=FALSE;
END_IF
*)

]]></ST>
      </Implementation>
