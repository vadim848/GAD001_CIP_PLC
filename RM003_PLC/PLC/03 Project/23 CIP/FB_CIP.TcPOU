      <Implementation>
        <ST><![CDATA[tonStepConditionTime(IN:=FALSE);
m_DashState_done(stage:=E_CIP_DashStage_List.e15_CIP4_Client_DisInfection_Condition_Pipe);
m_DashState_activate(stage:=E_CIP_DashStage_List.e16_CIP4_Client_DisInfection_Condition_Sprinkler);]]></ST>
