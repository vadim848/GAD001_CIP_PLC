            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aFill_Water_T94_Done_active" Id="{972d8a9c-6f90-434c-9eee-b7777733be46}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF fbPis.m_CheckByRecipe(stPis:=stPis_FillWater_T94, 		req:=E_Piston_Recipe_State.Act) THEN
	bStepDone:=TRUE;
END_IF
bStepDone:=TRUE;]]></ST>
      </Implementation>
