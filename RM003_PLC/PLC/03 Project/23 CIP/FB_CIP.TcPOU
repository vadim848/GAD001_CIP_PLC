    <Action Name="_aFill_Water_T94_entry" Id="{cab8dd8a-41d7-4bc6-8864-94606c706eb3}">
      <Implementation>
        <ST><![CDATA[fbCIP_Source.m_Run(eReqProc:=E_CIP_Source.eClose);
fbCIP_Usage.m_Run(eReqProc:=E_CIP_Usage.eLocal);
fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eDrain);
fbPis.m_SetByRecipe(stPis:=stPis_FillWater_T94, 			req:=E_Piston_Recipe_State.Act);


CASE eRefClient_fbElement.eState_Long OF

	E_Element_State_Long.eCIP_2_Deterged:;
			m_DashState_activate(stage:=E_CIP_DashStage_List.e08_CIP3_Detergent_Collect);

	E_Element_State_Long.eCIP_4_Sanitized:;
			m_DashState_activate(stage:=E_CIP_DashStage_List.e17_CIP5_DisInfection_Collect);
			
END_CASE

bClean_MixProof:=FALSE;
bValveCleanDone:=FALSE;]]></ST>
      </Implementation>
