    <Action Name="_aStartPump_CIP2_01_active" Id="{c1fce140-5edc-4740-a154-cfbe59a57483}">
      <Implementation>
        <ST><![CDATA[IF TRUE 
//AND stAnalogSensor[E_ASense_Name.FT1001].Value>=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Flow_1 // 
//AND stAnalogSensor[E_ASense_Name.FT1002].Value>=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Flow_2 // 
//AND stAnalogSensor[E_ASense_Name.PT1001].Value>=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Pressure // 
//AND pcFlow1_Rate.mRun_With_SP(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Flow_Pipe)
//AND pcFlow2_Rate.mRun_With_SP(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Flow_Pipe)
AND pcFlow1_Rate.mRun()
AND pcFlow2_Rate.mRun()
//AND pcPressure.mRun()
THEN;
	bStepDone:=TRUE;
ELSE;
	bStepDone:=FALSE;
END_IF

fb_PumpCIP.m_Run(RPM:=pcFlow1_Rate.mRun_PID(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Flow_Pipe,controlManual:=NOT(fb_PumpCIP.modeAuto)));
]]></ST>
      </Implementation>
