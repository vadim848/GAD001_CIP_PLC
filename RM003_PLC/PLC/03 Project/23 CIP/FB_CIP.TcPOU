            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aCIP4_Collect_entry" Id="{6daf871f-9050-473d-9190-81d975256abb}">
      <Implementation>
        <ST><![CDATA[mVolumeReset_All();]]></ST>
      </Implementation>
