    <Action Name="_aConnect_CIP2_Drain_01_active" Id="{f68678bc-b18d-4852-94b8-98264ea0b005}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE; 
IF fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eDrain)THEN;
	bStepDone:=TRUE;
END_IF]]></ST>
