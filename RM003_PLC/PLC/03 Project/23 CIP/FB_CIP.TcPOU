    <Action Name="_aTriBlender_Selection_active" Id="{d0e672f4-6afb-4eb1-ae08-259e55e6edbe}">
      <Implementation>
        <ST><![CDATA[
IF eRefClient_fbElement.eElementID=E_Element_List.eTriBlender_Marinada THEN;
	bStepDone:=fbTriBlender_Select.m_CheckStatus(eReqStatus:=E_TriBlenderSelect.eMarinade);

ELSIF eRefClient_fbElement.eElementID=E_Element_List.eTriBlender_Color THEN;
	bStepDone:=fbTriBlender_Select.m_CheckStatus(eReqStatus:=E_TriBlenderSelect.eColor);
	
ELSE;
	bStepDone:=TRUE;
END_IF


]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
