        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aConnect_CIP4_active" Id="{588b6467-3c69-4e91-bbae-17dceb39c081}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF TRUE
AND fbCIP_Source.m_CheckStatus(eReqStatus:=E_CIP_Source.eT94_Water) 
//AND fbCIP_Source.m_CheckStatus(eReqStatus:=E_CIP_Source.eT93_R_Water) 
AND fbCIP_Usage.m_CheckStatus(eReqStatus:=eReq.eClient)  
//AND fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eDrain) 
AND mCIP_Clients_status(command:=E_CIP_Client_Command.eCIP)
THEN;

	CASE eReq.eClient OF
	
		E_CIP_Usage.eTank_1:;
					bStepDone:=fbCIP_ClientTank_Marinade.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_A);
		E_CIP_Usage.eTank_2:;
					bStepDone:=fbCIP_ClientTank_Marinade.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_B);	
		E_CIP_Usage.eTank_3:;
					bStepDone:=fbCIP_ClientTank_Color.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_A);
		E_CIP_Usage.eTank_4:;
					bStepDone:=fbCIP_ClientTank_Color.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_B);	
	ELSE;				
		bStepDone:=TRUE;
	END_CASE
	
END_IF

IF bStepDone THEN;
	CASE eRefClient_fbElement.eState_Long OF
		E_Element_State_Long.eCIP_2_Deterged:;
				//fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eT92_Detergent);
				bStepDone:=fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eT92_Detergent);
		E_Element_State_Long.eCIP_4_Sanitized:;
				//fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eT91_Sanitation);	
				bStepDone:=fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eT91_Sanitation);
	ELSE;
		bStepDone:=FALSE;
	END_CASE	
END_IF]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aConnect_CIP4_entry" Id="{e2d0dcfe-cb47-41eb-a6a5-6136c5fde635}">
      <Implementation>
        <ST><![CDATA[fbCIP_Source.m_Run(eReqProc:=E_CIP_Source.eT94_Water);
//Temp solution for T93
//fbCIP_Source.m_Run(eReqProc:=E_CIP_Source.eT93_R_Water);
fbCIP_Usage.m_Run(eReqProc:=eReq.eClient);

mCIP_Clients_command(command:=E_CIP_Client_Command.eCIP);



CASE eRefClient_fbElement.eState_Long OF
	E_Element_State_Long.eCIP_2_Deterged:;
			fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eT92_Detergent);
		
	E_Element_State_Long.eCIP_4_Sanitized:;
			fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eT91_Sanitation);				
END_CASE

CASE eReq.eClient OF

	E_CIP_Usage.eTank_1:;
				fbCIP_ClientTank_Marinade.m_Run(eReqProc:=E_CIP_ClientTank.eTank_A);
	E_CIP_Usage.eTank_2:;
				fbCIP_ClientTank_Marinade.m_Run(eReqProc:=E_CIP_ClientTank.eTank_B);	
	E_CIP_Usage.eTank_3:;
				fbCIP_ClientTank_Color.m_Run(eReqProc:=E_CIP_ClientTank.eTank_A);
	E_CIP_Usage.eTank_4:;
				fbCIP_ClientTank_Color.m_Run(eReqProc:=E_CIP_ClientTank.eTank_B);	

END_CASE
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
