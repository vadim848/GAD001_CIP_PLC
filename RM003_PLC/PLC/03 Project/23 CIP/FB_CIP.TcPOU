            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aDisconnect_CIP_Client_entry" Id="{389c4393-cc6f-44b7-aa76-d6cd696fd6a2}">
      <Implementation>
        <ST><![CDATA[fbCIP_Source.m_Run(eReqProc:=E_CIP_Source.eClose);
fbCIP_Usage.m_Run(eReqProc:=E_CIP_Usage.eLocal);
fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eDrain);
mCIP_Clients_command(command:=E_CIP_Client_Command.eDrain);

CASE eReq.eClient OF

	E_CIP_Usage.eTank_1:;
				fbCIP_ClientTank_Marinade.m_Run(eReqProc:=E_CIP_ClientTank.eDrain);
	E_CIP_Usage.eTank_2:;
				fbCIP_ClientTank_Marinade.m_Run(eReqProc:=E_CIP_ClientTank.eDrain);	
	E_CIP_Usage.eTank_3:;
				fbCIP_ClientTank_Color.m_Run(eReqProc:=E_CIP_ClientTank.eDrain);
	E_CIP_Usage.eTank_4:;
				fbCIP_ClientTank_Color.m_Run(eReqProc:=E_CIP_ClientTank.eDrain);	

END_CASE

IF __ISVALIDREF(eRefClient_fbElement) THEN;
	IF eRefClient_fbElement.eElementID=E_Element_List.eTriBlender_Marinada THEN;
		fbTriBlender_Select.m_Run(eReqProc:=E_TriBlenderSelect.eDrain);
	END_IF
	
	IF eRefClient_fbElement.eElementID=E_Element_List.eTriBlender_Color THEN;
		fbTriBlender_Select.m_Run(eReqProc:=E_TriBlenderSelect.eDrain);
	END_IF	
END_IF

]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aDisconnect_Old_Client_entry" Id="{0737bcf1-8ed2-4576-9f1e-32273d33eec5}">
      <Implementation>
        <ST><![CDATA[eReq:=eReqBlank;
eRun:=E_CIP_Source.eNone;
m_CleanEmpty_Spaces();

IF __ISVALIDREF(eRefClient_fbElement) THEN;
	IF eRefClient_fbElement.m_Get_CIP_Avilable() THEN;
		eRefClient_fbElement.m_Disconnect();
	END_IF
END_IF
eRefClient_fbElement REF= fbElement_Blank;

m_DashState_MixProof_set();]]></ST>
      </Implementation>
