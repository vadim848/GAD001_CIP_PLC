      <Implementation>
        <ST><![CDATA[fb_PumpCIP.m_Run(RPM:=pcFlow1_Rate.mRun_PID(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Flow_Pipe,controlManual:=NOT(fb_PumpCIP.modeAuto)));

IF TRUE 
AND pcFlow1_Rate.mRun(mRun=>_cond[1])
AND pcFlow2_Rate.mRun(mRun=>_cond[2])
//AND pcPressure.mRun()
THEN;
	//
ELSE;
	bCIP_Condition_Failed:=TRUE;
END_IF

pcHeatExchanger.mRun_PID(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Temper_Detergent, controlManual:=g_Data.stHeatExchanger.bManual ,mRun_PID=>_temp);
tonr_CIP_Condition(PT:=SECOND_TO_TIME(g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].t_ConditionDetergent), ResetTime:=FALSE);
IF TRUE 
AND pcHeatExchanger.mRun_With_SP(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Temper_Detergent, mRun_With_SP=>_cond[3])
AND pcTemperature_Deterg.mRun_With_SP(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Temper_Detergent, mRun_With_SP=>_cond[4])
AND pcTemp_ClntReturn.mRun_With_SP(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Temper_Detergent, mRun_With_SP=>_cond[5])
AND pcDetergent.mRun_With_SP(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_DetergentConcentration, mRun_With_SP=>_cond[6])
AND measure_Deterg.x
AND TRUE
THEN;
	tonr_CIP_Condition.IN:=TRUE;
ELSE;
	tonr_CIP_Condition.IN:=FALSE;
END_IF
	
IF tonr_CIP_Condition.Q THEN;
	bCIP_Condition_Done:=TRUE;
ELSE;
	bCIP_Condition_Done:=FALSE;	
END_IF


ton_Concentration_Filter(PT:=T#30S, IN:=stDetergent.Control_ON AND NOT stDetergent.OverFlow);
IF TRUE 
AND ton_Concentration_Filter.Q	
THEN;
 bConcentration_correct:=TRUE;
ELSE;
 bConcentration_correct:=FALSE;
END_IF

// Reverce function

(*
IF Deterg_Conc_Local_Done.x 
AND NOT pcDetergent.mRun()
THEN;
	bCIP_Condition_Failed:=TRUE;
END_IF

IF Temperature_1_Done.x 
AND (NOT pcTemperature_Deterg.mRun()
	OR NOT pcTemp_ClntReturn.mRun())
THEN;
	bCIP_Condition_Failed:=TRUE;
END_IF
*)

(*
//ton_CIP_Condition(PT:=T#30S);
IF (g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].t_ConditionDetergent-nDeter_CondActTime_Lcl)>0 THEN
	tonr_CIP_Condition(PT:=SECOND_TO_TIME(g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].t_ConditionDetergent-nDeter_CondActTime_Lcl));
	bDeter_CondActTime_Lcl_Done:=FALSE;
ELSE
	bDeter_CondActTime_Lcl_Done:=TRUE;
END_IF

IF TRUE 
AND Deterg_Conc_Local_Done.x
AND Temperature_1_Done.x
AND NOT bDeter_CondActTime_Lcl_Done
AND TRUE
THEN;
	tonr_CIP_Condition.IN:=TRUE;
ELSE;
	nDeter_CondActTime_Lcl:=TIME_TO_INT(tonr_CIP_Condition.ET)/1000;
	tonr_CIP_Condition.IN:=FALSE;
END_IF
	
IF tonr_CIP_Condition.Q OR bDeter_CondActTime_Lcl_Done THEN;
	bCIP_Condition_Done:=TRUE;
ELSE;
	bCIP_Condition_Done:=FALSE;	
END_IF

*)




]]></ST>
