            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aStartPump_CIP2_01_entry" Id="{4589c8d4-2b8a-47b6-b8e7-d8da9bb4ee5a}">
      <Implementation>
        <ST><![CDATA[
//fb_PumpDetergent.m_Auto();
fb_HeatExchenger.m_Auto();
bCIP_Condition_Failed:=FALSE;
bCIP_Condition_Done:=FALSE;
iConcentrationDeluteCounter:=0;

nStepHeat:=1;]]></ST>
      </Implementation>
