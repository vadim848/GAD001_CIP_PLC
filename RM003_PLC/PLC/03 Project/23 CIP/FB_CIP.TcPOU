    <Action Name="_aCondition_CIP2_Client_active" Id="{4c374eda-5cab-4d42-be48-b4cc4764cc7c}">
      <Implementation>
        <ST><![CDATA[
IF TRUE 
AND stAnalogSensor[E_ASense_Name.FT1001].Value>=st_CIP_Param.r_Flow_1 // 
AND stAnalogSensor[E_ASense_Name.FT1002].Value>=st_CIP_Param.r_Flow_2 // 
AND stAnalogSensor[E_ASense_Name.PT1001].Value>=st_CIP_Param.r_Pressure // 
THEN;
	//
ELSE;
	bCIP_Condition_Failed:=TRUE;
END_IF


IF Deterg_Conc_Client_Done.x 
AND NOT pcDetergent.mRun()
THEN;
	bCIP_Condition_Failed:=TRUE;
END_IF

IF Temperature_2_Done.x 
AND NOT pcTemperature_Deterg.mRun()
THEN;
	bCIP_Condition_Failed:=TRUE;
END_IF


ton_CIP_Condition(PT:=T#30S);
IF TRUE 
AND Deterg_Conc_Client_Done.x
AND Temperature_2_Done.x
AND TRUE
THEN;
	ton_CIP_Condition.IN:=TRUE;
ELSE;
	ton_CIP_Condition.IN:=FALSE;
END_IF

IF ton_CIP_Condition.Q THEN;
	bCIP_Condition_Done:=TRUE;
ELSE;
	bCIP_Condition_Done:=FALSE;
END_IF
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aCondition_CIP2_Local_active" Id="{e5e07d09-44e8-4297-94d3-a998af75e5e0}">
      <Implementation>
        <ST><![CDATA[
IF TRUE 
AND stAnalogSensor[E_ASense_Name.FT1001].Value>=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Flow_1 // 
AND stAnalogSensor[E_ASense_Name.FT1002].Value>=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Flow_2//st_CIP_Param.st_Deter_Local.r_Flow_Pmp1_2 // 
AND stAnalogSensor[E_ASense_Name.PT1001].Value>=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Pressure//st_CIP_Param.st_Deter_Local.r_Pressure_Pmp1_1 // 
THEN;
	//
ELSE;
	bCIP_Condition_Failed:=TRUE;
END_IF


IF Deterg_Conc_Local_Done.x 
AND NOT pcDetergent.mRun()
THEN;
	bCIP_Condition_Failed:=TRUE;
END_IF

IF Temperature_1_Done.x 
AND NOT pcTemperature_Deterg.mRun()
THEN;
	bCIP_Condition_Failed:=TRUE;
END_IF


ton_CIP_Condition(PT:=T#30S);
IF TRUE 
AND Deterg_Conc_Local_Done.x
AND Temperature_1_Done.x
AND TRUE
THEN;
	ton_CIP_Condition.IN:=TRUE;
ELSE;
	ton_CIP_Condition.IN:=FALSE;
END_IF

IF ton_CIP_Condition.Q THEN;
	bCIP_Condition_Done:=TRUE;
ELSE;
	bCIP_Condition_Done:=FALSE;	
END_IF
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aCondition_CIP3_Client_active" Id="{c8b10d3e-d2df-4479-877a-926158cbaf79}">
      <Implementation>
        <ST><![CDATA[
IF TRUE  
AND stAnalogSensor[E_ASense_Name.FT1001].Value>=st_CIP_Param.r_Flow_1//st_CIP_Param.st_DisInf_Client.r_Flow_Pmp1_1 // 
AND stAnalogSensor[E_ASense_Name.FT1002].Value>=st_CIP_Param.r_Flow_2//st_CIP_Param.st_DisInf_Client.r_Flow_Pmp1_2 // 
AND stAnalogSensor[E_ASense_Name.PT1001].Value>=st_CIP_Param.r_Pressure//st_CIP_Param.st_DisInf_Client.r_Pressure_Pmp1_1 // 
THEN;
	//
ELSE;
	bCIP_Condition_Failed:=TRUE;
END_IF


IF Disinfct_Conc_Client_Done.x 
AND NOT pcDisinfectant.mRun()
THEN;
	bCIP_Condition_Failed:=TRUE;
END_IF

IF Temperature_Dis_2_Done.x 
AND NOT pcTemperature_Dis.mRun()
THEN;
	bCIP_Condition_Failed:=TRUE;
END_IF


ton_CIP_Condition(PT:=T#30S);
IF TRUE 
AND Disinfct_Conc_Client_Done.x
AND Temperature_Dis_2_Done.x
AND TRUE
THEN;
	ton_CIP_Condition.IN:=TRUE;
ELSE;
	ton_CIP_Condition.IN:=FALSE;
END_IF

IF ton_CIP_Condition.Q THEN;
	bCIP_Condition_Done:=TRUE;
ELSE;
	bCIP_Condition_Done:=FALSE;	
END_IF
]]></ST>
      </Implementation>
