    <Action Name="_aConnect_CIP3_02_entry" Id="{3d7e9a21-8eb7-46bc-aab2-fb63e0bca5ca}">
      <Implementation>
        <ST><![CDATA[fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eT91_Sanitation);

m_DashState_done(stage:=E_CIP_DashStage_List.e14_CIP4_Client_DisInfection_Fill);
m_DashState_activate(stage:=E_CIP_DashStage_List.e15_CIP4_Client_DisInfection_Condition_Pipe);]]></ST>
      </Implementation>
