    <Action Name="_aCIP1_Conn_Sprinkler_active" Id="{4c796a07-4449-4c49-bcc2-457b99419775}">
      <Implementation>
        <ST><![CDATA[//Connect client tank to sprinkler
CASE eReq.eClient OF
	
	E_CIP_Usage.eTank_1:;
				bStepDone:=fbCIP_ClientTank_Marinade.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_A_Sprinkler);
	E_CIP_Usage.eTank_2:;
				bStepDone:=fbCIP_ClientTank_Marinade.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_B_Sprinkler);	
	E_CIP_Usage.eTank_3:;
				bStepDone:=fbCIP_ClientTank_Color.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_A_Sprinkler);
	E_CIP_Usage.eTank_4:;
				bStepDone:=fbCIP_ClientTank_Color.m_CheckStatus(eReqStatus:=E_CIP_ClientTank.eTank_B_Sprinkler);	

ELSE;				
	bStepDone:=FALSE;
END_CASE
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aCIP1_Conn_Sprinkler_entry" Id="{5b8727b3-8cd5-4a98-a184-e51877734957}">
      <Implementation>
        <ST><![CDATA[bSprinkler:=TRUE;
CASE eReq.eClient OF

	E_CIP_Usage.eTank_1:;
				fbCIP_ClientTank_Marinade.m_Run(eReqProc:=E_CIP_ClientTank.eTank_A_Sprinkler);
	E_CIP_Usage.eTank_2:;
				fbCIP_ClientTank_Marinade.m_Run(eReqProc:=E_CIP_ClientTank.eTank_B_Sprinkler);	
	E_CIP_Usage.eTank_3:;
				fbCIP_ClientTank_Color.m_Run(eReqProc:=E_CIP_ClientTank.eTank_A_Sprinkler);
	E_CIP_Usage.eTank_4:;
				fbCIP_ClientTank_Color.m_Run(eReqProc:=E_CIP_ClientTank.eTank_B_Sprinkler);	

END_CASE
tonr_CIP_Condition(ResetTime:=TRUE);


]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
