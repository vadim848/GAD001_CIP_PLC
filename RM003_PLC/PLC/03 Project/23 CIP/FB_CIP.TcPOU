    <Action Name="_aStartPump_CIP3_01_entry" Id="{b0df1b3d-bbd7-422e-b23e-87cbef7af745}">
      <Implementation>
        <ST><![CDATA[

fb_HeatExchenger.m_Auto();
bCIP_Condition_Failed:=FALSE;
bCIP_Condition_Done:=FALSE;

nStepHeat:=2;
iConcentrationDeluteCounter:=0;]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
