    <Action Name="act_Status" Id="{8c5bd8f8-66f0-4098-9f33-9015434f732a}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[IF bReady AND bDone OR TRUE THEN;
	IF TRUE 
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_Water, 			req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_R_Water, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_Detergent, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_DisInfection, 	req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 				req:=E_Piston_Recipe_State.Release)
	THEN;
		eStatus:=E_CIP_Source.eClose;
	
	ELSIF TRUE 
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_Water, 			req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_R_Water, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_Detergent, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_DisInfection, 	req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 				req:=E_Piston_Recipe_State.Release)
	THEN;
		eStatus:=E_CIP_Source.eT94_Water;
		
	ELSIF TRUE 
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_Water, 			req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_R_Water, 		req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_Detergent, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_DisInfection, 	req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 				req:=E_Piston_Recipe_State.Act)
	THEN;
		eStatus:=E_CIP_Source.eT93_R_Water;
		
	ELSIF TRUE 	
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_Water, 			req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_R_Water, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_Detergent, 		req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_DisInfection, 	req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 				req:=E_Piston_Recipe_State.Act)
	THEN;
		eStatus:=E_CIP_Source.eT92_Detergent;
		
	ELSIF TRUE 	
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_Water, 			req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_R_Water, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_Detergent, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Tank_DisInfection, 	req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 				req:=E_Piston_Recipe_State.Act)
	THEN;
		eStatus:=E_CIP_Source.eT91_Sanitation;
	ELSE;
		eStatus:=E_Tank_Target.eNone;
	END_IF
ELSE;
	eStatus:=E_Tank_Target.eNone;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_CheckStatus" Id="{cc574672-75d4-4109-af68-d1c872851152}">
      <Declaration><![CDATA[METHOD m_CheckStatus : BOOL
VAR_INPUT
	eReqStatus		: E_CIP_Source;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eStatus=eReqStatus 
AND eProcess=E_CIP_Source.eNone
AND eReq=E_CIP_Source.eNone
AND bReady
AND bDone
AND NOT bRun
THEN;
	m_CheckStatus:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Run" Id="{5d191ab6-be10-46af-8016-5701543b152c}">
      <Declaration><![CDATA[METHOD m_Run : BOOL
VAR_INPUT
	eReqProc			: E_CIP_Source;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eProcess=E_CIP_Source.eNone THEN;
	eProcess:=eReq:=eReqProc;
	bDone:=FALSE;
	m_Run:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Set_SFCFlags_Reference" Id="{6a5e32bd-46a1-4d83-b2b2-41e90d72387a}">
      <Declaration><![CDATA[METHOD m_Set_SFCFlags_Reference : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Set reference to SFC flags

refSFC.SFCInit REF= SFCInit;
refSFC.SFCReset REF= SFCReset;
refSFC.SFCError REF= SFCError;
refSFC.SFCEnableLimit REF= SFCEnableLimit;
refSFC.SFCErrorStep REF= SFCErrorStep;
refSFC.SFCErrorPOU REF= SFCErrorPOU;
refSFC.SFCQuitError REF= SFCQuitError;
refSFC.SFCPause REF= SFCPause;
refSFC.SFCTrans REF= SFCTrans;
refSFC.SFCCurrentStep REF= SFCCurrentStep;
refSFC.SFCTip REF= SFCTip;
refSFC.SFCTipMode REF= SFCTipMode;

// Cycle handle for SFC
m_SFC_Handle();]]></ST>
      </Implementation>
    </Method>
