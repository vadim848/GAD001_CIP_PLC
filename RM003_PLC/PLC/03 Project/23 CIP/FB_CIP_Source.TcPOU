    <Action Name="_aReady_active" Id="{2f0857dc-1162-4f85-849b-826c1f096529}">
      <Implementation>
        <ST><![CDATA[

CASE eReq OF
	E_CIP_Source.eClose:;
			IF TRUE THEN;
				eProcess:=E_CIP_Source.eClose;
			END_IF

	E_CIP_Source.eT91_Sanitation:;
			IF TRUE THEN;
				eProcess:=E_CIP_Source.eT91_Sanitation;
			END_IF	
			
	E_CIP_Source.eT92_Detergent:;
			IF TRUE THEN;
				eProcess:=E_CIP_Source.eT92_Detergent;
			END_IF	

	E_CIP_Source.eT93_R_Water:;
			IF TRUE THEN;
				eProcess:=E_CIP_Source.eT93_R_Water;
			END_IF	
			
	E_CIP_Source.eT94_Water:;
			IF TRUE THEN;
				eProcess:=E_CIP_Source.eT94_Water;
			END_IF	

END_CASE
		
]]></ST>
      </Implementation>
