    <Action Name="act_GetReference" Id="{553e7d71-99a7-47aa-ae6f-0cd5ac38902f}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[m_Set_SFCFlags_Reference();
//refElement REF= fbElement[eElementID];
//refState_Long REF= fbElement[eElementID].eState_Long;
	
stPis_Tank_Water			REF= g_Piston.stPis[valTank_Water];
stPis_Tank_R_Water			REF= g_Piston.stPis[valTank_R_Water];
stPis_Tank_Detergent		REF= g_Piston.stPis[valTank_Detergent];
stPis_Tank_DisInfection		REF= g_Piston.stPis[valTank_DisInfection];
stPis_Drain					REF= g_Piston.stPis[valDrain];]]></ST>
      </Implementation>
    </Action>
