<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_CIP_Source" Id="{51aff4c3-d299-4189-9ddb-b537da8ea506}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_CIP_Source EXTENDS FB_SFC_Cycle IMPLEMENTS ITF_FB_SFC_Cycle
VAR_INPUT
	//eElementID			: E_Element_List;
	
	valTank_Water			: E_Pis_Name;
	valTank_R_Water			: E_Pis_Name;
	valTank_Detergent		: E_Pis_Name;
	valTank_DisInfection	: E_Pis_Name;	
	valDrain				: E_Pis_Name;
END_VAR
VAR_OUTPUT
END_VAR
VAR
	//refElement		: REFERENCE TO FB_Element;
	//refState_Long		: REFERENCE TO E_Element_State_Long;
	eReq				: E_CIP_Source;
	eProcess			: E_CIP_Source;
	eStatus				: E_CIP_Source;
	
	fbPis					: FB_Piston;
	stPis_Tank_Water		: REFERENCE TO ST_Piston;
	stPis_Tank_R_Water		: REFERENCE TO ST_Piston;
	stPis_Tank_Detergent	: REFERENCE TO ST_Piston;
	stPis_Tank_DisInfection	: REFERENCE TO ST_Piston;
	stPis_Drain				: REFERENCE TO ST_Piston;

END_VAR
VAR_IN_OUT


END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[act_GetReference();

act_Oper();
IF NOT Init.x THEN;
	act_Status();
END_IF

]]></ST>
    </Implementation>
    <Folder Name="Manage" Id="{f72c9a77-5990-4e2a-906f-d727cb28c56e}" />
