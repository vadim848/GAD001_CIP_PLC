<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="prg_RealClock" Id="{e1fe7cf5-42c6-4697-8de3-74e42c26da6a}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM prg_RealClock
VAR

(* Real Time Clock *)
(*	dtRealTime				: DATE_AND_TIME;
	sRealTime				: STRING[22];	
	stSystemTime			: TimeStruct;
	stSystemTime_Empty		: TimeStruct;
	sTime					: STRING[20];
	sDate					: STRING[20];
	sTimeWithMicroSec		: STRING[40];*)

	syncTimer 	: TON;
	fbGetLocalTime 	: NT_GetTime;
	fbRTC_EX2 	: RTC_EX2;
	presetTime 	: TimeStruct;
	syncTrigger 	: F_TRIG;
	bBusy 		: BOOL;
	bError 		: BOOL;
	nErrID 		: UDINT;
	temp1: DATE;
	temp2: TOD;
	NetId :STRING :='';
	bValid_RTCEX2 	: BOOL;
	nMicroseconds 	: DWORD;
	r_trigTrigger: R_TRIG;
	sRealTime_Date	 :STRING(25);
	
	bStartTime: BOOL;
	stStart: TimeStruct;
	sDelta: STRING;
	ton_OneMinuteCount: TON;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*--------->Set Plc Clock<----------------*)

dtRealTime:=SYSTEMTIME_TO_DT(stSystemTime);
sRealTime:= DT_TO_STRING(dtRealTime);
sRealTime_Date:= DT_TO_STRING(dtRealTime);
sRealTime_Date:=right(sRealTime_Date,19);
temp1:=DT_TO_DATE(dtRealTime);
temp2:=DT_TO_TOD(dtRealTime);
sDate:=DATE_TO_STRING(temp1);
sDate:=DELETE(sDate,2,1);


sTime:=TOD_TO_STRING(temp2);
sTime:=DELETE(sTime,4,1);

sDateTime:=CONCAT(sDate,' ');
sDateTime:=CONCAT(sDateTime,sTime);

sTimeWithMicroSec:=CONCAT(sTime,'.');
sTimeWithMicroSec:=CONCAT(sTimeWithMicroSec,DWORD_TO_STRING(nMicroseconds));




	syncTimer(IN:=NOT SyncTimer.Q , PT:=T#100ms , Q=> , ET=> );
(*r_trigTrigger(CLK:=q_Trigger);*)
	fbGetLocalTime(
		NETID:='' ,
		START:=syncTimer.Q,
		(*START:=r_trigTrigger.Q,*)
		TMOUT:=T#5s ,
		BUSY=>bBusy ,
		ERR=>bError ,
		ERRID=>nErrId ,
		TIMESTR=>presetTime );

	(*syncTrigger(CLK:=NOT bBusy*)
	syncTrigger(CLK:= bBusy
					 AND NOT bError , Q=> );
	fbRTC_EX2(
		EN:=syncTrigger.Q ,
		PDT:=presetTime ,
		PMICRO:=0 ,
		Q=>bValid_RTCEX2 ,
		CDT=>stSystemTime ,
		CMICRO=>nMicroseconds );
		
act_TestDelta();	

ton_OneMinuteCount(PT:=T#1m, IN:=NOT ton_OneMinuteCount.Q);
	]]></ST>
    </Implementation>
    <Action Name="act_TestDelta" Id="{08938b78-9c04-44ce-b119-b8aafe65b4bd}">
      <Implementation>
        <ST><![CDATA[IF bStartTime THEN;
	bStartTime:=FALSE;
	stStart:=stSystemTime;
END_IF

sDelta:= m_DeltaTime(stStartTime:=stStart);
]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_DeltaTime" Id="{1c4b0796-a4fe-4138-8f76-ada22c4cd03e}">
      <Declaration><![CDATA[METHOD m_DeltaTime : STRING
VAR_INPUT
	stStartTime  : TimeStruct;
END_VAR
VAR
	tDelta: TIME;
	dtDelta: DATE_AND_TIME;
	todDelta: TOD;


END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tDelta:=TO_TIME(SYSTEMTIME_TO_DT(stSystemTime)-SYSTEMTIME_TO_DT(stStartTime));

m_DeltaTime:=mTime_to_String_HMI(tInputTime:=tDelta,iSecondDisplay:=FALSE);

(*old
todDelta:=TIME_TO_TOD(tDelta);
m_DeltaTime:=TOD_TO_STRING(todDelta);
m_DeltaTime:=DELETE(m_DeltaTime,4,1);
//dtDelta:=TO_DT(SYSTEMTIME_TO_DT(stSystemTime)-SYSTEMTIME_TO_DT(stStartTime));
//m_DeltaTime:=TIME_TO_STRING(dtDelta);
*)


]]></ST>
      </Implementation>
    </Method>
    <Method Name="mTime_to_String_HMI" Id="{3b1224bb-1c81-4651-ba24-0d54cc3dd297}">
      <Declaration><![CDATA[METHOD mTime_to_String_HMI : STRING
VAR_INPUT
    tInputTime 		: TIME; // TIME type, stored internally as LTIME (ms)
	iSecondDisplay	: BOOL;
END_VAR
VAR
    nTotalSeconds : UDINT;
    nTotalHours : UDINT;
    nMinutes : UDINT;
    nSeconds : UDINT;
    sFormatted : STRING(20);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Convert TIME to total seconds
nTotalSeconds := TO_UDINT(tInputTime) / 1000;

// Extract minutes and seconds
nMinutes := nTotalSeconds / 60;
nSeconds := nTotalSeconds MOD 60;

// Convert to total hours
nTotalHours := nMinutes / 60;
nMinutes := nMinutes MOD 60;

// Format output as HHHH:MM:SS (e.g., 0123:45:56)
sFormatted := CONCAT(UDINT_TO_STRING(nTotalHours),'h:');
IF nMinutes < 10 THEN
    sFormatted := CONCAT(sFormatted, '0');
END_IF
sFormatted := CONCAT(sFormatted, UDINT_TO_STRING(nMinutes));
sFormatted := CONCAT(sFormatted, 'm');

IF iSecondDisplay THEN;
	sFormatted := CONCAT(sFormatted, ':');
	IF nSeconds < 10 THEN
		sFormatted := CONCAT(sFormatted, '0');
	END_IF
	sFormatted := CONCAT(sFormatted, UDINT_TO_STRING(nSeconds));
	sFormatted := CONCAT(sFormatted, 's');	
END_IF

// Return formatted string
mTime_to_String_HMI := sFormatted;
]]></ST>
      </Implementation>
    </Method>
