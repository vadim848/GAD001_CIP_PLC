<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_AnalogSignal" Id="{8298b09f-9328-44af-ab3b-10f37f835efd}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_AnalogSignal
VAR_IN_OUT
	AnalogSignal	:	 ST_AnalogSignal	;
END_VAR
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF AnalogSignal.nIn_RawSignal>AnalogSignal.rRawZeroPointOffset AND AnalogSignal.nIn_RawSignal<(AnalogSignal.rRawMax-AnalogSignal.rRawMaxPointOffset) THEN
	AnalogSignal.rOut_Converted:=TO_REAL((AnalogSignal.rOutMax/(AnalogSignal.rRawMax-AnalogSignal.rRawMaxPointOffset-AnalogSignal.rRawZeroPointOffset))*AnalogSignal.nIn_RawSignal);
ELSIF AnalogSignal.nIn_RawSignal<AnalogSignal.rRawZeroPointOffset THEN
	AnalogSignal.rOut_Converted:=0;		
ELSIF AnalogSignal.nIn_RawSignal>(AnalogSignal.rRawMax-AnalogSignal.rRawMaxPointOffset) THEN
	AnalogSignal.rOut_Converted:=AnalogSignal.rOutMax;
END_IF]]></ST>
    </Implementation>
    <LineIds Name="FB_AnalogSignal">
      <LineId Id="13" Count="5" />
      <LineId Id="9" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>