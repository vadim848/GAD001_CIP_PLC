<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_TankLevel" Id="{b2733916-5f6c-401f-ba03-73f4ab298e9c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TankLevel
VAR_INPUT
	senHL: BOOL;
	senLL: BOOL;
	TankLevel: REAL;
	TankCapacity: REAL;

END_VAR

VAR_IN_OUT
	stTank_Level	: 	ST_Tank_Level	;
	stAnalogSignal	:	ST_AnalogSignal	;
END_VAR

VAR_OUTPUT
END_VAR
VAR
	Call_AnalogSignal 	:	FB_AnalogSignal	;
	fbScaleCapacityToPercentage: FB_ScaleFactor;
	
	rPercentageLevel: REAL;


END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF stTank_Level.bIn_LL_signal=FALSE AND stTank_Level.bIn_HL_signal=FALSE THEN
	stTank_Level.e_state:=E_Tank_Level.eEmpty;
ELSIF stTank_Level.bIn_LL_signal=TRUE AND stTank_Level.bIn_HL_signal=FALSE THEN
	stTank_Level.e_state:=E_Tank_Level.eLL;
ELSIF stTank_Level.bIn_LL_signal=TRUE AND stTank_Level.bIn_HL_signal=TRUE THEN
	stTank_Level.e_state:=E_Tank_Level.eHL;
ELSIF stTank_Level.bIn_LL_signal=FALSE AND stTank_Level.bIn_HL_signal=TRUE THEN
	stTank_Level.e_state:=E_Tank_Level.eERROR;
END_IF

Call_AnalogSignal(AnalogSignal:=stAnalogSignal );

stTank_Level.rOut_LvlAnalog:=stAnalogSignal.rOut_Converted;

fbScaleCapacityToPercentage(
	rVal:= TankLevel, 
	rInValHigh:= TankCapacity, 
	rInValLow:= 0, 
	rOutValHigh:= 100, 
	rOutValLow:= 0, 
	rValOut=> rPercentageLevel, 
	diValOut=> , 
	iValOut=> );]]></ST>
    </Implementation>
    <LineIds Name="FB_TankLevel">
      <LineId Id="25" Count="7" />
      <LineId Id="18" Count="0" />
      <LineId Id="56" Count="0" />
      <LineId Id="55" Count="0" />
      <LineId Id="58" Count="0" />
      <LineId Id="57" Count="0" />
      <LineId Id="88" Count="0" />
      <LineId Id="90" Count="7" />
      <LineId Id="89" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>