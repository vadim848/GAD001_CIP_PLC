<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ControlWordStruct" Id="{78e74134-eb86-4a5a-8ac6-77338cae8d03}">
    <Declaration><![CDATA[TYPE ControlWordStruct :
STRUCT
    SwitchOn           : BOOL;  // Bit 0: Switch on
    EnableVoltage      : BOOL;  // Bit 1: Enable voltage
    QuickStop          : BOOL;  // Bit 2: Quick stop
    EnableOperation    : BOOL;  // Bit 3: Enable operation
    Reserved1          : BOOL;  // Bit 4: Reserved
    Reserved2          : BOOL;  // Bit 5: Reserved
    Reserved3          : BOOL;  // Bit 6: Reserved
    Reserved4          : BOOL;  // Bit 7: Reserved
    FaultReset         : BOOL;  // Bit 8: Fault reset
    Reserved5          : BOOL;  // Bit 9: Reserved
    Reserved6          : BOOL;  // Bit 10: Reserved
    Reserved7          : BOOL;  // Bit 11: Reserved
    Reserved8          : BOOL;  // Bit 12: Reserved
    Reserved9          : BOOL;  // Bit 13: Reserved
    Reserved10         : BOOL;  // Bit 14: Reserved
    Reserved11         : BOOL;  // Bit 15: Reserved	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>