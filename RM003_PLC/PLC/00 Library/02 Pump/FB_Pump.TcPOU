<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_Pump" Id="{85164826-ad0f-4589-97dc-725e0f6c34e4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Pump
VAR_INPUT
	
END_VAR
VAR
	//request
	modeAuto	:	BOOL	:= TRUE	;//System in automatic
	bRun_Auto	:	BOOL	;
	bRun_Man	:	BOOL	;

	nRPM_Auto	:	INT		;//Pump RPM 
	nRPM_Man	:	INT		;//Pump RPM 
	//feedback
	nRPM_fdbk	:	INT	;	
	rtManual: R_TRIG;
END_VAR
VAR_OUTPUT
	bRun		: 	BOOL;
	nRPM		:	INT		;//Pump RPM 
END_VAR
VAR_IN_OUT
	ST_Pump	:	st_Pump	;
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF modeAuto THEN;
	bRun:=bRun_Auto;
ELSE;
	bRun:=bRun_Man;
END_IF

rtManual(CLK:=NOT modeAuto);
IF rtManual.Q THEN;
	bRun:=bRun_Man:=bRun_Auto;
END_IF
]]></ST>
    </Implementation>
    <Method Name="m_Auto" Id="{80bcb1da-caaf-4610-b5db-3ec5b0ee5d69}">
      <Declaration><![CDATA[METHOD m_Auto : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//ST_Pump.bRun_Auto:=TRUE;
m_Auto:=TRUE;
bRun_Auto:=TRUE;
//need to be set up an set point so the pump could keep the needed value in automatic mode]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Run" Id="{c021bce4-07f3-44e5-a920-e4b2f00640f2}">
      <Declaration><![CDATA[METHOD m_Run : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRun_Auto:=TRUE;
m_Run:=TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Stop" Id="{32beb2f6-b52c-44a4-83d0-2553e54c7ded}">
      <Declaration><![CDATA[METHOD m_Stop : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRun_Auto:=FALSE;
m_Stop:=TRUE;]]></ST>
      </Implementation>
    </Method>
