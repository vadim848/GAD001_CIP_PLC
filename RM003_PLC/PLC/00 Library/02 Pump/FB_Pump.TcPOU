<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Pump" Id="{85164826-ad0f-4589-97dc-725e0f6c34e4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Pump
VAR_INPUT
	Pump_ID				: E_Pump_List:=E_Pump_List.eNotSelected;
	PressureSensor_ID	: E_ASense_Name:=E_ASense_Name.eNotSelected;
END_VAR
VAR
	sID: STRING(6);

	stNidec: REFERENCE TO ST_Nidec;
	status_word: WORD;
	control_word: WORD;

	ControlWord: ControlWordStruct;
	StatusWord: StatusWordStruct;


	//request
	modeAuto	:	BOOL	:= TRUE	;//System in automatic
	bRun_Auto	:	BOOL	;
	bRun_Man	:	BOOL	;

	//nRPM_Auto	:	REAL		;//Pump RPM 
	//nRPM_Man	:	REAL		;//Pump RPM 
	//feedback
	nRPM_fdbk	:	INT	;	
	rtManual: R_TRIG;
	ton_Drive_init: TON;
	state_init: (OFF,stage1,stage2,stage3,stage4, Ready);

	bInitiated: BOOL;
	ton_RPM_feedback_lag_monitoring: TON;
	ton_Pressure_feedback_monitoring: TON;
	
	fbPressureSensor: REFERENCE TO FB_AnalogSensor;

END_VAR
VAR_OUTPUT
	DriveReady	:   BOOL;
	bRun		: 	BOOL;
	nRPM		:	REAL		;//Pump RPM 
	
END_VAR
VAR_IN_OUT
	stPump			: ST_Pump	;
	stOperation		: ST_OperationButtons;
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[stNidec REF= gIO.Nidec[Pump_ID];
sID:=TO_STRING(Pump_ID);
nRPM:=stPump.nRPM;
IF __ISVALIDREF(stNidec) THEN;
	//run
	status_word:=stNidec.StatusWord;
	stNidec.ControlWord:=control_word;
	
	control_word:=m_Map_ControlWord(cwStruct:=ControlWord);
	StatusWord:=m_Map_StatusWord(wordInput:=status_word);
	
	stNidec.targetVelocity:=DINT_TO_INT(TRUNC(stPump.nRPM));	
	nRPM_fdbk:=stNidec.actVelocity;	
	
	m_Nidec_Init();
	
	IF state_init=Ready THEN;
		DriveReady:=TRUE;
		ControlWord.EnableOperation:=bRun;
	ELSE;
		DriveReady:=FALSE;
		//bRun:=bRun_Man:=bRun_Auto:=FALSE;
		ControlWord.EnableOperation:=FALSE;
	END_IF	
	stPump.DriveReady:=DriveReady;
ELSE;
	//RETURN;
END_IF

IF modeAuto THEN;
	//bRun:=bRun_Auto;
	IF bRun_Auto AND m_CheckOper() THEN;
		bRun:=TRUE;
	ELSE;
		bRun:=FALSE;
	END_IF
	stPump.nRPM:=stPump.nRPM_Auto;
ELSE;
	//bRun:=bRun_Man;
	IF bRun_Man AND m_CheckOper() THEN;
		bRun:=TRUE;
	ELSE;
		bRun:=FALSE;
	END_IF	
	stPump.nRPM:=stPump.nRPM_Man;
END_IF

rtManual(CLK:=NOT modeAuto);
IF rtManual.Q THEN;
	bRun:=bRun_Man:=bRun_Auto;
	//stPump.nRPM:=stPump.nRPM_Man:=stPump.nRPM_Auto;
END_IF

IF stPump.nRPM>3000 THEN;
	stPump.nRPM:=3000;
END_IF

stPump.bRun_Man:=bRun_Man;
stPump.bRun_Auto:=bRun_Auto;
stPump.bRun:=bRun;

IF m_Error()<>'' THEN;
	//stOperation.bSetPause:=TRUE;
	//print error
	//fbPrintErrMessageByID(sModuleDescription:='Pump',sActErrorID:='101x000x001');	
END_IF

bInitiated:=TRUE;
]]></ST>
    </Implementation>
    <Method Name="m_Auto" Id="{80bcb1da-caaf-4610-b5db-3ec5b0ee5d69}">
      <Declaration><![CDATA[METHOD m_Auto : BOOL
VAR_INPUT
	control: LREAL; // RPM
END_VAR

VAR
	RPM: INT;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[//ST_Pump.bRun_Auto:=TRUE;
m_Auto:=TRUE;
RPM:=DINT_TO_INT(TRUNC(control));
IF RPM>3000 THEN;
	stPump.nRPM_Auto:=3000;
ELSIF RPM<200 THEN;
	stPump.nRPM_Auto:=200;
ELSE;
	stPump.nRPM_Auto:=RPM;
END_IF

bRun_Auto:=TRUE;
//need to be set up an set point so the pump could keep the needed value in automatic mode]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_CheckOper" Id="{6a5ac2f6-04be-4f30-9c45-ef254ec3bf61}">
      <Declaration><![CDATA[METHOD INTERNAL m_CheckOper : BOOL
VAR_INPUT
END_VAR

VAR
	sMotorTypeAgrigate_to_check: STRING(2);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[sMotorTypeAgrigate_to_check:=TO_STRING(Pump_ID);

IF sMotorTypeAgrigate_to_check='AG' THEN;
	m_CheckOper:=TRUE;
ELSE;
	IF stOperation.iActOperation=E_OperationButtons.ePlayAll THEN;
		m_CheckOper:=TRUE;
	ELSE;
		m_CheckOper:=FALSE;
	END_IF
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Error" Id="{68a99073-1da5-4a02-9be0-3cdcd2d323d9}">
      <Declaration><![CDATA[METHOD m_Error : STRING(11)
VAR_INPUT
	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ton_RPM_feedback_lag_monitoring(PT:=T#10S);
IF __ISVALIDREF(stNidec) THEN;
	IF bRun
	AND ABS(stNidec.targetVelocity - nRPM_fdbk) > 10 
	THEN;
		ton_RPM_feedback_lag_monitoring.IN:=TRUE;
	ELSE;
		ton_RPM_feedback_lag_monitoring.IN:=FALSE;
	END_IF	
END_IF



IF bRun THEN;
	IF NOT DriveReady THEN;
		m_Error:=concat(sID,'x001');
		stOperation.bSetPause:=TRUE;
		RETURN;
	END_IF	

	IF ton_RPM_feedback_lag_monitoring.Q THEN;
		m_Error:=concat(sID,'x002');
		RETURN;
	END_IF
END_IF

IF NOT DriveReady THEN;
	m_Error:=concat(sID,'x003');
	//stOperation.bSetPause:=TRUE;
	RETURN;
END_IF


IF 	PressureSensor_ID <> E_ASense_Name.eNotSelected THEN;
	fbPressureSensor REF= fbAnalogSensor[PressureSensor_ID];
	IF __ISVALIDREF(fbPressureSensor) THEN;	
		ton_Pressure_feedback_monitoring(PT:=T#30S);
		IF bRun AND ( fbPressureSensor.bHH_Alarm 
					OR fbPressureSensor.bHH_Warning
					OR fbPressureSensor.bLL_Warning 
					OR fbPressureSensor.bLL_Alarm) 
		THEN;
			ton_Pressure_feedback_monitoring.IN:=TRUE;
		ELSE;
			ton_Pressure_feedback_monitoring.IN:=FALSE;
		END_IF	
		
		IF fbPressureSensor.bHH_Alarm AND ton_Pressure_feedback_monitoring.Q THEN;
			m_Error:=concat(sID,'x004');
			stOperation.bSetPause:=TRUE;
			RETURN;
		END_IF
		IF fbPressureSensor.bHH_Warning AND ton_Pressure_feedback_monitoring.Q THEN;
			m_Error:=concat(sID,'x005');
			RETURN;
		END_IF
		IF fbPressureSensor.bLL_Warning AND ton_Pressure_feedback_monitoring.Q THEN;
			m_Error:=concat(sID,'x006');
			RETURN;
		END_IF
		IF fbPressureSensor.bLL_Alarm AND ton_Pressure_feedback_monitoring.Q THEN;
			m_Error:=concat(sID,'x007');
			stOperation.bSetPause:=TRUE;
			RETURN;
		END_IF		
	END_IF	
END_IF
 
m_Error:='';]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Get_Speed" Id="{275f4b83-9198-4221-80b4-9931ca620fd7}">
      <Declaration><![CDATA[METHOD m_Get_Speed : INT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Get_Speed:=nRPM_fdbk;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Map_ControlWord" Id="{de707bea-2c05-4e8e-8763-cf6ec1f146fa}">
      <Declaration><![CDATA[METHOD m_Map_ControlWord : WORD
VAR_INPUT
	cwStruct : ControlWordStruct;
END_VAR
VAR
    tempWord : WORD;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[

// Map each bit from the structure to the corresponding bit in the control word
tempWord := 0;
IF cwStruct.SwitchOn THEN
    tempWord := tempWord OR 1; // Bit 0
END_IF
IF cwStruct.EnableVoltage THEN
    tempWord := tempWord OR 2; // Bit 1
END_IF
IF cwStruct.QuickStop THEN
    tempWord := tempWord OR 4; // Bit 2
END_IF
IF cwStruct.EnableOperation THEN
    tempWord := tempWord OR 8; // Bit 3
END_IF
// Reserved bits (4-7) are not set
IF cwStruct.FaultReset THEN
    tempWord := tempWord OR 256; // Bit 8
END_IF
// Reserved bits (9-15) are not set

m_Map_ControlWord := tempWord;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Map_StatusWord" Id="{5d50e45b-c861-42d8-b099-cb1dcb3c3141}">
      <Declaration><![CDATA[METHOD m_Map_StatusWord : StatusWordStruct
VAR_INPUT
	wordInput : WORD;
END_VAR
VAR
    swStruct : StatusWordStruct;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[

// Map each bit from the status word to the corresponding field in the structure
swStruct.ReadyToSwitchOn    := (wordInput AND 1) <> 0;         // Bit 0
swStruct.SwitchedOn         := (wordInput AND 2) <> 0;         // Bit 1
swStruct.OperationEnabled   := (wordInput AND 4) <> 0;         // Bit 2
swStruct.Fault              := (wordInput AND 8) <> 0;         // Bit 3
swStruct.VoltageEnabled     := (wordInput AND 16) <> 0;        // Bit 4
swStruct.QuickStop          := (wordInput AND 32) <> 0;        // Bit 5
swStruct.SwitchOnDisabled   := (wordInput AND 64) <> 0;        // Bit 6
swStruct.Warning            := (wordInput AND 128) <> 0;       // Bit 7
swStruct.Remote             := (wordInput AND 256) <> 0;       // Bit 8
// Reserved bits (9-15) are not set, assuming FALSE
m_Map_StatusWord := swStruct;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Nidec_Init" Id="{8437beaa-fdb9-4bb5-970a-a6fc0677a284}">
      <Declaration><![CDATA[METHOD m_Nidec_Init : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF  NOT StatusWord.VoltageEnabled 
OR StatusWord.Fault 
OR (state_init=Ready AND NOT StatusWord.ReadyToSwitchOn )
THEN;
	ControlWord.SwitchOn:=FALSE;
	ControlWord.EnableVoltage:=FALSE;
	ControlWord.QuickStop:=FALSE;
	ControlWord.EnableOperation:=FALSE;
	ton_Drive_init(IN:=FALSE);
	state_init:=OFF;
	RETURN;
END_IF


CASE state_init OF
	OFF:; 
		IF TRUE
		AND StatusWord.VoltageEnabled
		AND StatusWord.QuickStop
		AND StatusWord.SwitchOnDisabled
		THEN;
			ton_Drive_init(IN:=TRUE,PT:=T#2S);
		ELSE;
			ton_Drive_init(IN:=FALSE);RETURN;
		END_IF
		
		IF ton_Drive_init.Q THEN;
			ControlWord.EnableVoltage:=TRUE;
			ControlWord.QuickStop:=TRUE;	
			state_init:=stage1;
			ton_Drive_init(IN:=FALSE);
		END_IF	
		
	stage1:;
		IF TRUE
		AND StatusWord.VoltageEnabled
		AND StatusWord.QuickStop
		AND NOT StatusWord.SwitchOnDisabled
		THEN;
			ton_Drive_init(IN:=TRUE,PT:=T#0.5S);
		ELSE;
			ton_Drive_init(IN:=FALSE);RETURN;
		END_IF
		
		IF ton_Drive_init.Q THEN;
			ControlWord.SwitchOn:=TRUE;
			state_init:=stage2;
			ton_Drive_init(IN:=FALSE);
		END_IF	
		
	stage2:;
		IF TRUE
		AND StatusWord.SwitchedOn
		AND StatusWord.VoltageEnabled
		AND StatusWord.QuickStop
		AND NOT StatusWord.SwitchOnDisabled
		THEN;
			ton_Drive_init(IN:=TRUE,PT:=T#0.5S);
		ELSE;
			ton_Drive_init(IN:=FALSE);RETURN;
		END_IF
		
		IF ton_Drive_init.Q THEN;
			state_init:=Ready;
			ton_Drive_init(IN:=FALSE);
		END_IF	

	
	
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Run" Id="{c021bce4-07f3-44e5-a920-e4b2f00640f2}">
      <Declaration><![CDATA[METHOD m_Run : BOOL
VAR_INPUT
	RPM: REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInitiated THEN;
	RETURN;
END_IF
bRun_Auto:=TRUE;
stPump.nRPM_Auto:=RPM;
m_Run:=TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Stop" Id="{32beb2f6-b52c-44a4-83d0-2553e54c7ded}">
      <Declaration><![CDATA[METHOD m_Stop : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRun_Auto:=FALSE;
bRun_Man:=FALSE;
m_Stop:=TRUE;]]></ST>
      </Implementation>
    </Method>
