    <Method Name="m_Stop" Id="{3db98452-a5ed-40f9-9827-9416d8a0c505}">
      <Declaration><![CDATA[METHOD m_Stop : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
