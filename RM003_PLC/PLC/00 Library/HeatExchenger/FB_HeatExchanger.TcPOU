    </Method>
    <Method Name="mCMD_to_Analog" Id="{560014a2-19b1-4d00-9b7a-c42a2745f37a}">
      <Declaration><![CDATA[METHOD mCMD_to_Analog : INT
VAR_INPUT
	fControl: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (stHeatExchanger.cntrlVal_Max-stHeatExchanger.cntrlVal_Min)<>0 THEN
	mCMD_to_Analog:=DINT_TO_INT((TRUNC((fControl*
		(stHeatExchanger.outVal_Max-stHeatExchanger.outVal_Min)/(stHeatExchanger.cntrlVal_Max-stHeatExchanger.cntrlVal_Min))+
		stHeatExchanger.outOffset)));
ELSE;
	mCMD_to_Analog:=0;
END_IF

//nAlagonValveCntrOut]]></ST>
      </Implementation>
    </Method>
