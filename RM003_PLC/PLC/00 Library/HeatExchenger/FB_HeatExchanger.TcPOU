<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_HeatExchanger" Id="{a552b9b2-c3a1-4da2-ba19-b259dcf3d943}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_HeatExchanger
VAR_IN_OUT
	stHeatExchanger	:	ST_HeatExchanger	;
END_VAR
VAR_INPUT
	nValveID		:	E_Pis_Name 	;	
	nAnalogValveID	:	E_Pis_Name 	;

	nProcCntrlID	:	E_ProcessControl_Name	;
END_VAR
VAR_OUTPUT
	nAlagonValveCntrOut	:	INT	;//output for analog valve opening
END_VAR
VAR
	stPis			:	REFERENCE TO ST_Piston;
	stPisAnalog		:	REFERENCE TO ST_Piston;
	
	stProcessControl		:	REFERENCE TO ST_ProcessControl	;
	fbProcessControl		: 	REFERENCE TO FB_ProcessControl	;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[act_GetReference();
//act_AnalogOutScaling();

stProcessControl.fCtrlOutput_Min:=0;
stProcessControl.fCtrlOutput_Max:=100;
stProcessControl.fCtrlOutput_Manual;

IF stHeatExchanger.bManual THEN;
	fbProcessControl.mRun_PID(Set_Point:=stProcessControl.fCtrlOutput_Manual , controlManual:=TRUE);
	//nAlagonValveCntrOut:=mCMD_to_Analog(fControl:=stHeatExchanger.fManualControl);
ELSE;
	IF stProcessControl.bActiveCntr AND NOT stPis.st_Open THEN
		stPis.req_Open:=TRUE;
	ELSIF NOT stProcessControl.bActiveCntr AND NOT stPis.st_Close THEN
		stPis.req_Close:=TRUE;
	END_IF
	//nAlagonValveCntrOut:=mCMD_to_Analog(fControl:=stProcessControl.fCtrlOutput);	
END_IF
nAlagonValveCntrOut:=mCMD_to_Analog(fControl:=stProcessControl.fCtrlOutput);
IF nAlagonValveCntrOut=0 AND NOT stPisAnalog.st_Close THEN;
	stPisAnalog.req_Close:=TRUE;
ELSIF nAlagonValveCntrOut<>0 AND NOT stPisAnalog.st_Open THEN;
	stPisAnalog.req_Open:=TRUE;
END_IF


]]></ST>
    </Implementation>
    <Action Name="act_AnalogOutScaling" Id="{3066c111-d337-406a-9a79-f8a55347b485}">
      <Implementation>
        <ST><![CDATA[IF (stHeatExchanger.cntrlVal_Max-stHeatExchanger.cntrlVal_Min)<>0 THEN
	nAlagonValveCntrOut:=DINT_TO_INT((TRUNC((stProcessControl.fCtrlOutput*
		(stHeatExchanger.outVal_Max-stHeatExchanger.outVal_Min)/(stHeatExchanger.cntrlVal_Max-stHeatExchanger.cntrlVal_Min))+
		stHeatExchanger.outOffset)));
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_GetReference" Id="{e298de8b-73e5-4293-9611-13e0901ac69a}">
      <Implementation>
        <ST><![CDATA[//On-Off walve structure
stPis REF= g_Piston.stPis[nValveID];
stPisAnalog REF= g_Piston.stPis[nAnalogValveID];

stProcessControl REF=g_ProcControl.arr_stProcCntrl[nProcCntrlID];
fbProcessControl REF=g_ProcControl.arr_fbProcCntrl[nProcCntrlID];]]></ST>
      </Implementation>
    </Action>
