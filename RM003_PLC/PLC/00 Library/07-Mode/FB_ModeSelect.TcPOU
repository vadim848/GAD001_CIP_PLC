    <Action Name="act_Operation" Id="{d99501f7-9523-4197-a4a8-8762849e15ea}" FolderPath="Actions\">
      <Implementation>
        <ST><![CDATA[(*
IF stOperation.bSetPlay THEN;
	bResumeMachine:=TRUE;
END_IF
ton_ResumeMachine(PT:=T#10MS,IN:=bResumeMachine,);
ton_PlayAllDelay(PT:=T#20MS);
IF ton_ResumeMachine.Q THEN;
	bResumeMachine:=FALSE;	
	stOperation.bSetPlay:=FALSE;
	ton_PlayAllDelay.IN:=TRUE;	
END_IF





r_trigPlayAllDelay(CLK:=ton_PlayAllDelay.Q);
IF r_trigPlayAllDelay.Q THEN	
	IF FALSE(*iActErrorNum=0*) THEN
		//stOperation.iActOperation:=E_OperationButtons.ePlayAll;
		stOperation.bSetPlay:=TRUE;
	END_IF	
END_IF


IF stOperation.bSetPause THEN;
	stOperation.iActOperation:=E_OperationButtons.ePauseAll;
	stOperation.bSetPause:=FALSE;
	ton_PlayAllDelay.IN:=FALSE;
END_IF



IF stOperation.iActOperation=E_OperationButtons.ePauseAll THEN;
	
ELSIF stOperation.iActOperation=E_OperationButtons.ePlayAll THEN;
	
END_IF

bPauseMachine:=stOperation.iActOperation=E_OperationButtons.ePauseAll;


ton_PauseDelay(PT:=T#1S, IN:=stOperation.iActOperation=E_OperationButtons.ePauseAll);
ton_PlayDelay(PT:=T#1S, IN:=stOperation.iActOperation=E_OperationButtons.ePlayAll);
*)]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_Ready" Id="{0b6aadda-085e-4ced-978e-c2e348c4875f}" FolderPath="Actions\">
      <Implementation>
        <ST><![CDATA[
IF stMode.iActMode=eManualMode AND stMode.bSetManual THEN; stMode.bSetManual:=FALSE; END_IF
IF stMode.iActMode=eSemiAutoMode AND stMode.bSetSemi THEN; stMode.bSetSemi:=FALSE; END_IF

IF stMode.iActMode=eAutoMode 
AND stMode.bSetAuto THEN; 
	stMode.bSetAuto:=FALSE; 
ELSIF stMode.iActMode=eAutoMode 
AND stMode.bSetSemi THEN; 
	stMode.bSetSemi:=FALSE;	
	stMode.iActMode:=eSemiAutoMode;
END_IF

IF stOperation.bStopResetAll THEN;
	stMode.bSetManual:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_Reject_CMD" Id="{29be06db-0135-4037-bf95-33eaa49632e7}" FolderPath="Actions\">
      <Implementation>
        <ST><![CDATA[
	IF stMode.bSetManual 	THEN; sActErrorID:='300';END_IF	(*	'050x000x300',	'Warning',	'Manual mode request rejected, first pause automation',	*)
	IF stMode.bSetSemi 		THEN; sActErrorID:='301';END_IF	(*	'050x000x301',	'Warning',	'Semi mode request rejected, first pause automation',	*)
	IF stMode.bSetAuto 		THEN; sActErrorID:='302';END_IF	(*	'050x000x302',	'Warning',	'Auto mode request rejected, first pause automation',	*)
	act_GetErrorID_Format();
	fbPrintErrMessageByID(sFB_ModuleDescription:=sModuleDescription,sActErrorID:=sFullErrorId,bSFCError:=TRUE);]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_SwitchFailed" Id="{0bafcad7-61fd-48ec-8730-f5aebd8fa624}" FolderPath="Actions\">
      <Implementation>
        <ST><![CDATA[
IF stMode.bSetManual 	THEN; sActErrorID:='303';END_IF	(*	'050x000x303',	'Warning',	'Manual mode request rejected, Pistion not in last auto pisition',	*)
IF stMode.bSetSemi 		THEN; sActErrorID:='304';END_IF	(*	'050x000x304',	'Warning',	'Semi mode request rejected, Pistion not in last auto pisition',	*)
IF stMode.bSetAuto 		THEN; sActErrorID:='304';END_IF	(*	'050x000x305',	'Warning',	'Auto mode request rejected, Pistion not in last auto pisition',	*)
act_GetErrorID_Format();
fbPrintErrMessageByID(sFB_ModuleDescription:=sModuleDescription,sActErrorID:=sFullErrorId,bSFCError:=TRUE);

stMode.bSetManual:=FALSE;
stMode.bSetSemi:=FALSE;
stMode.bSetAuto:=FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Condition_Check_active" Id="{e128942e-0ef4-40fb-bfd1-9a6e83cafa0d}" FolderPath="Actions\">
      <Implementation>
        <ST><![CDATA[bPistonsOK:=TRUE;
IF bPistonCheck THEN
	FOR i:=1 TO C_Max_Pistons DO;
		IF stPis[i].b_Exist
		AND (NOT stPis[i].st_SyncAuto) THEN;
			IF stPis[i].eModeZone=eModeZone THEN;
				stPis[i].b_Print_NotSyncAutoMessage:=TRUE;
				bPistonsOK:=FALSE;
			END_IF
		END_IF
	END_FOR	
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Condition_Check_exit" Id="{71572210-e632-4875-9651-3697c7764c07}" FolderPath="Actions\">
      <Implementation>
        <ST><![CDATA[IF NOT bPistonsOK THEN;	
(*	IF stMode.bSetManual 	THEN; sActErrorID:='303';END_IF	(*	'050x000x303',	'Warning',	'Manual mode request rejected, Pistion not in last auto pisition',	*)
	IF stMode.bSetSemi 		THEN; sActErrorID:='304';END_IF	(*	'050x000x304',	'Warning',	'Semi mode request rejected, Pistion not in last auto pisition',	*)
	IF stMode.bSetAuto 		THEN; sActErrorID:='304';END_IF	(*	'050x000x305',	'Warning',	'Auto mode request rejected, Pistion not in last auto pisition',	*)
	act_GetErrorID_Format();
	fbPrintErrMessageByID(sModuleDescription:=sModuleDescription,sActErrorID:=sFullErrorId);*)
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_Error_zone_check" Id="{d71a2d60-edec-4d86-b797-3285b49c2480}">
      <Declaration><![CDATA[METHOD m_Error_zone_check : BOOL
VAR_INPUT
END_VAR

VAR
	i: INT;
	sCheckZone: STRING;

END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[sCheckZone:=TO_STRING(stMode.eModeZone);

FOR i:=1 TO C_Max_Buffer_Act_list DO;
	IF TRUE 
	AND Buffer_Act_Message[i].sLevel='Error'
	AND Buffer_Act_Message[i].sModuleDescription=sCheckZone
	AND stOperation.iActOperation=E_OperationButtons.ePlayAll 
	THEN;
		stOperation.bSetPause:=TRUE;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Action Name="Ready_exit" Id="{ab53e8f1-23f1-4ef5-9d62-59ff46d788ce}" FolderPath="Actions\">
      <Implementation>
        <ST><![CDATA[stOperation.bSetPause:=TRUE;
stOperation.iPauseHistory:=6;]]></ST>
      </Implementation>
    </Action>
    <Action Name="SetAuto_entry" Id="{906f77fe-e6af-4363-a7f2-9a8ea55499dc}" FolderPath="Actions\">
      <Implementation>
        <ST><![CDATA[stMode.iActMode:=eAutoMode;]]></ST>
      </Implementation>
    </Action>
    <Action Name="SetMan_entry" Id="{35c0470c-3ef9-4a62-a98e-99801a1845c6}" FolderPath="Actions\">
      <Implementation>
        <ST><![CDATA[stMode.iActMode:=eManualMode;
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">false</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="SetSemi_entry" Id="{d2dffbfe-e7bb-4d4a-81f3-bbc52c51799f}" FolderPath="Actions\">
      <Implementation>
        <ST><![CDATA[stMode.iActMode:=eSemiAutoMode;]]></ST>
      </Implementation>
    </Action>
    <Action Name="SwitchFail1_entry" Id="{0a54deee-f1fc-4dfc-972d-717bcd92630a}">
      <Implementation>
        <ST><![CDATA[//entrance condition <NOT prg_Initialise.bGeneralDone>

//IF stMode.bSetAuto 		THEN; sActErrorID:='304';END_IF	(*	'050x000x305',	'Warning',	'Auto mode request rejected, Pistion not in last auto pisition',	*)

sActErrorID:='350'; // '050x000x350',	'Warning',	'Semi/Auto mode request rejected, initialize all system first',
act_GetErrorID_Format();
fbPrintErrMessageByID(sFB_ModuleDescription:=sModuleDescription,sActErrorID:=sFullErrorId,bSFCError:=TRUE);

stMode.bSetManual:=FALSE;
stMode.bSetSemi:=FALSE;
stMode.bSetAuto:=FALSE;]]></ST>
      </Implementation>
    </Action>
