<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_ModeSelect" Id="{b95347f3-88f5-4be2-b47c-79ac89a3355f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ModeSelect
VAR_INPUT
	bInterlockBypass: BOOL;
	bAutoPlayEnable: BOOL:=TRUE;
	sModuleDescription: STRING:='Mode Select';
	eModeZone:E_ModeZone;
	bLockedFB: BOOL;
	bPistonCheck: BOOL:=TRUE;
	bStateSafe_mode: BOOL:=TRUE;
END_VAR
VAR_OUTPUT
	bModeStillState: BOOL;
	bLockRequest: BOOL;
END_VAR
VAR
	fbPrintErrMessageByID: FB_PrintErrMessageByID_SFC_Cycle;
	r_trig_ModeExchange1: R_TRIG;
	r_trig_ModeExchange2: R_TRIG;
	r_trig_ModeExchange3: R_TRIG;
	ton_ModeExchengeDelay: TON;	
	fbOperation:FB_Operation;
	bLockRelay: BOOL;	
	i: INT;
	bPistonsOK: BOOL;
	fbFormatString:FB_FormatString;
	sFB_ID: STRING(3):='050';

	sActErrorID: STRING(11);
	sFullErrorId: STRING(11);
	//r_trigAuto: R_TRIG;
	r_trigIntClose: R_TRIG;
	r_trigIntOpen: R_TRIG;
	bIntZonePaused: BOOL;
	rt_Play: R_TRIG;

END_VAR
VAR
	ton_ResumeMachine: TON;
	ton_ResetErrors: TON;
	ton_ResetAllCycles: TON;
	ton_PlayAllDelay: TON;
	ton_PauseDelay: TON;
	r_trigPlayAllDelay: R_TRIG;
	ton_PlayDelay: TON;
END_VAR
VAR_IN_OUT
	stMode:ST_Mode;
	stOperation:ST_OperationButtons;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[act_Oper();
act_ModeStillState();
fbOperation(stOper:=stOperation);
stMode.eModeZone:=eModeZone;		
stOperation.eModeZone:=eModeZone;
stOperation.sModeZone:=TO_STRING(eModeZone);
IF (stMode.iActMode=E_WorkingMode.eAutoMode OR stMode.iActMode=E_WorkingMode.eSemiAutoMode)
AND NOT bInterlockBypass
THEN;
	bLockRequest:=TRUE;
ELSE;
	bLockRequest:=FALSE;
END_IF



r_trigIntClose(CLK:=bLockedFB);
r_trigIntOpen(CLK:=NOT bLockedFB);

(*888888888888888888   InterLocks Zone 1		8888888888888*)
IF stOperation.iActOperation=E_OperationButtons.ePlayAll AND  r_trigIntOpen.Q THEN
	bIntZonePaused:=TRUE;
END_IF

IF NOT bLockedFB 
AND NOT bInterlockBypass	
AND stOperation.iActOperation=E_OperationButtons.ePlayAll THEN
	//Message
	sActErrorID:='351'; // '050x000x351',	'Warning',	'Interlock Paused Operation',
	act_GetErrorID_Format();
	fbPrintErrMessageByID(sFB_ModuleDescription:=sModuleDescription,sActErrorID:=sFullErrorId,bSFCError:=TRUE);
	stOperation.bSetPause:=TRUE;
	stOperation.iPauseHistory:=4;
END_IF


IF bAutoPlayEnable AND bIntZonePaused AND r_trigIntClose.Q THEN
	stOperation.bSetPlay:=TRUE;
	bIntZonePaused:=FALSE;
END_IF

IF bLockedFB OR stMode.iActMode=E_WorkingMode.eManualMode THEN
	bIntZonePaused:=FALSE;
END_IF

rt_Play(CLK:=stOperation.iActOperation=E_OperationButtons.ePlayAll);

IF NOT bStateSafe_mode OR stOperation.bStopResetAll THEN;
	stMode.bSetManual:=TRUE;
	stOperation.bSetPause:=TRUE;
END_IF

m_Error_zone_check();

stOperation.iActModeState:=stMode.iActMode;]]></ST>
    </Implementation>
    <Folder Name="Actions" Id="{82255ca1-1f75-456a-a29d-0d95ddaf34af}" />
    <Action Name="act_AutomationLock_Failed" Id="{749ee08a-32c4-42e6-baa7-e0e1eee12535}" FolderPath="Actions\">
      <Implementation>
        <ST><![CDATA[sActErrorID:='306';//'050x000x306',	'Warning',	'Semi/Auto mode request rejected, automation lock failed',
act_GetErrorID_Format();
fbPrintErrMessageByID(sFB_ModuleDescription:=sModuleDescription,sActErrorID:=sFullErrorId,bSFCError:=TRUE);
]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_Done" Id="{296eb8e7-61ec-4e1e-9dc0-d90c1d2d741e}" FolderPath="Actions\">
      <Implementation>
        <ST><![CDATA[stMode.bSetManual:=FALSE;
stMode.bSetSemi:=FALSE;
stMode.bSetAuto:=FALSE;
//stMode.iErrorNum:=0;
//stMode.sErrorMessage:='No Error';]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_GetErrorID_Format" Id="{06fa01f5-e787-4c81-a2b4-ad12d608a7c8}" FolderPath="Actions\">
      <Implementation>
        <ST><![CDATA[(*IF bErrorSFC THEN;
	
	IF    sLast_SFCErrorStep='WaitSenOpen' 							THEN sActErrorID:='001';
	ELSIF sLast_SFCErrorStep='WaitSenNotClose' 		   				THEN sActErrorID:='002';
	ELSIF sLast_SFCErrorStep='WaitSenClose' 						THEN sActErrorID:='003';
	ELSIF sLast_SFCErrorStep='WaitSenNotOpen' 						THEN sActErrorID:='004';
	ELSIF sLast_SFCErrorStep='No Status' 							THEN sActErrorID:='005';		
	ELSIF sLast_SFCErrorStep='No Valve Operation' 					THEN sActErrorID:='006';
	ELSIF sLast_SFCErrorStep='Not synchronized with cycle command' 	THEN sActErrorID:='007';
	ELSIF sLast_SFCErrorStep='SensorsChecking' 						THEN sActErrorID:='008';
	
	ELSE;
		 sActErrorID:='999';
	END_IF

ELSE
		 sActErrorID:='000';
END_IF*)

fbFormatString(
	sFormat:= '%.3sx%.3dx%.3s', 
	arg1:= F_STRINGEx(sFB_ID), 
	arg2:= F_INT(eModeZone), 
	arg3:= F_STRINGEx(sActErrorID), 
	sOut=>sFullErrorId );
	
]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_ModeStillState" Id="{8ed3c8be-df69-41c3-95fa-f76f61afeb74}" FolderPath="Actions\">
      <Implementation>
        <ST><![CDATA[
r_trig_ModeExchange1(CLK:=stMode.iActMode=eManualMode);
r_trig_ModeExchange2(CLK:=stMode.iActMode=eSemiAutoMode);
r_trig_ModeExchange3(CLK:=stMode.iActMode=eAutoMode);
ton_ModeExchengeDelay(PT:=T#0.5S);
(*IF ton_ModeExchengeDelay.Q THEN
	ton_ModeExchengeDelay.IN:=FALSE;
END_IF*)
IF r_trig_ModeExchange1.Q
OR r_trig_ModeExchange2.Q
OR r_trig_ModeExchange3.Q
THEN
	ton_ModeExchengeDelay(IN:=FALSE);
	ton_ModeExchengeDelay.IN:=TRUE;
END_IF
bModeStillState:=ton_ModeExchengeDelay.Q;]]></ST>
      </Implementation>
    </Action>
