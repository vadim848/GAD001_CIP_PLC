<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="E_LightTowerState" Id="{1cb78ad0-7a61-4282-a065-16311b14b39b}">
    <Declaration><![CDATA[TYPE E_LightTowerState :
(
	eLightsOff:=0,
	eGreen,						//Run All
	eGreen_YellowBlink,			//Run All and warning
	eGreenBlink,				//Run some and some not
	eGreenBlink_YellowBlink,	//Run some and warning
	eGreenBlink_RedBlink,		//Run some and error
	eYellow,					//Pause
	eBlue,						//
	eRed						//Error
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>