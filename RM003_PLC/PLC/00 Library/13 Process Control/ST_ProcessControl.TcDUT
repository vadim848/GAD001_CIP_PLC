	fKp				:	REAL	; 
	fTn				:	REAL	; 
	fTv				:	REAL	;
	fTd				:	REAL	;
	fCtrlOutput		:	LREAL	; 
	nErrorStatus 	: 	UINT	;
	
	bDone			:	BOOL	;
END_STRUCT
END_TYPE
]]></Declaration>
