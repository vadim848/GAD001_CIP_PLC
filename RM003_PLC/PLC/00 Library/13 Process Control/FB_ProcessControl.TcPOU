<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_ProcessControl" Id="{a1972051-d534-4d79-bd7a-71cd1b516897}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ProcessControl

VAR_IN_OUT
	stProcessControl	:	ST_ProcessControl	;
END_VAR
VAR
	bRun			: BOOL	;
	//fbPID	: 	FB_BasicPID	;
	fbPID	: 	PID	;
	hystCIP_SetPoint: FB_Hysteresis_REAL;
	Call_ActDelayTON	: TON	;
	
	hendelingPID_Manual: TON;

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//stProcessControl.bManual:=TRUE;



Call_ActDelayTON(IN:=stProcessControl.bActiveCntr , PT:=T#1S , Q=> , ET=> );

m_Check();

act_Call_PID();
act_CallHyst();

hendelingPID_Manual(PT:=T#0.5S, IN:=TRUE);
IF hendelingPID_Manual.Q THEN;
	stProcessControl.bManual:=TRUE;
ELSE;
	stProcessControl.bManual:=FALSE;
END_IF

]]></ST>
    </Implementation>
