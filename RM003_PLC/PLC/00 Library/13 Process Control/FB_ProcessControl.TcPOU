    <Action Name="act_Call_PID_old" Id="{e29ea305-112b-4479-9e5c-3d503fcea5b6}">
      <Implementation>
        <ST><![CDATA[
	
(*
fbPID(
	fSetpointValue:=stProcessControl.rSetPoint , 
	fActualValue:=stProcessControl.rValue , 
	bReset:=stProcessControl.bReset , 
	fCtrlCycleTime:=stProcessControl.fCtrlCycleTime , 
	fKp:=stProcessControl.fKp , 
	fTn:=stProcessControl.fTn , 
	fTv:=stProcessControl.fTv , 
	fTd:=stProcessControl.fTd , 
	fCtrlOutput=>stProcessControl.fCtrlOutput , 
	nErrorStatus=>stProcessControl.nErrorStatus );
*)]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_CallHyst" Id="{7f4572c7-9e9a-4bff-b0e0-f6c19cca19c6}">
      <Implementation>
        <ST><![CDATA[hystCIP_SetPoint(
	fIn:=stProcessControl.rValue,//g_HMI.stT4_Sens.rTankLevel,
	fHigh:=stProcessControl.fHystHigh,
	fLow:=-stProcessControl.fHystLow,
	iDigitsAfterDot:=,
	bOut=>stProcessControl.bHystOut);
			
]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_Check" Id="{b27ec81e-04ce-483d-958b-1ee4b2519c56}">
      <Declaration><![CDATA[METHOD m_Check : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bRun THEN 
	stProcessControl.bActiveCntr:=TRUE; 
ELSIF NOT bRun AND Call_ActDelayTON.Q THEN
	stProcessControl.bActiveCntr:=FALSE;
END_IF

IF bRun THEN
	stProcessControl.Deviation:=stProcessControl.rSetPoint-stProcessControl.rValue;
	stProcessControl.Control_ON:=FALSE;
	stProcessControl.OverFlow:=FALSE;
	stProcessControl.bDone:=FALSE;
	
	IF stProcessControl.Deviation >= stProcessControl.ToleravceLow THEN;
		//Value too low needs to be increased
		stProcessControl.Control_ON:=TRUE;
		stProcessControl.OverFlow:=FALSE;
		stProcessControl.bDone:=FALSE;
	ELSIF stProcessControl.Deviation <= -stProcessControl.ToleranceHigh THEN;
		//value too high need to be decreased
		stProcessControl.OverFlow:=TRUE;
		stProcessControl.Control_ON:=TRUE;
		stProcessControl.bDone:=FALSE;
		//message
	ELSE;
		// Done, value in tolerace
		stProcessControl.OverFlow:=FALSE;
		stProcessControl.Control_ON:=FALSE;
		stProcessControl.bDone:=TRUE;
	END_IF
	bRun:=FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="mReset" Id="{b49576d6-978e-47f7-ae59-752a1612df43}">
      <Declaration><![CDATA[METHOD mReset : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stProcessControl.Control_ON:=FALSE;
stProcessControl.OverFlow:=FALSE;
stProcessControl.bDone:=FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="mRun" Id="{9603e267-93ce-4898-8d8d-2a4ace5f7fdf}">
      <Declaration><![CDATA[METHOD mRun : BOOL
VAR_INPUT
	//Set_Point: REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRun:=TRUE;
//stProcessControl.rSetPoint:=Set_Point;
m_Check();



mRun:=stProcessControl.bDone;]]></ST>
      </Implementation>
    </Method>
    <Method Name="mRun_Hyst" Id="{ddfa5b4a-f749-4a9f-b8a9-9760265fd642}">
      <Declaration><![CDATA[METHOD mRun_Hyst : REAL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stProcessControl.bManual:=FALSE;
IF stProcessControl.bHystOut THEN
	mRun_Hyst:=stProcessControl.rHystOutLow;
ELSE
	mRun_Hyst:=stProcessControl.rHystOutHigh;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="mRun_PID" Id="{4a3f5dec-9850-4133-86e5-b2ae6f3c1d56}">
      <Declaration><![CDATA[METHOD mRun_PID : REAL
VAR_INPUT
	Set_Point: REAL;
	controlManual: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[mRun();//mRun(Set_Point:=Set_Point);
//stProcessControl.bManual:=controlManual;
//stProcessControl.rSetPoint:=Set_Point;
hendelingPID_Manual(IN:=controlManual);
mRun_PID:=stProcessControl.fCtrlOutput;]]></ST>
      </Implementation>
    </Method>
    <Method Name="mRun_With_SP" Id="{2d03209f-e46c-40c1-b393-0560a9377f6a}">
      <Declaration><![CDATA[METHOD mRun_With_SP : BOOL
VAR_INPUT
	Set_Point: REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stProcessControl.rSetPoint:=Set_Point;
bRun:=TRUE;
mRun();
stProcessControl.rSetPoint:=Set_Point;
mRun_With_SP:=stProcessControl.bDone;]]></ST>
      </Implementation>
    </Method>
