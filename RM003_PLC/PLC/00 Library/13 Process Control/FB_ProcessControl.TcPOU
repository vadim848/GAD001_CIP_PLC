<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_ProcessControl" Id="{a1972051-d534-4d79-bd7a-71cd1b516897}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ProcessControl
VAR_IN_OUT
	stProcessControl	:	ST_ProcessControl	;
END_VAR
(*VAR_INPUT
	rValue			: REAL;
	rSetPoint		: REAL;
	ToleravceLow	: REAL:=0;  // min=0
	ToleranceHigh	: REAL:=0;  // min=0
END_VAR

VAR_OUTPUT
	Control_Value	: REAL;  // min=0 , max=1
	Control_ON		: BOOL;
	OverFlow		: BOOL;	
	
	bDone			:	BOOL	;
END_VAR*)
VAR
	bRun		:	BOOL	;
	Deviation	: 	REAL	;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bRun THEN
	Deviation:=stProcessControl.rSetPoint-stProcessControl.rValue;
	stProcessControl.Control_ON:=FALSE;
	stProcessControl.OverFlow:=FALSE;
	stProcessControl.bDone:=FALSE;
	
	IF Deviation >= stProcessControl.ToleravceLow THEN;
		//Value too low needs to be increased
		stProcessControl.Control_ON:=TRUE;
		stProcessControl.OverFlow:=FALSE;
		stProcessControl.bDone:=FALSE;
	ELSIF Deviation <= -stProcessControl.ToleranceHigh THEN;
		//value too high need to be decreased
		stProcessControl.OverFlow:=TRUE;
		stProcessControl.Control_ON:=FALSE;
		stProcessControl.bDone:=FALSE;
		//message
	ELSE;
		// Done, value in tolerace
		stProcessControl.OverFlow:=FALSE;
		stProcessControl.Control_ON:=FALSE;
		stProcessControl.bDone:=TRUE;
	END_IF
	bRun:=FALSE;
END_IF]]></ST>
    </Implementation>
    <Method Name="mReset" Id="{b49576d6-978e-47f7-ae59-752a1612df43}">
      <Declaration><![CDATA[METHOD mReset : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stProcessControl.Control_ON:=FALSE;
stProcessControl.OverFlow:=FALSE;
stProcessControl.bDone:=FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="mRun" Id="{9603e267-93ce-4898-8d8d-2a4ace5f7fdf}">
      <Declaration><![CDATA[METHOD mRun : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRun:=TRUE;]]></ST>
      </Implementation>
    </Method>
