<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_ProcessControl" Id="{a1972051-d534-4d79-bd7a-71cd1b516897}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ProcessControl
VAR_INPUT
	value			: REAL;
	SetPoint		: REAL;
	ToleravceLow	: REAL:=0;  // min=0
	ToleranceHigh	: REAL:=0;  // min=0
END_VAR

VAR_OUTPUT
	Control_Value	: REAL;  // min=0 , max=1
	Control_ON		: BOOL;
	OverFlow		: BOOL;	
END_VAR
VAR

	Deviation		: REAL;


END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Deviation:=SetPoint-value;
Control_ON:=FALSE;
OverFlow:=FALSE;

IF Deviation >= ToleravceLow THEN;
	Control_ON:=TRUE;
ELSIF Deviation <= -ToleranceHigh THEN;
	OverFlow:=TRUE;
	//message
ELSE;
	// Done, value in tolerace
END_IF]]></ST>
    </Implementation>
    <LineIds Name="FB_ProcessControl">
      <LineId Id="9" Count="0" />
