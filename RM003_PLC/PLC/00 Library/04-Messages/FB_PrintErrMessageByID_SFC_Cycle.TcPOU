<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_PrintErrMessageByID_SFC_Cycle" Id="{0afd8d87-7097-4d9f-b83c-39bc3804931a}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PrintErrMessageByID_SFC_Cycle
VAR_INPUT
	sActErrorID				: STRING;
	iFB_Num					: INT:=0;
	sFB_ModuleDescription	: STRING:='';
	bSFCError				: BOOL;
	sLast_ErrorToPrint		: STRING;
END_VAR
VAR_OUTPUT
END_VAR
VAR
	cFound				: INT;
	i					: INT;
	iFound				: INT;
	bNewMeasege			: BOOL;
	rtrig1				: R_TRIG;
	sLastErrorID		: STRING;
	sLastErrorID_ToPrint		: STRING;	
	j: INT;
	sActErrorID_List: STRING(11);
	sTemp1: STRING(11);
	sTemp2: STRING(11);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
sLastErrorID_ToPrint:='';
	
IF bSFCError THEN
	IF sActErrorID<>'000x000x000'  AND sActErrorID<>'' THEN
		sLastErrorID:=sActErrorID;
		bNewMeasege:=TRUE;
		FOR i:=1 TO 100 DO
			IF Buffer_Act_Message[i].sErrID=sActErrorID THEN;
				//IF Buffer_Act_Message[i].sModuleDescription = sFB_ModuleDescription THEN
					bNewMeasege:=FALSE;
					EXIT; 
				//END_IF
			END_IF
		END_FOR
	ELSE
		bNewMeasege:=FALSE;
	END_IF
	
	
	IF bNewMeasege THEN;
		FOR i:=100 TO 2 BY -1 DO
			Buffer_Act_Message[i].sDateTime:=Buffer_Act_Message[i-1].sDateTime;
			Buffer_Act_Message[i].sErrID:=Buffer_Act_Message[i-1].sErrID;
			Buffer_Act_Message[i].sErrorMessage:=Buffer_Act_Message[i-1].sErrorMessage;
			Buffer_Act_Message[i].sLevel:=Buffer_Act_Message[i-1].sLevel;
			Buffer_Act_Message[i].sModuleDescription:=Buffer_Act_Message[i-1].sModuleDescription;
		END_FOR
		
		Buffer_Act_Message[1].sDateTime:=prg_RealClock.sRealTime_Date;
		Buffer_Act_Message[1].sErrID:=sActErrorID;
		Buffer_Act_Message[1].sModuleDescription:=sFB_ModuleDescription;

		IF REPLACE(sActErrorID,'',8,1)='PUZ' THEN;
			sActErrorID_List:=REPLACE(sActErrorID,'000x000',7,1);	
			sTemp1:=sActErrorID_List;		
		ELSE;
			sActErrorID_List:=REPLACE(sActErrorID,'000',3,5);
			sTemp2:=sActErrorID_List;
		END_IF
		
		
		IF sActErrorID='000x000x999' THEN;
			Buffer_Act_Message[1].sErrorMessage:=CONCAT('Cycle message: ',sLast_ErrorToPrint);
			Buffer_Act_Message[1].sLevel:='Error';
		ELSE
			cFound:=0;
			FOR i:=1 TO C_Max_ErrorList DO
				IF ar_ErrorList[i,eErrID]=sActErrorID_List THEN
					iFound:=i;
					ar_ErrorActive[iFound]:=TRUE;
					cFound:=cFound+1;
				END_IF
			END_FOR
	
			IF cFound=1 THEN;
				Buffer_Act_Message[1].sErrorMessage:=ar_ErrorList[iFound,eErrMeassage];	(*	Error from the List	*)
				Buffer_Act_Message[1].sLevel:=ar_ErrorList[iFound,eErrLevel];	(*	Error Level from the List	*)
			ELSIF cFound=0 THEN; //(*	Error ID not Foud on the List	*)
				//Buffer_Act_Message[1].sErrorMessage:='Error ID not found on the "Error_List"';
				Buffer_Act_Message[1].sErrorMessage:=CONCAT('Cycle message[1]: ',sLast_ErrorToPrint);
				Buffer_Act_Message[1].sLevel:='Error';
			ELSIF cFound>1 THEN; //(*	More then one Errors Foud with the same  ID		*)
				//Buffer_Act_Message[1].sErrorMessage:='More then one error with the same ID  found on the "Error_list"';
				Buffer_Act_Message[1].sErrorMessage:=CONCAT('Cycle message[2]: ',sLast_ErrorToPrint);
				Buffer_Act_Message[1].sLevel:='Error';
			END_IF
		END_IF
		FUN_Write_Line_To_History();
	END_IF
	
END_IF

(*
rtrig1(CLK:= NOT bSFCError , Q=> );
IF rtrig1.Q THEN  // if cycle not in pause
	FOR i:= 2 TO 100 DO //loop for search 
		IF Buffer_Act_Message[i-1].sErrID = sLastErrorID THEN // search if last error id = buffer which it error table.
			FOR j:= i TO 100 DO //if found message id then delete it.
				Buffer_Act_Message[j-1]:=Buffer_Act_Message[j];//delete
			END_FOR
		END_IF
	END_FOR
END_IF
*)
]]></ST>
    </Implementation>
