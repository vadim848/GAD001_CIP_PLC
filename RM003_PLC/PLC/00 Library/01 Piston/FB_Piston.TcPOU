<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_Piston" Id="{ec561158-aba5-4c24-99fa-59f7aabd22e8}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Piston
VAR_INPUT
	description		: STRING;		(* Piston description*)	
	sen_Open		: BOOL;
	sen_Close		: BOOL;
	
	DefaultCmd		: E_PistonDefault_CMD:=E_PistonDefault_CMD.Close;

	iFB_Num			: E_Pis_Name;

END_VAR
VAR_OUTPUT
	valve_Open		: BOOL;
	valve_Close		: BOOL;	
END_VAR
VAR_IN_OUT
	stDevErr_H		: ST_OperationButtons;	
END_VAR
VAR
	stPis			:	REFERENCE TO ST_Piston;
	stPis_UpLow		:	REFERENCE TO ST_Piston_U_L;
	state: E_Piston_State;
	state_Close,state_Open: (Ready, CheckState, ValveUpdate, Busy, Delay, Done, Error);

	//sen_Open_Exist	: REFERENCE TO BOOL :=FALSE;
	//sen_Close_Exist	: REFERENCE TO BOOL :=FALSE;
	
	ton_SensorCheck	: TON;
	ton_MinTime		: TON;
	ton_MaxTime		: TON;
	ton_SensorDelay	: TON;

	// Timing 
	t_minOpen		: TIME 	:=T#300MS;	(* minimum time to open piston*)
	t_minClose		: TIME	:=T#300MS;	(* minimum time to close piston*)
	t_maxOpen		: TIME 	:=T#3S;		(* Maximum time to open piston, will initiate an error*)
	t_maxClose		: TIME	:=T#3S;		(* Maximum time to open piston, will initiate an error*)
	t_DelayOpen		: TIME 	:=T#0S;		(* Delay time to getting "st_Open", will count after minimum time and sensors detection done*)
	t_DelayClose	: TIME	:=T#0S;		(* Delay time to getting "st_Close", will count after minimum time and sensors detection done*)	
	
	rt_Close		: R_TRIG;
	rt_Open			: R_TRIG;
	rt_OpenMan		: R_TRIG;
	rt_CloseMan		: R_TRIG;
	rt_DefaultPos	: R_TRIG;
	rt_ResumeMaster	: R_TRIG;
	b_memo_OpenFDBKExist	: BOOL;
	b_memo_CloseFDBKExist	: BOOL;
	Call_FTrig_ReqUp	: F_TRIG;
	Call_FTrig_ReqLow	: F_TRIG;
	
	bErrorMemo: BOOL;
	
	stOperation		: REFERENCE TO ST_OperationButtons;
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF iFB_Num <> E_Pis_Name.e0_not_in_use THEN;
	
END_IF

act_Get_Reference();




act_State_Machine();
act_StateDeafult();
act_MemFdbkExist();

stPis_UpLow.bError:=stPis.b_Error;
stPis_UpLow.iFB_Num:=iFB_Num;
	
IF iFB_Num = E_Pis_Name.e0_not_in_use THEN;
	//stPis.st_Deafult:=TRUE;
END_IF

(* case to acception at PLC Restart ...TBD*)
IF __ISVALIDREF(stPis) THEN;
	IF prg_Safety.ftStateSafe.Q
	AND NOT stPis.st_Deafult
	THEN;
		stPis.req_DefaultPos:=TRUE;
		stPis.req_Close:=FALSE;
		stPis.req_Open:=FALSE;	
	END_IF
	
	IF prg_Safety.rtStateSafe.Q THEN;
		
		IF NOT stPis.st_Deafult THEN;
			stPis.req_DefaultPos:=TRUE;
		END_IF	
		stPis.b_Resume:=TRUE;
		//stPis.b_Reset:=TRUE;	
	END_IF	
END_IF



]]></ST>
    </Implementation>
    <Action Name="act_Close" Id="{1d06fffa-a52d-4208-941d-d3aedaa130ae}">
      <Implementation>
        <ST><![CDATA[


CASE state_Close OF
	Ready:;
		IF stPis.req_CloseMan THEN;
			stPis.req_CloseMan:=FALSE;
			// Do manual case code
			stPis.req_Close:=TRUE;
		END_IF		
		IF stPis.req_Close THEN;
			stPis.req_Open:=FALSE;
			stPis.req_OpenMan:=FALSE;	
			stPis.req_DefaultPos:=FALSE;			
			state_Close:=CheckState;
		END_IF
		
	CheckState:;
		IF stPis.st_Close THEN;
			stPis.st_Open:=FALSE;
			state_Close:=Done;
		ELSE;
			stPis.st_Close:=FALSE;
			stPis.st_Open:=FALSE;
			state_Close:=ValveUpdate;
		END_IF
		
	ValveUpdate:;
		valve_Open:=FALSE;
		valve_Close:=TRUE;
		ton_SensorCheck(IN:=FALSE);
		ton_MinTime(IN:=FALSE);
		ton_MinTime(IN:=TRUE);
		ton_MaxTime(IN:=FALSE);
		ton_MaxTime(IN:=TRUE);
		ton_SensorDelay(IN:=FALSE);
		
		stPis.t_LastClose:=T#0S;
		state_Close:=Busy;
		
	Busy:;
		ton_MinTime(PT:=t_minClose);
		ton_MaxTime(PT:=t_maxClose, IN:=TRUE);
		ton_SensorDelay(PT:=t_DelayClose,IN:=m_PistonSensorCheck());	
		IF 	ton_MinTime.Q 		
		AND ton_SensorDelay.IN THEN;
			ton_MaxTime(IN:=FALSE);
			IF ton_SensorDelay.Q THEN;
				stPis.t_LastClose:=ton_MaxTime.ET;			
				state_Close:=Done;				
			END_IF
		ELSE;
			IF ton_MaxTime.Q THEN;
				//Error to print
				state_Close:=Error;
			END_IF			
		END_IF
	
	Done:;
		stPis.st_Close:=TRUE;
		IF stPis.st_Close THEN;
			state_Close:=Ready;
			stPis.req_Close:=FALSE;
		END_IF	
		
	Error:;
		//Wating to operator reset & resume 
		stPis.b_Error:=TRUE;	
		m_Error();
		IF stPis.b_Resume THEN;
			state_Close:=ValveUpdate;
			stPis.b_Resume:=FALSE;	
			stPis.b_Error:=FALSE;
			bErrorMemo:=FALSE;
		END_IF
		
END_CASE]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_Error" Id="{87d4419b-1cc7-477e-82bc-3d7bbce7bd99}">
      <Implementation>
        <ST><![CDATA[IF SFCError OR FALSE THEN

	IF  SFCErrorStep='WaitSenOpen' THEN
		db.eErrNum:=1;
	ELSIF SFCErrorStep='WaitSenNotClose' THEN
		db.eErrNum:=2;
	ELSIF SFCErrorStep='WaitSenClose' THEN
		db.eErrNum:=3;
	ELSIF SFCErrorStep='WaitSenNotOpen' THEN
		db.eErrNum:=4;
	ELSIF SFCErrorStep='No Status' THEN
		db.eErrNum:=5;
	ELSIF SFCErrorStep='No Valve Operation' THEN
		db.eErrNum:=6;
	ELSIF SFCErrorStep='Not synchronized with cycle command' THEN //SensorsChecking
		db.eErrNum:=7;
	ELSIF SFCErrorStep='SensorsChecking' THEN
		db.eErrNum:=8;		
	ELSIF bWarning THEN;	// act_Ready
		//db.eErrNum:=21; 	// '2AAx021',	'Warning',	', Manual command rejected in semi/auto mode',	(**)
	ELSE
		db.eErrNum:=9;
	END_IF
	Last_SFCErrorStep:=SFCErrorStep;
	
ELSE
		db.eErrNum:=0;
END_IF

IF db.eErrNum<>0 AND NOT bErrorMemo AND db.iPisNum<>0 THEN

	IF db.iPisNum<10 THEN
		sActErrorID:=CONCAT('20',INT_TO_STRING(db.iPisNum));
	ELSE
		sActErrorID:=CONCAT('2',INT_TO_STRING(db.iPisNum));
	END_IF
	
	IF db.eErrNum<10 THEN
		sActErrorID:=CONCAT(sActErrorID,'x00');
		sActErrorID:=CONCAT(sActErrorID,INT_TO_STRING(db.eErrNum));
	ELSE
		sActErrorID:=CONCAT(sActErrorID,'x0');
		sActErrorID:=CONCAT(sActErrorID,INT_TO_STRING(db.eErrNum));		
	END_IF

	FOR Mess:=100 TO 2 BY -1 DO
		Buffer_Act_Message[Mess].sDateTime:=Buffer_Act_Message[Mess-1].sDateTime;
		Buffer_Act_Message[Mess].sErrID:=Buffer_Act_Message[Mess-1].sErrID;
		Buffer_Act_Message[Mess].sErrorMessage:=Buffer_Act_Message[Mess-1].sErrorMessage;
		Buffer_Act_Message[Mess].sLevel:=Buffer_Act_Message[Mess-1].sLevel;
	END_FOR
		Buffer_Act_Message[1].sDateTime:=sRealTime;
		Buffer_Act_Message[1].sErrID:=sActErrorID;

		(*888888888888888888888888888888888888888888*)
		IF db.eErrNum<10 THEN
			sActErrorID_AA:=CONCAT('2AAx00',INT_TO_STRING(db.eErrNum));
		ELSE
			sActErrorID_AA:=CONCAT('2AAx0',INT_TO_STRING(db.eErrNum));			
		END_IF
		cFound:=0;
		FOR i:=1 TO C_Max_ErrorList DO
			IF ar_ErrorList[i,eErrID]=sActErrorID_AA THEN
				iFound:=i;
				ar_ErrorActive[iFound]:=TRUE;
				cFound:=cFound+1;
			END_IF
		END_FOR

		Buffer_Act_Message[1].sErrorMessage:=CONCAT( 'Piston Num ', INT_TO_STRING(db.iPisNum));
		Buffer_Act_Message[1].sErrorMessage:=CONCAT( Buffer_Act_Message[1].sErrorMessage, ', ');
		Buffer_Act_Message[1].sErrorMessage:=CONCAT( Buffer_Act_Message[1].sErrorMessage, arPisDescription[db.iPisNum]);
		Buffer_Act_Message[1].sErrorMessage:=CONCAT( Buffer_Act_Message[1].sErrorMessage, ': ');

		IF cFound=1 THEN;
			Buffer_Act_Message[1].sErrorMessage:=CONCAT( Buffer_Act_Message[1].sErrorMessage, ar_ErrorList[iFound,eErrMeassage]);	(*	Error from the List	*)
			Buffer_Act_Message[1].sLevel:= ar_ErrorList[iFound,eErrLevel];	(*	Level from the List	*)
		ELSIF cFound=0 THEN;
			Buffer_Act_Message[1].sErrorMessage:=CONCAT( Buffer_Act_Message[1].sErrorMessage, 'Error ID not found on the "Error_List"');	(*	Error ID not Foud on the List	*)
		ELSIF cFound>1 THEN;
			Buffer_Act_Message[1].sErrorMessage:=CONCAT( Buffer_Act_Message[1].sErrorMessage, 'More then one error with the same ID  found on the "Error_list"');	(*	More then one Errors Foud with the same  ID		*)
		END_IF
		(*888888888888888888888888888888888888888888*)

	FUN_Write_Line_To_History();
	bErrorMemo:=TRUE;
END_IF

(*
'WaitSenOpen'
'WaitSenNotClose'
'WaitSenClose'
'WaitSenNotOpen'
'No Status'
'No Valve Operation'
*)]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_Get_Reference" Id="{5587b6ef-4983-4751-a3fb-a1c5a80691d6}">
      <Implementation>
        <ST><![CDATA[stPis REF= g_Piston.stPis[iFB_Num];
stPis_UpLow REF= g_Piston.stPis_U_L[iFB_Num];
//stPis.description:=description;
stPis.b_Exist:=TRUE;
stPis.sName:=TO_STRING(iFB_Num);
stPis.iPisNum:=iFB_Num;
arPisName[iFB_Num].Num:=iFB_Num;
arPisName[iFB_Num].Description:=stPis.sName;

stPis.sen_Close REF= sen_Close;
stPis.sen_Close_Exist REF= stPisSetting[iFB_Num].sen_Close_Exist;
//stPis.sen_Close_Exist REF= sen_Close_Exist;
stPis.sen_Open REF= sen_Open;
stPis.sen_Open_Exist REF= stPisSetting[iFB_Num].sen_Open_Exist;
//stPis.sen_Open_Exist REF= sen_Open_Exist;

stPis.valve_Close REF= valve_Close;
stPis.valve_Open REF= valve_Open;

stPis.t_maxClose REF= stPisSetting[iFB_Num].t_maxClose;
stPis.t_maxOpen REF= stPisSetting[iFB_Num].t_maxOpen;
stPis.t_minClose REF= stPisSetting[iFB_Num].t_minClose;
stPis.t_minOpen REF= stPisSetting[iFB_Num].t_minOpen;
stPis.t_DelayClose REF= stPisSetting[iFB_Num].t_DelayClose;
stPis.t_DelayOpen REF= stPisSetting[iFB_Num].t_DelayOpen;
t_maxClose:=fun_Real_SecondsToTime(in_Time:=stPis.t_maxClose);
t_maxOpen:=fun_Real_SecondsToTime(in_Time:=stPis.t_maxOpen);
t_minClose:=fun_Real_SecondsToTime(in_Time:=stPis.t_minClose);
t_minOpen:=fun_Real_SecondsToTime(in_Time:=stPis.t_minOpen);
t_DelayClose:=fun_Real_SecondsToTime(in_Time:=stPis.t_DelayClose);
t_DelayOpen:=fun_Real_SecondsToTime(in_Time:=stPis.t_DelayOpen);

stPis.DefaultCmd REF= DefaultCmd;
(*
IF stPis.b_Error 
AND stDevErr_H.eErrorActive=E_Error_Active_Module.noError 
THEN;
	stDevErr_H.sObjectName:=CONCAT('pis.No:',INT_TO_STRING(stPis.iPisNum));
	stDevErr_H.sObjectName:=CONCAT(stDevErr_H.sObjectName,'- ');
	stDevErr_H.sObjectName:=CONCAT(stDevErr_H.sObjectName,TO_STRING(iFB_Num));
	stDevErr_H.eErrorActive:=E_Error_Active_Module.Piston;
	stDevErr_H.iObjectID:=iFB_Num;
END_IF

rt_ResumeMaster(CLK:=stDevErr_H.bMasterResume);
IF rt_ResumeMaster.Q THEN;
	stPis.b_Resume:=TRUE;
END_IF
*)]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_MemFdbkExist" Id="{a0b17f23-d2da-40b6-b232-4b9995f30b7b}">
      <Implementation>
        <ST><![CDATA[IF stPis.st_Close AND stPis_UpLow.exist THEN
	//Fetching signals
	IF TRUE THEN
		Call_FTrig_ReqUp(CLK:=stPis_UpLow.req_Upper , Q=> );
	ELSE
		Call_FTrig_ReqUp(CLK:=stPis_UpLow.st_Upper , Q=> );
	END_IF
	
	Call_FTrig_ReqLow(CLK:=stPis_UpLow.st_Lower , Q=> );
	
	//setting memmory
	IF stPis_UpLow.req_Lower AND stPis.sen_Close_Exist THEN
		b_memo_CloseFDBKExist:=stPis.sen_Close_Exist;
		stPis.sen_Close_Exist:=FALSE;
	ELSIF stPis_UpLow.req_Lower AND b_memo_CloseFDBKExist THEN
		stPis.sen_Close_Exist:=FALSE;
	END_IF
	
	IF stPis_UpLow.req_Upper AND stPis.sen_Open_Exist THEN
		b_memo_OpenFDBKExist:=stPis.sen_Open_Exist;
		stPis.sen_Open_Exist:=FALSE;
	ELSIF stPis_UpLow.req_Upper AND b_memo_OpenFDBKExist THEN
		stPis.sen_Open_Exist:=FALSE;
	END_IF
	//resseting memmory
	IF Call_FTrig_ReqUp.Q AND b_memo_OpenFDBKExist THEN
		stPis.sen_Open_Exist:=b_memo_OpenFDBKExist;
		b_memo_OpenFDBKExist:=FALSE;
	END_IF
	
	IF Call_FTrig_ReqLow.Q AND b_memo_CloseFDBKExist THEN
		stPis.sen_Close_Exist:=b_memo_CloseFDBKExist;
		b_memo_CloseFDBKExist:=FALSE;
	END_IF
ELSE
	IF stPis_UpLow.exist THEN
		b_memo_CloseFDBKExist:=FALSE;
		b_memo_OpenFDBKExist:=FALSE;
		stPis_UpLow.req_Lower:=FALSE;
		stPis_UpLow.st_Lower:=FALSE;
	ELSE
		;
	END_IF
	
END_IF

IF stPis.req_Open AND NOT stPis_UpLow.exist  THEN
	IF stPis.sen_Close_Exist THEN
		b_memo_CloseFDBKExist:=TRUE;
		stPis.sen_Close_Exist:=FALSE;
	END_IF
	
	IF stPis.sen_Open_Exist THEN
		b_memo_OpenFDBKExist:=TRUE;
		stPis.sen_Open_Exist:=FALSE;
	END_IF
ELSIF stPis.req_Close AND NOT stPis_UpLow.exist THEN
	IF b_memo_CloseFDBKExist THEN
		stPis.sen_Close_Exist:=TRUE;
		b_memo_CloseFDBKExist:=FALSE;
	END_IF
	
	IF b_memo_OpenFDBKExist THEN
		stPis.sen_Open_Exist:=TRUE;
		b_memo_OpenFDBKExist:=FALSE;
	END_IF
	
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_New_CMD" Id="{41187a43-fa92-4bd7-bb88-cf8db79fe6ff}">
      <Implementation>
        <ST><![CDATA[IF stPis.b_Enable AND stPis.b_InterLock THEN;
	
	rt_Close(CLK:=stPis.req_Close);
	rt_Open(CLK:=stPis.req_Open);
	rt_CloseMan(CLK:=stPis.req_CloseMan);
	rt_OpenMan(CLK:=stPis.req_OpenMan);
	rt_DefaultPos(CLK:=stPis.req_DefaultPos);


	IF rt_Close.Q OR rt_CloseMan.Q THEN; 
		state:=E_Piston_State.Busy_Close; 
		stPis.req_Open:=FALSE;
		stPis.req_OpenMan:=FALSE;	
		stPis.req_DefaultPos:=FALSE;	
	END_IF
	IF rt_Open.Q OR rt_OpenMan.Q THEN; 
		state:=E_Piston_State.Busy_Open; 
		stPis.req_Close:=FALSE;
		stPis.req_CloseMan:=FALSE;
		stPis.req_DefaultPos:=FALSE;	
	END_IF
	IF rt_DefaultPos.Q THEN; 
		state:=E_Piston_State.Init; 
	END_IF
	
	(*IF rt_CloseMan.Q THEN; 
		state:=E_Piston_State.Busy_Close;
	END_IF
	IF rt_OpenMan.Q THEN; 
		state:=E_Piston_State.Busy_Open; 
	END_IF
*)
	
	IF rt_Close.Q 
	OR rt_Open.Q
	OR rt_CloseMan.Q
	OR rt_OpenMan.Q
	OR rt_DefaultPos.Q
	THEN;
		stPis.b_Error:=FALSE;
	END_IF
	
	stPis.b_DeactivateMan:=FALSE;
ELSE;
	stPis.b_DeactivateMan:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_Open" Id="{44296d41-1ac9-468f-bdd3-09d882e1e24e}">
      <Implementation>
        <ST><![CDATA[


CASE state_Open OF
	Ready:;
		IF stPis.req_OpenMan THEN;
			stPis.req_OpenMan:=FALSE;
			// Do manual case code
			stPis.req_Open:=TRUE;
		END_IF		
		IF stPis.req_Open THEN;
			stPis.req_Close:=FALSE;
			stPis.req_CloseMan:=FALSE;
			stPis.req_DefaultPos:=FALSE;		
			state_Open:=CheckState;
		END_IF
		
	CheckState:;
		IF stPis.st_Open THEN;
			stPis.st_Close:=FALSE;
			state_Open:=Done;
		ELSE;
			stPis.st_Close:=FALSE;
			stPis.st_Open:=FALSE;
			state_Open:=ValveUpdate;
		END_IF
		
	ValveUpdate:;
		valve_Open:=TRUE;
		valve_Close:=FALSE;
		ton_SensorCheck(IN:=FALSE);
		ton_MinTime(IN:=FALSE);
		ton_MinTime(IN:=TRUE);
		ton_MaxTime(IN:=FALSE);
		ton_MaxTime(IN:=TRUE);	
		ton_SensorDelay(IN:=FALSE);
		
		stPis.t_LastOpen:=T#0S;	
		state_Open:=Busy;
		
	Busy:;
		ton_MinTime(PT:=t_minOpen);
		ton_MaxTime(PT:=t_maxOpen);
		ton_SensorDelay(PT:=t_DelayOpen,IN:=m_PistonSensorCheck());	
		IF 	ton_MinTime.Q 
		AND m_PistonSensorCheck()	THEN;
			ton_MaxTime(IN:=FALSE);
			IF ton_SensorDelay.Q THEN;
				stPis.t_LastOpen:=ton_MaxTime.ET;			
				state_Open:=Done;				
			END_IF
		ELSE;
			IF ton_MaxTime.Q THEN;
				//Error to print
				state_Open:=Error;
				;
			END_IF				
		END_IF
	
	Done:;
		stPis.st_Open:=TRUE;	
		IF stPis.st_Open THEN;
			state_Open:=Ready;
			stPis.req_Open:=FALSE;
		END_IF	
		
	Error:;
		//Wating to operator reset & resume 
		stPis.b_Error:=TRUE;
		m_Error();
		IF stPis.b_Resume THEN;
			state_Open:=ValveUpdate;
			stPis.b_Resume:=FALSE;
			stPis.b_Error:=FALSE;
			bErrorMemo:=FALSE;
		END_IF
		
END_CASE]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_State_Machine" Id="{0a032fc1-47d5-4a06-9768-752edcf06d0a}">
      <Implementation>
        <ST><![CDATA[IF stPis.b_Resume THEN;
	stPis.b_Error:=FALSE;		
END_IF

act_New_CMD();
CASE state OF
	E_Piston_State.Init:;
			ton_SensorCheck(IN:=FALSE);
			
	
			stPis.st_Close:=FALSE;
			stPis.st_Open:=FALSE;
			
			stPis.b_Error:=FALSE;
			stPis.b_Reset:=FALSE;
			stPis.b_Resume:=FALSE;
			
			stPis.req_Close:=FALSE;
			stPis.req_CloseMan:=FALSE;	
			stPis.req_Open:=FALSE;
			stPis.req_OpenMan:=FALSE;
			stPis.req_DefaultPos:=FALSE;
			
			state_Close:=Ready;
			state_Open:=Ready;
			
			//check default configuration
			IF stPis.b_Enable AND stPis.b_InterLock THEN;				
				CASE DefaultCmd OF
					E_PistonDefault_CMD.Close:;
						state:=E_Piston_State.Busy_Close;
						stPis.req_Close:=TRUE;
					E_PistonDefault_CMD.Open:;
						state:=E_Piston_State.Busy_Open;
						stPis.req_Open:=TRUE;
					E_PistonDefault_CMD.Sensors:;
					E_PistonDefault_CMD.SensorsClose:;
					E_PistonDefault_CMD.SensorsOpen:;
					
				END_CASE
			END_IF
	
	E_Piston_State.Close:;
		IF m_PistonSensorCheck() AND NOT stPis.b_Error THEN;
			stPis.st_Close:=TRUE;
			stPis.st_Open:=FALSE;
			ton_SensorCheck(IN:=FALSE);
		ELSE;
			ton_SensorCheck(IN:=TRUE);
			IF ton_SensorCheck.Q THEN;
				stPis.st_Close:=FALSE;
				stPis.st_Open:=FALSE;				
				stPis.b_Error:=TRUE;		
			END_IF			
		END_IF
				
	E_Piston_State.Open:;
		IF m_PistonSensorCheck() AND NOT stPis.b_Error THEN;
			stPis.st_Close:=FALSE;
			stPis.st_Open:=TRUE;
			ton_SensorCheck(IN:=FALSE);
		ELSE;			
			ton_SensorCheck(IN:=TRUE);
			IF ton_SensorCheck.Q THEN;
				stPis.st_Close:=FALSE;
				stPis.st_Open:=FALSE;				
				stPis.b_Error:=TRUE;		
			END_IF
		END_IF
	
	E_Piston_State.Busy_Close:;
		ton_SensorCheck(IN:=FALSE);
		act_Close();		
		state_Open:=Ready;		
		IF stPis.st_Close AND NOT stPis.req_Close THEN;
			state:=E_Piston_State.Close;
		END_IF

	E_Piston_State.Busy_Open:;
		ton_SensorCheck(IN:=FALSE);
		act_Open();
		state_Close:=Ready;
		IF stPis.st_Open AND NOT stPis.req_Open THEN;
			state:=E_Piston_State.Open;
		END_IF
END_CASE			

ton_SensorCheck(PT:=T#0.5S);

IF ton_SensorCheck.Q THEN;
	stPis.b_Error:=TRUE;		
END_IF
stPis.b_Resume:=FALSE;

]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_StateDeafult" Id="{b0074a99-883b-4291-9224-694e1dc99e79}">
      <Implementation>
        <ST><![CDATA[CASE DefaultCmd	OF
	E_PistonDefault_CMD.Close:;
		stPis.st_Deafult:=stPis.st_Close;
	E_PistonDefault_CMD.Open:;
		stPis.st_Deafult:=stPis.st_Open;
END_CASE]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_CheckByRecipe" Id="{cee17294-eb51-431c-81b6-223f1165d04f}">
      <Declaration><![CDATA[METHOD PUBLIC m_CheckByRecipe : BOOL
VAR_INPUT
	stPis: ST_Piston;
	req: E_Piston_Recipe_State;	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_CheckByRecipe:=FALSE;
IF stPis.iPisNum <> E_Pis_Name.e0_not_in_use THEN
	CASE req OF
		E_Piston_Recipe_State.NoChanges:;
			m_CheckByRecipe:=TRUE;
		E_Piston_Recipe_State.Act:;
			IF (stPis.DefaultCmd=E_PistonDefault_CMD.Close AND stPis.st_Open) 
			OR (stPis.DefaultCmd=E_PistonDefault_CMD.Open AND stPis.st_Close)
			THEN;
				m_CheckByRecipe:=TRUE;
			END_IF
		E_Piston_Recipe_State.Release:;
			IF (stPis.DefaultCmd=E_PistonDefault_CMD.Close AND stPis.st_Close) 
			OR (stPis.DefaultCmd=E_PistonDefault_CMD.Open AND stPis.st_Open)
			THEN;
				m_CheckByRecipe:=TRUE;
			END_IF	
	END_CASE
ELSE;
	m_CheckByRecipe:=TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Error" Id="{5ea8f179-3e42-48cd-bee3-d65b4870588b}">
      <Declaration><![CDATA[METHOD m_Error : BOOL
VAR_INPUT
END_VAR
VAR
	sActErrorID_AA: STRING;
	sActErrorID: STRING;
	Mess: INT;
	cFound: INT;
	iFound: INT;
	i: INT;
	bWarning: BOOL;

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*
IF SFCError OR bWarning THEN

	IF  SFCErrorStep='WaitSenOpen' THEN
		stPis.eErrNum:=1;
	ELSIF SFCErrorStep='WaitSenNotClose' THEN
		stPis.eErrNum:=2;
	ELSIF SFCErrorStep='WaitSenClose' THEN
		stPis.eErrNum:=3;
	ELSIF SFCErrorStep='WaitSenNotOpen' THEN
		stPis.eErrNum:=4;
	ELSIF SFCErrorStep='No Status' THEN
		stPis.eErrNum:=5;
	ELSIF SFCErrorStep='No Valve Operation' THEN
		stPis.eErrNum:=6;
	ELSIF SFCErrorStep='Not synchronized with cycle command' THEN //SensorsChecking
		stPis.eErrNum:=7;
	ELSIF SFCErrorStep='SensorsChecking' THEN
		stPis.eErrNum:=8;		
	ELSIF bWarning THEN;	// act_Ready
		//stPis.eErrNum:=21; 	// '2AAx021',	'Warning',	', Manual command rejected in semi/auto mode',	(**)
	ELSE
		stPis.eErrNum:=9;
	END_IF
	Last_SFCErrorStep:=SFCErrorStep;
	
ELSE
		stPis.eErrNum:=0;
END_IF
*)
// Temp solution
IF stPis.b_Error THEN;
	stPis.eErrNum:=1;
END_IF

IF stPis.eErrNum<>0 AND NOT bErrorMemo AND stPis.iPisNum<>0 THEN

	IF stPis.iPisNum<10 THEN
		sActErrorID:=CONCAT('20',INT_TO_STRING(stPis.iPisNum));
	ELSE
		sActErrorID:=CONCAT('2',INT_TO_STRING(stPis.iPisNum));
	END_IF
	
	IF stPis.eErrNum<10 THEN
		sActErrorID:=CONCAT(sActErrorID,'x00');
		sActErrorID:=CONCAT(sActErrorID,INT_TO_STRING(stPis.eErrNum));
	ELSE
		sActErrorID:=CONCAT(sActErrorID,'x0');
		sActErrorID:=CONCAT(sActErrorID,INT_TO_STRING(stPis.eErrNum));		
	END_IF

	FOR Mess:=100 TO 2 BY -1 DO
		Buffer_Act_Message[Mess].sDateTime:=Buffer_Act_Message[Mess-1].sDateTime;
		Buffer_Act_Message[Mess].sErrID:=Buffer_Act_Message[Mess-1].sErrID;
		Buffer_Act_Message[Mess].sLevel:=Buffer_Act_Message[Mess-1].sLevel;
		Buffer_Act_Message[Mess].sModuleDescription:=Buffer_Act_Message[Mess-1].sModuleDescription;
		Buffer_Act_Message[Mess].sErrorMessage:=Buffer_Act_Message[Mess-1].sErrorMessage;
	END_FOR
		Buffer_Act_Message[1].sDateTime:=sRealTime;
		Buffer_Act_Message[1].sErrID:=sActErrorID;
		Buffer_Act_Message[1].sLevel:='Error';
		Buffer_Act_Message[1].sModuleDescription:='Pneumatic valve';

		(*888888888888888888888888888888888888888888*)
		IF stPis.eErrNum<10 THEN
			sActErrorID_AA:=CONCAT('2AAx00',INT_TO_STRING(stPis.eErrNum));
		ELSE
			sActErrorID_AA:=CONCAT('2AAx0',INT_TO_STRING(stPis.eErrNum));			
		END_IF
		cFound:=0;
		FOR i:=1 TO C_Max_ErrorList DO
			IF ar_ErrorList[i,eErrID]=sActErrorID_AA THEN
				iFound:=i;
				ar_ErrorActive[iFound]:=TRUE;
				cFound:=cFound+1;
			END_IF
		END_FOR

		Buffer_Act_Message[1].sErrorMessage:=CONCAT( 'Piston Num ', INT_TO_STRING(stPis.iPisNum));
		Buffer_Act_Message[1].sErrorMessage:=CONCAT( Buffer_Act_Message[1].sErrorMessage, ', ');
		//Buffer_Act_Message[1].sErrorMessage:=CONCAT( Buffer_Act_Message[1].sErrorMessage, arPisDescription[stPis.iPisNum]);
		Buffer_Act_Message[1].sErrorMessage:=CONCAT( Buffer_Act_Message[1].sErrorMessage, stPis.sName);
		Buffer_Act_Message[1].sErrorMessage:=CONCAT( Buffer_Act_Message[1].sErrorMessage, ': ');

		IF cFound=1 THEN;
			Buffer_Act_Message[1].sErrorMessage:=CONCAT( Buffer_Act_Message[1].sErrorMessage, ar_ErrorList[iFound,eErrMeassage]);	(*	Error from the List	*)
			Buffer_Act_Message[1].sLevel:= ar_ErrorList[iFound,eErrLevel];	(*	Level from the List	*)
		ELSIF cFound=0 THEN;
			Buffer_Act_Message[1].sErrorMessage:=CONCAT( Buffer_Act_Message[1].sErrorMessage, 'Error ID not found on the "Error_List"');	(*	Error ID not Foud on the List	*)
		ELSIF cFound>1 THEN;
			Buffer_Act_Message[1].sErrorMessage:=CONCAT( Buffer_Act_Message[1].sErrorMessage, 'More then one error with the same ID  found on the "Error_list"');	(*	More then one Errors Foud with the same  ID		*)
		END_IF
		(*888888888888888888888888888888888888888888*)

	FUN_Write_Line_To_History();
	bErrorMemo:=TRUE;
END_IF

(*
'WaitSenOpen'
'WaitSenNotClose'
'WaitSenClose'
'WaitSenNotOpen'
'No Status'
'No Valve Operation'
*)]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PistonSensorCheck" Id="{c8a92531-63c9-446a-a8cf-58db140f8780}">
      <Declaration><![CDATA[METHOD m_PistonSensorCheck : BOOL
(*VAR_INPUT
	exist: BOOL;
	SensorState: BOOL;
	ValveState: BOOL;

END_VAR*)
VAR
	OK_Open: BOOL;
	OK_Close: BOOL;


END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stPis.sen_Close_Exist THEN;
	IF valve_Close = sen_Close THEN;
		OK_Close:=TRUE;
	//ELSIF NOT valve_Close AND NOT sen_Close THEN;
	//	OK_Close:=TRUE;
	ELSE;
		OK_Close:=FALSE;
	END_IF
ELSE
	OK_Close:=TRUE;
END_IF

IF stPis.sen_Open_Exist THEN;
	IF valve_Open = sen_Open THEN;
		OK_Open:=TRUE;	
	//ELSIF NOT valve_Open AND sen_Open THEN;
	//	OK_Open:=TRUE;
	ELSE;
		OK_Open:=FALSE;
	END_IF
ELSE
	OK_Open:=TRUE;
END_IF

IF OK_Close AND OK_Open THEN;
	m_PistonSensorCheck:=TRUE;
ELSE;
	m_PistonSensorCheck:=FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SetByRecipe" Id="{efe06830-a32d-4e0b-8632-3f1d05861d09}">
      <Declaration><![CDATA[METHOD PUBLIC m_SetByRecipe : BOOL
VAR_INPUT
	
	req: E_Piston_Recipe_State;
END_VAR
VAR
	ref_stPis: REFERENCE TO ST_Piston;
END_VAR

VAR_IN_OUT
	stPis: ST_Piston;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stPis.iPisNum <> E_Pis_Name.e0_not_in_use THEN
	//ref_stPis REF= stPis;
	CASE req OF
		E_Piston_Recipe_State.NoChanges:;
			//Done
		E_Piston_Recipe_State.Act:;
			IF stPis.DefaultCmd=E_PistonDefault_CMD.Close THEN;
				IF NOT stPis.st_Open THEN;
					stPis.req_Open:=TRUE;
				END_IF		
			ELSIF stPis.DefaultCmd=E_PistonDefault_CMD.Open THEN;
				IF NOT stPis.st_Close THEN;
					stPis.req_Close:=TRUE;
				END_IF				
			END_IF
	
		E_Piston_Recipe_State.Release:;
			IF stPis.DefaultCmd=E_PistonDefault_CMD.Close THEN;
				IF NOT stPis.st_Close THEN;
					stPis.req_Close:=TRUE;
				END_IF			
			ELSIF stPis.DefaultCmd=E_PistonDefault_CMD.Open THEN;
				IF NOT stPis.st_Open THEN;
					stPis.req_Open:=TRUE;
				END_IF			
			END_IF	
	END_CASE	
END_IF
]]></ST>
      </Implementation>
    </Method>
