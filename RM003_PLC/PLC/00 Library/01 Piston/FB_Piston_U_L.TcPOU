<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_Piston_U_L" Id="{f6df062b-8dd7-4dca-98fe-56ea9e281485}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK PUBLIC FB_Piston_U_L// EXTENDS FB_Piston
VAR_INPUT
	enable: BOOL;
	sen_Upper: BOOL;
	sen_Lower: BOOL;

END_VAR
VAR_OUTPUT
	valve_Upper		:BOOL;
	valve_Lower		:BOOL;	
END_VAR
VAR
	tOn: TIME:=T#1S;
	tOff: TIME:=T#1S;
END_VAR
VAR_IN_OUT
	st_Piston_U_L	:	ST_Piston_U_L	;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[act_Get_Reference();
act_SetOutputs();

]]></ST>
    </Implementation>
    <Action Name="act_Get_Reference" Id="{60607663-ce4f-44c4-8288-4340f34ed98c}">
      <Implementation>
        <ST><![CDATA[//st_Piston_U_L.str_Piston REF= g_Piston.stPis[iFB_Num];]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_SetOutputs" Id="{fe9d830e-c8cb-470f-9da2-a61c532c4f0f}">
      <Implementation>
        <ST><![CDATA[IF enable THEN;
	IF st_Piston_U_L.req_Upper THEN;
		valve_Upper:=TRUE;
		valve_Lower:=FALSE;		
	ELSIF st_Piston_U_L.req_Lower THEN;
		valve_Upper:=FALSE;
		valve_Lower:=TRUE;		
	ELSE;
		valve_Upper:=FALSE;
		valve_Lower:=FALSE;		
	END_IF
ELSE;
	valve_Upper:=FALSE;
	valve_Lower:=FALSE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <LineIds Name="FB_Piston_U_L">
      <LineId Id="9" Count="0" />
      <LineId Id="16" Count="0" />
