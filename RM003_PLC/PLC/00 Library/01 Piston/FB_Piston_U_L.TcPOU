<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_Piston_U_L" Id="{f6df062b-8dd7-4dca-98fe-56ea9e281485}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK PUBLIC FB_Piston_U_L// EXTENDS FB_Piston
VAR_INPUT
	enable		: BOOL	;
	sen_Upper	: BOOL	;
	sen_Lower	: BOOL	;

END_VAR
VAR_OUTPUT
	valve_Upper		:BOOL;
	valve_Lower		:BOOL;	
END_VAR
VAR
	tOn: TIME:=T#1S;
	tOff: TIME:=T#1S;
	Call_RTrig_ReqUp: R_TRIG;
	Call_RTrig_ReqLow: R_TRIG;
	
	b_Memo_ReqUp	:	BOOL	;
	b_Memo_ReqLow	:	BOOL	;
	Call_FTrig_Error: 	F_TRIG	;
	stPis			:	REFERENCE TO ST_Piston;
END_VAR
VAR_IN_OUT
	st_Piston_U_L	:	ST_Piston_U_L	;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[act_Get_Reference();
act_SetOutputs();

]]></ST>
    </Implementation>
    <Action Name="act_Get_Reference" Id="{60607663-ce4f-44c4-8288-4340f34ed98c}">
      <Implementation>
        <ST><![CDATA[//st_Piston_U_L.str_Piston REF= g_Piston.stPis[iFB_Num];
stPis REF= g_Piston.stPis[st_Piston_U_L.iFB_Num];]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_SetOutputs" Id="{fe9d830e-c8cb-470f-9da2-a61c532c4f0f}">
      <Implementation>
        <ST><![CDATA[(*IF st_Piston_U_L.bError THEN
	IF st_Piston_U_L.req_Upper THEN
		b_Memo_ReqUp:=TRUE;
	END_IF
	IF st_Piston_U_L.req_Lower THEN
		b_Memo_ReqLow:=TRUE;
	END_IF
	st_Piston_U_L.req_Upper:=FALSE;
	st_Piston_U_L.req_Lower:=FALSE;
END_IF*)

(*
Call_FTrig_Error(CLK:=st_Piston_U_L.bError , Q=> );

IF Call_FTrig_Error.Q THEN
	st_Piston_U_L.req_Upper:=b_Memo_ReqUp;
	st_Piston_U_L.req_Lower:=b_Memo_ReqLow;
	b_Memo_ReqUp:=FALSE;
	b_Memo_ReqLow:=FALSE;
END_IF*)

//Resseting opposite signal
//***************************************************************
Call_RTrig_ReqUp(CLK:=st_Piston_U_L.req_Upper , Q=> );
Call_RTrig_ReqLow(CLK:=st_Piston_U_L.req_Lower, Q=> );
IF Call_RTrig_ReqUp.Q THEN
	st_Piston_U_L.req_Lower:=FALSE;
END_IF

IF Call_RTrig_ReqLow.Q THEN
	st_Piston_U_L.req_Upper :=FALSE;
END_IF
//***************************************************************

IF enable AND stPis.st_Close THEN;
	st_Piston_U_L.exist:=TRUE;
	
	IF st_Piston_U_L.req_Upper THEN;
		valve_Upper:=TRUE;
		valve_Lower:=FALSE;		
	ELSIF st_Piston_U_L.req_Lower THEN;
		valve_Upper:=FALSE;
		valve_Lower:=TRUE;		
	ELSE;
		valve_Upper:=FALSE;
		valve_Lower:=FALSE;		
	END_IF
ELSE;
	st_Piston_U_L.exist:=FALSE;
	st_Piston_U_L.req_Upper:=FALSE;
	st_Piston_U_L.req_Lower:=FALSE;
	valve_Upper:=FALSE;
	valve_Lower:=FALSE;
END_IF

//outputs for hmi
st_Piston_U_L.out_Upper:=valve_Upper;
st_Piston_U_L.out_Lower:=valve_Lower;

//Status
st_Piston_U_L.st_Upper:=sen_Upper;
st_Piston_U_L.st_Lower:=sen_Lower;]]></ST>
      </Implementation>
    </Action>
