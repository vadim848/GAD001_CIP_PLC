END_VAR
VAR_OUTPUT
	sMessage: STRING;
END_VAR

VAR
	ErrID_xx: STRING(2);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bError 
AND error_code=''
THEN;
	fbFormat(sFormat:='%0.2d' ,arg1:=F_INT(stDevErr_H.iObjectID),sOut=>ErrID_xx);
	m_GetPistonErr:=CONCAT('22',ErrID_xx);
	sMessage:=stDevErr_H.sObjectName;
ELSE;
	m_GetPistonErr:='';
END_IF

]]></ST>
      </Implementation>
    </Method>
