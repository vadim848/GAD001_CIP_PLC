<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FUN_DeltaTime" Id="{19dfcdb4-a7ed-444c-b091-1a826063d65f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION FUN_DeltaTime : STRING
VAR_INPUT
    //stSystemTime : TimeStruct;
    stStartTime  : TimeStruct;	
END_VAR
VAR
    dtSystemTime : DT;
    dtStartTime  : DT;
    deltaTime    : TIME;
    hours        : INT;
    minutes      : INT;
    milliseconds : INT;
    sDeltaTime   : STRING;	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Convert TimeStruct to DT
dtSystemTime := SYSTEMTIME_TO_DT(stSystemTime);
dtStartTime  := SYSTEMTIME_TO_DT(stStartTime);

// Calculate the delta time
deltaTime := TO_TIME(dtSystemTime - dtStartTime);

// Extract hours, minutes, and milliseconds
hours := INT_TO_DINT(deltaTime / T#1H);
minutes := INT_TO_DINT((deltaTime MOD T#1H) / T#1M);
milliseconds := INT_TO_DINT((deltaTime MOD T#1M) / T#1MS);

// Format the string
sDeltaTime := CONCAT(CONCAT(CONCAT(CONCAT(INT_TO_STRING(hours), ':'), INT_TO_STRING(minutes)), ':'), INT_TO_STRING(milliseconds));

FUN_DeltaTime := sDeltaTime;]]></ST>
    </Implementation>
    <LineIds Name="FUN_DeltaTime">
      <LineId Id="17" Count="14" />
      <LineId Id="7" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>