<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_SFC_Cycle" Id="{2eff1a57-7803-4790-acb1-7416be6b3b39}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_SFC_Cycle
VAR_INPUT

END_VAR
VAR_OUTPUT
END_VAR
VAR
	refSFC: ST_SFC;

	bInit: BOOL;
	bResetCycle: BOOL;
	bResume: BOOL;
	bRun: BOOL;	
	bReady: BOOL;
	bDone: BOOL;
	bToBe_Done: BOOL;
	
	bStepMode: BOOL;
	bNextStep: BOOL;



	bStepDone: BOOL;
	ton_StepTime: TON;
	
	StageDelayByRecipe: TIME;
	
	//fbPis_Meth: FB_Piston;

	rtDone	: R_TRIG;
	rtRun	: R_TRIG;
	sLastStepBefore_Error	: STRING;
	sError_Message			: STRING;
	
	ErrorSFC: BOOL;

	tonResetCycle: TON;
	
	stMode_zone	: REFERENCE TO ST_Mode;
	stOper_zone	: REFERENCE TO ST_OperationButtons;
	ftStateSafe : F_TRIG;
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[

]]></ST>
    </Implementation>
    <Method Name="m_Reset_LastStepBeforeError" Id="{08ed94ea-c672-4a0e-a98f-d600bcddb817}">
      <Declaration><![CDATA[METHOD m_Reset_LastStepBeforeError : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[sLastStepBefore_Error:='';]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Set_LastStepBeforeError" Id="{0aa82dbd-a40e-4fb4-91cf-69d200d152ef}">
      <Declaration><![CDATA[METHOD m_Set_LastStepBeforeError : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[sLastStepBefore_Error:=refSFC.SFCCurrentStep;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Set_Mode_Reference" Id="{8c28502d-c713-429a-acdc-275818e4ceaf}">
      <Declaration><![CDATA[METHOD m_Set_Mode_Reference : BOOL
VAR_INPUT
	inMoedeZone: E_ModeZone;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stMode_zone REF=(stMode[inMoedeZone]);
stOper_zone REF=(stOper[inMoedeZone]);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_SFC_Handle" Id="{46532f38-5120-4137-ac00-dcc259f13a38}">
      <Declaration><![CDATA[METHOD m_SFC_Handle : BOOL
VAR_INPUT
END_VAR

VAR
	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(refSFC.SFCInit) 
OR NOT  __ISVALIDREF(refSFC.SFCReset) 
OR NOT  __ISVALIDREF(refSFC.SFCError) 
OR NOT  __ISVALIDREF(refSFC.SFCEnableLimit) 
OR NOT  __ISVALIDREF(refSFC.SFCErrorStep) 
OR NOT  __ISVALIDREF(refSFC.SFCErrorPOU) 
OR NOT  __ISVALIDREF(refSFC.SFCQuitError) 
OR NOT  __ISVALIDREF(refSFC.SFCPause) 
OR NOT  __ISVALIDREF(refSFC.SFCTrans) 
OR NOT  __ISVALIDREF(refSFC.SFCCurrentStep) 
OR NOT  __ISVALIDREF(refSFC.SFCTip) 
OR NOT  __ISVALIDREF(refSFC.SFCTipMode) 
THEN;
	RETURN;
END_IF

refSFC.SFCEnableLimit:=TRUE;
IF refSFC.SFCTrans THEN;
	bStepDone:=FALSE;
	ton_StepTime(IN:=FALSE);
ELSE;
	ton_StepTime(IN:=TRUE); //depend on step condition
END_IF

IF bInit THEN;
	refSFC.SFCInit:=TRUE;
ELSE;
	refSFC.SFCInit:=FALSE;
END_IF

IF refSFC.SFCError THEN;
	refSFC.SFCPause:=TRUE;
	ErrorSFC:=TRUE;
	m_Set_LastStepBeforeError();
END_IF

IF refSFC.SFCQuitError THEN;
	refSFC.SFCPause:=FALSE;
	ErrorSFC:=FALSE;
	refSFC.SFCQuitError:=FALSE;
	m_Reset_LastStepBeforeError();
	sError_Message:='';
END_IF

IF refSFC.SFCCurrentStep='Ready' THEN;
	bReady:=TRUE;
ELSE;
	bReady:=FALSE;
END_IF

rtDone(CLK:=refSFC.SFCCurrentStep='Done');
IF rtDone.Q THEN;
	bDone:=TRUE;
END_IF
rtRun(CLK:=bRun);
IF rtRun.Q THEN;
	bDone:=FALSE;
END_IF

IF bResume THEN;
	ErrorSFC:=FALSE;
	refSFC.SFCError:=FALSE;
	refSFC.SFCPause:=FALSE;
	m_Reset_LastStepBeforeError();
	bResume:=FALSE;
END_IF

IF NOT __ISVALIDREF(stMode_zone)
OR NOT __ISVALIDREF(stOper_zone)
THEN;
	RETURN;
ELSE;
	//IF prg_Safety.ftStateSafe.Q THEN;
	ftStateSafe(CLK:=stMode_zone.bStateSafe_mode);
	IF ftStateSafe.Q THEN;
		bResetCycle:=TRUE;
	END_IF	
END_IF
 

tonResetCycle(PT:=T#0.5S,IN:=bResetCycle);
IF bResetCycle THEN;
	refSFC.SFCReset:=TRUE;
	//tonResetCycle.IN:=TRUE;
END_IF
IF tonResetCycle.Q THEN;
	bResetCycle:=FALSE;
	refSFC.SFCReset:=FALSE;
END_IF

StepByStep();





(*
rtDone(CLK:=bDone);
IF rtDone.Q THEN
	bToBe_Done:=FALSE;
END_IF
*)]]></ST>
      </Implementation>
    </Method>
    <Method Name="mInit" Id="{db3a03fd-4aa8-4d31-895a-70e5974a7367}">
      <Declaration><![CDATA[METHOD mInit : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bInit:=TRUE;
bToBe_Done:=FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="mResetCycle" Id="{8464e014-3756-439a-b3ea-3ecdaaeb39fa}">
      <Declaration><![CDATA[METHOD mResetCycle : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bResetCycle:=TRUE;
bRun:=FALSE;
refSFC.SFCReset:=TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="mRun" Id="{0552b8ba-1fe7-4c0f-8dc3-c440bb8dda21}">
      <Declaration><![CDATA[METHOD mRun : BOOL
VAR_INPUT
	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRun:=TRUE;
bDone:=FALSE;

IF rtDone.Q THEN;
	mRun:=TRUE;	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="mToBe_Done" Id="{eb188846-1ae0-496f-bc27-e382d11bf47b}">
      <Declaration><![CDATA[METHOD mToBe_Done : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bToBe_Done:=TRUE;
bDone:=FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="StepByStep" Id="{530b4b0f-9753-4875-9dbf-b777c30197f1}">
      <Declaration><![CDATA[METHOD StepByStep : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[

IF bStepMode THEN;
	IF refSFC.SFCTrans THEN;
		refSFC.SFCTipMode:=TRUE;
		bNextStep:=FALSE;
	END_IF
	IF bNextStep THEN;
		refSFC.SFCTipMode:=FALSE;
	END_IF
ELSE;
	refSFC.SFCTipMode:=FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
