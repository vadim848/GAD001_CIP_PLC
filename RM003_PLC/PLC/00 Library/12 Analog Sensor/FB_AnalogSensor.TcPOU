<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_AnalogSensor" Id="{4149a809-7c27-49b8-ae2f-6ef38e3fd813}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_AnalogSensor
VAR_INPUT
	nSensorID	: 	E_ASense_Name	;
	nRawSensor	:	REAL				;
	arReset_AlrmWrn		:	ARRAY [0..3] OF BOOL		;//HH Alarm/LL Alarm/HH Warning/LL Warning
END_VAR
VAR_OUTPUT
	bLL_Alarm	:	BOOL	;
	bHH_Alarm	:	BOOL	;
	bLL_Warning	:	BOOL	;
	bHH_Warning	:	BOOL	;
END_VAR
VAR
	sName: STRING(12);

	stASens			:	REFERENCE TO ST_AnalogSensor	;
	state			: 	E_ASensor_State					;
	
	fbScaleFactor	: 	FB_ScaleFactor					;
	
	nTicks			:	INT:=0	;
	nI				:	INT		;
	
	bTestTemp		:	BOOL	;
	
	nTimeInCycles	:	INT:=100; //1 sec while cycletime is 10 ms
	nBufferSize_S	:	INT:=1	;//Buffer size in seconds
	nCycleTime_MS	:	INT:=10;//Cycle time in mili seconds
	
	
	//From Structure
	// Callibration 
	rawVal_Actual	: INT;//fb
	
	//MA
	arrRawVal_Actual	:	ARRAY [0..10000] OF INT	;//get out fb
	rTempRawVal			:	REAL	;//fb
	nRawSumm			:	DINT	;//fb
	
	bCopyRawTo_Min	: BOOL;//fb
	bCopyRawTo_Max	: BOOL;//fb
	
	//triggers
	arRS		:	ARRAY [0..3] OF RS		;//HH Alarm/LL Alarm/HH Warning/LL Warning
	
	ton_set_DATA: TON;
	rt_set_DATE: R_TRIG;
	fbScale: REFERENCE TO FB_ScaleFactor;
	fbMovingAverage: FB_MovingAverage;

	bSetFromTempCallibration: BOOL;
	bTypeTankConus: BOOL:=FALSE;
	rawTest: REAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[nTimeInCycles:=TO_INT(nBufferSize_S*1000/nCycleTime_MS);
act_Get_Reference();
act_MA();
act_SetValues();
sName:=TO_STRING(nSensorID);]]></ST>
    </Implementation>
    <Action Name="act_AlarmWarnings" Id="{94bc8425-4f7d-409b-a6cf-b4ccd61c6a97}">
      <Implementation>
        <ST><![CDATA[//arRS		:	ARRAY [0..3] OF RS		;//HH Alarm/LL Alarm/HH Warning/LL Warning

arRS[0](SET:=(stASens.Value>= stASens.rHH_Alarm AND NOT bHH_Alarm) , RESET1:=arReset_AlrmWrn[0] , Q1=>bHH_Alarm );
arRS[1](SET:=(stASens.Value<= stASens.rLL_Alarm AND NOT bLL_Alarm) , RESET1:=arReset_AlrmWrn[1] , Q1=>bLL_Alarm );
arRS[2](SET:=(stASens.Value>= stASens.rHH_Warning AND stASens.Value<stASens.rHH_Alarm AND NOT bHH_Warning) , RESET1:=arReset_AlrmWrn[2] , Q1=>bHH_Warning );
arRS[3](SET:=(stASens.Value<= stASens.rLL_Warning AND stASens.Value>stASens.rLL_Alarm AND NOT bLL_Warning) , RESET1:=arReset_AlrmWrn[3] , Q1=>bLL_Warning );]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_Get_Reference" Id="{3b9743a6-e63a-4bc1-886c-5921c522c277}">
      <Implementation>
        <ST><![CDATA[stASens REF=g_AnalogSensor.stAnalogSensor[nSensorID];

stASens.ID:=TO_STRING(nSensorID);

//!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
//stASens.rawVal_Actual:=g_AnalogSensor.arAnalogSensorRawValue[nSensorID];
//stASens.rawVal_Actual:=nRawSensor;

//rTempRawVal:=rawTest;
CASE nSensorID OF 
	E_ASense_Name.LT3001,E_ASense_Name.LT3002,E_ASense_Name.LT4001,E_ASense_Name.LT4002:;
		bTypeTankConus:=TRUE;
ELSE;
		bTypeTankConus:=FALSE;
END_CASE
IF bTypeTankConus 
AND rTempRawVal<=stASens.rawVal_Min
THEN;
	stASens.Value:=mConus(rawValue:=rTempRawVal,baseIncriments:=stASens.rawVal_Min);
ELSE;
	fbScaleFactor(
		rVal:=rTempRawVal,//stASens.rawVal_Actual , 
		rInValHigh:=stASens.rawVal_Max , 
		rInValLow:=stASens.rawVal_Min , 
		rOutValHigh:=stASens.outVal_Max , 
		rOutValLow:=stASens.outVal_Min ,
		rOutOffset:=stASens.outOffset , 
		rValOut=>stASens.Value , 
		diValOut=>, 
		iValOut=> );	
END_IF

	
	
	
ton_set_DATA(PT:=T#20S, IN:=TRUE);
rt_set_DATE(CLK:=ton_set_DATA.Q);
IF rt_set_DATE.Q AND bSetFromTempCallibration THEN;
	set_Data(ID_reference:=nSensorID);
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_MA" Id="{69960e6b-ad08-4ee1-9b6e-f116cc833ecb}">
      <Implementation>
        <ST><![CDATA[IF nTicks<nTimeInCycles THEN
	nTicks:=nTicks+1;
ELSIF nTicks>nTimeInCycles THEN
	nTicks:=nTimeInCycles;
END_IF

//moving ticks
nRawSumm:=0;
FOR nI:=nTimeInCycles TO 1 BY -1 DO
	arrRawVal_Actual[nI]:=arrRawVal_Actual[nI-1];
	//calculating summ
	nRawSumm:=nRawSumm+arrRawVal_Actual[nI];
END_FOR

arrRawVal_Actual[0]:=TO_INT(nRawSensor);
nRawSumm:=nRawSumm+arrRawVal_Actual[0];

rTempRawVal:=TO_REAL(nRawSumm/nTicks);


//fbMovingAverage(Value:=nRawSensor);
//rTempRawVal:=fbMovingAverage.Average;]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_SetValues" Id="{50799016-694b-4fa3-95e7-b80421febf4b}">
      <Implementation>
        <ST><![CDATA[meth_SetRawValue(bSetValue:=bCopyRawTo_Max , nValToSet:=stASens.rawVal_Max , nRawValue:=rawVal_Actual );
meth_SetRawValue(bSetValue:=bCopyRawTo_Min , nValToSet:=stASens.rawVal_Min , nRawValue:=rawVal_Actual );]]></ST>
      </Implementation>
    </Action>
    <Method Name="mConus" Id="{2dd1b0c0-6a3e-4030-88db-ac0921aee314}">
      <Declaration><![CDATA[METHOD mConus : REAL
VAR_INPUT
	rawValue: REAL;
	baseIncriments: REAL;
END_VAR



VAR
	hFactor: REAL;
	baseIncriment: REAL := 1050;
	h: REAL := 140;
	ConusConstant: REAL := 0.00000002165;
	pi: REAL:=3.1415926535;
	k: REAL:=3000000; // convert mm^3 to liters


	radius: REAL := 525;
	vConus: REAL;
END_VAR

VAR
	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[

//hFactor:=baseIncriment*h;

vConus:=pi*radius*radius*h/k;
IF baseIncriments=0 THEN;
	RETURN;
END_IF
ConusConstant:=vConus/(baseIncriments * baseIncriments * baseIncriments);
mConus:=ConusConstant*rawValue*rawValue*rawValue;]]></ST>
      </Implementation>
    </Method>
    <Method Name="meth_SetRawValue" Id="{9a7a01d2-f381-460b-bac2-ead7a5008be7}">
      <Declaration><![CDATA[METHOD INTERNAL meth_SetRawValue : BOOL
VAR_IN_OUT
	bSetValue	:	BOOL	;
	nValToSet	:	REAL	;
END_VAR
VAR_INPUT
	nRawValue	:	REAL		;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bSetValue THEN
	nValToSet:=nRawValue;
	bSetValue:=FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="mSetAsConus" Id="{3eaee7e9-c949-49cf-939c-9e8a87c08ffc}">
      <Declaration><![CDATA[METHOD mSetAsConus : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bTypeTankConus:=TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="set_Data" Id="{ce08728b-f0bd-4a94-ae65-6b0253b241c9}">
      <Declaration><![CDATA[METHOD set_Data : BOOL
VAR_INPUT
	ID_reference: E_ASense_Name;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbScale REF= gIO.fbScaleFactor[ID_reference];
IF NOT __ISVALIDREF(fbScale) THEN;
	RETURN;
END_IF
	


stASens.rawVal_Max:=fbScale.rInValHigh;
stASens.rawVal_Min:=fbScale.rInValLow;
stASens.outVal_Max:=fbScale.rOutValHigh;
stASens.outVal_Min:=fbScale.rOutValLow;
stASens.outOffset:=fbScale.rOutOffset;
]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_AnalogSensor">
