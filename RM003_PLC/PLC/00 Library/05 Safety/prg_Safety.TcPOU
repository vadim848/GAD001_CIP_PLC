<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="prg_Safety" Id="{db89eb8b-da04-4986-84d3-a7f6079fbab6}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM prg_Safety
VAR
	(*
	rt_TSafe_OK: R_TRIG;
	rt_TSafe_Err: R_TRIG;
	ton_TSafe_OK: TON;
	ton_TSafe_Err_Reset_ON: TON;
	ton_TSafe_Err_Reset_OFF: TON;
	*)
	fbTwinSAFE: ARRAY[1..1] OF FB_TwinSAFE;
	
	HMI_ES1_Restart: BOOL;
	HMI_ES2_Restart: BOOL;
	HMI_ES3_Restart: BOOL;
	HMI_ES4_Restart: BOOL;
	
	rtStateSafe: R_TRIG;
	ftStateSafe: F_TRIG;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[act_Call_TSs();
bStateSafe_ES1:=arSafe[1].stSafetyIn.ES1_State;
bStateSafe_ES2:=arSafe[1].stSafetyIn.ES2_State;
bStateSafe_ES3:=arSafe[1].stSafetyIn.ES3_State;
bStateSafe_ES4:=arSafe[1].stSafetyIn.ES4_State;

IF TRUE 
AND bStateSafe_ES1
AND bStateSafe_ES2
AND bStateSafe_ES3
AND bStateSafe_ES4
THEN;
	bStateSafe:=TRUE;
ELSE;
	bStateSafe:=FALSE;
END_IF
rtStateSafe(CLK:=bStateSafe);
ftStateSafe(CLK:=bStateSafe);

(*
ton_TSafe_OK(IN:=g_IO.TSafeIn.InRun AND NOT g_IO.TSafeIn.COM_Err, PT:=T#1S );
IF ton_TSafe_OK.Q THEN;
	bStateSafe:=TRUE;
ELSE;
	bStateSafe:=FALSE;	
END_IF
rt_TSafe_OK(CLK:=ton_TSafe_OK.Q );
IF rt_TSafe_OK.Q THEN;
	m_Print_Success_Message();
END_IF



rt_TSafe_Err(CLK:=g_IO.TSafeIn.COM_Err);
IF rt_TSafe_Err.Q THEN;
	m_Print_Error_Message();
END_IF

ton_TSafe_Err_Reset_ON(IN:=g_IO.TSafeIn.COM_Err AND NOT g_IO.TSafeOut.ErrACK, PT:=T#2S );
IF ton_TSafe_Err_Reset_ON.Q THEN;
	g_IO.TSafeOut.ErrACK:=TRUE;
END_IF

ton_TSafe_Err_Reset_OFF(IN:=g_IO.TSafeOut.ErrACK, PT:=T#1S );
IF ton_TSafe_Err_Reset_OFF.Q THEN;
	g_IO.TSafeOut.ErrACK:=FALSE;
END_IF
*)

]]></ST>
    </Implementation>
