<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_MovingAverage" Id="{97bcb5b3-e753-484c-adf8-776df189045e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MovingAverage
VAR_INPUT
	Value: REAL;
END_VAR
VAR_OUTPUT
	Average: REAL;

END_VAR
VAR
	arr: ARRAY[1..cMaxBufer] OF REAL;

	Sum: REAL;
	i: INT;
END_VAR
VAR CONSTANT
	cMaxBufer: INT:=500; // 10msec * 500 = 5 sec

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Sum:=0;
FOR	i:=1 TO cMaxBufer DO
	Sum:=Sum+arr[i];
END_FOR


Average:=Sum/cMaxBufer;
FOR i:=cMaxBufer TO 2 BY-1 DO
	arr[i]:=arr[i-1];
END_FOR
arr[1]:=Value;]]></ST>
    </Implementation>
    <LineIds Name="FB_MovingAverage">
      <LineId Id="29" Count="0" />
      <LineId Id="20" Count="0" />
      <LineId Id="22" Count="1" />
      <LineId Id="26" Count="2" />
      <LineId Id="31" Count="1" />
      <LineId Id="30" Count="0" />
      <LineId Id="33" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>