<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_Operation" Id="{9990a2bc-e9a5-4153-a5b7-bae03643ac6d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Operation
VAR_INPUT
	bStateSafe: BOOL:=TRUE;
END_VAR
VAR
	r1: R_TRIG;
	r2: R_TRIG;
	arPauseHistory: ARRAY[0..9] OF INT;
	ton_StopResetAllTime: TON;
	ton_PauseDelay: TON;
END_VAR
VAR_IN_OUT
	stOper	:ST_OperationButtons;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[r1(CLK:=stOper.bSetPlay,Q=>stOper.b_rt_Play );
IF  r1.Q THEN
	stOper.iActOperation:=E_OperationButtons.ePlayAll;
	stOper.bSetPause:=FALSE;
	stOper.bSetPlay:=FALSE;
END_IF

IF stOper.bSetPlay OR stOper.iActOperation=E_OperationButtons.ePlayAll THEN;
	stOper.bSetPlay:=FALSE;
END_IF

r2(CLK:= stOper.bSetPause, Q=>stOper.b_rt_Pause );
IF r2.Q THEN
	stOper.iActOperation:=E_OperationButtons.ePauseAll;
	stOper.bSetPause:=FALSE;
	stOper.bSetPlay:=FALSE;
	m_WritePauseHystory(iVar:=stOper.iPauseHistory);
END_IF

IF stOper.bSetPause OR stOper.iActOperation=E_OperationButtons.ePauseAll THEN;
	stOper.bSetPause:=FALSE;
END_IF

ton_StopResetAllTime(PT:=T#0.5S);
IF stOper.bStopResetAll OR NOT bStateSafe THEN;
	ton_StopResetAllTime.IN:=TRUE;
	stOper.bStopResetAll:=TRUE;
	IF ton_StopResetAllTime.Q THEN;
		ton_StopResetAllTime.IN:=FALSE;
		stOper.bStopResetAll:=FALSE;
	END_IF
END_IF

ton_PauseDelay(PT:=T#2S,
IN:=stOper.iActOperation=E_OperationButtons.ePauseAll,
Q=>stOper.bPauseOnDelayed
);




]]></ST>
    </Implementation>
    <Method Name="m_WritePauseHystory" Id="{75b78231-e980-4b10-afbb-1e1080d68899}">
      <Declaration><![CDATA[METHOD m_WritePauseHystory : BOOL
VAR_IN_OUT
	iVar: INT;

END_VAR
VAR
	i: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i:=9 TO 1 BY -1 DO;
	arPauseHistory[i]:=arPauseHistory[i-1];
END_FOR
arPauseHistory[0]:=iVar;
iVar:=0;]]></ST>
      </Implementation>
    </Method>
