<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="StatusWordStruct" Id="{dd134d33-bf42-4597-8f38-d7a73a0d1ac5}">
    <Declaration><![CDATA[TYPE StatusWordStruct :
STRUCT
    ReadyToSwitchOn       : BOOL;  // Bit 0
    SwitchedOn            : BOOL;  // Bit 1
    OperationEnabled      : BOOL;  // Bit 2
    Fault                 : BOOL;  // Bit 3
    VoltageEnabled        : BOOL;  // Bit 4
    QuickStop             : BOOL;  // Bit 5
    SwitchOnDisabled      : BOOL;  // Bit 6
    Warning               : BOOL;  // Bit 7
    Remote                : BOOL;  // Bit 8
    Reserved1             : BOOL;  // Bit 9
    Reserved2             : BOOL;  // Bit 10
    Reserved3             : BOOL;  // Bit 11
    Reserved4             : BOOL;  // Bit 12
    Reserved5             : BOOL;  // Bit 13
    Reserved6             : BOOL;  // Bit 14
    Reserved7             : BOOL;  // Bit 15	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>