    <Method Name="m_RunVolume" Id="{0d856e46-de18-4a27-9bfe-92513e0d3ab8}" FolderPath="manage\">
      <Declaration><![CDATA[METHOD m_RunVolume : BOOL
VAR_INPUT
	Volume	:REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fReqVolume:=Volume;
mRun();
IF rtDone.Q THEN;
	m_RunVolume:=TRUE;	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Set_SFCFlags_Reference" Id="{b86dd4e2-3c28-4c4e-ac24-8fad9b06dbde}" FolderPath="manage\">
      <Declaration><![CDATA[METHOD m_Set_SFCFlags_Reference : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Set reference to SFC flags

refSFC.SFCInit REF= SFCInit;
refSFC.SFCReset REF= SFCReset;
refSFC.SFCError REF= SFCError;
refSFC.SFCEnableLimit REF= SFCEnableLimit;
refSFC.SFCErrorStep REF= SFCErrorStep;
refSFC.SFCErrorPOU REF= SFCErrorPOU;
refSFC.SFCQuitError REF= SFCQuitError;
refSFC.SFCPause REF= SFCPause;
refSFC.SFCTrans REF= SFCTrans;
refSFC.SFCCurrentStep REF= SFCCurrentStep;
refSFC.SFCTip REF= SFCTip;
refSFC.SFCTipMode REF= SFCTipMode;

// Cycle handle for SFC
m_SFC_Handle();]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Stop" Id="{a4b5a574-39b4-41ee-a2fd-a4f071a60b58}" FolderPath="manage\">
      <Declaration><![CDATA[METHOD m_Stop : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SFCReset:=TRUE;]]></ST>
      </Implementation>
    </Method>
