<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_DosingPump" Id="{7c08c2ba-d9cf-4bfb-abfd-8e2c5a78618b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_DosingPump EXTENDS FB_SFC_Cycle
VAR_INPUT
END_VAR
VAR_OUTPUT
	valve_A			: BOOL;
	valve_B			: BOOL;
END_VAR
VAR

	action_Time		: TIME:=T#0.5S;
	startDelay		: TIME:=T#0S;
	
	reqTiks			: DINT:=5;
	actTiks			: DINT:=5;
	
	fStageVolume	: REAL:=65; 	// CC/stage
	fReqVolume		: REAL:=500.0; 	// CC
	fActVolume		: REAL; 		// CC


END_VAR

VAR PERSISTENT
	
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[act_GetReference();

act_Oper();

reqTiks:=TRUNC(fReqVolume/fStageVolume);
fActVolume:=(actTiks*fStageVolume);]]></ST>
    </Implementation>
    <Folder Name="manage" Id="{f3c1175b-51b4-45b8-98a1-aa077b9febe6}" />
    <Action Name="_acheck_Count_active" Id="{5ea15c14-afbb-4ed1-bc8c-231ae33b3975}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF actTiks>=reqTiks THEN;
	bStepDone:=TRUE;
END_IF]]></ST>
      </Implementation>
