<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <DUT Name="E_Anybus_Request" Id="{450b763d-3382-4897-9a15-641e76c88bc9}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'to_string'}
TYPE E_Anybus_Request :
(
	eNone		:= 0,	// ON=0, OFF=0: before start - idle, during CIP - pause
	eOn			:= 1,	// ON=1, OFF=0: run
	eOff		:= 2,	// ON=0, OFF=1: full stop
	eConflict	:= 3	// ON=1, OFF=1: not defined, treated as stop
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
