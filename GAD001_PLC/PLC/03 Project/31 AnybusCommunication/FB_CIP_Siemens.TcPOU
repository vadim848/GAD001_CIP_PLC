<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="FB_CIP_Siemens" Id="{7d3e91a2-4c56-4b18-8f27-2a6c0e5d1b01}" SpecialFunc="None">
    <Declaration><![CDATA[//Siemens order -> FB_CIP through its existing request buffer, CIP state -> Siemens status.
//Outside the CIP cycle, FB_CIP is not changed. Called in MAIN before act_Call_CIP while g_Anybus.bBridgeEnable.
//One Siemens order at a time: a new one is taken only when the buffer is free (decision B, 02.11.2026).
//Preparing solutions by NEXT (Vadim 02.11.2026, item 8): a local request of FB_CIP, READY = solutions ready.
//Open points are the agent's proposals, see work/vladimir/next_preparation_design.md. Not here yet: flow rate.
//Reaction to ALARM (pause) is temporary, to be confirmed by GAD.
FUNCTION_BLOCK FB_CIP_Siemens
VAR_INPUT
	bWaterOnly		: BOOL;					//commissioning: any order runs as R_Water, no preparation
	bPrepOff		: BOOL := TRUE;			//no preparation by NEXT, READY as soon as CIP is free. TRUE until Vadim decides which chemistry is allowed
	tPrepHold		: TIME := T#30M;		//READY held without circulation, then the preparation is refreshed
	tPrepRetry		: TIME := T#1M;			//new attempt after a preparation that did not reach Done
END_VAR
VAR_OUTPUT
	stStatus		: ST_Anybus_Outputs;	//to g_Anybus.fbAnybus.stStatus
	bActive			: BOOL;					//wash of a Siemens order is in progress
	bFinished		: BOOL;					//wash done, FINISH is held until REQUEST OFF
	bRejected		: BOOL;					//last REQUEST ON was not accepted
	nPrep			: INT;					//preparation state, cnPrep...
	nPrepClient		: INT;					//NEXT CLIENT the solutions are prepared for, 0 = none
	ePrepRecipe		: E_Anybus_RecipeType;	//NEXT RECIPE the solutions are prepared for
END_VAR
VAR
	stReq			: ST_CIP_Request;
	eRecipe			: E_Anybus_RecipeType;
	stBlank			: ST_CIP_Request;
	bTaken			: BOOL;					//our order has reached slot 0 of the buffer
	bStopping		: BOOL;					//cycle reset is running: mRun now would be lost and the order would hang
	tonStopping		: TON;
	bBufferFree		: BOOL;
	bPauseReq		: BOOL;
	bSprinklerReq	: BOOL;
	rtStart			: R_TRIG;				//REQUEST ON while Siemens READY and CIP READY
	tonReadyLost	: TON;					//Siemens READY lost during the wash
	rtPause			: R_TRIG;
	ftPause			: F_TRIG;
	nStage			: INT;
	//Preparation by NEXT
	stPrepReq		: ST_CIP_Request;
	bPrepTaken		: BOOL;					//our local request has reached slot 0 of the buffer
	bPrepMade		: BOOL;					//a local request was needed: refresh after tPrepHold
	nNextNow		: INT;
	eNextNow		: E_Anybus_RecipeType;
	tonPrepHold		: TON;
	tonPrepRetry	: TON;
END_VAR
VAR CONSTANT
	cnNotSupported	: INT := 100;			//order not accepted: CIP busy (proposal)
	cnPrepStart		: INT := 0;				//choose and start the local request when CIP is free
	cnPrepRun		: INT := 1;				//local request in FB_CIP
	cnPrepReady		: INT := 2;				//solutions ready, READY to Siemens
	cnPrepRetry		: INT := 3;				//local request did not reach Done, wait tPrepRetry
	cnPrepWash		: INT := 4;				//Siemens wash, no preparation
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[bBufferFree:=g_Data.arCIP_RequestBufer[0].eClient=E_CIP_Usage.eNotInUse;
tonStopping(IN:=bStopping, PT:=T#1S);
IF tonStopping.Q THEN;
	bStopping:=FALSE;
END_IF

//Order: only while Siemens READY and CIP READY (solutions prepared). REQUEST ON held from earlier starts the wash
//when both come, a new edge from Siemens is not needed (decisions 02.11.2026). stStatus.bReady of the last cycle
rtStart(CLK:=g_Anybus.fbAnybus.eRequest=E_Anybus_Request.eOn AND g_Anybus.fbAnybus.stIn.bReady AND stStatus.bReady);
IF rtStart.Q
AND NOT bActive
AND NOT bFinished
THEN;
	bRejected:=NOT m_Start();
END_IF

//The way back to Ready clears bRun (_ainit_exit, reset): keep the release until the order leaves Ready
IF (bActive OR nPrep=cnPrepRun)
AND NOT bBufferFree
AND NOT g_Data.b_CIP_Run
AND NOT g_Data.fbCIP.bRun
AND g_Data.fbCIP.eMode<>E_CIP_Mode.eOff
THEN;
	g_Data.fbCIP.mRun();
END_IF

//End of the wash: _aDone_entry frees slot 0
IF bActive THEN;
	IF NOT bBufferFree THEN;
		bTaken:=TRUE;
	ELSIF bTaken THEN;
		bActive:=FALSE;
		bTaken:=FALSE;
		bFinished:=TRUE;
	END_IF
END_IF

//REQUEST OFF: confirms FINISH or stops the wash
IF g_Anybus.fbAnybus.eRequest=E_Anybus_Request.eOff
OR g_Anybus.fbAnybus.eRequest=E_Anybus_Request.eConflict
THEN;
	bFinished:=FALSE;
	bRejected:=FALSE;
	IF bActive THEN;
		m_Stop();
	END_IF
END_IF

//Preparation by NEXT: free CIP prepares the solutions for the accepted NEXT, READY when done, refresh after tPrepHold.
//A change of NEXT stops the preparation and starts it for the new NEXT
IF g_Anybus.fbAnybus.bNextValid THEN;
	nNextNow:=g_Anybus.fbAnybus.nNextClient;
	eNextNow:=g_Anybus.fbAnybus.eNextRecipe;
ELSE;
	nNextNow:=0;
	eNextNow:=E_Anybus_RecipeType.eNone;
END_IF
IF bActive OR bFinished THEN;
	nPrep:=cnPrepWash;
ELSIF (nPrep=cnPrepRun OR nPrep=cnPrepReady OR nPrep=cnPrepRetry)
AND (nNextNow<>nPrepClient OR eNextNow<>ePrepRecipe)
THEN;
	IF nPrep=cnPrepRun THEN;
		m_PrepStop();
	END_IF
	nPrep:=cnPrepStart;
END_IF
tonPrepHold(IN:=nPrep=cnPrepReady AND bPrepMade, PT:=tPrepHold);
tonPrepRetry(IN:=nPrep=cnPrepRetry, PT:=tPrepRetry);
CASE nPrep OF
	cnPrepWash:;
		IF NOT bActive AND NOT bFinished THEN;
			nPrep:=cnPrepStart;
		END_IF

	cnPrepStart:;
		IF bBufferFree
		AND NOT bStopping
		AND NOT g_Data.fbCIP.bRun
		AND g_Data.fbCIP.SFCCurrentStep='Ready'
		AND g_Data.fbCIP.eMode<>E_CIP_Mode.eOff
		THEN;
			nPrepClient:=nNextNow;
			ePrepRecipe:=eNextNow;
			bPrepMade:=NOT bPrepOff AND NOT bWaterOnly AND m_PrepRequest();
			IF bPrepMade THEN;
				g_Data.fbCIP.m_TakePosInCIPBuffer(stCIP_Request:=stPrepReq);
				g_Data.fbCIP.mRun();
				bPrepTaken:=FALSE;
				nPrep:=cnPrepRun;
			ELSE;
				nPrep:=cnPrepReady;
			END_IF
		END_IF

	cnPrepRun:;
		//_aDone_entry frees slot 0; freed without Done = stopped from outside
		IF NOT bBufferFree THEN;
			bPrepTaken:=TRUE;
		ELSIF bPrepTaken THEN;
			bPrepTaken:=FALSE;
			IF g_Data.fbCIP.bDone THEN;
				nPrep:=cnPrepReady;
			ELSE;
				nPrep:=cnPrepRetry;
			END_IF
		END_IF

	cnPrepReady:;
		IF tonPrepHold.Q THEN;
			nPrep:=cnPrepStart;
		END_IF

	cnPrepRetry:;
		IF tonPrepRetry.Q THEN;
			nPrep:=cnPrepStart;
		END_IF
END_CASE

//Recipe of the local preparation in FB_CIP: the client of the wash, the NEXT client while preparing, else Local
IF bActive THEN;
	g_Data.fbCIP.nLocalRecipe:=stReq.nClientId;
ELSIF nPrep=cnPrepRun THEN;
	g_Data.fbCIP.nLocalRecipe:=nPrepClient;
ELSE;
	g_Data.fbCIP.nLocalRecipe:=0;
END_IF

//Pause, the existing CIP zone Pause / Play. Play comes by itself when all causes are gone (decision 02.11.2026)
tonReadyLost(IN:=bActive AND NOT g_Anybus.fbAnybus.stIn.bReady, PT:=T#1S);
bPauseReq:=bActive AND (
	g_Anybus.fbAnybus.eRequest=E_Anybus_Request.eNone
	OR tonReadyLost.Q
	OR g_Anybus.fbAnybus.stIn.bPause
	OR g_Anybus.fbAnybus.stIn.bAlarm
	OR NOT g_Anybus.fbAnybus.stIn.bInletPumpEnable);
rtPause(CLK:=bPauseReq);
ftPause(CLK:=bPauseReq);
IF rtPause.Q THEN;
	stOper[E_ModeZone.eCIP].bSetPause:=TRUE;
END_IF
IF ftPause.Q THEN;
	stOper[E_ModeZone.eCIP].bSetPlay:=TRUE;
END_IF

//Status
stStatus.bReady:=TRUE
	AND NOT bActive
	AND NOT bFinished
	AND NOT bStopping
	AND bBufferFree
	AND NOT g_Data.fbCIP.bRun
	AND g_Data.fbCIP.SFCCurrentStep='Ready'
	AND g_Data.fbCIP.eMode<>E_CIP_Mode.eOff
	AND g_Anybus.fbAnybus.bCommOk
	AND nPrep=cnPrepReady;
stStatus.bWorking:=bActive;
//SENDING PUMP WORKING: the CIP sending pump P1001 runs during the Siemens wash, for indication in the plant
stStatus.bSendingPump:=bActive AND g_Pump.fbPump[E_Pump_List.P1001].bRun;
//EMPTYING CLIENT: Tank on a Tank_LowLevel step, the steps wait for CLIENT EMPTY
stStatus.bEmptyingClient:=bActive
	AND stReq.eClientType=E_Anybus_ClientType.eTank
	AND FIND(g_Data.fbCIP.SFCCurrentStep, 'Tank_LowLevel')>0;
//Sprinkler: on from CIPx_Conn_Sprinkler until FB_CIP leaves the spray ball, off until Siemens confirms.
//bSprinkler alone is too early: the mix-proof steps set it before CIP2 and CIP4
IF NOT bActive OR NOT g_Data.fbCIP.bSprinkler THEN;
	bSprinklerReq:=FALSE;
END_IF
IF bActive AND FIND(g_Data.fbCIP.SFCCurrentStep, 'Conn_Sprinkler')>0 THEN;
	bSprinklerReq:=TRUE;
END_IF
//One level bit: 0 asks Siemens back to the pipe, Sprinkler State 0 confirms (Vadim 02.11.2026, items 7-8)
stStatus.bSprinklerRequest:=bSprinklerReq;
stStatus.bFinish:=bFinished;
stStatus.bPause:=bActive AND stOper[E_ModeZone.eCIP].iActOperation=E_OperationButtons.ePauseAll;
stStatus.eActualMedia:=m_Media();
//Progress of the current medium in seconds (proposal, to be confirmed by Vadim): circulation timer of FB_CIP,
//reset at the start of each medium. Remaining time to the next stage = recipe - actual
IF bActive THEN;
	stStatus.nRecipeProgress:=TIME_TO_DINT(g_Data.fbCIP.tonr_CIP_Condition.PT)/1000;
	stStatus.nActualProgress:=TIME_TO_DINT(g_Data.fbCIP.tonr_CIP_Condition.ET)/1000;
ELSE;
	stStatus.nRecipeProgress:=0;
	stStatus.nActualProgress:=0;
END_IF
IF bActive OR bFinished THEN;
	stStatus.nActiveClient:=stReq.nClientId;
	stStatus.eActiveRecipe:=eRecipe;
ELSE;
	stStatus.nActiveClient:=0;
	stStatus.eActiveRecipe:=E_Anybus_RecipeType.eNone;
END_IF
IF bRejected THEN;
	stStatus.nAlarmCode:=cnNotSupported;
ELSE;
	stStatus.nAlarmCode:=0;
END_IF
]]></ST>
    </Implementation>
    <Method Name="m_Start" Id="{7d3e91a2-4c56-4b18-8f27-2a6c0e5d1b02}">
      <Declaration><![CDATA[//TRUE: the order is in the CIP buffer and the cycle is released
METHOD PRIVATE m_Start : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Not before Ready: after a stop the way back to Ready (valves, client drain) takes more than bStopping,
//_aReady_exit would be missed and eCIP_State of the order not taken
IF NOT g_Anybus.fbAnybus.bCurrentValid
OR bStopping
OR NOT bBufferFree
OR g_Data.fbCIP.bRun
OR g_Data.fbCIP.SFCCurrentStep<>'Ready'
OR g_Data.fbCIP.eMode=E_CIP_Mode.eOff
THEN;
	RETURN;
END_IF

//GAD wash type -> CIP type and first stage, table of 02.11.2026
CASE g_Anybus.fbAnybus.stIn.eRecipeType OF
	E_Anybus_RecipeType.eFlushOnly:;
		stReq.eType:=E_CIP_Type.R_Water;
		stReq.eStartState:=E_Element_State_Long.eNotClean;
	E_Anybus_RecipeType.eDetergent:;
		stReq.eType:=E_CIP_Type.Detergent;
		stReq.eStartState:=E_Element_State_Long.eNotClean;
	E_Anybus_RecipeType.eDetergentOnly:;
		stReq.eType:=E_CIP_Type.Detergent;
		stReq.eStartState:=E_Element_State_Long.eCIP_1_Rinzed;
	E_Anybus_RecipeType.eDisinfectionOnly:;
		stReq.eType:=E_CIP_Type.Full;
		stReq.eStartState:=E_Element_State_Long.eCIP_3_Deterged_Clean;
	E_Anybus_RecipeType.eDetergentDisinfection:;
		stReq.eType:=E_CIP_Type.Full;
		stReq.eStartState:=E_Element_State_Long.eCIP_1_Rinzed;
	E_Anybus_RecipeType.eFull:;
		stReq.eType:=E_CIP_Type.Full;
		stReq.eStartState:=E_Element_State_Long.eNotClean;
ELSE;
	RETURN;
END_CASE
IF bWaterOnly THEN;
	stReq.eType:=E_CIP_Type.R_Water;
	stReq.eStartState:=E_Element_State_Long.eNotClean;
END_IF
eRecipe:=g_Anybus.fbAnybus.stIn.eRecipeType;
stReq.eClient:=E_CIP_Usage.eExternal;
stReq.nClientId:=g_Anybus.fbAnybus.stIn.nClientId;
stReq.eClientType:=g_Anybus.fbAnybus.stIn.eClientType;

g_Data.fbCIP.m_TakePosInCIPBuffer(stCIP_Request:=stReq);
g_Data.fbCIP.mRun();
bActive:=TRUE;
bTaken:=FALSE;
m_Start:=TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Stop" Id="{7d3e91a2-4c56-4b18-8f27-2a6c0e5d1b03}">
      <Declaration><![CDATA[//REQUEST OFF during the wash. Not bStopResetAll: it puts the CIP zone to Manual and Pause, the next order would not run
METHOD PRIVATE m_Stop : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[g_Data.arCIP_RequestBufer[0]:=stBlank;
g_Data.fbCIP.mResetCycle();
bStopping:=TRUE;
bActive:=FALSE;
bTaken:=FALSE;
m_Stop:=TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PrepRequest" Id="{ac8c35bb-7632-4b38-ba4d-97a2c891aa7d}">
      <Declaration><![CDATA[//Local request for ePrepRecipe, table of Vadim 02.11.2026. FALSE: no solution is needed (no NEXT, Flush_Only).
//The start state is set as in the table, FB_CIP takes it for local requests only with item 7 (later)
METHOD PRIVATE m_PrepRequest : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stPrepReq:=stBlank;
stPrepReq.eClient:=E_CIP_Usage.eLocal;
CASE ePrepRecipe OF
	E_Anybus_RecipeType.eDetergent, E_Anybus_RecipeType.eDetergentOnly:;
		//T92
		stPrepReq.eType:=E_CIP_Type.Detergent;
		stPrepReq.eStartState:=E_Element_State_Long.eCIP_1_Rinzed;
	E_Anybus_RecipeType.eDisinfectionOnly:;
		//T91
		stPrepReq.eType:=E_CIP_Type.Full;
		stPrepReq.eStartState:=E_Element_State_Long.eCIP_3_Deterged_Clean;
	E_Anybus_RecipeType.eDetergentDisinfection, E_Anybus_RecipeType.eFull:;
		//T92 and T91
		stPrepReq.eType:=E_CIP_Type.Full;
		stPrepReq.eStartState:=E_Element_State_Long.eCIP_1_Rinzed;
ELSE;
	RETURN;
END_CASE
m_PrepRequest:=TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_PrepStop" Id="{9ae72079-4a93-4d7f-9683-bf8f9397708a}">
      <Declaration><![CDATA[//NEXT changed during the preparation: the same stop as on REQUEST OFF
METHOD PRIVATE m_PrepStop : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[g_Data.arCIP_RequestBufer[0]:=stBlank;
g_Data.fbCIP.mResetCycle();
bStopping:=TRUE;
bPrepTaken:=FALSE;
m_PrepStop:=TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Media" Id="{7d3e91a2-4c56-4b18-8f27-2a6c0e5d1b04}">
      <Declaration><![CDATA[//Actual Media by the dashboard stage of FB_CIP
METHOD PRIVATE m_Media : E_Anybus_Media
]]></Declaration>
      <Implementation>
        <ST><![CDATA[m_Media:=E_Anybus_Media.eNone;
IF NOT bActive THEN;
	RETURN;
END_IF
nStage:=TO_INT(g_HMI.eCIP_DashStage_actual);
CASE nStage OF
	1..2:;
		m_Media:=E_Anybus_Media.eFirstWater;
	3..7:;
		m_Media:=E_Anybus_Media.eSoda;
	8..11:;
		m_Media:=E_Anybus_Media.eIntermediateWater;
	12..16:;
		m_Media:=E_Anybus_Media.eDisinfection;
	17..20:;
		m_Media:=E_Anybus_Media.eLastWater;
END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
