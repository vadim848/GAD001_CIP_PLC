  <DUT Name="E_Anybus_RecipeType" Id="{2496285c-e348-414b-9c1d-31a8acdde51c}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'to_string'}
TYPE E_Anybus_RecipeType :
(
	eNone			:= 0,	// not selected
	eFlushOnly				:= 1,	// CIP1
	eDetergent				:= 2,	// CIP1, CIP2, CIP3
	eDetergentOnly			:= 3,	// CIP2, CIP3
	eDisinfectionOnly		:= 4,	// CIP4, CIP5
