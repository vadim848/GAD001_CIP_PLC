<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <DUT Name="ST_Anybus_Outputs" Id="{28f04226-9ab4-4c1d-993e-5da8704ab9fa}">
    <Declaration><![CDATA[//CIP -> Siemens, encoded to gIO.Anybus_Outputs_Raw
TYPE ST_Anybus_Outputs :
STRUCT
	//Word 0, byte 0
	bAlarm				: BOOL;	//0.0 CIP alarm
	bReady				: BOOL;	//0.1 solution for the next client is prepared
	bWorking			: BOOL;	//0.2 CIP in progress
	bFinish				: BOOL;	//0.3 CIP finished
	bEmptyingClient		: BOOL;	//0.4 client must be emptied between media
	bSendingPump		: BOOL;	//0.5 sending pump is running
	bPause				: BOOL;	//0.6 CIP is paused
	bAlive				: BOOL;	//0.7 generated by FB_Anybus_Interface, value shown in fbAnybus.stOut
	bSprinklerRequest	: BOOL;	//1.0 level: 1 = spray ball needed, 0 = pipe (Vadim 02.11.2026, address not agreed with GAD)

	eActualMedia		: E_Anybus_Media;		//word 1
	nRecipeProgress		: DINT;					//words 2-3, setpoint of the current stage
	nActualProgress		: DINT;					//words 4-5, actual value of the current stage
	nAlarmCode			: INT;					//word 6, 0 = no alarm, CIP process codes from 100 (proposal)
	nProgressUnit		: INT;					//word 7, 1 = seconds, 2 = litres (proposal)
	nActiveClient		: INT;					//word 8, echo of the client in CIP (proposal)
	eActiveRecipe		: E_Anybus_RecipeType;	//word 9, echo of the recipe in CIP (proposal)
	nFlowRateSet		: INT;					//word 10, required flow rate (proposal)
	nFlowRateActual		: INT;					//word 11, actual flow rate (proposal)
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
