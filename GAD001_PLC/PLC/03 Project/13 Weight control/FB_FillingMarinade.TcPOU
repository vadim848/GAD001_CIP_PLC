<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_FillingMarinade" Id="{e17c7fa9-00cf-4e3b-894a-a82205e0ff5f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_FillingMarinade
VAR_INPUT
	iFillAmoungKg		: UINT;
	rActWeight			: REAL;
	bStop				: BOOL;
END_VAR
VAR_OUTPUT
	bFillingBusy		: BOOL;
	bFillingDone		: BOOL;
END_VAR
VAR_IN_OUT
	bFillRequest		: BOOL;
	fbFiliingPump		: FB_Pump;
	bPistonOpen			: BOOL;
	bPistonClose		: BOOL;
END_VAR
VAR
	trigStop			: R_TRIG;
	rHighVelocity		: REAL:=200;
	rMidVelocity		: REAL:=100;
	rLowVelocity		: REAL:=10;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[actFillComponent();

trigStop(Clk:= bStop);
IF SFCReset THEN
	SFCReset:=FALSE;
END_IF
IF trigStop.Q THEN
	bFillRequest:=FALSE;
	SFCReset:=TRUE;
END_IF]]></ST>
    </Implementation>
    <Folder Name="Management" Id="{2e571a8a-32c1-4b64-83bc-f923998c1f7e}" />
