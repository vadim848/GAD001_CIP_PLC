    <Action Name="_aMarinade_Up_active" Id="{35ac2ee3-7118-443b-9114-b224b600d3b5}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF TRUE 
AND eStatus=E_CIP_Client_Selector.eMarinade_Up
THEN;
	bStepDone:=TRUE;
END_IF]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
