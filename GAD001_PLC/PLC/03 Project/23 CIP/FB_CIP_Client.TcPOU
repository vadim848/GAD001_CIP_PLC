      </ObjectProperties>
    </Action>
    <Action Name="_aMarinade_Up_entry" Id="{328f52ec-1b83-47ac-84bf-d158e139b2f9}">
      <Implementation>
        <ST><![CDATA[fbPis.m_SetByRecipe(stPis:=stPis_Client_Source, 		req:=E_Piston_Recipe_State.Act);
fbPis.m_SetByRecipe(stPis:=stPis_Client_Return, 		req:=E_Piston_Recipe_State.Act);
fbPis.m_SetByRecipe(stPis:=stPis_S_Marinade_Up, 		req:=E_Piston_Recipe_State.Act);
fbPis.m_SetByRecipe(stPis:=stPis_S_Marinade_Low, 		req:=E_Piston_Recipe_State.Release);
fbPis.m_SetByRecipe(stPis:=stPis_S_Color_Up, 			req:=E_Piston_Recipe_State.Release);
fbPis.m_SetByRecipe(stPis:=stPis_S_Color_Low, 			req:=E_Piston_Recipe_State.Release);
fbPis.m_SetByRecipe(stPis:=stPis_Drain, 				req:=E_Piston_Recipe_State.Release);
fbPis.m_SetByRecipe(stPis:=stPis_Loop, 					req:=E_Piston_Recipe_State.Release);
fbPis.m_SetByRecipe(stPis:=stPis_S_Future, 				req:=E_Piston_Recipe_State.Release);]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aReady_active" Id="{08fcf68e-dc0f-47ca-acbd-f456115322bd}">
      <Implementation>
        <ST><![CDATA[

IF eReq<>E_CIP_Client_Selector.eNone THEN;
	IF eProcess=E_CIP_Client_Selector.eNone 
	THEN;
		eProcess:=eReq;
	ELSE;
		eReq:=E_CIP_Client_Selector.eNone;
	END_IF
END_IF

(*
CASE eReq OF
	E_CIP_Usage.eLine_Color:;
			IF TRUE THEN;
				eProcess:=E_CIP_Usage.eLine_Color;
			END_IF

	E_CIP_Usage.eLine_Marinada:;
			IF TRUE THEN;
				eProcess:=E_CIP_Usage.eLine_Marinada;
			END_IF	
			
	E_CIP_Usage.eLocal:;
			IF TRUE THEN;
				eProcess:=E_CIP_Usage.eLocal;
			END_IF	

	E_CIP_Usage.eNotInUse:;
			IF TRUE THEN;
				eProcess:=E_CIP_Usage.eNotInUse;
			END_IF	
			
	E_CIP_Usage.eTank_1:;
			IF TRUE THEN;
				eProcess:=E_CIP_Usage.eTank_1;
			END_IF	
	E_CIP_Usage.eTank_2:;
			IF TRUE THEN;
				eProcess:=E_CIP_Usage.eTank_2;
			END_IF	
	E_CIP_Usage.eTank_3:;
			IF TRUE THEN;
				eProcess:=E_CIP_Usage.eTank_3;
			END_IF	
	E_CIP_Usage.eTank_4:;
			IF TRUE THEN;
				eProcess:=E_CIP_Usage.eTank_4;
			END_IF	
	E_CIP_Usage.eTriBlender_Color:;
			IF TRUE THEN;
				eProcess:=E_CIP_Usage.eTriBlender_Color;
			END_IF	
	E_CIP_Usage.eTriBlender_Marinada:;
			IF TRUE THEN;
				eProcess:=E_CIP_Usage.eTriBlender_Marinada;
			END_IF	

END_CASE
*)		
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
