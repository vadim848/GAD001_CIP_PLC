<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_CIP_Client" Id="{c5033c12-cb76-4d9f-9912-a992211c6f9c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_CIP_Client EXTENDS FB_SFC_Cycle IMPLEMENTS ITF_FB_SFC_Cycle
VAR_INPUT
	//eElementID			: E_Element_List;
	
	valClient_Source		: E_Pis_Name;
	valClient_Return		: E_Pis_Name;
	valS_Marinade_Up		: E_Pis_Name;
	//valS_Marinade_Up_Drain	: E_Pis_Name;
	valS_Marinade_Low		: E_Pis_Name;
	valS_Color_Up			: E_Pis_Name;
	//valS_Color_Up_Drain		: E_Pis_Name;
	valS_Color_Low			: E_Pis_Name;
	//valTank_1				: E_Pis_Name;
	//valTank_2				: E_Pis_Name;
	//valTank_3				: E_Pis_Name;
	//valTank_4				: E_Pis_Name;
	//valS_Marinade_Low_Select	: E_Pis_Name;
	//valS_Color_Low_Select	: E_Pis_Name;
	valDrain				: E_Pis_Name;
	valLoop					: E_Pis_Name;//V1030
	valS_Future				: E_Pis_Name;
	
END_VAR
VAR_OUTPUT
END_VAR
VAR
	//refElement		: REFERENCE TO FB_Element;
	//refState_Long		: REFERENCE TO E_Element_State_Long;
	eReq				: E_CIP_Client_Selector;
	eProcess			: E_CIP_Client_Selector;
	eStatus				: E_CIP_Client_Selector;
	
	fbPis					: FB_Piston;
	stPis_Client_Source			: REFERENCE TO ST_Piston;
	stPis_Client_Return			: REFERENCE TO ST_Piston;
	stPis_S_Marinade_Up			: REFERENCE TO ST_Piston;
	//stPis_S_Marinade_Up_Drain	: REFERENCE TO ST_Piston;
	stPis_S_Marinade_Low		: REFERENCE TO ST_Piston;
	stPis_S_Color_Up			: REFERENCE TO ST_Piston;
	//stPis_S_Color_Up_Drain		: REFERENCE TO ST_Piston;
	stPis_S_Color_Low			: REFERENCE TO ST_Piston;
	//stPis_Tank_1				: REFERENCE TO ST_Piston;
	//stPis_Tank_2				: REFERENCE TO ST_Piston;
	//stPis_Tank_3				: REFERENCE TO ST_Piston;
	//stPis_Tank_4				: REFERENCE TO ST_Piston;
	//stPis_S_Marinade_Low_Select	: REFERENCE TO ST_Piston;
	//stPis_S_Color_Low_Select	: REFERENCE TO ST_Piston;
	stPis_Drain					: REFERENCE TO ST_Piston;	
	stPis_Loop					: REFERENCE TO ST_Piston;//V1030
	stPis_S_Future				: REFERENCE TO ST_Piston;

	tonDrainTime: TON;
	
	rt_Req_Reset: R_TRIG;

END_VAR
VAR_IN_OUT


END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[act_GetReference();

act_Oper();
IF NOT Init.x THEN;
	act_Status();
END_IF

tonDrainTime(PT:=T#1M, IN:=eStatus=E_CIP_Client_Selector.eDrain);
IF tonDrainTime.Q 
AND eReq=E_CIP_Client_Selector.eNone
AND eProcess=E_CIP_Client_Selector.eNone
THEN;
	eReq:=E_CIP_Client_Selector.eClose;
END_IF

m_Request_Reset(memo:=rt_Req_Reset);//rt_Req_Reset: R_TRIG;]]></ST>
    </Implementation>
    <Folder Name="Manage" Id="{38103117-043f-403d-a53b-cc92b5c9eca8}" />
