    <Action Name="act_GetReference" Id="{84cac95e-a105-49db-a8ae-c6f6784af55d}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[m_Set_SFCFlags_Reference();
//refElement REF= fbElement[eElementID];
//refState_Long REF= fbElement[eElementID].eState_Long;

stPis_Client_Source			REF= g_Piston.stPis[valClient_Source];
stPis_Client_Return			REF= g_Piston.stPis[valClient_Return];
stPis_S_Marinade_Up			REF= g_Piston.stPis[valS_Marinade_Up];
//stPis_S_Marinade_Up_Drain	REF= g_Piston.stPis[valS_Marinade_Up_Drain];
stPis_S_Marinade_Low		REF= g_Piston.stPis[valS_Marinade_Low];
stPis_S_Color_Up			REF= g_Piston.stPis[valS_Color_Up];
//stPis_S_Color_Up_Drain		REF= g_Piston.stPis[valS_Color_Up_Drain];
stPis_S_Color_Low			REF= g_Piston.stPis[valS_Color_Low];
//stPis_Tank_1				REF= g_Piston.stPis[valTank_1];
//stPis_Tank_2				REF= g_Piston.stPis[valTank_2];
//stPis_Tank_3				REF= g_Piston.stPis[valTank_3];
//stPis_Tank_4				REF= g_Piston.stPis[valTank_4];
//stPis_S_Marinade_Low_Select	REF= g_Piston.stPis[valS_Marinade_Low_Select];
//stPis_S_Color_Low_Select	REF= g_Piston.stPis[valS_Color_Low_Select];
stPis_Drain					REF= g_Piston.stPis[valDrain];
stPis_Loop				REF= g_Piston.stPis[valLoop];
stPis_S_Future				REF= g_Piston.stPis[valS_Future];]]></ST>
      </Implementation>
    </Action>
