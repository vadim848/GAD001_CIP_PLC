    <Action Name="_aClose_entry" Id="{89bb949b-73b9-4e77-8017-b6327b0bdda0}">
      <Implementation>
        <ST><![CDATA[fbPis.m_SetByRecipe(stPis:=stPis_Client_Source, 		req:=E_Piston_Recipe_State.Release);
fbPis.m_SetByRecipe(stPis:=stPis_Client_Return, 		req:=E_Piston_Recipe_State.Release);
fbPis.m_SetByRecipe(stPis:=stPis_S_Marinade_Up, 		req:=E_Piston_Recipe_State.Release);
fbPis.m_SetByRecipe(stPis:=stPis_S_Marinade_Low, 		req:=E_Piston_Recipe_State.Release);
fbPis.m_SetByRecipe(stPis:=stPis_S_Color_Up, 			req:=E_Piston_Recipe_State.Release);
fbPis.m_SetByRecipe(stPis:=stPis_S_Color_Low, 			req:=E_Piston_Recipe_State.Release);
fbPis.m_SetByRecipe(stPis:=stPis_Drain, 				req:=E_Piston_Recipe_State.Release);
fbPis.m_SetByRecipe(stPis:=stPis_Loop, 					req:=E_Piston_Recipe_State.Release);
fbPis.m_SetByRecipe(stPis:=stPis_S_Future, 				req:=E_Piston_Recipe_State.Release);
]]></ST>
      </Implementation>
