    </Action>
    <Action Name="act_Status" Id="{62143100-fdee-42d6-8a63-1ad3f74db813}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[IF bReady AND bDone OR TRUE THEN;
	IF TRUE 
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Client_Source, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Client_Return, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Marinade_Up, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Marinade_Low, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Color_Up, 			req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Color_Low, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 				req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Loop, 				req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Future, 			req:=E_Piston_Recipe_State.Release)
	THEN;
		eStatus:=E_CIP_Client_Selector.eClose;
	ELSIF TRUE
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Client_Source, 		req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Client_Return, 		req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Marinade_Up, 		req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Marinade_Low, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Color_Up, 			req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Color_Low, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 				req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Loop, 				req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Future, 			req:=E_Piston_Recipe_State.Release)
	THEN;
		eStatus:=E_CIP_Client_Selector.eMarinade_Up;
	ELSIF TRUE 
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Client_Source, 		req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Client_Return, 		req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Marinade_Up, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Marinade_Low, 		req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Color_Up, 			req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Color_Low, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 				req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Loop, 				req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Future, 			req:=E_Piston_Recipe_State.Release)
	THEN;
		eStatus:=E_CIP_Client_Selector.eMarinade_Low;
	ELSIF TRUE 
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Client_Source, 		req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Client_Return, 		req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Marinade_Up, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Marinade_Low, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Color_Up, 			req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Color_Low, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 				req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Loop, 				req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Future, 			req:=E_Piston_Recipe_State.Release)
	THEN;
		eStatus:=E_CIP_Client_Selector.eColor_Up;
	ELSIF TRUE 
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Client_Source, 		req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Client_Return, 		req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Marinade_Up, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Marinade_Low, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Color_Up, 			req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Color_Low, 		req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 				req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Loop, 				req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Future, 			req:=E_Piston_Recipe_State.Release)
	THEN;
		eStatus:=E_CIP_Client_Selector.eColor_Low;
	ELSIF TRUE 
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Client_Source, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Client_Return, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Marinade_Up, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Marinade_Low, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Color_Up, 			req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Color_Low, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 				req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Loop, 				req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Future, 			req:=E_Piston_Recipe_State.Release)
	THEN;
		eStatus:=E_CIP_Client_Selector.eDrain;
	ELSIF TRUE 
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Client_Source, 		req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Client_Return, 		req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Marinade_Up, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Marinade_Low, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Color_Up, 			req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Color_Low, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 				req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Loop, 				req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Future, 			req:=E_Piston_Recipe_State.Release)
	THEN;
		eStatus:=E_CIP_Client_Selector.eLoop;
	ELSIF TRUE 
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Client_Source, 		req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Client_Return, 		req:=E_Piston_Recipe_State.Act)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Marinade_Up, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Marinade_Low, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Color_Up, 			req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Color_Low, 		req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Drain, 				req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_Loop, 				req:=E_Piston_Recipe_State.Release)
	AND fbPis.m_CheckByRecipe(stPis:=stPis_S_Future, 			req:=E_Piston_Recipe_State.Act)
	THEN;
		eStatus:=E_CIP_Client_Selector.eFuture;
	ELSE;
		eStatus:=E_CIP_Client_Selector.eNone;
	END_IF
ELSE;
	eStatus:=E_CIP_Client_Selector.eNone;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="m_CheckStatus" Id="{b5de556e-91b0-4df7-96d4-bc419ec06c1d}" FolderPath="Manage\">
      <Declaration><![CDATA[METHOD m_CheckStatus : BOOL
VAR_INPUT
	eReqStatus		: E_CIP_Usage;
END_VAR
VAR
	eReqStatusLocal	: E_CIP_Client_Selector;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eReqStatus OF
	E_CIP_Usage.eLocal:;
				eReqStatusLocal	:=E_CIP_Client_Selector.eClose;
	E_CIP_Usage.eTank_1,
	E_CIP_Usage.eTank_2:;
				eReqStatusLocal	:=E_CIP_Client_Selector.eMarinade_Up;	
	E_CIP_Usage.eTank_3,
	E_CIP_Usage.eTank_4:;
				eReqStatusLocal	:=E_CIP_Client_Selector.eColor_Up;	
	E_CIP_Usage.eTriBlender_Marinada,
	E_CIP_Usage.eLine_Marinada:;
				eReqStatusLocal	:=E_CIP_Client_Selector.eMarinade_Low;	
	E_CIP_Usage.eTriBlender_Color,
	E_CIP_Usage.eLine_Color:;
				eReqStatusLocal	:=E_CIP_Client_Selector.eColor_Low;	
	
END_CASE

IF eStatus=eReqStatusLocal 
AND eProcess=E_CIP_Client_Selector.eNone
AND eReq=E_CIP_Client_Selector.eNone
AND bReady
AND bDone
AND NOT bRun
THEN;
	m_CheckStatus:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Request_Reset" Id="{3a0085ac-d519-46ef-8977-d86d9a880e6b}" FolderPath="Manage\">
      <Declaration><![CDATA[METHOD m_Request_Reset : BOOL
VAR_IN_OUT
	memo: R_TRIG;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[memo(CLK:=eReq=0);
IF TRUE 
AND memo.Q
THEN;
	SFCReset:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Run" Id="{a8bdb2df-eb11-4961-9b0c-b01d07d5677a}" FolderPath="Manage\">
      <Declaration><![CDATA[METHOD m_Run : BOOL
VAR_INPUT
	eReqProc			: E_CIP_Usage;
END_VAR
VAR
	eReqStatusLocal	: E_CIP_Client_Selector;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eReqProc OF
	E_CIP_Usage.eLocal:;
				eReqStatusLocal	:=E_CIP_Client_Selector.eClose;
	E_CIP_Usage.eTank_1,
	E_CIP_Usage.eTank_2:;
				eReqStatusLocal	:=E_CIP_Client_Selector.eMarinade_Up;	
	E_CIP_Usage.eTank_3,
	E_CIP_Usage.eTank_4:;
				eReqStatusLocal	:=E_CIP_Client_Selector.eColor_Up;	
	E_CIP_Usage.eTriBlender_Marinada,
	E_CIP_Usage.eLine_Marinada:;
				eReqStatusLocal	:=E_CIP_Client_Selector.eMarinade_Low;	
	E_CIP_Usage.eTriBlender_Color,
	E_CIP_Usage.eLine_Color:;
				eReqStatusLocal	:=E_CIP_Client_Selector.eColor_Low;	
	
END_CASE

IF eProcess=E_CIP_Client_Selector.eNone THEN;
	eProcess:=eReq:=eReqStatusLocal;
	bDone:=FALSE;
	m_Run:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="m_Set_SFCFlags_Reference" Id="{6740c604-b51a-4401-88e7-e8f7ceec239c}" FolderPath="Manage\">
      <Declaration><![CDATA[METHOD m_Set_SFCFlags_Reference : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Set reference to SFC flags

refSFC.SFCInit REF= SFCInit;
refSFC.SFCReset REF= SFCReset;
refSFC.SFCError REF= SFCError;
refSFC.SFCEnableLimit REF= SFCEnableLimit;
refSFC.SFCErrorStep REF= SFCErrorStep;
refSFC.SFCErrorPOU REF= SFCErrorPOU;
refSFC.SFCQuitError REF= SFCQuitError;
refSFC.SFCPause REF= SFCPause;
refSFC.SFCTrans REF= SFCTrans;
refSFC.SFCCurrentStep REF= SFCCurrentStep;
refSFC.SFCTip REF= SFCTip;
refSFC.SFCTipMode REF= SFCTipMode;

// Cycle handle for SFC
m_SFC_Handle();]]></ST>
      </Implementation>
    </Method>
