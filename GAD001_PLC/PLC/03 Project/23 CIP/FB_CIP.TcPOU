    <Action Name="_aConnect_CIP2_01_entry" Id="{706022d5-0f64-404a-afba-3efb082d83da}">
      <Implementation>
        <ST><![CDATA[fbCIP_Source.m_Run(eReqProc:=E_CIP_Source.eT92_Detergent);
fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eT92_Detergent);
fbPis.m_SetByRecipe(stPis:=stPis_FillWater_T92, req:=E_Piston_Recipe_State.Release);

m_DashState_done(stage:=E_CIP_DashStage_List.e03_CIP2_Local_Detergent_Fill);
m_DashState_activate(stage:=E_CIP_DashStage_List.e04_CIP2_Local_Detergent_Condition);]]></ST>
