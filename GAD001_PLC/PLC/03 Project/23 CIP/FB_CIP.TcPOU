        <ST><![CDATA[bStepDone:=FALSE;
IF fbPis.m_CheckByRecipe(stPis:=stPis_FillWater_T94, 		req:=E_Piston_Recipe_State.Act) THEN
	bStepDone:=TRUE;
END_IF
bStepDone:=TRUE;]]></ST>
