    <Action Name="_aConnect_CIP3_01_active" Id="{6ad9d3b4-017f-4b24-b262-50ad8667ca02}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF fbCIP_Source.m_CheckStatus(eReqStatus:=E_CIP_Source.eT91_Sanitation)  
AND fbCIP_Return.m_CheckStatus(eReqStatus:=E_CIP_Return.eT91_Sanitation)  
AND fbPis.m_CheckByRecipe(stPis:=stPis_FillWater_T91, req:=E_Piston_Recipe_State.Release) THEN;
	bStepDone:=TRUE;
END_IF]]></ST>
