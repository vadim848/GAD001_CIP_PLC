          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aCIP2_Done_entry" Id="{9a18f41c-f03b-4bca-ad35-6eeccc6aba8e}">
      <Implementation>
        <ST><![CDATA[m_Set_CIP_State(eState:=E_Element_State_Long.eCIP_2_Deterged);]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aCIP3_Done_entry" Id="{ea9db615-0bf9-482c-b261-eaf0de2b9036}">
      <Implementation>
        <ST><![CDATA[m_Set_CIP_State(eState:=E_Element_State_Long.eCIP_4_Sanitized);]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aCIP4_Collect_active" Id="{245a31fa-2345-490d-951c-e73052de6876}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF eCIP_State=E_Element_State_Long.eCIP_2_Deterged THEN;
	volume_Requered:= REAL_TO_INT(st_CIP_Param.r_Volume_Collect_Detergent);
	volume_Actual:= REAL_TO_INT(delta_T92_Volume);
ELSIF eCIP_State=E_Element_State_Long.eCIP_4_Sanitized THEN;
	volume_Requered:= REAL_TO_INT(st_CIP_Param.r_Volume_Collect_DisInfection);
	volume_Actual:= REAL_TO_INT(delta_T91_Volume);
END_IF

IF volume_Actual >= volume_Requered THEN;
	bStepDone:=TRUE;
END_IF]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aCIP4_Collect_entry" Id="{6daf871f-9050-473d-9190-81d975256abb}">
      <Implementation>
        <ST><![CDATA[mVolumeReset_All();]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aCIP4_Done_entry" Id="{2c90a1c0-9583-407e-b51f-9727c492c562}">
      <Implementation>
        <ST><![CDATA[CASE eCIP_State OF
	E_Element_State_Long.eCIP_2_Deterged:;
			m_Set_CIP_State(eState:=E_Element_State_Long.eCIP_3_Deterged_Clean);

	E_Element_State_Long.eCIP_4_Sanitized:;
			m_Set_CIP_State(eState:=E_Element_State_Long.eCIP_5_Done);

END_CASE]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aCIP4_Drain_active" Id="{d7aa4e20-df54-48dd-9a3c-3664a01991e5}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;

IF eCIP_State=E_Element_State_Long.eCIP_2_Deterged THEN;
	volume_Requered:= REAL_TO_INT(st_CIP_Param.r_Volume_Drain_Detergent);
	volume_Actual:= REAL_TO_INT(-delta_T94_Volume);
ELSIF eCIP_State=E_Element_State_Long.eCIP_4_Sanitized THEN;
	volume_Requered:= REAL_TO_INT(st_CIP_Param.r_Volume_Drain_DisInfection);
	volume_Actual:= REAL_TO_INT(-delta_T94_Volume);
END_IF

IF volume_Actual >= volume_Requered THEN;
	bStepDone:=TRUE;
END_IF]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aCIP4_Drain_entry" Id="{048a2c59-3991-477e-82b6-2061ef66a49f}">
      <Implementation>
        <ST><![CDATA[fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eDrain);
mVolumeReset_All();

CASE eCIP_State OF

	E_Element_State_Long.eCIP_2_Deterged:;
			m_DashState_done(stage:=E_CIP_DashStage_List.e08_CIP3_Detergent_Collect);
			m_DashState_activate(stage:=E_CIP_DashStage_List.e09_CIP3_Detergent_Drain);

	E_Element_State_Long.eCIP_4_Sanitized:;
			m_DashState_done(stage:=E_CIP_DashStage_List.e17_CIP5_DisInfection_Collect);
			m_DashState_activate(stage:=E_CIP_DashStage_List.e18_CIP5_DisInfection_Drain);

END_CASE]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aCondition_CIP2_Local_active" Id="{e5e07d09-44e8-4297-94d3-a998af75e5e0}">
      <Implementation>
        <ST><![CDATA[fb_PumpCIP.m_Run(RPM:=pcFlow1_Rate.mRun_PID(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Flow_Pipe,controlManual:=NOT(fb_PumpCIP.modeAuto)));

IF TRUE 
AND pcFlow1_Rate.mRun(mRun=>_cond[1])
AND pcFlow2_Rate.mRun(mRun=>_cond[2])
//AND pcPressure.mRun()
THEN;
	//
ELSE;
	bCIP_Condition_Failed:=TRUE;
END_IF

pcHeatExchanger.mRun_PID(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Temper_Detergent, controlManual:=g_Data.stHeatExchanger.bManual ,mRun_PID=>_temp);
tonr_CIP_Condition(PT:=SECOND_TO_TIME(g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].t_ConditionDetergent), ResetTime:=FALSE);
IF TRUE 
AND pcHeatExchanger.mRun_With_SP(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Temper_Detergent, mRun_With_SP=>_cond[3])
AND pcTemperature_Deterg.mRun_With_SP(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Temper_Detergent, mRun_With_SP=>_cond[4])
AND pcTemp_ClntReturn.mRun_With_SP(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Temper_Detergent, mRun_With_SP=>_cond[5])
AND pcDetergent.mRun_With_SP(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_DetergentConcentration, mRun_With_SP=>_cond[6])
AND measure_Deterg.x
AND TRUE
THEN;
	tonr_CIP_Condition.IN:=TRUE;
ELSE;
	tonr_CIP_Condition.IN:=FALSE;
END_IF
	
IF tonr_CIP_Condition.Q THEN;
	bCIP_Condition_Done:=TRUE;
ELSE;
	bCIP_Condition_Done:=FALSE;	
END_IF


ton_Concentration_Filter(PT:=T#30S, IN:=stDetergent.Control_ON AND NOT stDetergent.OverFlow);
IF TRUE 
AND ton_Concentration_Filter.Q	
THEN;
	bConcentration_correct:=TRUE;
ELSE;
	bConcentration_correct:=FALSE;
END_IF

// Reverce function

(*
IF Deterg_Conc_Local_Done.x 
AND NOT pcDetergent.mRun()
THEN;
	bCIP_Condition_Failed:=TRUE;
END_IF

IF Temperature_1_Done.x 
AND (NOT pcTemperature_Deterg.mRun()
	OR NOT pcTemp_ClntReturn.mRun())
THEN;
	bCIP_Condition_Failed:=TRUE;
END_IF
*)

(*
//ton_CIP_Condition(PT:=T#30S);
IF (g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].t_ConditionDetergent-nDeter_CondActTime_Lcl)>0 THEN
	tonr_CIP_Condition(PT:=SECOND_TO_TIME(g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].t_ConditionDetergent-nDeter_CondActTime_Lcl));
	bDeter_CondActTime_Lcl_Done:=FALSE;
ELSE
	bDeter_CondActTime_Lcl_Done:=TRUE;
END_IF

IF TRUE 
AND Deterg_Conc_Local_Done.x
AND Temperature_1_Done.x
AND NOT bDeter_CondActTime_Lcl_Done
AND TRUE
THEN;
	tonr_CIP_Condition.IN:=TRUE;
ELSE;
	nDeter_CondActTime_Lcl:=TIME_TO_INT(tonr_CIP_Condition.ET)/1000;
	tonr_CIP_Condition.IN:=FALSE;
END_IF
	
IF tonr_CIP_Condition.Q OR bDeter_CondActTime_Lcl_Done THEN;
	bCIP_Condition_Done:=TRUE;
ELSE;
	bCIP_Condition_Done:=FALSE;	
END_IF

*)




]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aCondition_CIP2_Local_exit" Id="{3abd6e3a-fa29-4e39-83b3-0f68581fb9ea}">
      <Implementation>
        <ST><![CDATA[tonr_CIP_Condition(IN:=FALSE);]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aCondition_CIP3_Local_active" Id="{df016d92-2d66-4702-a496-5eb5a36fcd94}">
      <Implementation>
        <ST><![CDATA[fb_PumpCIP.m_Run(RPM:=pcFlow1_Rate.mRun_PID(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Flow_Pipe,controlManual:=NOT(fb_PumpCIP.modeAuto)));

IF TRUE 
AND pcFlow1_Rate.mRun(mRun=>_cond[1])
AND pcFlow2_Rate.mRun(mRun=>_cond[2])
//AND pcPressure.mRun()
THEN;
	//
ELSE;
	bCIP_Condition_Failed:=TRUE;
END_IF

pcHeatExchanger.mRun_PID(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Temper_DisInfection, controlManual:=g_Data.stHeatExchanger.bManual ,mRun_PID=>_temp);
tonr_CIP_Condition(PT:=SECOND_TO_TIME(g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].t_ConditionDisInfection));
IF TRUE 
AND pcHeatExchanger.mRun_With_SP(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Temper_DisInfection, mRun_With_SP=>_cond[3])
AND pcTemperature_Dis.mRun_With_SP(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Temper_DisInfection, mRun_With_SP=>_cond[4])
AND pcTemp_ClntReturn.mRun_With_SP(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_Temper_DisInfection, mRun_With_SP=>_cond[5])
AND pcDisInfectant.mRun_With_SP(Set_Point:=g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].r_DisInfectionConcentration, mRun_With_SP=>_cond[6])	
AND measure_Dis.x
AND TRUE
THEN;
	tonr_CIP_Condition.IN:=TRUE;
ELSE;
	tonr_CIP_Condition.IN:=FALSE;
END_IF

IF tonr_CIP_Condition.Q THEN
	bCIP_Condition_Done:=TRUE;
ELSE;
	bCIP_Condition_Done:=FALSE;	
END_IF


ton_Concentration_Filter(PT:=T#30S, IN:=stDisInfectant.Control_ON AND NOT stDisInfectant.OverFlow);
IF TRUE 
AND ton_Concentration_Filter.Q	
THEN;
 bConcentration_correct:=TRUE;
ELSE;
 bConcentration_correct:=FALSE;
END_IF

// Reverce function
(*
IF Disinfct_Conc_Local_Done.x 
AND NOT pcDisInfectant.mRun()
THEN;
	bCIP_Condition_Failed:=TRUE;
END_IF

IF Temperature_Dis_1_Done.x 
AND NOT pcTemperature_Dis.mRun()
THEN;
	bCIP_Condition_Failed:=TRUE;
END_IF
*)
(*
//ton_CIP_Condition(PT:=T#30S);
IF g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].t_ConditionDisInfection-nDisInf_CondActTime_Lcl>0 THEN
	tonr_CIP_Condition(PT:=SECOND_TO_TIME(g_Data.arr_CIP_Param[E_CIP_Usage.eLocal].t_ConditionDisInfection-nDisInf_CondActTime_Lcl));
	bDisInf_CondActTime_Lcl_Done:=FALSE;
ELSE
	bDisInf_CondActTime_Lcl_Done:=TRUE;
END_IF

IF TRUE 
AND Disinfct_Conc_Local_Done.x
AND Temperature_Dis_1_Done.x
AND NOT bDisInf_CondActTime_Lcl_Done
AND TRUE
THEN;
	tonr_CIP_Condition.IN:=TRUE;
ELSE;
	nDisInf_CondActTime_Lcl:=TIME_TO_INT(tonr_CIP_Condition.ET)/1000;
	tonr_CIP_Condition.IN:=FALSE;
END_IF

IF tonr_CIP_Condition.Q
OR bDisInf_CondActTime_Lcl_Done
THEN
	bCIP_Condition_Done:=TRUE;
ELSE;
	bCIP_Condition_Done:=FALSE;	
END_IF
*)
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
