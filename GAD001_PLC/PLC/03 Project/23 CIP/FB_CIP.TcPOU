    <Action Name="act_CallProcessControl" Id="{ba2500c4-7891-45b7-bd60-804b421a62c3}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[//Heat Exchanger
	stHeatExchanger.rValue:=g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1105].Value;
	pcHeatExchanger(stProcessControl:=stHeatExchanger );
//CIP return temperature
	stTemp_ClntReturn.rValue:=g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1101].Value;
	pcTemp_ClntReturn(stProcessControl:=stTemp_ClntReturn );

//Detergent
	//Concentration
	stDetergent.rValue:=g_AnalogSensor.stAnalogSensor[E_ASense_Name.CT1101_3].Value;
	pcDetergent(stProcessControl:=stDetergent );

	//Temperature
	stTemperature_Deterg.rValue:=g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1003].Value;
	pcTemperature_Deterg(stProcessControl:=stTemperature_Deterg );


//Disinfectant
	//Concentration
	stDisInfectant.rValue:=g_AnalogSensor.stAnalogSensor[E_ASense_Name.CT1101_4].Value;
	pcDisInfectant(stProcessControl:=stDisInfectant );

	//Temperature
	stTemperature_Dis.rValue:=g_AnalogSensor.stAnalogSensor[E_ASense_Name.TT1004].Value;
	pcTemperature_Dis(stProcessControl:=stTemperature_Dis );

// Flow_Rate
	//CIP Pump
		//Pump CIP infeed
		stFlow1_Rate.rValue:=g_AnalogSensor.stAnalogSensor[E_ASense_Name.FT1001].Value;
		stFlow1_Rate.rValue_Min_To_ReleaseControl:=50;// Litter/Hours
		stFlow1_Rate.bPause:=stOper[E_ModeZone.eCIP].iActOperation=E_OperationButtons.ePauseAll;
		stFlow1_Rate.fCtrlOutput_Manual:=fb_PumpCIP.nRPM;
		stFlow1_Rate.fCtrlOutput_Max:=1700;
		stFlow1_Rate.fCtrlOutput_Min:=700;
		pcFlow1_Rate(stProcessControl:=stFlow1_Rate, );

		//Pump CIP return
		stFlow2_Rate.rValue:=g_AnalogSensor.stAnalogSensor[E_ASense_Name.FT1002].Value;
		stFlow3_Rate.rValue:=g_AnalogSensor.stAnalogSensor[E_ASense_Name.FT1002].Value;
		stFlow3_Rate.rSetPoint:=stFlow2_Rate.rSetPoint;
		pcFlow2_Rate(stProcessControl:=stFlow2_Rate );
		pcFlow3_Rate(stProcessControl:=stFlow3_Rate );

		stFlow1_Rate.rSetPoint:=st_CIP_Param.r_Flow_Pipe;
		stFlow2_Rate.rSetPoint:=st_CIP_Param.r_Flow_Pipe;

//Presure
		stP1001_Pressure.rValue:=g_AnalogSensor.stAnalogSensor[E_ASense_Name.PT1001].Value;
		pcP1001_Pressure(stProcessControl:=stP1001_Pressure );

//Load def set points
IF bLoadDefSetPoints THEN
	bLoadDefSetPoints:=FALSE;
	mLoadDefProcessSetPoints();
END_IF

//selecting set point based on user

	IF bTestPID THEN;
		pcFlow1_Rate.mRun();

		fb_PumpCIP.m_Auto(control:=pcFlow1_Rate.mRun_PID(Set_Point:=180,controlManual:=NOT(fb_PumpCIP.modeAuto)));

		IF fb_PumpCIP.modeAuto THEN;
			stFlow1_Rate.bManual:=FALSE;
		ELSE;
			stFlow1_Rate.bManual:=TRUE;
			stFlow1_Rate.fCtrlOutput_Manual:=fb_PumpCIP.nRPM;
		END_IF

	END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_GetReference" Id="{483d260d-ab35-4076-91bc-ffd5a0e6d733}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[stPis_FillWater_T91 REF= stPis[valFillWater_T91];
stPis_FillWater_T92 REF= stPis[valFillWater_T92];
stPis_FillWater_T93 REF= stPis[valFillWater_T93];
stPis_FillWater_T94 REF= stPis[valFillWater_T94];

	//concentration
stDetergent 	REF=g_ProcControl.arr_stProcCntrl[E_ProcessControl_Name.eDetergentConc];
pcDetergent 	REF=g_ProcControl.arr_fbProcCntrl[E_ProcessControl_Name.eDetergentConc];

stDisInfectant 	REF=g_ProcControl.arr_stProcCntrl[E_ProcessControl_Name.eDisinfectionConc];
pcDisInfectant 	REF=g_ProcControl.arr_fbProcCntrl[E_ProcessControl_Name.eDisinfectionConc];

	//Temperature
stTemperature_Deterg REF=g_ProcControl.arr_stProcCntrl[E_ProcessControl_Name.eDeterTemp];
pcTemperature_Deterg REF=g_ProcControl.arr_fbProcCntrl[E_ProcessControl_Name.eDeterTemp];

stTemperature_Dis 	 REF=g_ProcControl.arr_stProcCntrl[E_ProcessControl_Name.eDisTemp];
pcTemperature_Dis 	 REF=g_ProcControl.arr_fbProcCntrl[E_ProcessControl_Name.eDisTemp];
	//Flow rate
stFlow1_Rate REF=g_ProcControl.arr_stProcCntrl[E_ProcessControl_Name.eCIP_Flow_1];
pcFlow1_Rate REF=g_ProcControl.arr_fbProcCntrl[E_ProcessControl_Name.eCIP_Flow_1];

stFlow2_Rate REF=g_ProcControl.arr_stProcCntrl[E_ProcessControl_Name.eCIP_Flow_2];
pcFlow2_Rate REF=g_ProcControl.arr_fbProcCntrl[E_ProcessControl_Name.eCIP_Flow_2];

stFlow3_Rate REF=g_ProcControl.arr_stProcCntrl[E_ProcessControl_Name.eCIP_Flow_3];
pcFlow3_Rate REF=g_ProcControl.arr_fbProcCntrl[E_ProcessControl_Name.eCIP_Flow_3];

	//Pressure
stP1001_Pressure 	REF=g_ProcControl.arr_stProcCntrl[E_ProcessControl_Name.eCIP_Pressure];
pcP1001_Pressure 	REF=g_ProcControl.arr_fbProcCntrl[E_ProcessControl_Name.eCIP_Pressure];

//temperature control
stTemp_ClntReturn REF=g_ProcControl.arr_stProcCntrl[E_ProcessControl_Name.eClientReturn_Temp];
pcTemp_ClntReturn REF=g_ProcControl.arr_fbProcCntrl[E_ProcessControl_Name.eClientReturn_Temp];

stHeatExchanger REF=g_ProcControl.arr_stProcCntrl[E_ProcessControl_Name.eHeatExchanger];
pcHeatExchanger REF=g_ProcControl.arr_fbProcCntrl[E_ProcessControl_Name.eHeatExchanger];]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_HeatExchng" Id="{13b9d6f9-7b3e-4e54-9f53-f81ae43526f9}" FolderPath="Manage\">
      <Implementation>
        <ST><![CDATA[//calling heat exchanger 
fb_HeatExchenger(stHeatExchanger:=g_Data.stHeatExchanger );

//Choosing heat exchanger set point 

CASE nStepHeat OF
	0:	
	(*	//heat excahnger not in use 
	1:
		//detergent local
		IF stTemperature_Deterg.Control_ON THEN
			g_Data.stHeatExchanger:=stTemperature_Deterg.Control_Value;
		ELSE
			g_Data.stHeatExchanger:=0;
		END_IF
	10:
		//detergent client
	2:
		//disinfection
		IF stTemperature_Dis.Control_ON THEN
			g_Data.stHeatExchanger:=stTemperature_Dis.Control_Value;
		ELSE
			g_Data.stHeatExchanger:=0;
		END_IF
	20:
		//disinfection client
	3:
		//something else
		*)
END_CASE]]></ST>
      </Implementation>
    </Action>
