fbCIP_Usage.m_Run(eReqProc:=E_CIP_Usage.eLocal);
fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eDrain);

m_DashState_activate(stage:=E_CIP_DashStage_List.e12_CIP4_Local_DisInfection_Fill);]]></ST>
      </Implementation>
