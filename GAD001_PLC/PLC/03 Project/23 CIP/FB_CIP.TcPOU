      <Implementation>
        <ST><![CDATA[eReq:=arCIP_RequestBufer[0];

IF eReq.eType=E_CIP_Type.Full THEN;
	eCIP_State:=E_Element_State_Long.eNotClean;
ELSE;
	eCIP_State:=E_Element_State_Long.eCIP_1_Rinzed;
