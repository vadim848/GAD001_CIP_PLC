    <Action Name="_aEnd_Check_active" Id="{98177335-fdd1-4c16-8092-a4d30c9fc2e4}">
      <Implementation>
        <ST><![CDATA[bStepDone:=FALSE;
IF TRUE
AND eCIP_State = E_Element_State_Long.eCIP_3_Deterged_Clean
AND eReq.eType = E_CIP_Type.Detergent
THEN;
	bStepDone:=TRUE;

ELSIF TRUE
AND eCIP_State = E_Element_State_Long.eCIP_5_Done
AND eReq.eType = E_CIP_Type.Full
THEN;
	bStepDone:=TRUE;

END_IF]]></ST>
      </Implementation>
