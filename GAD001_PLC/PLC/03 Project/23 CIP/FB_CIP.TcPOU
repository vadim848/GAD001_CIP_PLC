    <Action Name="_aCondition_CIP3_Local_exit" Id="{c5ddd08b-9232-4cf0-8f74-a26e6c7d4c1f}">
      <Implementation>
        <ST><![CDATA[tonr_CIP_Condition(IN:=FALSE);]]></ST>
      </Implementation>
