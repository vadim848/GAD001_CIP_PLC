    <Action Name="_aConnect_CIP4_R_Water_entry" Id="{14a8e164-fee8-4fa5-b39e-b5e01295e23f}">
      <Implementation>
        <ST><![CDATA[fbCIP_Return.m_Run(eReqProc:=E_CIP_Return.eT93_R_Water);
mVolumeReset_All();

CASE eCIP_State OF

	E_Element_State_Long.eCIP_2_Deterged:;
			m_DashState_done(stage:=E_CIP_DashStage_List.e09_CIP3_Detergent_Drain);
			m_DashState_activate(stage:=E_CIP_DashStage_List.e10_CIP3_Detergent_Clean_Pipe);

	E_Element_State_Long.eCIP_4_Sanitized:;
			m_DashState_done(stage:=E_CIP_DashStage_List.e18_CIP5_DisInfection_Drain);
			m_DashState_activate(stage:=E_CIP_DashStage_List.e19_CIP5_DisInfection_Clean_Pipe);

END_CASE]]></ST>
      </Implementation>
