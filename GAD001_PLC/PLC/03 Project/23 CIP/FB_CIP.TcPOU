    <Action Name="_aReady_active" Id="{560e86d1-cd11-44bd-aed6-a8db9be9b76c}">
      <Implementation>
        <ST><![CDATA[CASE eMode OF
	E_CIP_Mode.eOff:;
		bRun:=FALSE;
		bStepDone:=FALSE;
	E_CIP_Mode.eManual:;
		IF TRUE 
		AND bRun 
		AND arCIP_RequestBufer[0].eClient<>E_CIP_Usage.eNotInUse
		
		THEN;
			bStepDone:=TRUE;
		ELSE;
			bStepDone:=FALSE;
		END_IF	
	E_CIP_Mode.eAuto:;
		IF TRUE 
		//AND bRun 
		AND arCIP_RequestBufer[0].eClient<>E_CIP_Usage.eNotInUse
		
		THEN;
			bRun:=TRUE;
			bStepDone:=TRUE;
		ELSE;
			bStepDone:=FALSE;
		END_IF		
END_CASE
	
]]></ST>
      </Implementation>
