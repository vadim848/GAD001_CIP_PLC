<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <GVL Name="g_Data" Id="{d323a574-dba5-4513-95f5-99a87722cf92}">
    <Declaration><![CDATA[//{attribute 'qualified_only'}
VAR_GLOBAL PERSISTENT
	fbCIP						: FB_CIP;
	
	fbCIP_Source				: FB_CIP_Source;
	fbCIP_Return				: FB_CIP_Return;
	fbCIP_Client				: FB_CIP_Client;
	
	arCIP_RequestBufer: ARRAY [0..9] OF ST_CIP_Request;

	//Heat Exchanger
	fbHeatExchenger	:	FB_HeatExchanger	;
	stHeatExchanger	:	ST_HeatExchanger	;
	
	////////////////////////////////////////////////////////////////
	arrTanksSens	:	ARRAY [0..E_Tank_Name.last] OF FB_TankSensors;
	stTanksSens		:	ARRAY [0..E_Tank_Name.last] OF ST_Tank_Level;
	
	////////////////////////////////////////////////////////////////
	arr_CIP_Param		:	ARRAY [0..E_CIP_Usage.eLocal] OF ST_CIP_Param		;//old sets, not read by FB_CIP any more: source of the one-time transfer
	//Recipes of FB_CIP (Vadim 02.11.2026): 0 = Local, 1..30 = CLIENT ID of Siemens
	arr_CIP_Recipe		:	ARRAY [0..cnRecipeMax] OF ST_CIP_Param		;
	arr_CIP_Description	:	ARRAY [0..cnRecipeMax] OF STRING(80)		;//text of the operator, FB_CIP does not read it
	bRecipeTransfer		:	BOOL	;//one-time: old Local, Tank3 Color, Line Color -> recipes 0, 1, 2; reset by MAIN

	//additional variables
	b_CIP_Run	:	BOOL	;
END_VAR
VAR_GLOBAL CONSTANT
	cnRecipeMax			:	INT := 30	;//last recipe = last CLIENT ID
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>