<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="Prg_Filter_Messages" Id="{e805a088-c94f-4978-97be-be65f3abe8a0}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Prg_Filter_Messages
VAR
	sSearchMessage		: STRING;
	i					: INT;
	d					: INT;
	stFilter			: stMessageFormat;
	stLastFilter		: stMessageFormat;
	T1					: TON;
	bFilter				: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF stFilter.sErrID<>stLastFilter.sErrID
OR  stFilter.sLevel <>stLastFilter.sLevel
OR  stFilter.sModuleDescription <>stLastFilter.sModuleDescription
OR  stFilter.sErrorMessage<>stLastFilter.sErrorMessage THEN

	FOR i:=1000 TO 1 BY -1 DO
		Buffer_Search_Messages[i].sDateTime:='';
		Buffer_Search_Messages[i].sErrID:='';
		Buffer_Search_Messages[i].sErrorMessage:='';
		Buffer_Search_Messages[i].sLevel:='';
		Buffer_Search_Messages[i].sModuleDescription:='';
	END_FOR
	bFilter:=TRUE;
ELSE
	bFilter:=FALSE;
END_IF




T1(IN:=bFilter , PT:=T#300MS , Q=> , ET=> );
IF T1.Q THEN
	d:=2;
	FOR i:=1 TO 1000 DO
			IF (Buffer_Act_History[i].sErrID=stFilter.sErrID OR stFilter.sErrID='')
			AND (Buffer_Act_History[i].sLevel=stFilter.sLevel OR stFilter.sLevel='')
			AND (Buffer_Act_History[i].sErrorMessage=stFilter.sErrorMessage OR stFilter.sErrorMessage='')
			AND (Buffer_Act_History[i].sModuleDescription=stFilter.sModuleDescription OR stFilter.sModuleDescription='')THEN
				Buffer_Search_Messages[d]:=Buffer_Act_History[i];
				d:=d+1;
			END_IF
	END_FOR
	
	
ELSE

FOR i:=1000 TO 2 BY -1 DO
	Buffer_Search_Messages[i]:=Buffer_Act_History[i-1];
END_FOR

END_IF

	]]></ST>
    </Implementation>
