<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="prg_HMI_OperationLock" Id="{f5b36e28-da1f-4c4d-8f16-7f4a7f73e8f6}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM prg_HMI_OperationLock
VAR
	b_LockIndex: BOOL;
	b_LockLoad: BOOL;
	b_LockUnload: BOOL;
	b_LockManip: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF stModeMain.iActMode= 2 AND prg_User.actUser< 3 THEN
   b_LockIndex := TRUE;
ELSE
   b_LockIndex := FALSE;
END_IF
]]></ST>
    </Implementation>
    <LineIds Name="prg_HMI_OperationLock">
      <LineId Id="44" Count="3" />
      <LineId Id="14" Count="0" />
      <LineId Id="26" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>